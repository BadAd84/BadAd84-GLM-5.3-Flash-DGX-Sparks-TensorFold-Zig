+test "GLM disk ranks: a kept state's words carry the digest of the cuts its pass kept it under" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    x.e.drafter = null; // keep reads the drafter only with DRAFT_KEEPWIN on, and this engine holds none
+    const at: u32 = 2048;
+    x.seq.st.pos = at;
+    x.seq.st.pending = 0;
+    x.seq.st.mtp_len = 0;
+    try x.seq.cuts.append(t.allocator, 300); // one request start below `at`: the pass cut off the plain grid
+    defer x.seq.cuts.deinit(t.allocator);
+    const id = try snapshots.keep(x.e);
+    const want = prompt_cuts.below(x.seq.cuts.items, at);
+    try t.expect(want != 0);
+    try t.expectEqual(want, (try ranks.wordsOf(x.e, id)).below); // the words gather writes into the image
+    try t.expectEqual(want, x.e.snaps.get(id).?.below); // the snapshot a second gather reads them off
+}
+
+test "GLM disk ranks: a state read back keeps its file's digest, and resumes only a pass that cuts alike" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    const at: u32 = 2348; // a grid point past a request start: the position a warm turn resumes at
+    const cuts = [_]u32{300}; // the pass that kept the state: one start below `at`
+    const kept = prompt_cuts.below(&cuts, at);
+    try t.expect(kept != 0);
+    const id = try ranks.blank(x.e, at);
+    var k: Kept = .{ .id = id, .at = at };
+    const file = image.Words{ .at = at, .mtp_len = 0, .base = 0, .mtp_base = 0, .cur = 0, .world = x.e.share.world, .below = kept };
+    try ranks.unseal(x.e, &k, file.encode()); // what scatter does with the state's own file
+    try t.expectEqual(kept, k.below);
+    try t.expectEqual(kept, x.e.snaps.get(id).?.below);
+    try t.expect(prompt_cuts.resumes(4 * at, &cuts, at, k.below)); // the same cuts below it: resumed
+    try t.expect(!prompt_cuts.resumes(4 * at, &.{ 700, at }, at, k.below)); // another start below it: refused
+    try t.expect(!prompt_cuts.resumes(4 * at, &cuts, at, 0)); // the digest a read back used to lose: refused
+    const id2 = try ranks.blank(x.e, 4096); // a state on the plain grid round-trips with a zero digest
+    var k2: Kept = .{ .id = id2, .at = 4096 };
+    try ranks.unseal(x.e, &k2, (image.Words{ .at = 4096, .mtp_len = 0, .base = 0, .mtp_base = 0, .cur = 0, .world = x.e.share.world }).encode());
+    try t.expectEqual(@as(u64, 0), k2.below);
+    try t.expect(prompt_cuts.resumes(8192, &.{}, 4096, k2.below)); // the plain grid, as before
+    try t.expect(!prompt_cuts.resumes(8192, &.{ 300, 4096 }, 4096, k2.below)); // a start below it: refused, as before
+}
