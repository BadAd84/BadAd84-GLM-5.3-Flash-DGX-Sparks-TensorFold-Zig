+test "GLM disk image: the words' digest round-trips, and a nine-word format 1 image is refused by name" {
+    const at: u32 = 4096;
+    const below: u64 = 0x9e3779b97f4a7c15 | 1; // what cuda_prompt_cuts.below gives off the plain grid: never 0
+    const w: image.Words = .{ .at = at, .mtp_len = 7, .base = 1, .mtp_base = 2, .cur = 0b1, .world = 3, .below = below };
+    const x = w.encode();
+    try expectEqual(@as(u64, 10), image.Words.count);
+    try expectEqual(below, x[image.Words.count - 1]);
+    try expectEqual(w, try image.Words.decode(x, at, 3, .unsplit));
+    // the words before this change: nine words, the ninth the owner; a file written by that build reads as nothing
+    var old = x;
+    old[0] = 1;
+    try expectError(error.DiskWords, image.Words.decode(old, at, 3, .unsplit));
+    // a state kept on the plain grid carries a zero digest, as every image did
+    const plain: image.Words = .{ .at = at, .mtp_len = 7, .base = 1, .mtp_base = 2, .cur = 0b1, .world = 3 };
+    try expectEqual(@as(u64, 0), (try image.Words.decode(plain.encode(), at, 3, .unsplit)).below);
+}
