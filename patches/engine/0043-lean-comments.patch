+    const long long* __restrict__ table, int n, int mode, unsigned* __restrict__ sink) {  // pieces of at most 32 KiB
     const int lane = threadIdx.x & 31;
     const int warp = (blockIdx.x * blockDim.x + threadIdx.x) >> 5;
     const int warps = (gridDim.x * blockDim.x) >> 5;
-    if (mode == 0) {
+    if (mode == 0) {  // "bulk": one cp.async.bulk.prefetch.L2 a piece, which the TMA unit walks (sm_90+)
         for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
             const unsigned long long a = (unsigned long long)table[2 * i];
             const unsigned bytes = (unsigned)table[2 * i + 1];
@@ -34,9 +25,9 @@
         const unsigned long long a = (unsigned long long)table[2 * i];
         const unsigned bytes = (unsigned)table[2 * i + 1];
         for (unsigned o = lane * 128u; o < bytes; o += 32u * 128u) {
-            if (mode == 1) {
+            if (mode == 1) {  // "lines": every 128-byte line of a piece, a warp's lanes on adjacent lines
                 asm volatile("prefetch.global.L2::evict_last [%0];" :: "l"(a + o));
-            } else {
+            } else {  // "touch": a real load of each line's first 16 bytes, so the kernel lasts as long as the reads
                 unsigned x, y, z, w;
                 asm volatile("ld.global.cg.v4.u32 {%0, %1, %2, %3}, [%4];"
                              : "=r"(x), "=r"(y), "=r"(z), "=r"(w) : "l"(a + o));
