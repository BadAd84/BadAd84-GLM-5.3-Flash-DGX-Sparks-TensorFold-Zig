+//! TF_GLM_OVN_PIECE_FRONT, _FFN and _MLA: which sites hand the next block's front their glued rows piece by piece.
+const std = @import("std");
+const cuda = @import("cuda");
+const pieces = @import("cuda_forward_pieces.zig");
+
+test "TF_GLM_OVN_PIECE_FRONT, _FFN and _MLA: each off unless set to 1, and independent" {
+    const names = .{ "PIECE_FRONT", "PIECE_FFN", "PIECE_MLA" };
+    const reads = .{ pieces.pieceFront, pieces.pieceFfn, pieces.pieceMla };
+    defer inline for (names) |n| cuda.ovn.fake(n, null);
+    inline for (names, reads) |n, read| {
+        inline for (names) |other| cuda.ovn.fake(other, null);
+        try std.testing.expect(!read());
+        cuda.ovn.fake(n, "1");
+        try std.testing.expect(read());
+        inline for (names, reads) |other, other_read| if (!std.mem.eql(u8, other, n)) try std.testing.expect(!other_read());
+        cuda.ovn.fake(n, "0");
+        try std.testing.expect(!read());
+    }
+}
+
+test "pieces.handsFront: only to a block with a front, and not under the profiler or with shared segments" {
+    try std.testing.expect(pieces.handsFront(true, false, false, true));
+    try std.testing.expect(!pieces.handsFront(false, false, false, true));
+    try std.testing.expect(!pieces.handsFront(true, true, false, true));
+    try std.testing.expect(!pieces.handsFront(true, false, true, true));
+    try std.testing.expect(!pieces.handsFront(true, false, false, false));
+}
+
+fn rangesMin(cut: []const [2]usize, min_rows: usize, want: []const [2]usize, want_last: []const usize) !void {
+    var out: [pieces.max_pieces][2]usize = undefined;
+    var last: [pieces.max_pieces]usize = undefined;
+    const n = pieces.frontRanges(cut, min_rows, &out, &last);
+    try std.testing.expectEqual(want.len, n);
+    for (want, want_last, 0..) |w, l, i| {
+        try std.testing.expectEqual(w, out[i]);
+        try std.testing.expectEqual(l, last[i]);
+    }
+}
+
+fn ranges(cut: []const [2]usize, want: []const [2]usize, want_last: []const usize) !void {
+    return rangesMin(cut, 0, want, want_last);
+}
+
+test "pieces.frontRanges: the pieces as cut, a last piece under a row step joined to the one before it" {
+    try ranges(&.{ .{ 0, 1024 }, .{ 1024, 2048 }, .{ 2048, 3072 }, .{ 3072, 4096 } }, &.{ .{ 0, 1024 }, .{ 1024, 2048 }, .{ 2048, 3072 }, .{ 3072, 4096 } }, &.{ 0, 1, 2, 3 });
+    try ranges(&.{ .{ 0, 384 }, .{ 384, 768 }, .{ 768, 769 } }, &.{ .{ 0, 384 }, .{ 384, 769 } }, &.{ 0, 2 });
+    try ranges(&.{ .{ 0, 128 }, .{ 128, 256 }, .{ 256, 383 } }, &.{ .{ 0, 128 }, .{ 128, 383 } }, &.{ 0, 2 });
+    try ranges(&.{ .{ 0, 128 }, .{ 128, 256 } }, &.{ .{ 0, 128 }, .{ 128, 256 } }, &.{ 0, 1 });
+    try ranges(&.{.{ 0, 3 }}, &.{.{ 0, 3 }}, &.{0});
+    try ranges(&.{ .{ 0, 100 }, .{ 100, 150 } }, &.{.{ 0, 150 }}, &.{1});
+}
+
+test "pieces.frontRanges: with a minimum, pieces join until a range has that many rows, and the last one never starts a short range" {
+    const warm: []const [2]usize = &.{ .{ 0, 384 }, .{ 384, 768 }, .{ 768, 1152 }, .{ 1152, 1326 } };
+    try rangesMin(warm, 768, &.{ .{ 0, 768 }, .{ 768, 1326 } }, &.{ 1, 3 });
+    try rangesMin(warm, 1024, &.{ .{ 0, 1152 }, .{ 1152, 1326 } }, &.{ 2, 3 });
+    try rangesMin(warm, 1326, &.{.{ 0, 1326 }}, &.{3});
+    try rangesMin(warm, 384, warm, &.{ 0, 1, 2, 3 });
+    try rangesMin(&.{ .{ 0, 1024 }, .{ 1024, 2048 }, .{ 2048, 3072 }, .{ 3072, 4096 } }, 1024, &.{ .{ 0, 1024 }, .{ 1024, 2048 }, .{ 2048, 3072 }, .{ 3072, 4096 } }, &.{ 0, 1, 2, 3 });
+}
+
+test "TF_GLM_OVN_FRONT_ROWS: 0 unless set, a whole number" {
+    defer cuda.ovn.fake("FRONT_ROWS", null);
+    cuda.ovn.fake("FRONT_ROWS", null);
+    try std.testing.expectEqual(@as(usize, 0), try pieces.frontRows());
