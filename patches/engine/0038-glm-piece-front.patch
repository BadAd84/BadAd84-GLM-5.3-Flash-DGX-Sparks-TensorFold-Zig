+        }
+    }
+}
+
+/// Layer `l`'s MoE router on each range of rows once its pieces' glued rows are in (`sent`: gluePiecesAsync's mask).
+pub fn route(f: *const Forward, p: *const Pieces, l: weights.Layer, cut: []const [2]usize, sent: usize, min_rows: usize) !void {
+    const m = switch (l.ffn) {
+        .moe => |moe_layer| moe_layer,
+        .dense => return error.BadFront,
+    };
+    var spans: [fw.max_pieces][2]usize = undefined;
+    var last: [fw.max_pieces]usize = undefined;
+    const n = pieces.frontRanges(cut, min_rows, &spans, &last);
+    var from: usize = 0;
+    for (spans[0..n], last[0..n]) |span, q| {
+        try waitShared(f, p, sent, from, q);
+        from = q + 1;
+        for (f.ranks) |r| try moe.routeRows(f.moeKernels(), f.stream, m, r.b.moe, r.b.normed, r.w.config.hidden, span[0], span[1]);
+    }
+}
