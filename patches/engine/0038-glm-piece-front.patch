+
+/// Layer `next`'s row-by-row part on each range of rows once its pieces' glued rows are in (every piece shared).
+pub fn mixer(f: *const Forward, p: *const Pieces, next: weights.Layer, cut: []const [2]usize, min_rows: usize) !void {
+    var spans: [fw.max_pieces][2]usize = undefined;
+    var last: [fw.max_pieces]usize = undefined;
+    const n = pieces.frontRanges(cut, min_rows, &spans, &last);
+    const all = (@as(usize, 1) << @intCast(cut.len)) - 1;
+    var from: usize = 0;
+    for (spans[0..n], last[0..n]) |span, q| {
+        try waitShared(f, p, all, from, q);
+        from = q + 1;
+        for (f.ranks) |r| {
+            switch (next.mixer) {
+                .kda => |k| {
+                    var s = r.b.kda;
+                    s.p = r.b.kproj;
+                    try kda_block.projectRows(f.set(), f.stream, k, s, r.b.normed, r.w.config.hidden, span[0], span[1]);
+                },
+                .mla => |a| {
+                    const qi = dsa_block.sparseRows(a, r.st.pos, cut[cut.len - 1][1]);
+                    try dsa_block.prepareRows(f.set(), f.stream, a, r.b.dsa, r.b.normed, r.w.config.hidden, span[0], span[1], qi);
+                },
