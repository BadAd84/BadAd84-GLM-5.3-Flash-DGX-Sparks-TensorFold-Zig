+/// What an ffn site hands the next layer's mixer: nothing, its KDA projections, or its DSA block's row-by-row part.
+pub const Next = enum { none, kda, mla };
+
+/// Whether a rank's pass is a shared window with segments (its blocks read other rows than a piece's).
+fn anySegments(f: *const Forward) bool {
+    for (f.ranks) |r| if (r.segs.len > 0) return true;
+    return false;
+}
+
+/// What layer j's ffn site hands layer j + 1: its KDA projections (PIECE_FRONT) or its DSA front (PIECE_MLA).
+pub fn handsMixer(f: *const Forward, kda_on: bool, mla_on: bool, j: usize) Next {
+    const layers = f.ranks[0].w.layers;
+    const kda_next = j + 1 < layers.len and std.meta.activeTag(layers[j + 1].mixer) == .kda;
+    const mla_next = j + 1 < layers.len and std.meta.activeTag(layers[j + 1].mixer) == .mla;
+    if (pieces.handsFront(kda_on, f.prof != null, anySegments(f), kda_next)) return .kda;
+    if (pieces.handsFront(mla_on, f.prof != null, anySegments(f), mla_next)) return .mla;
+    return .none;
