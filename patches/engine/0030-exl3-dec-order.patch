@@ -57,6 +57,17 @@ pub fn plan(k: usize, n: usize, gateup: bool) !u32 {
     return error.TileNotBuilt;
 }
 
+/// TF_EXL3_DEC_ORDER: 1 issues each k slice's blocks before the items; the same values, a different order. Read once.
+var dec_order_env: ?u32 = null;
+fn decOrder() u32 {
+    if (dec_order_env == null) {
+        const raw = @import("profile").lookup("TF_EXL3_DEC_ORDER");
+        const on = @import("sys").environment.value(bool, "TF_EXL3_DEC_ORDER", raw, false) catch false;
+        dec_order_env = @intFromBool(on);
+    }
+    return dec_order_env.?;
+}
+
 /// One call's buffers (exl3/experts.py Scratch), laid out in scratch()'s order, each 256-byte aligned.
 pub const Scratch = struct {
     xg: u64, // fp16 [P, D], the rotated gate inputs
@@ -268,7 +279,11 @@ pub const Experts = struct {
         g.add(i32d(l.gu_stride));
         g.add(std_a);
         g.add(skip_a);
-        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(nx), .y = @intCast(w / 128), .z = @intCast(2 * g_sk * mtu) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &g);
+        const ord_g: u32 = decOrder();
+        g.add(i32d(ord_g));
+        const gx: u32 = @intCast(if (ord_g == 1) w / 128 else nx);
+        const gy: u32 = @intCast(if (ord_g == 1) nx else w / 128);
+        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = gx, .y = gy, .z = @intCast(2 * g_sk * mtu) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &g);
 
         var ep: launch_.Args = .{};
         ep.add(sc.z);
@@ -307,7 +322,11 @@ pub const Experts = struct {
         dn.add(@as(i32, 0));
         dn.add(std_a);
         dn.add(skip_a);
-        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(nx), .y = @intCast(d / 128), .z = @intCast(d_sk * mtu) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &dn);
+        const ord_d: u32 = decOrder();
+        dn.add(i32d(ord_d));
+        const dx: u32 = @intCast(if (ord_d == 1) d / 128 else nx);
+        const dy: u32 = @intCast(if (ord_d == 1) nx else d / 128);
+        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = dx, .y = dy, .z = @intCast(d_sk * mtu) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &dn);
 
         var cb: launch_.Args = .{};
         cb.add(sc.z);
