+test "TF_GLM_OVN_NO_COPY: a drafter's facts drop copy drafts only while the switch is on" {
+    var e: engine.Engine = undefined;
+    e.gpa = std.testing.allocator;
+    e.mtp = true;
+    e.drafter = null;
+    var self: Lanes = .{ .x = .{ .e = &e, .link = undefined } };
+    defer self.lanes.deinit(e.gpa);
+    defer cuda.ovn.fake("NO_COPY", null);
+    cuda.ovn.fake("NO_COPY", null);
+    try std.testing.expect(self.facts().copy_drafts); // no drafter loaded: nothing to switch off
+    cuda.ovn.fake("NO_COPY", "1");
+    try std.testing.expect(self.facts().copy_drafts); // nor with the switch on: the head's copies stay
+    var block: dflash.Drafter = undefined;
+    e.drafter = &block;
+    defer e.drafter = null;
+    try std.testing.expect(!self.facts().copy_drafts);
+    cuda.ovn.fake("NO_COPY", null);
+    try std.testing.expect(self.facts().copy_drafts); // the switch off: the model's own default stands
+    cuda.ovn.fake("NO_COPY", "0");
+    try std.testing.expect(self.facts().copy_drafts);
+}
