From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Subject: [PATCH] core: every OVN knob gets its own cache statics

ai-engine 32989e34f. The registry's cache key captures the knob name, so each knob gets its own
type and its own statics; a single type for all names would answer the first knob it read for
every later one. Same reads, same values, no behaviour change.

Gate: applies on the pin stack; check-native-cuda-host green; whole-tree fmt green; lean
base-vs-head 0 new. No speed claim of its own.

diff --git a/zig/src/cuda/ovn.zig b/zig/src/cuda/ovn.zig
index 7b2896777..762497f51 100644
--- a/zig/src/cuda/ovn.zig
+++ b/zig/src/cuda/ovn.zig
@@ -1,20 +1,22 @@
 //! Speed-hunt knobs (`TF_GLM_OVN_<NAME>`): environment-read once a process, default off, same on every rank.
 const std = @import("std");
 
-fn raw(comptime name: []const u8) ?[]const u8 {
-    const v = std.c.getenv("TF_GLM_OVN_" ++ name) orelse return null;
-    const s = std.mem.span(v);
-    return if (s.len == 0) null else s;
+/// One knob's cache: `key` captures `name`, giving every knob its own type and statics.
+fn Cache(comptime name: []const u8) type {
+    return struct {
+        const key = "TF_GLM_OVN_" ++ name;
+        var read = false;
+        var value: ?[]const u8 = null;
+    };
 }
 
 /// `TF_GLM_OVN_<name>` as text (unset or empty: null), cached after the first read.
 pub fn text(comptime name: []const u8) ?[]const u8 {
-    const S = struct {
-        var read = false;
-        var value: ?[]const u8 = null;
-    };
+    const S = Cache(name);
     if (!S.read) {
-        S.value = raw(name);
+        const v = std.c.getenv(S.key);
+        const s = if (v) |p| std.mem.span(p) else "";
+        S.value = if (s.len == 0) null else s;
         S.read = true;
     }
     return S.value;
@@ -36,3 +38,13 @@ test "ovn: an unset knob is off and takes its default" {
     try std.testing.expect(!on("NO_SUCH_KNOB_FOR_TESTS"));
     try std.testing.expectEqual(@as(u64, 7), try int("NO_SUCH_KNOB_FOR_TESTS", 7));
 }
+
+test "ovn: each knob keeps its own value (one knob read first never answers for another)" {
+    Cache("TEST_A").read = true;
+    Cache("TEST_A").value = "8";
+    Cache("TEST_B").read = true;
+    Cache("TEST_B").value = null;
+    try std.testing.expectEqual(@as(u64, 8), try int("TEST_A", 0));
+    try std.testing.expect(!on("TEST_B"));
+    try std.testing.expect(on("TEST_A"));
+}
