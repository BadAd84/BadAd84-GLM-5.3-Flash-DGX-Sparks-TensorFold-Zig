     const nk = w.layers.len - nd;
     const n = s.kda.len() * c.kda_dim;
-    const kw = @import("cuda_kda_block.zig").paddedWidth(3 * n + 2 * c.kda_dim + s.kda.len()); // TF_GLM_KDA_PAD
+    const kw = @import("cuda_kda_block.zig").rowWidth(s.kda.len()); // TF_GLM_KDA_PAD
     const pk_rows = capacity / sparse.pool + 2;
     const ring_rows = @min(capacity, index_ring);
     const rows: usize = @intFromBool(table == null); // on pages a cache's rows are the pool's
@@ -120,7 +120,7 @@
     const c = &w.config;
     const s = &w.share;
     const n = s.kda.len() * c.kda_dim;
-    const kw = @import("cuda_kda_block.zig").paddedWidth(3 * n + 2 * c.kda_dim + s.kda.len()); // TF_GLM_KDA_PAD
+    const kw = @import("cuda_kda_block.zig").rowWidth(s.kda.len()); // TF_GLM_KDA_PAD
     return .{
         .{ kw, c.hidden },                   .{ n, c.kda_dim },                    .{ c.hidden, n },
         .{ c.q_lora + c.kv_lora, c.hidden }, .{ s.mla.len() * c.nope, c.q_lora },  .{ c.i_dim + c.i_heads, c.hidden },
@@ -215,7 +215,7 @@
         const LL = s.kda.len();
         const HL = s.mla.len();
         const n = LL * c.kda_dim;
-        const kw = @import("cuda_kda_block.zig").paddedWidth(3 * n + 2 * c.kda_dim + LL); // TF_GLM_KDA_PAD
+        const kw = @import("cuda_kda_block.zig").rowWidth(LL); // TF_GLM_KDA_PAD
         const mw = s.dense.len();
         const ew = s.moe.len();
         const sh = s.shared.len();
@@ -434,7 +434,7 @@
         const nk = w.layers.len - mlaLayers(w);
         const nd = mlaLayers(w);
         const n = s.kda.len() * c.kda_dim;
-        const kw = @import("cuda_kda_block.zig").paddedWidth(3 * n + 2 * c.kda_dim + s.kda.len()); // TF_GLM_KDA_PAD
+        const kw = @import("cuda_kda_block.zig").rowWidth(s.kda.len()); // TF_GLM_KDA_PAD
         const pk_rows = capacity / sparse.pool + 2;
         const sizes = try stateSizes(gpa, w, capacity, kv8, if (paged) |q| q.pages else null);
         defer gpa.free(sizes);
diff --git a/zig/src/families/glm/cuda_tile.zig b/zig/src/families/glm/cuda_tile.zig
--- a/zig/src/families/glm/cuda_tile.zig
+++ b/zig/src/families/glm/cuda_tile.zig
@@ -147,7 +147,6 @@
 
 /// Eligible linears tiled in place; uneven KDA inputs and their views stay bf16 for the row-major kernels.
 pub fn tileLinears(gpa: std.mem.Allocator, w: *Weights, mk: *const mm_mod.Kernels, s: cuda.Stream, d: *const cuda.Driver, dense_bits: u8, head_bits: u8) !mm_mod.Packed {
-    try padKdaInputs(w, d, s); // pad_to is set at load (Engine.open), so a stack pads only with TF_GLM_KDA_PAD=1
     try padKdaInputs(w, d, s); // pad_to was set at load (Engine.open), so a stack pads only with TF_GLM_KDA_PAD=1
     var list: std.ArrayList(Lin) = .empty;
     defer list.deinit(w.gpa);
