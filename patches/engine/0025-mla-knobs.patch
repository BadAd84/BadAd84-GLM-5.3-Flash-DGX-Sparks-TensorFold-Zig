     \\  glm-draft-onepass         TF_GLM_OVN_DRAFT_ONEPASS: the drafter's 4-bit rows in one launch against 16-row launches, byte for byte
     \\  glm-index-ovn-check       TF_GLM_OVN_DECODE_INDEX, _INDEX_SCHED and _POOLS32 against today's kernels, byte for byte (one GPU)
     \\  glm-index-regroup-check   TF_GLM_OVN_INDEX_REGROUP's scores and pools against today's, byte for byte (one GPU)
+    \\  glm-mla-skip-check        TF_GLM_OVN_MLA_FUSEMERGE: the bounded and fused chunk launches against today's, byte for byte
+    \\  glm-onepass-exact-check   TF_GLM_OVN_ONEPASS_PIPE: pipe exact against the chunk programs plus merge, pipe off against the one-pass
     \\
 ;
 
@@ -22,6 +26,10 @@ pub fn run(gpu: check.Gpu, cmd: []const u8, rest: []const [:0]const u8) !bool {
         try glm_index_ovn_check.run(gpu);
     } else if (std.mem.eql(u8, cmd, "glm-index-regroup-check")) {
         try glm_index_regroup_check.run(gpu);
+    } else if (std.mem.eql(u8, cmd, "glm-mla-skip-check")) {
+        try glm_mla_skip_check.run(gpu);
+    } else if (std.mem.eql(u8, cmd, "glm-onepass-exact-check")) {
+        try glm_onepass_exact_check.run(gpu);
     } else return false;
     return true;
 }
