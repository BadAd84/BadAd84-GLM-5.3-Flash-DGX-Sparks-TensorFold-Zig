+              "tf_glm_chunks_32_skip and tf_glm_chunks_32 take one argument list");
+static_assert(glm_attn_ovn::same_params<decltype(tf_glm_chunks_16_fp8_skip), decltype(tf_glm_chunks_16_fp8)>::value,
+              "tf_glm_chunks_16_fp8_skip and tf_glm_chunks_16_fp8 take one argument list");
