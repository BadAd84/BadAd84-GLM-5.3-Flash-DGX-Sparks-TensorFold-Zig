diff --git a/zig/tests/cuda/glm_mla_skip_check.zig b/zig/tests/cuda/glm_mla_skip_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..344155fa52e4c1ff6289494537b4f7f6c7b4323b
--- /dev/null
+++ b/zig/tests/cuda/glm_mla_skip_check.zig
@@ -0,0 +1,109 @@
+//! glm-mla-skip-check (GPU): TF_GLM_OVN_MLA_FUSEMERGE's bounded and fused launches against today's, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const glm = @import("glm_cuda");
+const Rig = qr.RigT;
+const latent = glm.latent;
+const glue = glm.glue;
+
+const lw = 512;
+const heads = 22; // a TP=3 rank's heads
+const keys = 2100;
+const width = 2051; // sparse.width: five 512-key chunks, the last with 3 keys
+const scale: f32 = 0.0625;
+
+/// A latent cache: BF16 rows (scales 0), or the FP8 writer's E4M3 rows followed by their scales.
+const Cache = struct { lc: u64, scales: u64, name: []const u8 };
+
+/// One attention call: dense from position `pos` on `hb`-head blocks, or sparse over token lists (`pos` null).
+const Call = struct { rows: usize, pos: ?usize = null, hb: usize = latent.heads_tile };
+
+fn position(r: *Rig, v: usize) !u64 {
+    const p: i32 = @intCast(v);
+    return r.dev(std.mem.asBytes(&p));
+}
+
+fn caches(r: *Rig, set: glue.Set) ![2]Cache {
+    const bf = try r.dev(std.mem.sliceAsBytes(try r.bfs(keys * lw, 1.0)));
+    const fp = try r.zeros(try latent.cacheBytes(keys, lw, true));
+    const scales = fp + keys * lw;
+    try latent.latentWriteFormat(set, r.s, bf, lw, fp, scales, .{}, try position(r, 0), keys, lw);
+    return .{ .{ .lc = bf, .scales = 0, .name = "bf16" }, .{ .lc = fp, .scales = scales, .name = "fp8" } };
+}
+
+/// Token lists of `rows` rows: counts at the chunk and tile edges, count 0 included, keys at random.
+fn lists(r: *Rig, rows: usize) !struct { u64, u64 } {
+    const edges = [_]i32{ 0, 1, 31, 32, 33, 511, 512, 513, 1024, 2048, 2051, 3 };
+    const tok = try r.a.alloc(i32, rows * width);
+    @memset(tok, -1);
+    const cnt = try r.a.alloc(i32, rows);
+    for (cnt, 0..) |*n, row| {
+        n.* = edges[row % edges.len];
+        for (tok[row * width ..][0..@intCast(n.*)]) |*t| t.* = @intCast(r.rng.uintLessThan(usize, keys));
+    }
+    return .{ try r.dev(std.mem.sliceAsBytes(tok)), try r.dev(std.mem.sliceAsBytes(cnt)) };
+}
+
+/// One call's output on `set`, written into fresh 0xff bytes (a row the call leaves alone stays 0xff).
+fn attend(r: *Rig, set: glue.Set, c: Cache, q: u64, x: Call, tok: u64, cnt: u64, s: f32) ![]u8 {
+    const bytes = x.rows * heads * lw * 2;
+    const out = try r.zeros(bytes);
+    const nch = latent.chunksFor(if (x.pos) |p| p + x.rows else width);
+    const n = nch * x.rows * heads;
+    const part: latent.Partials = .{ .po = try r.zeros(n * lw * 4), .pm = try r.zeros(n * 4), .pl = try r.zeros(n * 4) };
+    if (x.pos) |p| {
+        const dp = try position(r, p);
+        try latent.attentionFormat(set, r.s, q, c.lc, c.scales, .{}, dp, part, out, dp, x.rows, heads, lw, nch, s, x.hb);
+    } else try latent.sparseAttentionFormat(set, r.s, q, c.lc, c.scales, .{}, tok, cnt, width, part, out, x.rows, heads, lw, s);
+    return r.back(out, bytes);
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(0x5c1);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer mod.unload();
+    const ks = try glue.Kernels.loadOvn(mod, true);
+    const off: glue.Set = .{ .glue = &ks };
+    const arms = [_]struct { []const u8, glue.Set }{
+        .{ "bounded", .{ .glue = &ks, .mla = .{ .skip = true } } },
+        .{ "fused", .{ .glue = &ks, .mla = .{ .fuse_rows = 1, .skip = true } } },
+    };
+    const cs = try caches(&r, off);
+    // dense on both head blocks with dead key tiles in the last chunk; sparse at 3, 16 and 70 rows (headBlock's pick)
+    const calls = [_]Call{ .{ .rows = 3, .pos = 1100 }, .{ .rows = 3, .pos = 1100, .hb = latent.heads_tile_wide }, .{ .rows = 70, .pos = 1500, .hb = latent.heads_tile_wide }, .{ .rows = 70, .pos = 0 }, .{ .rows = 3 }, .{ .rows = 16 }, .{ .rows = 70 } };
+    var name: [96]u8 = undefined;
+    var fails: usize = 0;
+    var cases: usize = 0;
+    for (cs) |c| for (calls) |x| {
+        const q = try r.dev(std.mem.sliceAsBytes(try r.bfs(x.rows * heads * lw, 0.5)));
+        const tok, const cnt = try lists(&r, x.rows);
+        const want = try attend(&r, off, c, q, x, tok, cnt, scale);
+        for (arms) |arm| {
+            const what = try std.fmt.bufPrint(&name, "{s} == today's: {s} cache, {d} rows, {s}", .{ arm[0], c.name, x.rows, if (x.pos == null) "sparse" else "dense" });
+            check.sameBytes(what, try attend(&r, arm[1], c, q, x, tok, cnt, scale), want) catch {
+                fails += 1;
+            };
+            cases += 1;
+        }
+    };
+    const cq = try r.dev(std.mem.sliceAsBytes(try r.bfs(16 * heads * lw, 0.5)));
+    const ctok, const ccnt = try lists(&r, 16);
+    const base = try attend(&r, off, cs[1], cq, .{ .rows = 16 }, ctok, ccnt, scale);
+    const moved = try attend(&r, off, cs[1], cq, .{ .rows = 16 }, ctok, ccnt, scale * 1.5);
+    check.expect(!std.mem.eql(u8, base, moved), "glm-mla-skip-check: a 1.5x scale left the bytes alone (the red control must differ)", .{}) catch {
+        fails += 1;
+    };
+    try check.expect(fails == 0, "glm-mla-skip-check: {d} of {d} checks failed", .{ fails, cases + 1 });
+    check.pass("glm-mla-skip-check: bounded and fused launches == today's chunk programs and merge on {d} calls; the control differs", .{cases});
+}
