diff --git a/zig/kernels/cuda/glm_l2pf.cu b/zig/kernels/cuda/glm_l2pf.cu
new file mode 100644
index 000000000..b34bf5f39
--- /dev/null
+++ b/zig/kernels/cuda/glm_l2pf.cu
@@ -0,0 +1,41 @@
+// L2 prefetch of weight ranges for GLM decode windows on a side stream: loads and prefetches only, no result changes.
+
+#include <stdint.h>
+#include "glm_pdl.cuh"
+
+extern "C" __global__ void __launch_bounds__(512) tf_glm_l2pf(  // table [n, 2] i64: (address, bytes), 16-byte aligned
+    const long long* __restrict__ table, int n, int mode, unsigned* __restrict__ sink) {  // pieces of at most 32 KiB
+    glm_pdl::enter();
+    const int lane = threadIdx.x & 31;
+    const int warp = (blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+    const int warps = (gridDim.x * blockDim.x) >> 5;
+    if (mode == 0) {  // "bulk": one cp.async.bulk.prefetch.L2 a piece, which the TMA unit walks (sm_90+)
+        for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+            const unsigned long long a = (unsigned long long)table[2 * i];
+            const unsigned bytes = (unsigned)table[2 * i + 1];
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 900
+            asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" :: "l"(a), "r"(bytes) : "memory");
+#else
+            for (unsigned o = 0; o < bytes; o += 128)
+                asm volatile("prefetch.global.L2 [%0];" :: "l"(a + o));
+#endif
+        }
+        return;
+    }
+    unsigned acc = 0;
+    for (int i = warp; i < n; i += warps) {             // a warp a piece, its lanes on adjacent lines
+        const unsigned long long a = (unsigned long long)table[2 * i];
+        const unsigned bytes = (unsigned)table[2 * i + 1];
+        for (unsigned o = lane * 128u; o < bytes; o += 32u * 128u) {
+            if (mode == 1) {  // "lines": every 128-byte line of a piece, a warp's lanes on adjacent lines
+                asm volatile("prefetch.global.L2::evict_last [%0];" :: "l"(a + o));
+            } else {  // "touch": a real load of each line's first 16 bytes, so the kernel lasts as long as the reads
+                unsigned x, y, z, w;
+                asm volatile("ld.global.cg.v4.u32 {%0, %1, %2, %3}, [%4];"
+                             : "=r"(x), "=r"(y), "=r"(z), "=r"(w) : "l"(a + o));
+                acc ^= x ^ y ^ z ^ w;
+            }
+        }
+    }
+    if (mode == 2 && acc == 0x9e3779b9u && sink != nullptr) sink[0] = acc;  // keeps the loads; never true in practice
+}
