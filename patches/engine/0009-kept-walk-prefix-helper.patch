diff --git a/zig/src/core/prompt_prefix.zig b/zig/src/core/prompt_prefix.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d5a5b03b017332a412602bea6ea41866da2fb0b3
--- /dev/null
+++ b/zig/src/core/prompt_prefix.zig
@@ -0,0 +1,112 @@
+//! Whether kept ids begin a prompt, and how many ids two lists share: every walk over kept states asks here.
+const std = @import("std");
+const platform = @import("sys");
+
+// TF_GLM_OVN_KEPT_WALK=1 (production's IdsOf and common_prefix): the same answers from fewer compared ids.
+const knob = "TF_GLM_OVN_KEPT_WALK";
+
+/// Ids `common` compares a block before it looks for the first difference inside that block.
+const block = 1024;
+
+var read = false;
+var gate = false;
+
+/// Whole-list compares this thread ran (`starts` past its gate, one a `common`): the tests and the walk bench read it.
+pub threadlocal var full: u64 = 0;
+
+/// The knob, its .glm row read once a process (0 or 1, unset off); every rank and lane sees the same environment.
+pub fn gated() bool {
+    if (!read) {
+        gate = platform.environment.read(bool, knob, false) catch false; // GLM's open refuses other text first
+        read = true;
+    }
+    return gate;
+}
+
+/// Tests only: the knob reads as `on` from now on, as if the environment held it.
+pub fn fake(on: bool) void {
+    if (!@import("builtin").is_test) @compileError("prompt_prefix.fake is for tests");
+    read = true;
+    gate = on;
+}
+
+/// `std.mem.eql(u32, prompt[0..tokens.len], tokens)`, false when `tokens` is longer; gated, the last id goes first.
+pub fn starts(prompt: []const u32, tokens: []const u32) bool {
+    return if (gated()) ends(prompt, tokens) else whole(prompt, tokens);
+}
+
+/// `starts` with the last id compared first, knob or not (the snapshot index's lookup always asked this way).
+pub fn ends(prompt: []const u32, tokens: []const u32) bool {
+    const n = tokens.len;
+    if (n > prompt.len) return false;
+    if (n > 0 and prompt[n - 1] != tokens[n - 1]) return false; // a prefix ends on the prompt's id at its length
+    return whole(prompt, tokens);
+}
+
+fn whole(prompt: []const u32, tokens: []const u32) bool {
+    if (tokens.len > prompt.len) return false;
+    full += 1;
+    return if (gated()) same(prompt[0..tokens.len], tokens) else std.mem.eql(u32, prompt[0..tokens.len], tokens);
+}
+
+/// Ids `same` folds into one vector test (std.mem.eql tests every 32 bytes: 3.6 ms at 600k ids on the laptop, 41 us).
+const fold = 64;
+
+/// `std.mem.eql(u32, a, b)` for lists of one length, `fold` ids a test: xor and or in vectors, then one reduction.
+fn same(a: []const u32, b: []const u32) bool {
+    std.debug.assert(a.len == b.len);
+    const V = @Vector(8, u32);
+    var i: usize = 0;
+    while (i + fold <= a.len) : (i += fold) {
+        var x: V = @splat(0);
+        inline for (0..fold / 8) |k| x |= @as(V, a[i + k * 8 ..][0..8].*) ^ @as(V, b[i + k * 8 ..][0..8].*);
+        if (@reduce(.Or, x) != 0) return false;
+    }
+    for (a[i..], b[i..]) |p, q| if (p != q) return false;
+    return true;
+}
+
+/// How many leading ids `a` and `b` share (`std.mem.indexOfDiff`, else the shorter length); gated, a block at a time.
+pub fn common(a: []const u32, b: []const u32) usize {
+    const n = @min(a.len, b.len);
+    full += 1;
+    if (!gated()) return std.mem.indexOfDiff(u32, a, b) orelse n;
+    var at: usize = 0;
+    while (at < n) : (at += block) { // a vector compare a block, the scalar search only inside the one that differs
+        const end = @min(n, at + block);
+        if (!same(a[at..end], b[at..end])) return at + std.mem.indexOfDiff(u32, a[at..end], b[at..end]).?;
+    }
+    return n;
+}
+
+/// Whether `a` and `b` may share more than `n` ids (they must agree at `n`); always true with the knob off.
+pub fn beyond(a: []const u32, b: []const u32, n: usize) bool {
+    return !gated() or (n < a.len and n < b.len and a[n] == b[n]);
+}
+
+/// `starts(prompt, tokens)` asked at most once and, gated, only when the walk needs it (off: at once, as before).
+pub const Lazy = struct {
+    prompt: []const u32,
+    tokens: []const u32,
+    known: ?bool = null,
+
+    pub fn of(prompt: []const u32, tokens: []const u32) Lazy {
+        return .{ .prompt = prompt, .tokens = tokens, .known = if (gated()) null else whole(prompt, tokens) };
+    }
+
+    pub fn get(l: *Lazy) bool {
+        if (l.known == null) l.known = starts(l.prompt, l.tokens);
+        return l.known.?;
+    }
+};
+
+test "kept walk: the knob is its .glm row: unset, blank and 0 are off, 1 is on, other text is refused" {
+    const e = platform.environment;
+    for ([_]?[]const u8{ null, "", " ", "0" }) |raw| try std.testing.expect(!try e.value(bool, knob, raw, false));
+    try std.testing.expect(try e.value(bool, knob, "1", false));
+    for ([_][]const u8{ "on", "00", "2" }) |raw| try std.testing.expectError(error.InvalidEnvironment, e.value(bool, knob, raw, false));
+}
+test {
+    _ = @import("prompt_prefix_test.zig");
+    _ = @import("prompt_prefix_count_test.zig");
+}
diff --git a/zig/src/core/prompt_prefix_bench.zig b/zig/src/core/prompt_prefix_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..457c68034c972c78f426c4a0156fab87751cbd64
--- /dev/null
+++ b/zig/src/core/prompt_prefix_bench.zig
@@ -0,0 +1,106 @@
+//! Laptop timing of the kept-state walks (TF_GLM_OVN_KEPT_WALK set or not): agent turns over many long kept states.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const prefix = @import("prompt_prefix.zig");
+const forks = @import("prompt_cache_fork.zig");
+
+const system = 8192; // ids of the system block every conversation starts with
+const step = 2048; // ids a turn adds (a reply and a tool result)
+
+/// A family whose saves cost nothing: the walks are all that is timed.
+const Family = struct {
+    gpa: std.mem.Allocator,
+    fn bytes(_: *anyopaque, _: u32) u64 {
+        return 1;
+    }
+    fn save(ptr: *anyopaque, _: ?*anyopaque, _: u32) anyerror!pc.Saved {
+        const f: *Family = @ptrCast(@alignCast(ptr));
+        return @ptrCast(try f.gpa.create(u8));
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {}
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const f: *Family = @ptrCast(@alignCast(ptr));
+        f.gpa.destroy(@as(*u8, @ptrCast(saved)));
+    }
+    fn snapshots(f: *Family) pc.Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop } };
+    }
+};
+
+fn output(text: []const u8) !void {
+    std.debug.print("{s}", .{text}); // stderr, on every host
+}
+
+/// One warm agent turn: the lookup, its restore, then the keeps it planned; the compares it ran.
+fn turn(s: *pc.Store, a: std.mem.Allocator, prompt: []const u32) !u64 {
+    const before = prefix.full;
+    const l = try s.lookupUser(a, prompt, @intCast(prompt.len), @intCast(prompt.len - 64), 0, 0, &.{}, &.{}, &.{});
+    if (l.entry) |e| s.resumed(e, prompt, true);
+    for (l.marks) |m| _ = s.keepBorn(prompt, @intCast(prompt.len), m, null, &.{}, &.{});
+    return prefix.full - before;
+}
+
+fn ms(io: std.Io, started: std.Io.Timestamp) f64 {
+    return @as(f64, @floatFromInt(started.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds())) / 1e6;
+}
+
+/// kept-walk-bench IDS KEPT CONVERSATIONS TURNS: per-turn and per-walk milliseconds and whole compares, one JSON line.
+pub fn main(init: std.process.Init) !void {
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 5) return error.Arguments;
+    const n = try std.fmt.parseInt(usize, args[1], 10);
+    const kept = try std.fmt.parseInt(usize, args[2], 10);
+    const convs = try std.fmt.parseInt(usize, args[3], 10);
+    const turns = try std.fmt.parseInt(usize, args[4], 10);
+    const per = kept / convs; // kept turns a conversation
+    if (convs == 0 or per == 0 or n < system + (per + 1) * step) return error.Arguments;
+    var prng = std.Random.DefaultPrng.init(42);
+    const r = prng.random();
+    const ids = try gpa.alloc([]u32, convs + 1); // the last: a new conversation, the fork walk's miss
+    defer gpa.free(ids);
+    for (ids, 0..) |*c, i| {
+        c.* = try gpa.alloc(u32, n + turns * step);
+        for (c.*, 0..) |*t, j| t.* = if (j < system and i > 0) ids[0][j] else r.uintLessThan(u32, 151_000);
+    }
+    defer for (ids) |c| gpa.free(c);
+    var f: Family = .{ .gpa = gpa };
+    var s = pc.Store.init(gpa, f.snapshots(), .{ .lookahead = 1, .min_prompt = 0, .fork = true }, 1 << 40);
+    s.most = kept;
+    defer s.deinit();
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    for (0..per) |j| for (ids[0..convs]) |c| { // warm up: each conversation's earlier turns, up to `n` ids
+        _ = try turn(&s, arena.allocator(), c[0 .. n - (per - j) * step]);
+    };
+    var times = try gpa.alloc(f64, turns * convs);
+    defer gpa.free(times);
+    var compares: u64 = 0;
+    for (0..turns) |j| for (ids[0..convs], 0..) |c, i| {
+        _ = arena.reset(.retain_capacity);
+        const started = std.Io.Clock.awake.now(io);
+        compares += try turn(&s, arena.allocator(), c[0 .. n + j * step]);
+        times[j * convs + i] = ms(io, started);
+    };
+    std.mem.sort(f64, times, {}, std.sort.asc(f64));
+    const next = ids[0][0 .. n + turns * step];
+    const fresh = ids[convs][0..n];
+    var walk: [3]f64 = .{ 1e9, 1e9, 1e9 };
+    var walk_cmp: [3]u64 = undefined;
+    for (0..5) |_| { // the walks alone on the warm store: eviction, the miss's fork, the lookup's index
+        inline for (0..3) |w| {
+            const before = prefix.full;
+            const started = std.Io.Clock.awake.now(io);
+            switch (w) {
+                0 => std.mem.doNotOptimizeAway(s.victimBut(null, next, @intCast(next.len))),
+                1 => std.mem.doNotOptimizeAway(forks.longestShared(pc.Entry, s.entries.items, fresh).len),
+                else => std.mem.doNotOptimizeAway(s.find(next, &.{}, &.{})),
+            }
+            walk[w] = @min(walk[w], ms(io, started));
+            walk_cmp[w] = prefix.full - before;
+        }
+    }
+    var line: [512]u8 = undefined;
+    try output(try std.fmt.bufPrint(&line, "{{\"gate\":{},\"ids\":{d},\"kept\":{d},\"convs\":{d},\"turn_ms_min\":{d:.3},\"turn_ms_median\":{d:.3},\"turn_compares\":{d:.1},\"victim_ms\":{d:.3},\"victim_compares\":{d},\"fork_ms\":{d:.3},\"fork_compares\":{d},\"find_ms\":{d:.3},\"find_compares\":{d}}}\n", .{ prefix.gated(), n, s.entries.items.len, convs, times[0], times[times.len / 2], @as(f64, @floatFromInt(compares)) / @as(f64, @floatFromInt(times.len)), walk[0], walk_cmp[0], walk[1], walk_cmp[1], walk[2], walk_cmp[2] }));
+}
diff --git a/zig/src/core/prompt_prefix_count_test.zig b/zig/src/core/prompt_prefix_count_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..72d410d4babd626d2b3ca67dc6d120cc8c024b24
--- /dev/null
+++ b/zig/src/core/prompt_prefix_count_test.zig
@@ -0,0 +1,174 @@
+//! TF_GLM_OVN_KEPT_WALK: the whole-list compares each walk runs, gated and not, on two conversations' kept states.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const prefix = @import("prompt_prefix.zig");
+const forks = @import("prompt_cache_fork.zig");
+const rows = @import("rows_store.zig");
+const select = @import("rows_select.zig");
+const Fake = @import("prompt_cache_fake.zig").Fake;
+const RowsFake = @import("rows_fake.zig").Fake;
+const t = std.testing;
+const gpa = t.allocator;
+
+/// Conversations A and B behind one system block (8 ids); every id past it is its conversation's own.
+const Talk = struct {
+    a: [400]u32 = undefined,
+    b: [400]u32 = undefined,
+    fn init(x: *Talk) void {
+        for (&x.a, &x.b, 0..) |*p, *q, i| {
+            p.* = if (i < 8) @intCast(i) else @intCast(1000 + i);
+            q.* = if (i < 8) @intCast(i) else @intCast(5000 + i);
+        }
+    }
+    /// A's turn `k` ends at 40 + 30k ids; B's at 45 + 30k (B's turn 8 outruns A's turn 8).
+    fn lenA(k: usize) usize {
+        return 40 + 30 * k;
+    }
+    fn lenB(k: usize) usize {
+        return 45 + 30 * k;
+    }
+};
+
+/// Kept turns 0-7 of A and 0-8 of B, alternating, each state one id before its prompt's end.
+fn fill(s: *pc.Store, f: *Fake, x: *const Talk) !void {
+    for (0..9) |k| {
+        for ([_][]const u32{ x.a[0..Talk.lenA(k)], x.b[0..Talk.lenB(k)] }, 0..) |p, j| {
+            if (k == 8 and j == 0) continue;
+            f.at = @intCast(p.len - 1);
+            try t.expect(s.keep(p, f.at, null, &.{}, &.{}));
+        }
+    }
+}
+
+const Span = @import("cache_modes.zig").Span;
+const none: []const u32 = &.{};
+const plain: []const Span = &.{};
+
+/// The compares `run` makes with the gate `on`.
+fn count(on: bool, run: anytype, args: anytype) u64 {
+    prefix.fake(on);
+    const before = prefix.full;
+    _ = @call(.auto, run, args);
+    return prefix.full - before;
+}
+
+test "kept walk: each walk's whole compares, gated and not" {
+    defer prefix.fake(false);
+    var x: Talk = .{};
+    x.init();
+    var cells: [2][9]u64 = undefined;
+    for ([_]bool{ false, true }, 0..) |on, m| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = pc.Store.init(gpa, f.snapshots(), .{ .lookahead = 1, .min_prompt = 0, .min_gap = 1 }, 1 << 40);
+        defer s.deinit();
+        prefix.fake(false);
+        try fill(&s, &f, &x);
+        const next = x.a[0..Talk.lenA(9)];
+        f.at = @intCast(Talk.lenA(8) - 1); // link: A's turn 8 against the seventeen kept (B's turn 8 longer than it)
+        cells[m][0] = count(on, pc.Store.keep, .{ &s, x.a[0..Talk.lenA(8)], f.at, @as(?*anyopaque, null), none, plain });
+        cells[m][1] = count(on, pc.Store.victimBut, .{ &s, null, next, @as(u32, @intCast(next.len)) }); // eviction
+        s.active_rewind_at = @intCast(Talk.lenA(3) - 1); // eviction with a rewind state: only A's turn 3 is asked
+        cells[m][2] = count(on, pc.Store.victimBut, .{ &s, null, next, @as(u32, @intCast(next.len)) });
+        s.active_rewind_at = 0;
+        cells[m][3] = count(on, pc.Store.find, .{ &s, next, none, plain });
+        cells[m][4] = count(on, forks.longestShared, .{ pc.Entry, s.entries.items, next }); // a miss's fork
+        cells[m][5] = count(on, pc.Store.wouldServe, .{ &s, next, none, plain, @as([]const u32, x.b[0..]), plain, @as(u32, 100) });
+        cells[m][6] = count(on, pc.Store.forget, .{ &s, x.a[0..Talk.lenB(2)], @as(u32, @intCast(Talk.lenB(2) - 1)), plain });
+        s.links_lost = true; // eviction asking `extendedScan`: off, a superseded state's prefix first, as always
+        cells[m][7] = count(on, pc.Store.victimBut, .{ &s, null, next, @as(u32, @intCast(next.len)) });
+        s.links_lost = false;
+        f.at = 289; // a state born as a short request: link asks nothing of the earlier-born, nor does the proof
+        cells[m][8] = count(on, pc.Store.keepBorn, .{ &s, x.a[0..290], @as(u32, 30), f.at, @as(?*anyopaque, null), none, plain });
+    }
+    // off: as the walks always compared; on: one compare a conversation where a link proves the rest, none for B
+    try t.expectEqualSlices(u64, &.{ 17, 18, 18, 1, 18, 1, 1, 18, 0 }, &cells[0]);
+    try t.expectEqualSlices(u64, &.{ 1, 0, 1, 1, 9, 0, 0, 1, 0 }, &cells[1]);
+}
+
+/// A disk tier beside a RAM store, as rows_select_test's rig: states are any token lists, the prompt is A's.
+const Disk = struct {
+    family: RowsFake = .{ .gpa = gpa },
+    disk: rows.Rows = undefined,
+    store: pc.Store = undefined,
+    fn init(d: *Disk, prompt: []const u32) void {
+        d.family.prompt = prompt;
+        const f = d.family.snapshots();
+        d.disk = .{ .gpa = gpa, .family = f, .img = f.vtable.rows.?, .sync_writes = true, .root = undefined, .dir = undefined, .keying = .{ .identity = 17, .block = rows.block_tokens, .lookahead = 1 }, .cap = 1 << 30, .daily = 1 << 30, .read_rate = 1000, .prefill_rate = 100 };
+        d.store = pc.Store.init(gpa, f, .{ .min_prompt = 0, .min_gap = 1, .lookahead = 1 }, 1 << 30);
+        d.store.disk = &d.disk;
+    }
+    fn deinit(d: *Disk) void {
+        d.store.disk = null;
+        d.store.deinit();
+        for (d.disk.states.items) |state| gpa.free(state.tokens);
+        d.disk.states.deinit(gpa);
+    }
+    fn add(d: *Disk, tokens: []const u32, cost: u64) !void {
+        const own = try gpa.dupe(u32, tokens);
+        errdefer gpa.free(own);
+        try d.disk.states.append(gpa, .{ .name = @splat(0), .at = @intCast(tokens.len - 1), .tokens = own, .spans = &.{}, .starts = &.{}, .own = cost, .rows = 0, .used = 0, .shared = false });
+    }
+    /// The RAM state at `at` of the prompt, kept with the disk tier out of the way.
+    fn hold(d: *Disk, prompt: []const u32, at: u32) !*pc.Entry {
+        d.store.disk = null;
+        defer d.store.disk = &d.disk;
+        d.family.at = at;
+        try t.expect(d.store.keep(prompt, at, null, &.{}, &.{}));
+        return d.store.entries.items[d.store.entries.items.len - 1];
+    }
+};
+
+test "kept walk: a disk restore's choice is the same with the gate, from fewer compares" {
+    defer prefix.fake(false);
+    var x: Talk = .{};
+    x.init();
+    const prompt = x.a[0..Talk.lenA(9)];
+    var cells: [2]u64 = undefined;
+    for ([_]bool{ false, true }, 0..) |on, m| {
+        var d: Disk = .{};
+        d.init(prompt);
+        defer d.deinit();
+        var k: usize = 8;
+        while (k > 0) : (k -= 1) try d.add(x.a[0..Talk.lenA(k)], 10); // A's turns longest first, then B's
+        for (0..8) |j| try d.add(x.b[0..Talk.lenB(j)], 10);
+        const have = try d.hold(prompt, @intCast(Talk.lenA(5) - 1)); // RAM resumes at A's turn 5
+        prefix.fake(on);
+        const before = prefix.full;
+        const c = select.choose(&d.store, prompt, &.{}, &.{}, have);
+        cells[m] = prefix.full - before;
+        try t.expectEqual(@as(?usize, 0), c.restore); // A's turn 8 saves the most prefill
+        try t.expectEqual(@as(?usize, 0), c.disk);
+    }
+    // off: every state; on: A's turns past the RAM state (8, 7, 6), the rest moot or a last-id miss
+    try t.expectEqual([2]u64{ 16, 3 }, cells);
+}
+
+test "kept walk: random disk states choose the same restore with the gate" {
+    defer prefix.fake(false);
+    var prng = std.Random.DefaultPrng.init(11);
+    const r = prng.random();
+    var prompt: [300]u32 = undefined;
+    for (0..300) |round| {
+        for (&prompt) |*p| p.* = r.uintLessThan(u32, 3);
+        var got: [2]select.Choice = undefined;
+        for ([_]bool{ false, true }, 0..) |on, m| {
+            var rr = std.Random.DefaultPrng.init(round);
+            const q = rr.random();
+            var d: Disk = .{};
+            d.init(&prompt);
+            defer d.deinit();
+            for (0..q.uintLessThan(usize, 24)) |_| { // a prefix, or a prefix with one id changed (last ids collide)
+                var tokens: [300]u32 = prompt;
+                const n = 2 + q.uintLessThan(usize, 290);
+                if (q.boolean()) tokens[q.uintLessThan(usize, n)] +%= 1;
+                try d.add(tokens[0..n], 1 + q.uintLessThan(u64, 4000));
+            }
+            const have = if (q.boolean()) try d.hold(&prompt, 1 + q.uintLessThan(u32, 250)) else null;
+            prefix.fake(on);
+            got[m] = select.choose(&d.store, &prompt, &.{}, &.{}, have);
+        }
+        try t.expectEqual(got[0].disk, got[1].disk);
+        try t.expectEqual(got[0].restore, got[1].restore);
+        try t.expectEqual(got[0].read_seconds, got[1].read_seconds);
+    }
+}
