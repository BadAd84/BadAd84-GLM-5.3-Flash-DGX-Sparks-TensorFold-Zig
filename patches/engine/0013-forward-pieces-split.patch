 /// How the ranks' partials meet: every rank in-process copying into the others' slots, or one rank over NCCL.
 pub const Exchange = union(enum) {
diff --git a/zig/src/families/glm/cuda_forward_pieces.zig b/zig/src/families/glm/cuda_forward_pieces.zig
index ba803b1afbdf60876c28a9efef92237e945b7eca..10a81e9621f6bd8be8cd1579dc6c4d17ab4a4d93 100644
--- a/zig/src/families/glm/cuda_forward_pieces.zig
+++ b/zig/src/families/glm/cuda_forward_pieces.zig
@@ -3,12 +3,73 @@ const relay = @import("cuda_relay.zig");
 const taps = @import("cuda_taps.zig");
 const fw = @import("cuda_forward.zig");
 const prof = @import("cuda_prof.zig");
+const cuda = @import("cuda");
 const Forward = fw.Forward;
-const Pieces = fw.Pieces;
 const Site = fw.Forward.Site;
 const room = fw.Forward.room;
