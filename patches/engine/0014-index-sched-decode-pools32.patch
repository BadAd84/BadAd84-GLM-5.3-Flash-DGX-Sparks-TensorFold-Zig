+// GLM-5.3-Flash DSA indexer: tf_glm_index_scores with production's 0084 v2 stores (TF_GLM_OVN_INDEX_SCHED).
+#pragma once
+
+#include "glm_index_scores.cuh"
+
+// tf_glm_index_scores bit for bit; only the stores and the register bound differ. Grid (cdiv(rows, 8), cdiv(nb, loop)).
+extern "C" __global__ void __launch_bounds__(glm_index::RB * 32, 2)
+    tf_glm_index_scores_sched(const __nv_bfloat16* qi, const __nv_bfloat16* wts, int64_t w_stride,
+                              const __nv_bfloat16* pk, float* out, const int* pos, int64_t rows, int64_t np, int64_t nb,
+                              float scale, float wscale, int64_t heads, int loop, const int* pt, int64_t ps) {
+  using namespace glm_index;
+  __shared__ __align__(16) __nv_bfloat16 tile[2][BP * D];  // two key tiles
+  __shared__ __align__(16) float stage_out[RB][BP];         // a warp's 64 scores of a tile before the row's store
+  const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, g = lane >> 2, q = lane & 3;
+  const int64_t r = (int64_t)blockIdx.x * RB + warp, P = pos[0];
+  const bool live = r < rows;
+  const int64_t npool = live ? (P + r + 1) / 4 : 0;
+  const int64_t last = min(rows, (int64_t)(blockIdx.x + 1) * RB) - 1, nmax = (P + last + 1) / 4;  // the CTA's largest
+  uint32_t aq[KQ][2][4];
+#pragma unroll
+  for (int kq = 0; kq < KQ; ++kq)
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int h0 = i * 16 + g, h1 = h0 + 8;
+      const __nv_bfloat16* b0 = qi + ((live ? r : 0) * heads + (h0 < heads ? h0 : 0)) * D + kq * 16 + 2 * q;
+      const __nv_bfloat16* b1 = qi + ((live ? r : 0) * heads + (h1 < heads ? h1 : 0)) * D + kq * 16 + 2 * q;
+      const bool o0 = live && h0 < heads, o1 = live && h1 < heads;
+      aq[kq][i][0] = o0 ? *reinterpret_cast<const uint32_t*>(b0) : 0u;
+      aq[kq][i][1] = o1 ? *reinterpret_cast<const uint32_t*>(b1) : 0u;
+      aq[kq][i][2] = o0 ? *reinterpret_cast<const uint32_t*>(b0 + 8) : 0u;
+      aq[kq][i][3] = o1 ? *reinterpret_cast<const uint32_t*>(b1 + 8) : 0u;
+    }
+  float wv[4];
+  for (int i = 0; i < 4; ++i) {
+    const int64_t hh = g + 8 * i;
+    wv[i] = live && hh < heads ? __fmul_rn(__bfloat162float(wts[r * w_stride + hh]), wscale) : 0.0f;
+  }
+  auto stage = [&](int buf, int64_t pb) {
+    for (int idx = threadIdx.x; idx < BP * (D / 8); idx += RB * 32) {
+      const int row = idx / (D / 8), u = idx % (D / 8);
+      const int64_t p = pb * BP + row;
+      const bool ok = p < nmax;
+      cp16(&tile[buf][tile_at(row, u)], pk + key_at(pt, ps / 2, ok ? p : 0) + u * 8, ok);
+    }
+  };
+  // the warp's staged scores into row r's columns p0 .. p0 + 63 (as one float2 a lane where the row allows it)
+  float* st = stage_out[warp];
+  auto store = [&](int64_t p0) {
+    __syncwarp();
+    float* o = out + r * np + p0;
+    if (p0 + BP <= np && (np & 1) == 0)
+      *reinterpret_cast<float2*>(o + 2 * lane) = *reinterpret_cast<const float2*>(&st[2 * lane]);
+    else
+      for (int e = 0; e < 2; ++e)
+        if (p0 + 2 * lane + e < np) o[2 * lane + e] = st[2 * lane + e];
+    __syncwarp();  // every lane has read st before the next tile writes it
+  };
+  const int64_t first = (int64_t)blockIdx.y * loop;
+  auto any = [&](int j) { return j < loop && first + j < nb && (first + j) * BP < nmax; };
+  if (any(0)) stage(0, first);
+  cp_commit();
+  for (int j = 0; j < loop; ++j) {
+    const int64_t pb = first + j, p0 = pb * BP;
+    if (pb >= nb) break;
+    cp_wait<0>();
+    __syncthreads();  // tile j is in, and every warp is done with tile j - 1
+    if (any(j + 1)) stage((j + 1) & 1, pb + 1);
+    cp_commit();
+    if (!live) continue;
+    if (p0 >= npool) {  // the row sees none of these pools: -inf
+      st[2 * lane] = -INFINITY;
+      st[2 * lane + 1] = -INFINITY;
+      store(p0);
+      continue;
+    }
+    for (int gi = 0; gi < BP / 16; ++gi) {
+      float acc[2][2][4] = {};
+      const __nv_bfloat16* keys = tile[j & 1] + gi * 16 * D;
+#pragma unroll
+      for (int kq = 0; kq < KQ; ++kq) {
+        uint32_t b[4];
+        ldm4(b, keys + tile_at((lane >> 4) * 8 + (lane & 7), kq * 2 + ((lane >> 3) & 1)));
+        for (int nt = 0; nt < 2; ++nt)
+          for (int i = 0; i < 2; ++i) mma16816(acc[i][nt], aq[kq][i], b + 2 * nt);
+      }
+      for (int nt = 0; nt < 2; ++nt)
+        for (int e = 0; e < 2; ++e) {
+          const float v0 = fmaxf(__fmul_rn(acc[0][nt][e], scale), 0.0f),
+                      v1 = fmaxf(__fmul_rn(acc[0][nt][e + 2], scale), 0.0f);
+          const float v2 = fmaxf(__fmul_rn(acc[1][nt][e], scale), 0.0f),
+                      v3 = fmaxf(__fmul_rn(acc[1][nt][e + 2], scale), 0.0f);
+          float s = __fmul_rn(wv[1], v1);
+          s = __fmaf_rn(wv[0], v0, s);
+          s = __fmaf_rn(wv[2], v2, s);
+          s = __fmaf_rn(wv[3], v3, s);
+          for (int o = 16; o >= 4; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+          const int c = gi * 16 + nt * 8 + q * 2 + e;
+          if (g == 0) st[c] = p0 + c < npool ? s : -INFINITY;
+        }
+    }
+    store(p0);
+  }
+}
diff --git a/zig/kernels/cuda/glm_index_split.cuh b/zig/kernels/cuda/glm_index_split.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..6a49a976ae434cd4e6fbc6d61e4e5ebe5b5b8e45
--- /dev/null
+++ b/zig/kernels/cuda/glm_index_split.cuh
@@ -0,0 +1,231 @@
+// A decode window's top-K pools over chunk CTAs (TF_GLM_OVN_DECODE_INDEX); port of prod-src select_split (Apache-2.0).
+#pragma once
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+#include "glm_index_pools.cuh"
+
+namespace glm_split {
+
+constexpr int T = 128, WARPS = T / 32, PER = 8, SPAN = T * PER;  // threads, warps, keys a thread a scan, a scan
+constexpr long long PAGE = 512;                                   // rows a KV page holds (tf_glm_dsa_tokens' PAGE)
+
+struct Sh {
+  int hist[256];
+  int wsum[2][WARPS];  // block_scan's warp totals, two slots taken in turn
+  int red[2][WARPS];   // block_sum2's warp totals
+  uint32_t prefix, fixed;
+  int need, digit;
+};
+
+// a and b summed over the block (integers: any order); every thread calls it and gets the totals.
+__device__ __forceinline__ void block_sum2(Sh& sh, int& a, int& b) {
+  const int lane = threadIdx.x & 31, w = threadIdx.x >> 5;
+  for (int o = 16; o > 0; o >>= 1) {
+    a += __shfl_xor_sync(0xffffffffu, a, o);
+    b += __shfl_xor_sync(0xffffffffu, b, o);
+  }
+  if (lane == 0) {
+    sh.red[0][w] = a;
+    sh.red[1][w] = b;
+  }
+  __syncthreads();
+  a = 0;
+  b = 0;
+  for (int i = 0; i < WARPS; ++i) {
+    a += sh.red[0][i];
+    b += sh.red[1][i];
+  }
+  __syncthreads();  // every thread has read sh.red before a later call writes it
+}
+
+// Exclusive sum of v in thread order and the block's total, via slot `slot` (two slots, used in turn per scan).
+__device__ __forceinline__ int block_scan(Sh& sh, int v, int slot, int& total) {
+  const int lane = threadIdx.x & 31, w = threadIdx.x >> 5;
+  int inc = v;
+  for (int o = 1; o < 32; o <<= 1) {
+    const int u = __shfl_up_sync(0xffffffffu, inc, o);
+    if (lane >= o) inc += u;
+  }
+  if (lane == 31) sh.wsum[slot][w] = inc;
+  __syncthreads();
+  int before = inc - v;
+  total = 0;
+  for (int i = 0; i < WARPS; ++i) {
+    if (i < w) before += sh.wsum[slot][i];
+    total += sh.wsum[slot][i];
+  }
+  return before;
+}
+
+// sparse._split_digits from the row's totals [4][256]: the digit is the highest bin whose top count reaches need.
+__device__ __forceinline__ void digits(Sh& sh, const int* __restrict__ tot, int steps, int K) {
+  if (threadIdx.x < 32) {
+    const int lane = threadIdx.x;
+    uint32_t prefix = 0, fixed = 0;
+    int need = K, digit = 0;
+    for (int p = 0; p < steps; ++p) {
+      int h[8], own = 0;
+      for (int j = 0; j < 8; ++j) own += h[j] = tot[p * 256 + 255 - 8 * lane - j];
+      int upto = own;
+      for (int o = 1; o < 32; o <<= 1) {
+        const int v = __shfl_up_sync(0xffffffffu, upto, o);
+        if (lane >= o) upto += v;
+      }
+      const unsigned hit = __ballot_sync(0xffffffffu, upto >= need);
+      const int src = hit ? __ffs(hit) - 1 : 31;
+      int dg = 0, left = 0;
+      if (lane == src) {
+        int above = upto - own;
+        for (int j = 0; j < 8; ++j) {
+          if (above + h[j] >= need) {
+            dg = 255 - 8 * lane - j;
+            break;
+          }
+          above += h[j];
+        }
+        left = need - above;
+      }
+      digit = __shfl_sync(0xffffffffu, dg, src);
+      need = __shfl_sync(0xffffffffu, left, src);
+      prefix |= (uint32_t)digit << (24 - 8 * p);
+      fixed |= 0xFFu << (24 - 8 * p);
+    }
+    if (lane == 0) {
+      sh.prefix = prefix;
+      sh.fixed = fixed;
+      sh.need = need;
+      sh.digit = digit;
+    }
+  }
+  __syncthreads();
+}
+
+// The order keys of the chunk's scores i0 .. i0 + PER - 1 (0 past n).
+__device__ __forceinline__ void keys(const float* __restrict__ s, int n, int i0, uint32_t (&u)[PER]) {
+  if (i0 + PER <= n && ((uintptr_t)(s + i0) & 15) == 0) {
+    const float4 a = *reinterpret_cast<const float4*>(s + i0), b = *reinterpret_cast<const float4*>(s + i0 + 4);
+    const float v[PER] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+#pragma unroll
+    for (int j = 0; j < PER; ++j) u[j] = glm_index::order_key(v[j]);
+  } else {
+#pragma unroll
+    for (int j = 0; j < PER; ++j) u[j] = i0 + j < n ? glm_index::order_key(s[i0 + j]) : 0u;
+  }
+}
+
+// Token t's row: in order (pt null), or row t % PAGE of page pt[t / PAGE] (tf_glm_dsa_tokens' `at`).
+__device__ __forceinline__ int token_at(const int* __restrict__ pt, long long page_rows, long long t) {
+  return static_cast<int>(pt ? pt[t / PAGE] * page_rows + t % PAGE : t);
+}
+
+}  // namespace glm_split
+
+// Program (row, chunk) of radix-select steps 0..3 (GT, HIST, TOT) or step 4 (the chunk's picks as token rows).
+extern "C" __global__ void __launch_bounds__(glm_split::T)
+    tf_glm_index_split(const float* __restrict__ S, int64_t np, const int* __restrict__ pos, int K, int chs, int cp,
+                       int step, int* __restrict__ TOT, int* __restrict__ HIST, int* __restrict__ GT,
+                       int* __restrict__ TOK, int* __restrict__ CNT, const int* __restrict__ pt, int64_t page_rows) {
+  using namespace glm_split;
+  __shared__ Sh sh;
+  const int64_t r = blockIdx.x;
+  const int c = blockIdx.y;
+  const int64_t q = (int64_t)pos[0] + r, npool = (q + 1) / 4;
+  const int64_t NP = min(np, max(npool, (int64_t)K));  // sparse._visible_bound
+  const int64_t i0 = (int64_t)c * chs;
+  if (i0 >= NP) return;  // a chunk past the row's bound: the whole block leaves
+  const int n = (int)min((int64_t)chs, NP - i0);
+  const float* row = S + r * np + i0;
+  int* own = HIST + (r * cp + c) * 256;
+  int* tot = TOT + r * 1024;
+  digits(sh, tot, step, K);
+  const uint32_t prefix = sh.prefix, fixed = sh.fixed;
+  const int need = sh.need, d = sh.digit;
+  if (step < 4) {
+    if (step > 0) {  // the chunk's scores above the prefix first at the byte just fixed (its last histogram)
+      int a = 0, none = 0;
+      for (int b = threadIdx.x; b < 256; b += T) a += b > d ? own[b] : 0;
+      block_sum2(sh, a, none);
+      if (threadIdx.x == 0) GT[r * cp + c] = a + (step > 1 ? GT[r * cp + c] : 0);
+    }
+    for (int b = threadIdx.x; b < 256; b += T) sh.hist[b] = 0;
+    __syncthreads();  // also: every read of `own` above is done before it is rewritten below
+    const int lane = threadIdx.x & 31, shift = 24 - 8 * step;
+    const unsigned below = (1u << lane) - 1;
+    for (int k0 = 0; k0 < n; k0 += SPAN) {
+      const int ib = k0 + (int)threadIdx.x * PER;
+      uint32_t u[PER];
+      keys(row, n, ib, u);
+#pragma unroll
+      for (int j = 0; j < PER; ++j) {
+        const int b = ib + j < n && (u[j] & fixed) == prefix ? (int)((u[j] >> shift) & 0xFFu) : 256;
+        if (__any_sync(0xffffffffu, b < 256)) {
+          const unsigned same = __match_any_sync(0xffffffffu, b);
+          if (b < 256 && (same & below) == 0) atomicAdd(&sh.hist[b], __popc(same));
+        }
+      }
+    }
+    __syncthreads();
+    for (int b = threadIdx.x; b < 256; b += T) {
+      const int v = sh.hist[b];
+      own[b] = v;
+      if (v != 0) atomicAdd(&tot[step * 256 + b], v);
+    }
+    return;
+  }
+  // step 4: the earlier chunks' scores above the K-th best's key (GT and their last histograms) and equal to it
+  int above = 0, equal = 0;
+  for (int i = threadIdx.x; i < c * 256; i += T) {
+    const int b = i & 255, v = HIST[(r * cp + (i >> 8)) * 256 + b];
+    above += b > d ? v : 0;
+    equal += b == d ? v : 0;
+  }
+  for (int i = threadIdx.x; i < c; i += T) above += GT[r * cp + i];
+  block_sum2(sh, above, equal);
+  int* out = TOK + r * (4 * K + 3);
+  int run_take = above + min(equal, need), run_eq = equal;
+  for (int k0 = 0; k0 < n; k0 += SPAN) {  // in pool order: every key above the prefix, and the first `need` equal
+    const int ib = k0 + (int)threadIdx.x * PER;
+    uint32_t u[PER];
+    keys(row, n, ib, u);
+    bool eq[PER], gt[PER];
+    int eqs = 0;
+#pragma unroll
+    for (int j = 0; j < PER; ++j) {
+      const bool in = ib + j < n;
+      eq[j] = in && u[j] == prefix;
+      gt[j] = in && u[j] > prefix;
+      eqs += eq[j];
+    }
+    int all_eq, all_take;
+    int seen = run_eq + block_scan(sh, eqs, 0, all_eq);
+    bool take[PER];
+    int takes = 0;
+#pragma unroll
+    for (int j = 0; j < PER; ++j) {
+      take[j] = gt[j] || (eq[j] && seen < need);
+      seen += eq[j];
+      takes += take[j];
+    }
+    int at = run_take + block_scan(sh, takes, 1, all_take);
+#pragma unroll
+    for (int j = 0; j < PER; ++j)
+      if (take[j]) {
+        const long long p = i0 + ib + j;
+        for (int t = 0; t < 4; ++t) out[4 * at + t] = token_at(pt, page_rows, p * 4 + t);
+        at++;
+      }
+    run_eq += all_eq;
+    run_take += all_take;
+  }
+  if (c == 0 && threadIdx.x < 3) {  // the incomplete pool's visible tokens, as tf_glm_dsa_tokens writes them
+    const long long t = npool * 4 + threadIdx.x;
+    out[4 * K + threadIdx.x] = t <= q ? token_at(pt, page_rows, t) : -1;
+  }
+  if (c == 0 && threadIdx.x == 0) {
+    int tail = 0;
+    for (int t = 0; t < 3; ++t) tail += npool * 4 + t <= q;
+    CNT[r] = npool > K ? 4 * K + tail : 0;
+  }
+}
