index a7053c8c822ec2aa6f0b7bc774bf2f7c7c704cdc..dd525e7df7b1a119ab42abe853c8aba12bf8baf2 100644
--- a/zig/tests/cuda/glm_ovn_checks.zig
+++ b/zig/tests/cuda/glm_ovn_checks.zig
@@ -2,10 +2,12 @@
 const std = @import("std");
 const check = @import("check.zig");
