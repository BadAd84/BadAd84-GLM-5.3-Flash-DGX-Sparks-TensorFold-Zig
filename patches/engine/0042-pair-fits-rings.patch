From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Subject: [PATCH] glm cuda: a paired prompt step must fit the index rings from its own pool

The index rings hold 4,096 rows (index_ring = 2 * prefill_rows) and a rebase
moves a ring's base down to a multiple of the 4-row pool. On the pin every
prompt step starts on the 2,048-row grid, so a 4,096-row pair rebased at its
own start always fits. Patch 0007 lets a step start at any row (chunks end at
marks) but kept the pin's ringsAgree and State.ready: a pair starting at a row
that is not a multiple of 4 rebases to the pool below it and then writes up to
3 rows past the end of each ring, into its neighbour.

The tree 0007 was ported from guards both places, and this takes its lines:
ringsAgree also requires start % pool + ra + rb <= ring, so such a step runs
as single chunks, and State.ready and readyMtp return error.PastRing when a
pass still does not fit after the rebase instead of writing past the ring.

Seen in the serve (spark1-3, TP=3, a 10,929-token prompt, one stream, the
drafter off so both the pin and the stack pair): the pin returns digest
d0b0076e1126 with pairing on and off; the stack through 0041 returns
34deaa541eee with pairing on and the pin's digest with TF_GLM_PROMPT_PAIR=0.
Every image back to pin + 0001..0007 returns 34deaa541eee.

diff --git a/zig/src/families/glm/cuda_prompt_pair.zig b/zig/src/families/glm/cuda_prompt_pair.zig
--- a/zig/src/families/glm/cuda_prompt_pair.zig
+++ b/zig/src/families/glm/cuda_prompt_pair.zig
@@ -7,6 +7,7 @@
 const engine = @import("cuda_engine.zig");
 const dflash = @import("dflash.zig");
 const Engine = engine.Engine;
+const pool = @import("cuda_sparse.zig").pool;
 
 /// The fewest rows a paired step's second chunk takes: a shorter one's sites end before the first's exchanges do.
 pub const min_rows = fw.prefill_rows / 4;
@@ -52,10 +53,12 @@
     return std.mem.indexOfScalar(u32, marks, @intCast(next)) == null;
 }
 
-/// Whether a pair at `start` (b of `rb` rows) rebases the index rings where chunks one at a time do: at a, or not.
+/// Whether a pair at `start` (b of `rb` rows) rebases the index rings where chunks one at a time do: at a, or not; and
+/// fits them from there (State.ready rebases to a's pool, so a's rows into that pool count too).
 pub fn ringsAgree(base: usize, ring: usize, start: usize, rb: usize) bool {
     const ra = fw.prefill_rows;
-    return start + ra > base + ring or start + ra + rb <= base + ring;
+    if (start + ra + rb <= base + ring) return true;
+    return start + ra > base + ring and start % pool + ra + rb <= ring;
 }
 
 /// The pieces a forward over `b` exchanges in: the engine's, or the pair's for its twin; none for other buffers.
@@ -166,6 +169,10 @@
     try std.testing.expect(!ringsAgree(0, 2 * C, C, 1));
     try std.testing.expect(ringsAgree(0, 2 * C, 2 * C, C)); // both at a's start
     try std.testing.expect(ringsAgree(C, 2 * C, C, C));
+    try std.testing.expect(!ringsAgree(0, 2 * C, C + 1, C)); // rebased to C, b's last row would fall one past the ring
+    try std.testing.expect(ringsAgree(0, 2 * C, C + 1, C - 1));
+    try std.testing.expect(ringsAgree(0, 2 * C, C + 3, C - 3));
+    try std.testing.expect(!ringsAgree(0, 2 * C, C + 3, C - 2));
 }
 
 test "only ranks that exchange make the twin: TP=1 has no exchanges to hide" {
diff --git a/zig/src/families/glm/cuda_state.zig b/zig/src/families/glm/cuda_state.zig
--- a/zig/src/families/glm/cuda_state.zig
+++ b/zig/src/families/glm/cuda_state.zig
@@ -513,12 +513,14 @@
     pub fn ready(st: *State, stream: cuda.Stream, rows: usize) !void {
         if (st.pos + rows > st.capacity) return error.PastCapacity;
         if (st.pos + rows > st.base + st.ring_rows) try st.rebase(stream, false);
+        if (st.pos + rows > st.base + st.ring_rows) return error.PastRing; // rows past the ring overwrite its neighbour
     }
 
     /// Before the MTP head's pass of `n` rows at mtp_len, likewise for its caches.
     pub fn readyMtp(st: *State, stream: cuda.Stream, n: usize) !void {
         if (st.mtp_len + n > st.capacity) return error.PastCapacity;
         if (st.mtp_len + n > st.mtp_base + st.ring_rows) try st.rebase(stream, true);
+        if (st.mtp_len + n > st.mtp_base + st.ring_rows) return error.PastRing;
     }
 
     /// Rebase at the earliest pool a rollback may revisit; MTP retains a whole verify window before its cursor.
