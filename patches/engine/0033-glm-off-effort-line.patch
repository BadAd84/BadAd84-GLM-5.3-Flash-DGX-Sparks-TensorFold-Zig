+//! TF_GLM_OVN_OFF_EFFORT_LINE: GLM-5.3's chat template without its default effort line while thinking is off.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// The test GLM-5.3's chat template opens its `<|system|>Reasoning Effort: ...` line with.
+pub const effort_if = "{%- if effective_reasoning_effort is not none -%}";
+/// `effort_if`, false while thinking is off at the effort `max` (the default); a named `low` or `high` still renders.
+pub const effort_if_off = "{%- if effective_reasoning_effort is not none and (enable_thinking or effective_reasoning_effort != 'max') -%}";
+
+/// `source` with its first `effort_if` replaced by `effort_if_off`; `source` itself when it has none.
+pub fn offEffortLine(a: Allocator, source: []const u8) Allocator.Error![]const u8 {
+    const at = std.mem.indexOf(u8, source, effort_if) orelse return source;
+    return std.mem.concat(a, u8, &.{ source[0..at], effort_if_off, source[at + effort_if.len ..] });
+}
+
+/// The text `HfText.load` compiles from a chat template: `source`, through `offEffortLine` when the switch is 1.
+pub fn compileSource(a: Allocator, source: []const u8, problem: *[]const u8) error{ OutOfMemory, Load }![]const u8 {
+    const on = @import("sys").environment.read(bool, "TF_GLM_OVN_OFF_EFFORT_LINE", false) catch {
+        problem.* = "TF_GLM_OVN_OFF_EFFORT_LINE must be 0 or 1";
+        return error.Load;
+    };
+    if (!on) return source;
+    return offEffortLine(a, source);
+}
