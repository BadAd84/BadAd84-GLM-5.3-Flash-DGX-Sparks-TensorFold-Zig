diff --git a/zig/src/server/thinking_off_effort_line_test.zig b/zig/src/server/thinking_off_effort_line_test.zig
new file mode 100644
index 000000000..69b8b70d1
--- /dev/null
+++ b/zig/src/server/thinking_off_effort_line_test.zig
@@ -0,0 +1,190 @@
+//! TF_GLM_OVN_OFF_EFFORT_LINE: GLM-5.3's thinking-off prompt has no default effort line, as production renders it.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const openai = @import("openai.zig");
+const Server = @import("server.zig").Server;
+const Conn = @import("http_conn.zig").Conn;
+const HfText = @import("hf_text.zig").HfText;
+const effort = @import("hf_text_effort.zig");
+const env = @import("sys").env;
+const Allocator = std.mem.Allocator;
+
+const glm53 = @embedFile("fixtures/thinking/glm53.jinja");
+const glm53_config = @embedFile("fixtures/thinking/glm53-tokenizer_config.json");
+const name = "TF_GLM_OVN_OFF_EFFORT_LINE";
+const max_line = "[gMASK]<sop><|system|>Reasoning Effort: Max<|user|>H<|assistant|><think>";
+const no_line = "[gMASK]<sop><|user|>H<|assistant|><think>";
+
+/// The engine behind a test server: it keeps the prompt it is given and answers one token.
+const Script = struct {
+    prompt: [4096]u32 = undefined,
+    count: usize = 0,
+
+    fn engine(s: *Script) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 262144 };
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const s: *Script = @ptrCast(@alignCast(ctx));
+        s.count = request.prompt.len;
+        @memcpy(s.prompt[0..s.count], request.prompt);
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        sink.event(sink.ctx, id, &.{ .tokens = &.{2} });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// A chat reply's status, the one part of it these tests read.
+const Reply = struct {
+    status: ?u16 = null,
+
+    fn out(r: *Reply) openai.Out {
+        return .{ .ctx = r, .vt = &.{ .open = open, .event = event, .reply = reply } };
+    }
+    fn open(_: *anyopaque, _: usize) error{Closed}!void {}
+    fn event(_: *anyopaque, _: ?json.Value) error{Closed}!void {}
+    fn reply(ctx: *anyopaque, status_code: u16, _: json.Value) void {
+        const r: *Reply = @ptrCast(@alignCast(ctx));
+        r.status = status_code;
+    }
+};
+
+fn set(value: ?[:0]const u8) !void {
+    const rc = if (value) |v| env.setenv(name, v, 1) else env.unsetenv(name);
+    try std.testing.expectEqual(@as(c_int, 0), rc);
+}
+
+/// The switch's value before a test, which `restore` puts back.
+fn saved(gpa: Allocator) !?[:0]u8 {
+    const v = std.c.getenv(name) orelse return null;
+    return try gpa.dupeSentinel(u8, std.mem.span(v), 0);
+}
+
+fn restore(gpa: Allocator, value: ?[:0]u8) void {
+    if (value) |v| {
+        _ = env.setenv(name, v, 1);
+        gpa.free(v);
+    } else _ = env.unsetenv(name);
+}
+
+/// The prompt `source` renders for the user message `H`: thinking `on`, and the effort `named` when one is given.
+fn rendered(a: Allocator, source: []const u8, on: bool, named: ?[]const u8) ![]const u8 {
+    const t = std.testing;
+    var f = try @import("thinking_family_fixture.zig").init(t.allocator, t.io, source, glm53_config, "glm5_next");
+    defer f.deinit();
+    var problem: []const u8 = "";
+    const hf = try HfText.load(t.allocator, t.io, f.path, null, a, &problem);
+    defer hf.deinit();
+    const messages = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"H\"}]")).ok;
+    const r = try hf.text().render(a, messages, .{ .enable_thinking = on, .reasoning_effort = named }, &problem);
+    return a.dupe(u8, r.text);
+}
+
+test "off effort line: thinking off with no effort named renders production's prompt, with no effort line" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    try std.testing.expectEqualStrings(no_line, try rendered(a, try effort.offEffortLine(a, glm53), false, null));
+}
+
+test "off effort line: thinking on renders as before, the default Max line and a named effort's" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const source = try effort.offEffortLine(a, glm53);
+    try std.testing.expectEqualStrings(max_line, try rendered(a, source, true, null));
+    try std.testing.expectEqualStrings("[gMASK]<sop><|system|>Reasoning Effort: High<|user|>H<|assistant|><think>", try rendered(a, source, true, "high"));
+}
+
+test "off effort line: thinking off keeps the line of a named high or low" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const source = try effort.offEffortLine(a, glm53);
+    try std.testing.expectEqualStrings("[gMASK]<sop><|system|>Reasoning Effort: High<|user|>H<|assistant|><think>", try rendered(a, source, false, "high"));
+    try std.testing.expectEqualStrings("[gMASK]<sop><|system|>Reasoning Effort: Low<|user|>H<|assistant|><think>", try rendered(a, source, false, "low"));
+}
+
+test "off effort line: thinking off at a named max drops the line, as production deletes the Max line" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    try std.testing.expectEqualStrings(no_line, try rendered(a, try effort.offEffortLine(a, glm53), false, "max"));
+}
+
+test "off effort line: a template without the effort test comes back as it was, and only the first one is rewritten" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const plain = "[gMASK]<sop>{% for m in messages %}{{ m.content }}{% endfor %}";
+    try std.testing.expectEqualStrings(plain, try effort.offEffortLine(a, plain));
+    const two = effort.effort_if ++ "A{%- endif -%}" ++ effort.effort_if ++ "B{%- endif -%}";
+    const first = effort.effort_if_off ++ "A{%- endif -%}" ++ effort.effort_if ++ "B{%- endif -%}";
+    try std.testing.expectEqualStrings(first, try effort.offEffortLine(a, two));
+}
+
+test "off effort line: with the switch unset or 0 the checkpoint's template keeps its Max line with thinking off" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const before = try saved(std.testing.allocator);
+    defer restore(std.testing.allocator, before);
+    const none: ?[:0]const u8 = null;
+    for ([_]?[:0]const u8{ none, "0" }) |value| {
+        try set(value);
+        try std.testing.expectEqualStrings(max_line, try rendered(a, glm53, false, null));
+    }
+}
+
+test "off effort line: the switch at 1 serves production's thinking-off prompt and keeps the checkpoint's own text" {
+    const t = std.testing;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const before = try saved(t.allocator);
+    defer restore(t.allocator, before);
+    try set("1");
+    var f = try @import("thinking_family_fixture.zig").init(t.allocator, t.io, glm53, glm53_config, "glm5_next");
+    defer f.deinit();
+    var problem: []const u8 = "";
+    const hf = try HfText.load(t.allocator, t.io, f.path, null, a, &problem);
+    defer hf.deinit();
+    // the server reads its template facts (thinking switch, effort levels) from this text, so it stays the file's
+    try t.expectEqualStrings(glm53, hf.source);
+    const text = hf.text();
+    var script: Script = .{};
+    const srv = try Server.init(t.allocator, t.io, script.engine(), text, .{ .served_name = "m", .model_ids = &.{ "m", "alias" }, .use_drafts = false }, null);
+    defer srv.deinit();
+    try t.expect(!srv.thinking_switch);
+    const body = (try json.parse(a, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"H\"}],\"max_tokens\":2,\"chat_template_kwargs\":{\"enable_thinking\":false}}")).ok;
+    var conn: Conn = .{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+    var reply: Reply = .{};
+    openai.run(srv, a, reply.out(), .{ .conn = &conn }, true, body);
+    try t.expectEqual(@as(?u16, 200), reply.status);
+    try t.expectEqualStrings(no_line ++ "</think>", try text.decode(a, script.prompt[0..script.count]));
+}
+
+test "off effort line: a switch value other than 0 or 1 refuses the chat template by name" {
+    const t = std.testing;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const before = try saved(t.allocator);
+    defer restore(t.allocator, before);
+    try set("2");
+    var f = try @import("thinking_family_fixture.zig").init(t.allocator, t.io, glm53, glm53_config, "glm5_next");
+    defer f.deinit();
+    var problem: []const u8 = "";
+    try t.expectError(error.Load, HfText.load(t.allocator, t.io, f.path, null, a, &problem));
+    try t.expectEqualStrings("TF_GLM_OVN_OFF_EFFORT_LINE must be 0 or 1", problem);
+}
