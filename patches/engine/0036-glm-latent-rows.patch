diff --git a/zig/tests/cuda/glm_latent_rows_tests.zig b/zig/tests/cuda/glm_latent_rows_tests.zig
new file mode 100644
--- /dev/null
+++ b/zig/tests/cuda/glm_latent_rows_tests.zig
@@ -0,0 +1,164 @@
+//! TF_GLM_OVN_LATENT_ROWS: absorb_q and expand_v at 2 and 4 rows a loop step against today's launches, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+pub const Gpu = check.Gpu;
+
+const marker = 0xa5;
+
+/// Round to bf16 as __float2bfloat16_rn does: nearest, ties to even.
+fn bf(v: f32) u16 {
+    const u: u32 = @bitCast(v);
+    return @truncate((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+/// 2^e exactly, for an exponent in -126 to 127.
+fn pow2(e: i32) f32 {
+    return @bitCast(@as(u32, @intCast(e + 127)) << 23);
+}
+
+/// `n` bf16 values from `seed`: 2^-27 to 2^13 of a 1/1024 step, both signs and zeros, so a reordered sum shows.
+fn values(gpa: std.mem.Allocator, n: usize, seed: u32) ![]u16 {
+    const out = try gpa.alloc(u16, n);
+    for (out, 0..) |*v, i| {
+        const h = (@as(u32, @truncate((i *% 0x9E3779B97F4A7C15) >> 32)) *% 0x85EBCA6B) ^ seed;
+        const frac: f32 = @floatFromInt(@as(i32, @intCast((h >> 3) % 2049)) - 1024);
+        const sign: f32 = if ((h & 1) != 0) -1 else 1;
+        const mag = pow2(@as(i32, @intCast((h >> 23) % 41)) - 27);
+        v.* = if (h % 11 == 0) 0 else bf(sign * (frac / 1024.0) * mag);
+    }
+    return out;
+}
+
+const Rig = struct {
+    gpu: Gpu,
+    s: cuda.Stream,
+    k: glm.glue.Kernels,
+};
+
+/// A device buffer of `n` bf16 values from `seed`, uploaded and the host copy freed.
+fn buffer(gpu: Gpu, n: usize, seed: u32) !cuda.DeviceBuffer {
+    const host = try values(gpu.gpa, n, seed);
+    defer gpu.gpa.free(host);
+    return cuda.DeviceBuffer.fromHost(gpu.d, std.mem.sliceAsBytes(host));
+}
+
+/// absorb_q through the production entry point, `step` rows a loop step (0 is today's launch), whole buffer marked.
+fn run_absorb(r: *Rig, out: cuda.DeviceBuffer, q: cuda.DeviceBuffer, wk: cuda.DeviceBuffer, rows: usize, heads: usize, step: usize) !void {
+    try out.fill8(marker, r.s.handle);
+    const set: glm.glue.Set = .{ .glue = &r.k, .mla = .{ .rows = step } };
+    try glm.latent.absorbQ(set, r.s, q.ptr, wk.ptr, 0, out.ptr, rows, heads, 256, 512);
+}
+
+/// expand_v through the production entry point, as run_absorb.
+fn run_expand(r: *Rig, out: cuda.DeviceBuffer, ol: cuda.DeviceBuffer, wv: cuda.DeviceBuffer, rows: usize, heads: usize, step: usize) !void {
+    try out.fill8(marker, r.s.handle);
+    const set: glm.glue.Set = .{ .glue = &r.k, .mla = .{ .rows = step } };
+    try glm.latent.expandV(set, r.s, ol.ptr, wv.ptr, 0, out.ptr, rows, heads, 256, 512);
+}
+
+/// Both whole buffers equal once both launches have finished.
+fn same(r: *Rig, what: []const u8, got: cuda.DeviceBuffer, want: cuda.DeviceBuffer) !void {
+    try r.s.synchronize();
+    const g = try r.gpu.gpa.alloc(u8, got.len);
+    defer r.gpu.gpa.free(g);
+    const w = try r.gpu.gpa.alloc(u8, want.len);
+    defer r.gpu.gpa.free(w);
+    try got.download(0, g);
+    try want.download(0, w);
+    try check.sameBytes(what, g, w);
+}
+
+const rows_all = [_]usize{ 1, 2, 3, 4, 5, 7, 8, 9, 16, 31, 33, 63, 64, 65, 127, 128, 200, 1000, 4096 };
+const heads_all = [_]usize{ 22, 21, 16, 3 };
+const steps = [_]usize{ 2, 4 };
+
+/// The planted control: an equal pair, then a one-bit reference change, a changed input and written bytes show.
+fn planted(r: *Rig) !void {
+    const rows = 8;
+    const heads = 3;
+    var q = try buffer(r.gpu, rows * heads * 256, 11);
+    defer q.free();
+    var wk = try buffer(r.gpu, heads * 256 * 512, 12);
+    defer wk.free();
+    var a = try cuda.DeviceBuffer.alloc(r.gpu.d, rows * heads * 512 * 2);
+    defer a.free();
+    var b = try cuda.DeviceBuffer.alloc(r.gpu.d, a.len);
+    defer b.free();
+    try run_absorb(r, a, q, wk, rows, heads, 0);
+    try run_absorb(r, b, q, wk, rows, heads, 4);
+    try same(r, "glm-latent-rows: the control's pair", b, a);
+    const g = try r.gpu.gpa.alloc(u8, a.len);
+    defer r.gpu.gpa.free(g);
+    const h = try r.gpu.gpa.alloc(u8, b.len);
+    defer r.gpu.gpa.free(h);
+    try a.download(0, g);
+    try b.download(0, h);
+    var wrote: usize = 0;
+    for (g) |v| {
+        if (v != marker) wrote += 1;
+    }
+    try check.expect(wrote > g.len / 2, "glm-latent-rows: the control's launches write their output", .{});
+    h[h.len / 2] ^= 1; // one bit of a pair the comparison has just called equal
+    try check.expect(!std.mem.eql(u8, g, h), "glm-latent-rows: the control's one-bit change is a difference", .{});
+    h[h.len / 2] ^= 1;
+    var q2 = try buffer(r.gpu, rows * heads * 256, 13);
+    defer q2.free();
+    try run_absorb(r, a, q2, wk, rows, heads, 0);
+    try r.s.synchronize();
+    try a.download(0, g);
+    try check.expect(!std.mem.eql(u8, g, h), "glm-latent-rows: the control's second input changes the output", .{});
+    check.pass("glm-latent-rows: the planted control: written bytes, a one-bit reference change, a changed input", .{});
+}
+
+pub fn run(gpu: Gpu) !void {
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var m = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer m.unload();
+    var r: Rig = .{ .gpu = gpu, .s = s, .k = try glm.glue.Kernels.loadOvn(m, true) };
+    try check.expect(r.k.absorb_q_x2.handle != null, "glm-latent-rows: the glue image exports tf_glm_absorb_q_x2", .{});
+    try check.expect(r.k.absorb_q_x4.handle != null, "glm-latent-rows: the glue image exports tf_glm_absorb_q_x4", .{});
+    try check.expect(r.k.expand_v_x2.handle != null, "glm-latent-rows: the glue image exports tf_glm_expand_v_x2", .{});
+    try check.expect(r.k.expand_v_x4.handle != null, "glm-latent-rows: the glue image exports tf_glm_expand_v_x4", .{});
+    try check.expect(r.k.absorb_q_x4.handle != r.k.absorb_q.handle, "glm-latent-rows: x4 is not today's launch", .{});
+    var n: [4]usize = @splat(0); // cases per (kernel, step): absorb x2, absorb x4, expand x2, expand x4
+    for (heads_all, 0..) |heads, hi| {
+        const seed: u32 = 0x51ed2700 + @as(u32, @intCast(hi * 7919 + heads));
+        var wk = try buffer(gpu, heads * 256 * 512, seed);
+        defer wk.free();
+        var wv = try buffer(gpu, heads * 256 * 512, seed + 1);
+        defer wv.free();
+        for (rows_all) |rows| {
+            var q = try buffer(gpu, rows * heads * 256, seed + 2);
+            defer q.free();
+            var ol = try buffer(gpu, rows * heads * 512, seed + 3);
+            defer ol.free();
+            var today = try cuda.DeviceBuffer.alloc(gpu.d, rows * heads * 512 * 2);
+            defer today.free();
+            var variant = try cuda.DeviceBuffer.alloc(gpu.d, today.len);
+            defer variant.free();
+            var etoday = try cuda.DeviceBuffer.alloc(gpu.d, rows * heads * 256 * 2);
+            defer etoday.free();
+            var evariant = try cuda.DeviceBuffer.alloc(gpu.d, etoday.len);
+            defer evariant.free();
+            for (steps, 0..) |step, si| {
+                try run_absorb(&r, today, q, wk, rows, heads, 0);
+                try run_absorb(&r, variant, q, wk, rows, heads, step);
+                try same(&r, "glm-latent-rows: absorb_q at 2 or 4 rows a loop step", variant, today);
+                n[si] += 1;
+                try run_expand(&r, etoday, ol, wv, rows, heads, 0);
+                try run_expand(&r, evariant, ol, wv, rows, heads, step);
+                try same(&r, "glm-latent-rows: expand_v at 2 or 4 rows a loop step", evariant, etoday);
+                n[2 + si] += 1;
+            }
+        }
+    }
+    check.pass("glm-latent-rows: absorb_q at 2 rows a step equals today's launch, {d} cases", .{n[0]});
+    check.pass("glm-latent-rows: absorb_q at 4 rows a step equals today's launch, {d} cases", .{n[1]});
+    check.pass("glm-latent-rows: expand_v at 2 rows a step equals today's launch, {d} cases", .{n[2]});
+    check.pass("glm-latent-rows: expand_v at 4 rows a step equals today's launch, {d} cases", .{n[3]});
+    try planted(&r);
+    check.pass("glm-latent-rows: every case equals today's launches byte for byte", .{});
+}
