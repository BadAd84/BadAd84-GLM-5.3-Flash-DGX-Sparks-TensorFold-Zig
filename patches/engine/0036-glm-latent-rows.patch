 }
+
+/// The kernels a recorded launch reaches: each field's index plus one is its handle (cuda_mla_ovn_test's rig).
+const Rec = struct {
+    var n: usize = 0;
+    var ids: [8]usize = undefined;
+    fn run(f: cuda.abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, _: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) c_int {
+        ids[n] = @intFromPtr(f);
+        n += 1;
+        return 0;
+    }
+};
+
+fn id(comptime name: []const u8) usize {
+    return std.meta.fieldIndex(glue.Kernels, name).? + 1;
+}
+
+fn kernels(d: *cuda.Driver) glue.Kernels {
+    var ks: glue.Kernels = undefined;
+    inline for (@typeInfo(glue.Kernels).@"struct".field_names, 0..) |name, i| @field(ks, name) = .{ .d = d, .handle = @ptrFromInt(i + 1) };
+    return ks;
+}
+
+test "TF_GLM_OVN_LATENT_ROWS: rows 2 and 4 take the x2 and x4 launches; vec and KVB8 keep today's" {
+    var d: cuda.Driver = undefined;
+    d.api.cuLaunchKernel = Rec.run;
+    const ks = kernels(&d);
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    const plain: glue.Set = .{ .glue = &ks };
+    const x2: glue.Set = .{ .glue = &ks, .mla = .{ .rows = 2 } };
+    const x4: glue.Set = .{ .glue = &ks, .mla = .{ .rows = 4 } };
+    const vec4: glue.Set = .{ .glue = &ks, .mla = .{ .rows = 4, .vec = true } };
+    Rec.n = 0;
+    try absorbQ(plain, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try expandV(plain, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try absorbQ(x2, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try expandV(x2, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try absorbQ(x4, s, 256, 4096, 0, 512, 70, 22, 256, 512);
+    try expandV(x4, s, 256, 4096, 0, 512, 70, 22, 256, 512);
+    try absorbQ(vec4, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try expandV(vec4, s, 256, 4096, 0, 512, 2, 22, 256, 512);
+    try std.testing.expectEqualSlices(usize, &.{ id("absorb_q"), id("expand_v"), id("absorb_q_x2"), id("expand_v_x2"), id("absorb_q_x4"), id("expand_v_x4"), id("absorb_q_vec"), id("expand_v_vec") }, Rec.ids[0..Rec.n]);
+    Rec.n = 0;
+    try absorbQ(x4, s, 256, 4096, 8192, 512, 2, 22, 256, 512);
+    try expandV(x4, s, 256, 4096, 8192, 512, 2, 22, 256, 512);
+    try std.testing.expectEqualSlices(usize, &.{ id("absorb_q8"), id("expand_v8") }, Rec.ids[0..Rec.n]);
+}
