From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Subject: [PATCH] glm latent: TF_GLM_OVN_LATENT_ROWS, absorb_q and expand_v two and four rows a loop step

The latent path's absorb and expand launches loop one row at a time: each row's chain ends in two block
syncs and a dependent shuffle chain, so a 64-row block pays that latency 64 times. TF_GLM_OVN_LATENT_ROWS
(0, 2 or 4; default 0) lets the plain bf16 kernels take 2 or 4 rows a loop step with one pair of syncs an
iteration and every row's arithmetic untouched: tf_glm_absorb_q_x2, _x4, tf_glm_expand_v_x2 and _x4 are the
same block, the same weight tile held in registers and the same per-row chain, interleaved.

Bit exactness: each row runs the original kernel's expression for expression. absorb_q takes
fmul(w[1][j], q[1]), then __fmaf_rn over reps 0..7 into one accumulator, then the xor 16, 8 and 4 shuffles
as plain additions, the shared exchange keyed by (nq * 8 + j) * 4 + warp, the xor 2 and xor 1 sums, and
__float2bfloat16_rn on the store; expand_v takes fmul(w[rep][1], o[1]), __fmaf_rn over j = 0..7, the xor
16..1 sums, the exchange keyed by (nb + 2 * rep) * 2 + (warp & 1), the xor 1 sum and the same rounding. The
variants keep those operands, that order and those forms: the first product is an explicit fmul and every
sum of shuffled values stays an addition, so there is no product for nvcc to contract into a neighbouring
sum that the original did not contract, and no sum to reassociate. Rows hold independent registers, and a
shuffle is a warp-wide exchange of one register with the lanes in lockstep, so running 2 or 4 rows between
one pair of syncs cannot move any row's value. Block geometry is unchanged: the same weight tile, the same
grid, rb still 64, so a block still ends at r0 + rb or rows, a ragged last block leaves later rows alone,
and a row past an iteration's live rows reads row r, which is in bounds, and writes nothing. With
TF_GLM_OVN_KVB8's E4M3 forms or TF_GLM_OVN_ABSORB_VEC's 16-byte forms on, the existing kernels run.

The glm-latent-rows check runs today's launch and each of x2 and x4 through glm.latent.absorbQ and
expandV on the same input for 19 row counts (1 through 4096, decode windows and ragged 64-row blocks
included) and 4 head counts (22, 21, 16 and 3), on bf16 inputs from a fixed seed whose magnitudes span 2^-27
to 2^13 with both signs and zeros, and compares the whole output buffer byte for byte; a planted control
requires the comparison to see a written output, a one-bit change of the reference and a changed input.

Host tests: the row parses 0, 2 and 4 (unset off, 3 and 6 refused), and a recording driver shows the
launch each setting selects, with vec and KVB8 keeping today's kernels.

Not touched: the KVB8 and vec variants, the launch geometry (rowBlocks, rb, block and grid), any other
kernel and main.zig; the command joins glm_ovn_checks.zig's table, usage and dispatch. The switch is a row
of zig/src/platform/environment.zig after TF_GLM_OVN_KVB8's and a line of docs/environment.md after that
switch's, so patches/pr1411's environment.zig and docs/environment.md hunks still apply on top.

New here, not a re-seat: written on this series at v1.2.9.

diff --git a/zig/kernels/cuda/glm_glue_latent.cuh b/zig/kernels/cuda/glm_glue_latent.cuh
--- a/zig/kernels/cuda/glm_glue_latent.cuh
+++ b/zig/kernels/cuda/glm_glue_latent.cuh
@@ -66,6 +66,143 @@
   }
 }
 
+// absorb_q's block with R rows a step: R chains in flight, one pair of syncs, and every row's own chain as above.
+template <int R>
+__device__ __forceinline__ void absorb_rows(const __nv_bfloat16* q, const __nv_bfloat16* wk, __nv_bfloat16* qa,
+                                            int64_t rows, int64_t heads, int64_t rb) {
+  constexpr int D = 256, LW = 512;
+  __shared__ float part[R][128];
+  const int t = threadIdx.x, k0 = t >> 2, nq = t & 3, warp = t >> 5;
+  const int64_t h = blockIdx.x, n0 = (int64_t)blockIdx.y * 32 + nq * 8, r0 = blockIdx.z * rb;
+  float w[8][8];
+#pragma unroll
+  for (int rep = 0; rep < 8; ++rep)
+#pragma unroll
+    for (int j = 0; j < 8; ++j) w[rep][j] = bf(wk[(h * D + k0 + 32 * rep) * LW + n0 + j]);
+  for (int64_t r = r0; r < r0 + rb && r < rows; r += R) {
+    const int64_t nr = rows - r < R ? rows - r : R;  // the rows this iteration has
+    float qv[R][8];
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+      const int64_t ri = r + (i < nr ? i : 0);
+#pragma unroll
+      for (int rep = 0; rep < 8; ++rep) qv[i][rep] = bf(q[(ri * heads + h) * D + k0 + 32 * rep]);
+    }
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+      float a[R];
+#pragma unroll
+      for (int i = 0; i < R; ++i) {
+        a[i] = fmul(w[1][j], qv[i][1]);
+        a[i] = __fmaf_rn(w[0][j], qv[i][0], a[i]);
+#pragma unroll
+        for (int rep = 2; rep < 8; ++rep) a[i] = __fmaf_rn(w[rep][j], qv[i][rep], a[i]);
+      }
+#pragma unroll
+      for (int i = 0; i < R; ++i)
+        for (int o = 16; o >= 4; o >>= 1) a[i] = a[i] + __shfl_xor_sync(0xffffffffu, a[i], o);
+      if ((t & 28) == 0) {
+#pragma unroll
+        for (int i = 0; i < R; ++i) part[i][(nq * 8 + j) * 4 + warp] = a[i];
+      }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+      if (r + i < r0 + rb && r + i < rows) {
+        const int64_t row = r + i;
+        float v = part[i][t];
+        v = v + __shfl_xor_sync(0xffffffffu, v, 2);
+        v = v + __shfl_xor_sync(0xffffffffu, v, 1);
+        if ((t & 3) == 0) qa[(row * heads + h) * LW + (int64_t)blockIdx.y * 32 + t / 4] = __float2bfloat16_rn(v);
+      }
+    }
+    __syncthreads();
+  }
+}
+
+// TF_GLM_OVN_LATENT_ROWS: tf_glm_absorb_q's launch, 2 and 4 rows a step.
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_absorb_q_x2(const __nv_bfloat16* q, const __nv_bfloat16* wk, __nv_bfloat16* qa, int64_t rows,
+                       int64_t heads, int64_t rb) {
+  absorb_rows<2>(q, wk, qa, rows, heads, rb);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_absorb_q_x4(const __nv_bfloat16* q, const __nv_bfloat16* wk, __nv_bfloat16* qa, int64_t rows,
+                       int64_t heads, int64_t rb) {
+  absorb_rows<4>(q, wk, qa, rows, heads, rb);
+}
+
+// expand_v's block with R rows a step, as absorb_rows: R chains, one pair of syncs, every row's chain unchanged.
+template <int R>
+__device__ __forceinline__ void expand_rows(const __nv_bfloat16* ol, const __nv_bfloat16* wv, __nv_bfloat16* out,
+                                            int64_t rows, int64_t heads, int64_t rb) {
+  constexpr int DV = 256, LW = 512;
+  __shared__ float part[R][32];
+  const int t = threadIdx.x, lane = t & 31, warp = t >> 5, kb = (warp & 1) * 256 + lane * 8, nb = warp >> 1;
+  const int64_t h = blockIdx.x, n0 = (int64_t)blockIdx.y * 16, r0 = blockIdx.z * rb;
+  float w[8][8];
+#pragma unroll
+  for (int rep = 0; rep < 8; ++rep)
+#pragma unroll
+    for (int j = 0; j < 8; ++j) w[rep][j] = bf(wv[(h * DV + n0 + nb + 2 * rep) * LW + kb + j]);
+  for (int64_t r = r0; r < r0 + rb && r < rows; r += R) {
+    const int64_t nr = rows - r < R ? rows - r : R;  // the rows this iteration has
+    float o[R][8];
+#pragma unroll
+    for (int i = 0; i < R; ++i) {
+      const int64_t ri = r + (i < nr ? i : 0);
+#pragma unroll
+      for (int j = 0; j < 8; ++j) o[i][j] = bf(ol[(ri * heads + h) * LW + kb + j]);
+    }
+#pragma unroll
+    for (int rep = 0; rep < 8; ++rep) {
+      float a[R];
+#pragma unroll
+      for (int i = 0; i < R; ++i) {
+        a[i] = fmul(w[rep][1], o[i][1]);
+        a[i] = __fmaf_rn(w[rep][0], o[i][0], a[i]);
+#pragma unroll
+        for (int j = 2; j < 8; ++j) a[i] = __fmaf_rn(w[rep][j], o[i][j], a[i]);
+      }
+#pragma unroll
+      for (int i = 0; i < R; ++i)
+        for (int s = 16; s > 0; s >>= 1) a[i] = a[i] + __shfl_xor_sync(0xffffffffu, a[i], s);
+      if (lane == 0) {
+#pragma unroll
+        for (int i = 0; i < R; ++i) part[i][(nb + 2 * rep) * 2 + (warp & 1)] = a[i];
+      }
+    }
+    __syncthreads();
+    if (t < 32) {
+#pragma unroll
+      for (int i = 0; i < R; ++i) {
+        if (r + i < r0 + rb && r + i < rows) {
+          const int64_t row = r + i;
+          float v = part[i][t];
+          v = v + __shfl_xor_sync(0xffffffffu, v, 1);
+          if ((t & 1) == 0) out[(row * heads + h) * DV + n0 + t / 2] = __float2bfloat16_rn(v);
+        }
+      }
+    }
+    __syncthreads();
+  }
+}
+
+// TF_GLM_OVN_LATENT_ROWS: tf_glm_expand_v's launch, 2 and 4 rows a step.
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_expand_v_x2(const __nv_bfloat16* ol, const __nv_bfloat16* wv, __nv_bfloat16* out, int64_t rows,
+                       int64_t heads, int64_t rb) {
+  expand_rows<2>(ol, wv, out, rows, heads, rb);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_expand_v_x4(const __nv_bfloat16* ol, const __nv_bfloat16* wv, __nv_bfloat16* out, int64_t rows,
+                       int64_t heads, int64_t rb) {
+  expand_rows<4>(ol, wv, out, rows, heads, rb);
+}
+
 namespace glm_pages {
 
 // Row r's first element in a cache of `width`-element rows: in order (pt null), or row r % P of page pt[r / P].
diff --git a/zig/src/families/glm/cuda_latent.zig b/zig/src/families/glm/cuda_latent.zig
