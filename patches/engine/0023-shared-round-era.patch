+//! TF_GLM_OVN_COST_TIME: the lane host's window costs timed at load (DFlash2 only) instead of the two-GB10 constants.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const engine = @import("cuda_engine.zig");
+const fw = @import("cuda_forward.zig");
+const Seq = @import("cuda_engine_types.zig").Seq;
+const Engine = engine.Engine;
+const Cost = lanes.config.Cost;
+
+const first_slot = 1; // the timed sequences' slots: no stream holds one before the server starts
+const slots = 8;
+const capacity = 1024; // each timed sequence's tokens: the passes below commit about a hundred rows
+const reps = 5;
+const max_rows = fw.window_rows;
+
+/// The timed tables: a lone window's ms by rows, a shared window's by its total rows (1 .. shared_rows).
+pub const Timed = struct { window: [max_rows]Cost, shared: [engine.shared_rows]Cost };
+
+/// Whether this load times its costs: the knob, DFlash2 (the only user of the tables), shared windows, no vision
+pub fn wanted(e: *const Engine) bool {
+    return cuda.ovn.on("COST_TIME") and e.drafter != null and e.bs != null and e.images == null;
+}
+
+fn now(e: *const Engine) i96 {
+    return std.Io.Clock.awake.now(e.io).toNanoseconds();
+}
+
+fn ms(e: *const Engine, t0: i96) f64 {
+    return @as(f64, @floatFromInt(now(e) - t0)) / 1e6;
+}
+
+/// Every rank (Leader.costs, then the `costs` step): the timed passes; rank 0's tables (the others' are unused).
+pub fn run(e: *Engine) !Timed {
+    const end = first_slot + slots;
+    if (e.seqs.items.len < end) try e.seqs.appendNTimes(e.gpa, null, end - e.seqs.items.len);
+    for (e.seqs.items[first_slot..end]) |q| if (q != null) return error.SlotTaken;
+    defer { // every timed slot freed (Engine.release), and the drafter rings its passes made, as before the step
+        for (first_slot..end) |slot| e.release(@intCast(slot));
+        if (e.drafter) |dr| if (dr.slots.items.len > first_slot) for (dr.slots.items[first_slot..@min(end, dr.slots.items.len)]) |*s| {
+            if (s.ring) |*r| r.free();
+            s.* = .{};
+        };
+    }
+    for (e.seqs.items[first_slot..end]) |*q| { // small sequences, so no rank makes a full one on these slots
+        const s = try e.gpa.create(Seq);
+        errdefer e.gpa.destroy(s);
+        s.* = .{ .st = try fw.State.initFormat(e.gpa, e.d, &e.w, capacity, e.settings.kv8) };
+        q.* = s;
+    }
+    var ids: [engine.shared_rows]u32 = undefined;
+    for (&ids, 0..) |*t, i| t.* = @intCast(1000 + 7 * i); // distinct tokens
+    var out: [engine.shared_rows]u32 = undefined;
+    for (first_slot..end) |slot| {
+        try e.bind(@intCast(slot));
+        try e.begin(null);
+    }
+    var window: [max_rows]f64 = @splat(std.math.inf(f64));
+    try e.bind(first_slot);
+    try e.verify(ids[0..max_rows], out[0..max_rows], 0); // warm-up
+    try e.keep(1);
+    for (0..reps) |_| for (1..max_rows + 1) |r| {
+        const t0 = now(e);
+        try e.verify(ids[0..r], out[0..r], 0);
+        window[r - 1] = @min(window[r - 1], ms(e, t0));
+        try e.keep(1);
+    };
+    const streams = [_]usize{ 2, 4, 8 };
+    const per = [_]usize{ 1, 2, 4 };
+    var shared: [streams.len][per.len]f64 = @splat(@splat(std.math.inf(f64)));
+    var parts: [slots]engine.Part = undefined;
+    for (0..reps) |_| for (streams, 0..) |n, si| for (per, 0..) |r, pi| {
+        for (parts[0..n], 0..) |*p, k| p.* = .{ .slot = @intCast(first_slot + k), .ids = ids[k * r ..][0..r], .out = out[k * r ..][0..r] };
+        const t0 = now(e);
+        try e.verifyShared(parts[0..n]);
+        shared[si][pi] = @min(shared[si][pi], ms(e, t0));
+        for (parts[0..n]) |p| {
+            try e.bind(p.slot);
+            try e.keep(1);
+        }
+    };
+    var t: Timed = undefined;
+    for (&t.window, window, 1..) |*c, v, r| c.* = .{ .width = @intCast(r), .ms = v };
+    var points: [streams.len * per.len]Cost = undefined; // each combination's total rows and its time
+    for (streams, 0..) |n, si| for (per, 0..) |r, pi| {
+        points[si * per.len + pi] = .{ .width = @intCast(n * r), .ms = shared[si][pi] };
+    };
+    t.shared = sharedTable(&points);
+    if (e.share.rank == 0) std.log.info("glm costs (TF_GLM_OVN_COST_TIME): window ms by rows {any}; shared ms (2/4/8 streams x 1/2/4 rows) {any}", .{ window, shared });
+    return t;
+}
+
+/// The shared table by total rows: each measured total's mean, the line between them, extended past the ends.
+fn sharedTable(points: []const Cost) [engine.shared_rows]Cost {
+    var known: [engine.shared_rows + 1]?f64 = @splat(null);
+    var count: [engine.shared_rows + 1]f64 = @splat(0);
+    for (points) |p| {
+        known[p.width] = (known[p.width] orelse 0) + p.ms;
+        count[p.width] += 1;
+    }
+    var xs: [engine.shared_rows]u32 = undefined;
+    var ys: [engine.shared_rows]f64 = undefined;
+    var m: usize = 0;
+    for (known, count, 0..) |k, c, w| if (k) |sum| {
+        xs[m] = @intCast(w);
+        ys[m] = sum / c;
+        m += 1;
+    };
+    var out: [engine.shared_rows]Cost = undefined;
+    for (&out, 1..) |*o, w| {
+        var j: usize = 0; // the segment [j, j + 1] that holds w, or the first or last one
+        while (j + 2 < m and w > xs[j + 1]) j += 1;
+        const x0: f64 = @floatFromInt(xs[j]);
+        const x1: f64 = @floatFromInt(xs[j + 1]);
+        const at: f64 = @floatFromInt(w);
+        o.* = .{ .width = @intCast(w), .ms = ys[j] + (ys[j + 1] - ys[j]) * (at - x0) / (x1 - x0) };
+    }
+    return out;
+}
+
+test "shared costs: measured totals averaged, lines between them, extended at both ends" {
+    const pts = [_]Cost{ .{ .width = 2, .ms = 50 }, .{ .width = 4, .ms = 60 }, .{ .width = 4, .ms = 64 }, .{ .width = 8, .ms = 80 }, .{ .width = 32, .ms = 200 } };
+    const t = sharedTable(&pts);
+    try std.testing.expectEqual(@as(u32, 1), t[0].width);
+    try std.testing.expectApproxEqAbs(@as(f64, 44), t[0].ms, 1e-9); // below 2: the 2..4 line (50, 62)
+    try std.testing.expectApproxEqAbs(@as(f64, 62), t[3].ms, 1e-9); // 4: the mean of 60 and 64
+    try std.testing.expectApproxEqAbs(@as(f64, 71), t[5].ms, 1e-9); // 6: halfway from 62 to 80
+    try std.testing.expectApproxEqAbs(@as(f64, 200), t[31].ms, 1e-9);
+    try std.testing.expectApproxEqAbs(@as(f64, 140), t[19].ms, 1e-9); // 20: halfway from 80 to 200
+}
diff --git a/zig/src/families/glm/cuda_disk_image.zig b/zig/src/families/glm/cuda_disk_image.zig
new file mode 100644
index 000000000..2f4b17ac9
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_image.zig
@@ -0,0 +1,233 @@
+//! A GLM kept state's disk image on one rank: its parts at a position, and where each image byte sits in its lease.
+const std = @import("std");
+const cuda = @import("cuda");
+const st_mod = @import("cuda_state.zig");
+const sparse = @import("cuda_sparse.zig");
+const Config = @import("config.zig").Config;
+const pages = @import("cuda_snapshot_pages.zig");
+const State = st_mod.State;
+const window_rows = st_mod.window_rows;
+
+/// The image's first bytes: the format, the position, the head's rows, both ring bases and the KDA copy bits.
+pub const Words = struct {
+    at: u64,
+    mtp_len: u64,
+    base: u64,
+    mtp_base: u64,
+    cur: u64,
+
+    pub const bytes: u64 = 48;
+    const format: u64 = 1;
+
+    pub fn encode(w: Words) [6]u64 {
+        return .{ format, w.at, w.mtp_len, w.base, w.mtp_base, w.cur };
+    }
+
+    /// Words read back: refused unless the format is this one and the state stands at `at`.
+    pub fn decode(x: [6]u64, at: u32) !Words {
+        if (x[0] != format or x[1] != at) return error.DiskWords;
+        return .{ .at = x[1], .mtp_len = x[2], .base = x[3], .mtp_base = x[4], .cur = x[5] };
+    }
+};
+
+/// A part as the rows store takes it: `row` bytes for each `per` tokens from position 0, or the state's own (row 0).
+pub const Part = struct { bytes: u64, row: u32 = 0, per: u32 = 1 };
+
+/// `len` image bytes from `img`: the words, `lease` bytes into the state's lease, or zeros the lease does not hold.
+pub const Seg = struct { img: u64, len: u64, from: union(enum) { words, lease: u64, zeros } };
+
+/// What a rank's kept state holds, read from a sequence of the engine (its addresses are not used past here).
+pub const Shape = struct {
+    prefix: u64, // the sequence's own fields before its caches: KDA conv and states, a window's saved rows
+    tail: u64, // its fields after them: the head's position and first-draft row
+    layers: u32, // DSA layers, whose rows are shared by position
+    latent: u32, // a latent row's bytes
+    scales: bool, // fp8 latent rows: a 4-byte scale each
+    ring_rows: u32,
+    ring_row: u32,
+    pk_rows: u32,
+    pooled_row: u32,
+    capacity: u32,
+    head: bool, // the MTP head's caches are kept (drafting)
+
+    pub fn of(st: *const State, c: *const Config, capacity: usize, head: bool) !Shape {
+        if (st.rings.len == 0) return error.SnapshotShape;
+        const base = st.arena.buf.ptr;
+        const first = if (st.table != 0) st.rings[0] else if (st.caches.len > 0) st.caches[0].lc else st.mtp_caches.lc;
+        const end = if (st.table != 0) st.table else base + st.arena.buf.len;
+        if (first < base or st.mtp_pos_dev < first or end < st.mtp_pos_dev) return error.SnapshotShape;
+        const fp8 = st.mtp_caches.ls != 0;
+        return .{
+            .prefix = first - base,
+            .tail = end - st.mtp_pos_dev,
+            .layers = @intCast(st.caches.len),
+            .latent = c.kv_lora * @as(u32, if (fp8) 1 else 2),
+            .scales = fp8,
+            .ring_rows = @intCast(st.ring_rows),
+            .ring_row = @intCast(st.ring_row),
+            .pk_rows = @intCast(capacity / sparse.pool + 2),
+            .pooled_row = c.i_dim * 2,
+            .capacity = @intCast(capacity),
+            .head = head,
+        };
+    }
+
+    /// Rows the image keeps of the head's caches at `at`: a verify window past it, as the cache charges a state.
+    pub fn headRows(sh: Shape, at: u32) u32 {
+        return @min(sh.capacity, at + window_rows);
+    }
+};
+
+/// One cache's parts in the lease's order, for `n` rows: latent, scales, the two index rings, the pooled keys.
+fn cache(sh: Shape, n: u64) [5]u64 {
+    return .{
+        n * sh.latent,
+        if (sh.scales) n * 4 else 0,
+        @min(n, sh.ring_rows) * sh.ring_row,
+        @min(n, sh.ring_rows) * sh.ring_row,
+        @min(n / sparse.pool + 2, sh.pk_rows) * sh.pooled_row,
+    };
+}
+
+/// The image at `at` (a chunk start): the words, the prefix, each DSA layer's rows, the head's caches, the tail.
+pub fn parts(sh: Shape, at: u32, out: *std.ArrayList(Part), a: std.mem.Allocator) !void {
+    if (at == 0 or at % sparse.pool != 0 or at > sh.capacity) return error.SnapshotShape;
+    try out.appendSlice(a, &.{ .{ .bytes = Words.bytes }, .{ .bytes = sh.prefix } });
+    const pooled: u64 = at / sparse.pool;
+    for (0..sh.layers) |_| {
+        const c = cache(sh, at);
+        try out.append(a, .{ .bytes = c[0], .row = sh.latent });
+        if (sh.scales) try out.append(a, .{ .bytes = c[1], .row = 4 });
+        try out.appendSlice(a, &.{ .{ .bytes = c[2] }, .{ .bytes = c[3] } });
+        // whole pools are rows by position; the pool past them and the spare row stay the state's own
+        try out.appendSlice(a, &.{ .{ .bytes = pooled * sh.pooled_row, .row = sh.pooled_row, .per = sparse.pool }, .{ .bytes = c[4] - pooled * sh.pooled_row } });
+    }
+    if (sh.head) for (cache(sh, sh.headRows(at))) |n| if (n > 0) try out.append(a, .{ .bytes = n });
+    try out.append(a, .{ .bytes = sh.tail });
+}
+
+/// The image's segments in order for a state at `at` whose head holds `mtp_len` rows (0 without a head).
+pub fn segments(sh: Shape, at: u32, mtp_len: u64, out: *std.ArrayList(Seg), a: std.mem.Allocator) !void {
+    if (sh.head and mtp_len > sh.headRows(at)) return error.SnapshotShape;
+    var img: u64 = Words.bytes;
+    var lease: u64 = 0;
+    try out.append(a, .{ .img = 0, .len = Words.bytes, .from = .words });
+    const f = front(sh, at);
+    try out.append(a, .{ .img = img, .len = f, .from = .{ .lease = 0 } });
+    img += f;
+    lease += f;
+    if (sh.head) for (cache(sh, sh.headRows(at)), cache(sh, mtp_len)) |full, held| {
+        if (held > 0) try out.append(a, .{ .img = img, .len = held, .from = .{ .lease = lease } });
+        if (full > held) try out.append(a, .{ .img = img + held, .len = full - held, .from = .zeros });
+        img += full;
+        lease += held;
+    };
+    if (sh.tail > 0) try out.append(a, .{ .img = img, .len = sh.tail, .from = .{ .lease = lease } });
+}
+
+/// The image bytes after the words that sit in the lease as in the image: the prefix and every DSA layer's parts.
+pub fn front(sh: Shape, at: u32) u64 {
+    var n: u64 = sh.prefix;
+    for (0..sh.layers) |_| for (cache(sh, at)) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// The lease bytes of a state at `at` whose head holds `mtp_len` rows (layout.Plan's length for it).
+pub fn leaseBytes(sh: Shape, at: u32, mtp_len: u64) u64 {
+    var n: u64 = sh.prefix + sh.tail;
+    for (0..sh.layers) |_| for (cache(sh, at)) |x| {
+        n += x;
+    };
+    if (sh.head) for (cache(sh, mtp_len)) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// Rank 0's image bytes at `at` (its head counted at a verify window past `at`).
+pub fn imageBytes(sh: Shape, at: u32) u64 {
+    var n: u64 = Words.bytes + front(sh, at) + sh.tail;
+    if (sh.head) for (cache(sh, sh.headRows(at))) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// `len` bytes at `off` of rank `rank`'s image; `shared`: past rank 0's prefix, the same bytes every rank holds.
+pub const Piece = struct { rank: u32, off: u64, len: u64, shared: bool };
+
+/// The store's image at `at`: rank 0's, then each other rank's prefix (rank 0's bytes stand for all the rest).
+pub fn storeParts(sh: Shape, prefixes: []const u64, at: u32, out: *std.ArrayList(Part), a: std.mem.Allocator) !void {
+    try parts(sh, at, out, a);
+    for (prefixes[1..]) |p| try out.append(a, .{ .bytes = p });
+}
+
+/// Store image bytes [off, off + len) split by rank: rank 0's image, then rank r's prefix after its words.
+pub fn route(sh: Shape, prefixes: []const u64, at: u32, off: u64, len: u64, out: *std.ArrayList(Piece), a: std.mem.Allocator) !void {
+    const own = Words.bytes + sh.prefix; // rank 0's bytes no other rank holds
+    var start: u64 = 0; // the section's first store byte
+    for (prefixes, 0..) |p, r| {
+        const size = if (r == 0) imageBytes(sh, at) else p;
+        defer start += size;
+        const lo = @max(off, start);
+        const hi = @min(off + len, start + size);
+        if (lo >= hi) continue;
+        if (r > 0) {
+            try out.append(a, .{ .rank = @intCast(r), .off = Words.bytes + lo - start, .len = hi - lo, .shared = false });
+            continue;
+        }
+        if (lo < own) try out.append(a, .{ .rank = 0, .off = lo, .len = @min(hi, own) - lo, .shared = false });
+        if (hi > own) try out.append(a, .{ .rank = 0, .off = @max(lo, own), .len = hi - @max(lo, own), .shared = true });
+    }
+    if (off + len > start) return error.SnapshotShape;
+}
+
+/// Copies between `host` and image bytes [off, off + host.len) of a lease: out (lease to host) or in.
+pub const Copy = struct {
+    d: *const cuda.Driver,
+    pool: *const pages.Pool,
+    lease: *const pages.Lease,
+    segs: []const Seg,
+    words: *[6]u64,
+
+    pub fn run(c: Copy, off: u64, host: []u8, out: bool) !void {
+        const end = off + host.len;
+        for (c.segs) |s| {
+            const lo = @max(off, s.img);
+            const hi = @min(end, s.img + s.len);
+            if (lo >= hi) continue;
+            const h = host[@intCast(lo - off)..][0..@intCast(hi - lo)];
+            switch (s.from) {
+                .words => {
+                    const w = std.mem.asBytes(c.words)[@intCast(lo - s.img)..][0..h.len];
+                    if (out) @memcpy(h, w) else @memcpy(w, h);
+                },
+                .zeros => if (out) @memset(h, 0),
+                .lease => |at| try c.leased(at + (lo - s.img), h, out),
+            }
+        }
+    }
+
+    /// Lease bytes from `at`, a page at a time (each page is a run of the snapshot arena).
+    fn leased(c: Copy, at: u64, host: []u8, out: bool) !void {
+        const arena = c.pool.arena orelse return error.NoSnapshotRoom;
+        if (at + host.len > c.lease.ids.items.len * pages.page) return error.SnapshotSize;
+        var done: usize = 0;
+        while (done < host.len) {
+            const x = at + done;
+            const n = @min(host.len - done, pages.page - x % pages.page);
+            const dev = arena.ptr() + @as(u64, c.lease.ids.items[@intCast(x / pages.page)]) * pages.page + x % pages.page;
+            const p = host[done..][0..n];
+            if (out) {
+                try c.d.check(c.d.api.cuMemcpyDtoH_v2(p.ptr, dev, n), "cuMemcpyDtoH");
+            } else try c.d.check(c.d.api.cuMemcpyHtoD_v2(dev, p.ptr, n), "cuMemcpyHtoD");
+            done += n;
+        }
+    }
+};
+
+test {
+    _ = @import("cuda_disk_image_test.zig");
+}
diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
new file mode 100644
index 000000000..fea37bd00
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -0,0 +1,270 @@
+//! GLM's disk image on a driver whose device memory is host memory: sizes against the snapshot plan, a round trip.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("cuda_weights.zig");
+const shard = @import("cuda_shard.zig");
+const image = @import("cuda_disk_image.zig");
+const State = @import("cuda_state.zig").State;
+const Plan = @import("cuda_snapshot_layout.zig").Plan;
+const pages = @import("cuda_snapshot_pages.zig");
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+const expectError = std.testing.expectError;
+
+/// Device addresses are host addresses: allocations from the page allocator, copies and fills as memcpy and memset.
+const H = struct {
+    var held: [16]struct { ptr: u64 = 0, len: usize = 0 } = @splat(.{});
+    fn bytes(p: u64, n: usize) []u8 {
+        return @as([*]u8, @ptrFromInt(p))[0..n];
+    }
+    fn alloc(out: *u64, n: usize) callconv(.c) cuda.abi.Result {
+        const m = std.heap.page_allocator.alloc(u8, n) catch return 2;
+        for (&held) |*h| if (h.ptr == 0) {
+            h.* = .{ .ptr = @intFromPtr(m.ptr), .len = n };
+            out.* = h.ptr;
+            return 0;
+        };
+        std.heap.page_allocator.free(m);
+        return 2;
+    }
+    fn free(p: u64) callconv(.c) cuda.abi.Result {
+        for (&held) |*h| if (h.ptr == p) {
+            std.heap.page_allocator.free(bytes(h.ptr, h.len));
+            h.* = .{};
+            return 0;
+        };
+        return 1;
+    }
+    fn set(p: u64, v: u8, n: usize) callconv(.c) cuda.abi.Result {
+        @memset(bytes(p, n), v);
+        return 0;
+    }
+    fn dtod(dst: u64, src: u64, n: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        @memcpy(bytes(dst, n), bytes(src, n));
+        return 0;
+    }
+    fn dtoh(dst: ?*anyopaque, src: u64, n: usize) callconv(.c) cuda.abi.Result {
+        @memcpy(@as([*]u8, @ptrCast(dst.?))[0..n], bytes(src, n));
+        return 0;
+    }
+    fn htod(dst: u64, src: ?*const anyopaque, n: usize) callconv(.c) cuda.abi.Result {
+        @memcpy(bytes(dst, n), @as([*]const u8, @ptrCast(src.?))[0..n]);
+        return 0;
+    }
+    fn wait(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8_v2 = set;
+        d.api.cuMemcpyDtoDAsync_v2 = dtod;
+        d.api.cuMemcpyDtoH_v2 = dtoh;
+        d.api.cuMemcpyHtoD_v2 = htod;
+        d.api.cuStreamSynchronize = wait;
+        return d;
+    }
+};
+
+const capacity = 6144; // past the index rings' 4,096 rows, so a state at the end holds a full ring
+
+/// TP=2 rank 0's shapes on KDA, DSA, KDA, DSA layers.
+const Model = struct {
+    layers: [4]weights.Layer,
+    w: weights.Weights,
+
+    fn init(m: *Model) !void {
+        for (&m.layers, [_]bool{ false, true, false, true }) |*l, mla| l.mixer = if (mla) .{ .mla = undefined } else .{ .kda = undefined };
+        m.w = undefined;
+        m.w.config = .{};
+        m.w.share = try shard.Share.of(&m.w.config, 0, 2);
+        m.w.layers = &m.layers;
+    }
+};
+
+test "GLM disk image: the lease bytes the image counts are the snapshot plan's, at each position and head length" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    for ([_]bool{ false, true }) |kv8| {
+        var st = try State.initFormat(std.testing.allocator, &d, &m.w, capacity, kv8);
+        defer st.deinit();
+        for ([_]bool{ false, true }) |head| {
+            const sh = try image.Shape.of(&st, &m.w.config, capacity, head);
+            for ([_]u32{ 2048, 4096, 6144 }) |at| {
+                for ([_]u64{ at - 1, at, sh.headRows(at) }) |mtp| {
+                    const plan = try Plan.init(&st, &m.w.config, at, if (head) mtp else null);
+                    try expectEqual(@as(u64, plan.len), image.leaseBytes(sh, at, if (head) mtp else 0));
+                }
+            }
+        }
+    }
+}
+
+test "GLM disk image: the store's rows are by position from 0 in whole blocks; rings, pools in progress and the head are its own" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    var st = try State.initFormat(std.testing.allocator, &d, &m.w, capacity, true);
+    defer st.deinit();
+    const sh = try image.Shape.of(&st, &m.w.config, capacity, true);
+    const a = std.testing.allocator;
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(a);
+    const at: u32 = 6144;
+    try image.parts(sh, at, &list, a);
+    try image.segments(sh, at, at, &segs, a);
+    var total: u64 = 0;
+    var rows: usize = 0;
+    for (list.items) |p| {
+        total += p.bytes;
+        if (p.row == 0) continue;
+        rows += 1;
+        try expect(256 % p.per == 0);
+        try expectEqual(@as(u64, at / p.per) * p.row, p.bytes); // a pooled part counts the whole pools alone
+    }
+    try expectEqual(@as(usize, 3 * 2), rows); // each DSA layer's latent rows, scales and whole pools
+    const last = segs.items[segs.items.len - 1];
+    try expectEqual(total, last.img + last.len);
+    try expectEqual(@as(u64, 2 * 256), list.items[7].bytes); // layer 0's pools past `at`: the spare rows
+    try expectError(error.SnapshotShape, image.segments(sh, at, sh.headRows(at) + 1, &segs, a));
+}
+
+test "GLM disk image: a kept state's image read out of its lease restores every planned byte into another sequence" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    const c = &m.w.config;
+    var st = try State.initFormat(a, &d, &m.w, capacity, false);
+    defer st.deinit();
+    for (H.bytes(st.arena.buf.ptr, st.arena.buf.len), 0..) |*b, i| b.* = @truncate(i *% 31 +% 7);
+    var pool = try pages.Pool.init(a, &d, 64 << 20);
+    defer pool.deinit();
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    const at: u32 = 2048;
+    const mtp: u64 = at - 1; // a head one row behind: its last image row is not in the lease
+    const sh = try image.Shape.of(&st, c, capacity, true);
+    const plan = try Plan.init(&st, c, at, mtp);
+    var kept = try pool.take(plan.len);
+    defer pool.give(&kept);
+    try pool.move(stream, &kept, &plan, true);
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(a);
+    try image.segments(sh, at, mtp, &segs, a);
+    const last = segs.items[segs.items.len - 1];
+    const img = try a.alloc(u8, @intCast(last.img + last.len));
+    defer a.free(img);
+    var words = (image.Words{ .at = at, .mtp_len = mtp, .base = 0, .mtp_base = 0, .cur = 0b10 }).encode();
+    const out: image.Copy = .{ .d = &d, .pool = &pool, .lease = &kept, .segs = segs.items, .words = &words };
+    const cut = [_]u64{ 0, 1000, plan.len / 2, img.len }; // the store asks for ranges, not the whole image
+    for (cut[0..3], cut[1..]) |lo, hi| try out.run(lo, img[@intCast(lo)..@intCast(hi)], true);
+    for (segs.items) |s| if (s.from == .zeros) for (img[@intCast(s.img)..][0..@intCast(s.len)]) |b| try expectEqual(@as(u8, 0), b);
+    // a blank state as a disk read takes it (room for the head's whole window), filled from the image
+    var blank = try pool.take(@intCast(image.leaseBytes(sh, at, sh.headRows(at))));
+    defer pool.give(&blank);
+    var back: [6]u64 = undefined;
+    const in: image.Copy = .{ .d = &d, .pool = &pool, .lease = &blank, .segs = segs.items, .words = &back };
+    try in.run(0, img, false);
+    const w = try image.Words.decode(back, at);
+    try expectEqual(mtp, w.mtp_len);
+    try expectEqual(@as(u64, 0b10), w.cur);
+    try expectError(error.DiskWords, image.Words.decode(back, at + 2048));
+    var fresh = try State.initFormat(a, &d, &m.w, capacity, false);
+    defer fresh.deinit();
+    const into = try Plan.init(&fresh, c, at, w.mtp_len);
+    try expectEqual(plan.len, into.len);
+    try pool.move(stream, &blank, &into, false);
+    for (plan.parts[0..plan.count], into.parts[0..into.count]) |x, y| {
+        try std.testing.expectEqualSlices(u8, H.bytes(x.live, x.len), H.bytes(y.live, y.len));
+    }
+}
+
+test "GLM disk image: the store's image is rank 0's then each other rank's prefix, and routes every byte once" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    var st = try State.initFormat(a, &d, &m.w, capacity, true);
+    defer st.deinit();
+    const sh = try image.Shape.of(&st, &m.w.config, capacity, true);
+    const at: u32 = 4096;
+    const prefixes = [_]u64{ sh.prefix, sh.prefix - 4096, sh.prefix + 512 }; // TP=3: heads one by one
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    try image.storeParts(sh, &prefixes, at, &list, a);
+    var total: u64 = 0;
+    for (list.items) |p| total += p.bytes;
+    try expectEqual(image.imageBytes(sh, at) + prefixes[1] + prefixes[2], total);
+    var pieces: std.ArrayList(image.Piece) = .empty;
+    defer pieces.deinit(a);
+    var seen: [3]u64 = .{ 0, 0, 0 };
+    var shared: u64 = 0;
+    const cuts = [_]u64{ 0, 40, image.Words.bytes + sh.prefix - 8, image.imageBytes(sh, at) + 100, total }; // ranges across the seams
+    for (cuts[0 .. cuts.len - 1], cuts[1..]) |lo, hi| {
+        pieces.clearRetainingCapacity();
+        try image.route(sh, &prefixes, at, lo, hi - lo, &pieces, a);
+        var n: u64 = 0;
+        for (pieces.items) |p| {
+            n += p.len;
+            seen[p.rank] += p.len;
+            if (p.shared) shared += p.len;
+            if (p.rank > 0) try expect(p.off >= image.Words.bytes and p.off + p.len <= image.Words.bytes + prefixes[p.rank] and !p.shared);
+            if (p.shared) try expect(p.rank == 0 and p.off >= image.Words.bytes + sh.prefix);
+        }
+        try expectEqual(hi - lo, n);
+    }
+    try expectEqual(image.imageBytes(sh, at), seen[0]);
+    try expectEqual(prefixes[1], seen[1]);
+    try expectEqual(prefixes[2], seen[2]);
+    try expectEqual(image.imageBytes(sh, at) - image.Words.bytes - sh.prefix, shared);
+    try expectError(error.SnapshotShape, image.route(sh, &prefixes, at, total - 4, 8, &pieces, a));
+}
+
+/// The fields of an engine the kept-state functions read, over a host-memory driver.
+const Fake = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    c: @import("config.zig").Config,
+    cur: struct { st: State, in_head: usize = 0 },
+    capacity: usize = capacity,
+    mtp: bool = true,
+    snaps: std.AutoHashMapUnmanaged(u64, @import("cuda_engine_types.zig").Snap) = .empty,
+    snap_pages: ?pages.Pool = null,
+};
+
+test "GLM disk image: a disk read's blank state is refused until sealed, and its seal checks the words" {
+    const snaps = @import("cuda_snapshots.zig");
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    var e: Fake = .{ .gpa = a, .d = &d, .stream = .{ .d = &d, .handle = null }, .c = m.w.config, .cur = .{ .st = try State.initFormat(a, &d, &m.w, capacity, false) } };
+    defer e.cur.st.deinit();
+    e.snap_pages = try pages.Pool.init(a, &d, 256 << 20);
+    defer e.snap_pages.?.deinit();
+    try e.snaps.ensureTotalCapacity(a, 8);
+    defer e.snaps.deinit(a);
+    const at: u32 = 2048;
+    try snaps.blankAs(&e, 7, at);
+    defer {
+        var s = e.snaps.get(7).?;
+        snaps.free(&e, &s);
+    }
+    try expectError(error.StateKept, snaps.blankAs(&e, 7, at));
+    try expectError(error.UnsealedState, snaps.restore(&e, 7));
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at + 9, .{ 0, 0 }, 0)); // a head past its verify window
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at, .{ 0, 0 }, @as(u64, 1) << @intCast(e.cur.st.cur.len))); // a copy bit no layer has
+    try snaps.seal(&e, 7, at - 1, .{ 3, 5 }, 0b01);
+    const s = e.snaps.get(7).?;
+    const sh = try image.Shape.of(&e.cur.st, &e.c, capacity, true);
+    try expectEqual(image.leaseBytes(sh, at, at - 1), @as(u64, s.len));
+    try expectEqual(@as(usize, at - 1), s.mtp_len);
+    try expectEqual([2]usize{ 3, 5 }, s.bases);
+    try std.testing.expectEqualSlices(u1, &.{ 1, 0 }, s.cur);
+    try expectError(error.StateKept, snaps.seal(&e, 7, at, .{ 0, 0 }, 0));
+}
diff --git a/zig/src/families/glm/cuda_disk_ranks.zig b/zig/src/families/glm/cuda_disk_ranks.zig
new file mode 100644
index 000000000..975b025d1
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_ranks.zig
@@ -0,0 +1,152 @@
+//! A GLM kept state's disk image across ranks: rank 0's engine thread leases, fills, reads and seals each rank's copy.
+const std = @import("std");
+const follow = @import("cuda_follow.zig");
+const image = @import("cuda_disk_image.zig");
+const Engine = @import("cuda_engine.zig").Engine;
+
+/// A disk step's op (Header.flags); its id is `a`, its image offset `seed`, its bytes `depth`, its rank `top_k`.
+pub const Op = enum(u32) { blank = 1, put, take, seal, prefixes };
+const kind = @backingInt(follow.Kind.disk); // each op crosses the follow link as a disk step, its bytes as the ids
+
+/// This rank's image shape (every sequence of the engine has the same).
+pub fn shape(e: *const Engine) !image.Shape {
+    return image.Shape.of(&e.cur.st, &e.c, e.capacity, e.mtp);
+}
+
+/// The words of a kept state on this rank: its position, head rows, ring bases and KDA copy bits.
+pub fn wordsOf(e: *const Engine, id: u64) !image.Words {
+    const s = e.snaps.get(id) orelse return error.NoKeptState;
+    if (s.cur.len > 64) return error.SnapshotShape;
+    var cur: u64 = 0;
+    for (s.cur, 0..) |b, i| cur |= @as(u64, b) << @intCast(i);
+    return .{ .at = s.pos, .mtp_len = s.mtp_len, .base = s.bases[0], .mtp_base = s.bases[1], .cur = cur };
+}
+
+/// Bytes [off, off + host.len) of this rank's image of `id`, out (lease to host) or in; unsealed: before its head only.
+pub fn copy(e: *Engine, id: u64, off: u64, host: []u8, out: bool) !void {
+    const s = e.snaps.get(id) orelse return error.NoKeptState;
+    const sh = try shape(e);
+    const at: u32 = @intCast(s.pos);
+    if (s.len == 0 and off + host.len > image.Words.bytes + image.front(sh, at)) return error.DiskOrder;
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(e.gpa);
+    try image.segments(sh, at, s.mtp_len, &segs, e.gpa);
+    var w = (try wordsOf(e, id)).encode();
+    const pool = if (e.snap_pages) |*p| p else return error.NoSnapshotCache;
+    try (image.Copy{ .d = e.d, .pool = pool, .lease = &s.lease, .segs = segs.items, .words = &w }).run(off, host, out);
+}
+
+/// Rank 0's link at TP, else null (one rank: every op is local).
+fn leader(e: *Engine) ?follow.Leader {
+    const l = e.link orelse return null;
+    return .{ .e = e, .link = @ptrCast(@alignCast(l)) };
+}
+
+/// Rank 0: whether the other ranks sleep on their lines (no stream), and putting them back to sleep after disk steps.
+pub fn asleep(e: *Engine) bool {
+    return if (leader(e)) |x| x.link.asleep else false;
+}
+
+pub fn rest(e: *Engine) !void {
+    if (leader(e)) |x| try x.idle();
+}
+
+/// Rank 0: a new id leased at `at` on every rank (rank 0 first: the ranks' pools match, so theirs cannot fail apart).
+pub fn blank(e: *Engine, at: u32) !u64 {
+    if (e.next_snap > std.math.maxInt(u32)) return error.SnapshotIdLimit;
+    const id = e.next_snap;
+    try e.blankAs(id, at);
+    e.next_snap += 1;
+    if (leader(e)) |x| try x.disk(.{ .kind = kind, .flags = @backingInt(Op.blank), .a = id, .seed = at }, &.{});
+    return id;
+}
+
+/// Rank 0: `bytes` into rank `rank`'s image of `id` at `off` (rank 0's own lease, or through the link in pieces).
+pub fn put(e: *Engine, rank: u32, id: u64, off: u64, bytes: []const u8) !void {
+    if (rank == 0) return copy(e, id, off, @constCast(bytes), false);
+    const x = leader(e) orelse return error.NoRank;
+    const room = x.link.ids.len * 4;
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = @min(room, bytes.len - done);
+        const words = (n + 3) / 4;
+        @memcpy(std.mem.sliceAsBytes(x.link.ids[0..words])[0..n], bytes[done..][0..n]);
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.put), .a = id, .seed = off + done, .depth = @intCast(n), .top_k = rank }, x.link.ids[0..words]);
+        done += n;
+    }
+}
+
+/// Rank 0: rank `rank`'s image bytes of `id` from `off` into `out`.
+pub fn take(e: *Engine, rank: u32, id: u64, off: u64, out: []u8) !void {
+    if (rank == 0) return copy(e, id, off, out, true);
+    const x = leader(e) orelse return error.NoRank;
+    const room = x.link.ids.len * 4;
+    var done: usize = 0;
+    while (done < out.len) {
+        const n = @min(room, out.len - done);
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.take), .a = id, .seed = off + done, .depth = @intCast(n), .top_k = rank }, &.{});
+        try x.link.from(rank, n);
+        try x.link.buf.download(64, out[done..][0..n]);
+        done += n;
+    }
+}
+
+/// Rank 0: every rank's blank `id` sealed with `w` (its head's rows, ring bases and KDA copy bits).
+pub fn seal(e: *Engine, id: u64, w: image.Words) !void {
+    try e.sealState(id, w.mtp_len, .{ w.base, w.mtp_base }, w.cur);
+    if (leader(e)) |x| {
+        const words = w.encode();
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.seal), .a = id }, std.mem.bytesAsSlice(u32, std.mem.sliceAsBytes(&words)));
+    }
+}
+
+/// Rank 0: every rank's prefix bytes in rank order (the part of a state each rank holds alone).
+pub fn prefixes(e: *Engine, out: []u64) !void {
+    const mine = (try shape(e)).prefix;
+    const x = leader(e) orelse {
+        if (out.len != 1) return error.NoRank;
+        out[0] = mine;
+        return;
+    };
+    try x.disk(.{ .kind = kind, .flags = @backingInt(Op.prefixes) }, &.{});
+    try gather(x.link, e, mine, out);
+}
+
+fn gather(l: *follow.Link, e: *const Engine, mine: u64, out: []u64) !void {
+    try @import("cuda_ranks.zig").gather(u64, l.d, l.lib, l.comm, l.stream, e.share.rank, mine, out);
+}
+
+/// A rank other than 0: rank 0's disk step on this rank's copy of its state.
+pub fn step(e: *Engine, l: *follow.Link, h: follow.Header, ids: []const u32) !void {
+    if (h.flags < @backingInt(Op.blank) or h.flags > @backingInt(Op.prefixes)) return error.BadStep;
+    const op: Op = @fromBackingInt(h.flags);
+    const rank: u32 = @intCast(e.share.rank);
+    switch (op) {
+        .blank => try e.blankAs(h.a, @intCast(h.seed)),
+        .seal => {
+            if (ids.len != 12) return error.BadStep;
+            var x: [6]u64 = undefined;
+            @memcpy(std.mem.sliceAsBytes(&x), std.mem.sliceAsBytes(ids));
+            const w = try image.Words.decode(x, @intCast((e.snaps.get(h.a) orelse return error.NoKeptState).pos));
+            try e.sealState(h.a, w.mtp_len, .{ w.base, w.mtp_base }, w.cur);
+        },
+        .put => if (h.top_k == rank) {
+            if (h.depth > ids.len * 4) return error.BadStep;
+            try copy(e, h.a, h.seed, @constCast(std.mem.sliceAsBytes(ids))[0..h.depth], false);
+        },
+        .take => {
+            if (h.depth > l.ids.len * 4) return error.BadStep;
+            if (h.top_k == rank) {
+                const host = std.mem.sliceAsBytes(l.ids)[0..h.depth];
+                try copy(e, h.a, h.seed, host, true);
+                try l.buf.uploadAsync(64, host, l.stream.handle);
+            }
+            try l.from(h.top_k, h.depth);
+        },
+        .prefixes => {
+            var out: [64]u64 = undefined;
+            if (e.share.world > out.len) return error.BadStep;
+            try gather(l, e, (try shape(e)).prefix, out[0..e.share.world]);
+        },
+    }
+}
diff --git a/zig/src/families/glm/cuda_draw1.zig b/zig/src/families/glm/cuda_draw1.zig
new file mode 100644
index 000000000..beeeb6942
--- /dev/null
+++ b/zig/src/families/glm/cuda_draw1.zig
@@ -0,0 +1,179 @@
+//! TF_GLM_OVN_DRAW1: a verify's rows, or every part's of a shared round, drawn with one exchange a kind and one sync.
+const std = @import("std");
+const cuda = @import("cuda");
+const sampler = @import("cuda_sampler.zig");
+const ranks = @import("cuda_ranks.zig");
+const engine = @import("cuda_engine.zig");
+const Engine = engine.Engine;
+
+/// sample.cu's candidate cap (tf_sample::C): a top_k past it draws from whole rows as before.
+pub const max_k = 1024;
+const rows_max = engine.shared_rows;
+const pair_bytes = 16;
+
+/// A draw's per-row words as one upload: each sampled row's rule, its position less one, its logits row.
+const Ctl = extern struct { rules: [rows_max]sampler.Rule, metas: [rows_max]i32, src: [rows_max]u32 };
+
+/// One part's rows: logits rows row0.. of the draw's buffer, tokens at first, first + 1, ...; null sampling: greedy.
+pub const Part = struct { row0: usize, rows: usize, first: u64, sampling: ?sampler.Sampling, out: []u32 };
+
+/// Whether a part's rule draws here: greedy, or a top_k inside the candidate cap.
+pub fn takes(s: ?sampler.Sampling) bool {
+    const x = s orelse return true;
+    return x.top_k > 0 and x.top_k <= max_k;
+}
+
+pub const Draw1 = struct {
+    top1_rows: cuda.Function,
+    cands: cuda.Function,
+    place: cuda.Function,
+    draw_rows: cuda.Function,
+    picks: cuda.DeviceBuffer, // greedy: [world][rows] (value bits, id, 0, 0)
+    cand: cuda.DeviceBuffer, // sampled: [world][rows][k] (bf16 bits, id) word pairs
+    full: cuda.DeviceBuffer, // bf16 [rows][vocab]: -inf but the gathered candidates
+    ctl: cuda.DeviceBuffer, // Ctl
+    tok: cuda.DeviceBuffer, // u32 [rows]
+
+    /// Made at load with the knob on; glm_glue is the forward's module 6 (fw.Modules.load's order).
+    pub fn init(e: *Engine) !Draw1 {
+        const d = e.d;
+        const world = e.share.world;
+        var x: Draw1 = undefined;
+        x.top1_rows = try e.m.mods[6].function("tf_glm_top1_rows");
+        x.cands = try e.smp.module.function("tf_draw_cands");
+        x.place = try e.smp.module.function("tf_draw_place");
+        x.draw_rows = try e.smp.module.function("tf_draw_rows");
+        x.picks = try cuda.DeviceBuffer.alloc(d, world * rows_max * pair_bytes);
+        errdefer x.picks.free();
+        try x.picks.fill8(0, null); // each pick's padding stays zero
+        x.cand = try cuda.DeviceBuffer.alloc(d, world * rows_max * max_k * 8);
+        errdefer x.cand.free();
+        x.full = try cuda.DeviceBuffer.alloc(d, rows_max * e.c.vocab * 2);
+        errdefer x.full.free();
+        x.ctl = try cuda.DeviceBuffer.alloc(d, @sizeOf(Ctl));
+        errdefer x.ctl.free();
+        x.tok = try cuda.DeviceBuffer.alloc(d, rows_max * 4);
+        return x;
+    }
+
+    pub fn deinit(x: *Draw1) void {
+        x.tok.free();
+        x.ctl.free();
+        x.full.free();
+        x.cand.free();
+        x.picks.free();
+    }
+};
+
+/// Every rank's `bytes` at base + rank * bytes into every rank's base, rank order (the greedy pick's gather).
+fn gather(e: *Engine, base: u64, bytes: usize) !void {
+    const mine = base + e.share.rank * bytes;
+    if (e.group) |g| return g.allGather(e.stream, mine, base, bytes);
+    try e.lib.check(e.lib.api.ncclAllGather(mine, base, bytes, .u8, e.comm, e.stream.handle), "ncclAllGather");
+}
+
+/// `parts` (each `takes` its rule; no grammar) from `logits` (this rank's bf16 [rows][span]): every rank, same parts.
+pub fn draw(e: *Engine, logits: u64, parts: []const Part) !void {
+    const x = &e.draw1.?;
+    const world = e.share.world;
+    const span = e.share.vocab.len();
+    var greedy_rows: usize = 0; // the top1 launch covers rows 0 .. the last greedy part's end
+    var n: usize = 0; // sampled rows
+    var k: u32 = 0;
+    var ctl: Ctl = undefined;
+    for (parts) |p| {
+        if (p.rows == 0 or p.row0 + p.rows > rows_max or p.first < 1) return error.BadDraw;
+        const s = p.sampling orelse {
+            greedy_rows = @max(greedy_rows, p.row0 + p.rows);
+            continue;
+        };
+        const r = sampler.rule(s);
+        for (0..p.rows) |j| {
+            ctl.rules[n] = r;
+            ctl.metas[n] = @intCast(p.first - 1 + j); // tf_draw_rows keys row n at metas[n] + 1
+            ctl.src[n] = @intCast(p.row0 + j);
+            n += 1;
+        }
+        k = @max(k, s.top_k);
+    }
+    if (greedy_rows > 0) {
+        var a: cuda.Args = .{};
+        a.add(logits);
+        a.add(@as(i64, @intCast(span)));
+        a.add(@as(u32, @intCast(e.share.vocab.lo)));
+        a.add(@as(i64, @intCast(span))); // the rows' stride
+        a.add(x.picks.ptr + e.share.rank * greedy_rows * pair_bytes);
+        try cuda.launch.launch(x.top1_rows, .{ .grid = .{ .x = @intCast(greedy_rows) }, .block = .{ .x = 1024 } }, e.stream, &a);
+        try gather(e, x.picks.ptr, greedy_rows * pair_bytes);
+    }
+    if (n > 0) {
+        const slots = (k + 1) / 2 * 2; // even, so a rank's candidates are whole 16-byte packs for the RoCE gather
+        const per = n * slots * 8; // one rank's candidates
+        try x.ctl.uploadAsync(0, std.mem.asBytes(&ctl), e.stream.handle);
+        var a: cuda.Args = .{};
+        a.add(logits);
+        a.add(@as(u32, @intCast(span)));
+        a.add(@as(u32, @intCast(e.share.vocab.lo)));
+        a.add(x.ctl.ptr + @offsetOf(Ctl, "rules"));
+        a.add(x.ctl.ptr + @offsetOf(Ctl, "src"));
+        a.add(slots);
+        a.add(x.cand.ptr + e.share.rank * per);
+        try cuda.launch.launch(x.cands, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, e.stream, &a);
+        try gather(e, x.cand.ptr, per);
+        var b: cuda.Args = .{};
+        b.add(x.cand.ptr);
+        b.add(@as(u32, @intCast(world)));
+        b.add(@as(u32, @intCast(n)));
+        b.add(slots);
+        b.add(x.full.ptr);
+        b.add(@as(u32, @intCast(e.c.vocab)));
+        try cuda.launch.launch(x.place, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, e.stream, &b);
+        var c: cuda.Args = .{};
+        c.add(x.full.ptr);
+        c.add(@as(u32, @intCast(e.c.vocab)));
+        c.add(x.ctl.ptr + @offsetOf(Ctl, "rules"));
+        c.add(x.ctl.ptr + @offsetOf(Ctl, "metas"));
+        c.add(x.tok.ptr);
+        try cuda.launch.launch(x.draw_rows, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, e.stream, &c);
+    }
+    try e.stream.synchronize();
+    try e.checkGathers(); // the picks and candidates are gathered rows
+    var all: [ranks.max_world * rows_max][4]u32 = undefined; // Engine.init refuses a larger world
+    if (greedy_rows > 0) try e.d.check(e.d.api.cuMemcpyDtoH_v2(&all, x.picks.ptr, world * greedy_rows * pair_bytes), "cuMemcpyDtoH");
+    var tok: [rows_max]u32 = undefined;
+    if (n > 0) try x.tok.download(0, std.mem.sliceAsBytes(tok[0..n]));
+    var m: usize = 0;
+    for (parts) |p| {
+        if (p.sampling != null) {
+            @memcpy(p.out[0..p.rows], tok[m..][0..p.rows]);
+            m += p.rows;
+            continue;
+        }
+        for (0..p.rows) |j| p.out[j] = pick(all[0 .. world * greedy_rows], greedy_rows, p.row0 + j);
+    }
+}
+
+/// cuda_engine_pick.greedy's rule over the ranks' picks of `row` (rank q's at q * rows + row): the largest value,
+fn pick(all: []const [4]u32, rows: usize, row: usize) u32 {
+    var best = all[row];
+    var q: usize = rows + row;
+    while (q < all.len) : (q += rows) {
+        const p = all[q];
+        const v: f32 = @bitCast(p[0]);
+        const b: f32 = @bitCast(best[0]);
+        if (v > b or (v == b and p[1] < best[1])) best = p;
+    }
+    return best[1];
+}
+
+test "the ranks' greedy picks: largest value, then the lowest id, as cuda_engine_pick" {
+    const f = struct {
+        fn w(v: f32, id: u32) [4]u32 {
+            return .{ @bitCast(v), id, 0, 0 };
+        }
+    }.w;
+    // three ranks of two rows: row 0 ties at 2.0 (ids 9 and 4), row 1's best is rank 2's
+    const all = [_][4]u32{ f(2.0, 9), f(1.0, 1), f(2.0, 4), f(0.5, 100), f(1.0, 7), f(3.0, 200) };
+    try std.testing.expectEqual(@as(u32, 4), pick(&all, 2, 0));
+    try std.testing.expectEqual(@as(u32, 200), pick(&all, 2, 1));
+}
