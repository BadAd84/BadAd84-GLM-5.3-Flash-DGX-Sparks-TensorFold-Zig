diff --git a/zig/src/core/template/watch.zig b/zig/src/core/template/watch.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c6c9084f6c5851dda3147e11b05550b8c8b8bbdd
--- /dev/null
+++ b/zig/src/core/template/watch.zig
@@ -0,0 +1,29 @@
+//! A render that stops once its output has run `slack` bytes past where it first differs from a reference text.
+const std = @import("std");
+const v = @import("value.zig");
+
+/// Output is append-only, so a stopped render's text and spans are a prefix of the full render's.
+pub const Watch = struct {
+    against: []const u8,
+    slack: usize,
+    out: ?*const v.Buffer = null,
+    diverged: ?usize = null,
+    stopped: bool = false,
+
+    /// The root output grew from `from` bytes: fails the render, stopped, once it is `slack` past the difference.
+    pub fn grew(w: *Watch, rt: *v.Rt, out: *const v.Buffer, from: usize) v.Error!void {
+        const text = out.text.items;
+        if (w.diverged == null) {
+            const ref = w.against[@min(from, w.against.len)..];
+            const new = text[from..];
+            const n = @min(new.len, ref.len);
+            if (std.mem.indexOfDiff(u8, new[0..n], ref[0..n])) |i| {
+                w.diverged = from + i;
+            } else if (new.len > ref.len) w.diverged = from + ref.len;
+        }
+        const d = w.diverged orelse return;
+        if (text.len < d + w.slack) return;
+        w.stopped = true;
+        return rt.fail("render stopped {d} bytes past its first difference", .{w.slack});
+    }
+};
diff --git a/zig/src/core/tokenizer/kept.zig b/zig/src/core/tokenizer/kept.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5ecac15be9e77639381add3ba2078da93c7ae1a0
--- /dev/null
+++ b/zig/src/core/tokenizer/kept.zig
@@ -0,0 +1,160 @@
+//! Ids kept with their added-token segments: a later text reuses the ids of the segments it repeats, unencoded.
+const std = @import("std");
+const tok = @import("tokenizer.zig");
+const steps = @import("steps.zig");
+const memo = @import("memo.zig");
+const Allocator = std.mem.Allocator;
+const Span = tok.Span;
+const Segment = tok.Segment;
+
+/// `ids` equal encodeMasked(text, spans); no segments when nothing can be reused (no spans, or lossy UTF-8).
+pub const Kept = struct {
+    text: []const u8,
+    spans: []const Span,
+    segs: []const Segment = &.{},
+    starts: []const usize = &.{},
+    ids: []const u32,
+};
+
+/// Ids whose concatenation `head ++ mid ++ tail` is encodeMasked(text, spans): kept, encoded, kept.
+pub const Pieces = struct {
+    head: []const u32 = &.{},
+    mid: []const u32 = &.{},
+    tail: []const u32 = &.{},
+};
+
+/// Only valid UTF-8 with request spans splits as encodeMasked does without a lossy copy.
+fn reusable(text: []const u8, spans: []const Span) bool {
+    return spans.len > 0 and std.unicode.utf8ValidateSlice(text);
+}
+
+/// Each segment's ids in order, its first id's index in `starts` when given; a segment's ids depend on it alone.
+pub fn encodeSegments(t: *const tok.Tokenizer, ctx: *steps.Context, text: []const u8, spans: []const Span, segs: []const Segment, ids: *std.ArrayList(u32), starts: ?[]usize, work: ?*tok.MaskWork) tok.Error!void {
+    var cursor: usize = 0;
+    for (segs, 0..) |seg, n| {
+        if (starts) |s| s[n] = ids.items.len;
+        if (seg.id) |id| {
+            try ids.append(ctx.a, id);
+            continue;
+        }
+        if (seg.start == seg.end) continue;
+        while (cursor < spans.len and spans[cursor][1] <= seg.start) {
+            cursor += 1;
+            if (work) |w| w.spans += 1;
+        }
+        const request = cursor < spans.len and spans[cursor][0] < seg.end;
+        const gap = text[seg.start..seg.end];
+        if (!request or t.normalized.ends.items.len == 0) {
+            const from = ids.items.len;
+            try t.encodeSegment(ctx, gap, seg.start == 0, ids);
+            if (request) try t.refuseAdded(ids.items[from..]);
+        } else {
+            // A cached gap with this text may have been encoded using a different mask.
+            var clipped: std.ArrayList(Span) = .empty;
+            var j = cursor;
+            while (j < spans.len and spans[j][0] < seg.end) : (j += 1) {
+                const p = spans[j];
+                try clipped.append(ctx.a, .{ @max(seg.start, p[0]) - seg.start, @min(seg.end, p[1]) - seg.start });
+                if (work) |w| w.spans += 1;
+            }
+            try t.encodeTextMasked(ctx, gap, seg.start == 0, ids, true, clipped.items);
+        }
+    }
+    if (starts) |s| s[segs.len] = ids.items.len;
+}
+
+/// encodeMasked(text, spans) with the segments and each segment's first id index; slices of `text` and `spans` kept.
+pub fn keep(t: *const tok.Tokenizer, a: Allocator, text: []const u8, spans: []const Span) tok.Error!Kept {
+    if (!reusable(text, spans)) return .{ .text = text, .spans = spans, .ids = try t.encodeMasked(a, text, spans) };
+    try tok.checkSpans(text, spans, null);
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    var ctx = steps.Context{ .a = arena.allocator(), .matcher = .{ .a = arena.allocator() } };
+    const segs = try a.dupe(Segment, try t.segments(&ctx, text, spans));
+    const starts = try a.alloc(usize, segs.len + 1);
+    var ids: std.ArrayList(u32) = .empty;
+    try encodeSegments(t, &ctx, text, spans, segs, &ids, starts, null);
+    return .{ .text = text, .spans = spans, .segs = segs, .starts = starts, .ids = try a.dupe(u32, ids.items) };
+}
+
+/// encodeMasked(text, spans) as pieces: the leading and trailing segments `kept` repeats are its ids, not re-encoded.
+pub fn pieces(t: *const tok.Tokenizer, a: Allocator, kept: *const Kept, text: []const u8, spans: []const Span) tok.Error!Pieces {
+    if (kept.segs.len == 0 or !reusable(text, spans)) return .{ .mid = try t.encodeMasked(a, text, spans) };
+    try tok.checkSpans(text, spans, null);
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    var ctx = steps.Context{ .a = arena.allocator(), .matcher = .{ .a = arena.allocator() } };
+    const segs = try t.segments(&ctx, text, spans);
+    const both = @min(kept.segs.len, segs.len);
+    var head: usize = 0;
+    while (head < both and same(kept, kept.segs[head], text, spans, segs[head])) head += 1;
+    var tail: usize = 0;
+    while (tail < both - head and same(kept, kept.segs[kept.segs.len - 1 - tail], text, spans, segs[segs.len - 1 - tail])) tail += 1;
+    var ids: std.ArrayList(u32) = .empty;
+    try encodeSegments(t, &ctx, text, spans, segs[head .. segs.len - tail], &ids, null, null);
+    return .{ .head = kept.ids[0..kept.starts[head]], .mid = try a.dupe(u32, ids.items), .tail = kept.ids[kept.starts[kept.segs.len - tail]..] };
+}
+
+/// A cut text's leading segment ids, as every longer text with its bytes and clipped spans encodes them, or null.
+pub fn prefix(t: *const tok.Tokenizer, a: Allocator, kept: *const Kept, text: []const u8, spans: []const Span) tok.Error!?Pieces {
+    if (kept.segs.len == 0 or !reusable(text, spans)) return null;
+    try tok.checkSpans(text, spans, null);
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    var ctx = steps.Context{ .a = arena.allocator(), .matcher = .{ .a = arena.allocator() } };
+    const segs = try t.segments(&ctx, text, spans);
+    // an added token no later byte can lengthen (its trie walk ends inside the text) fixes every segment up to it
+    var reach: usize = 0;
+    for (t.added) |x| reach = @max(reach, x.content.len);
+    var fixed = segs.len;
+    while (fixed > 0 and !(segs[fixed - 1].id != null and segs[fixed - 1].start + reach < text.len)) fixed -= 1;
+    if (fixed == 0) return null;
+    for (segs[0 .. fixed - 1], segs[1..fixed]) |x, y| if (x.end > y.start) return null;
+    var head: usize = 0;
+    const both = @min(kept.segs.len, fixed);
+    while (head < both and same(kept, kept.segs[head], text, spans, segs[head])) head += 1;
+    var ids: std.ArrayList(u32) = .empty;
+    try encodeSegments(t, &ctx, text, spans, segs[head..fixed], &ids, null, null);
+    return .{ .head = kept.ids[0..kept.starts[head]], .mid = try a.dupe(u32, ids.items) };
+}
+
+/// Whether two segments encode alike: the same id, or the same bytes, start-of-text flag and clipped request spans.
+fn same(kept: *const Kept, k: Segment, text: []const u8, spans: []const Span, p: Segment) bool {
+    if (k.id != null or p.id != null) return k.id != null and p.id != null and k.id.? == p.id.?;
+    if (k.end - k.start != p.end - p.start or (k.start == 0) != (p.start == 0)) return false;
+    if (!memo.equal(kept.text[k.start..k.end], text[p.start..p.end])) return false;
+    var i = firstAfter(kept.spans, k.start);
+    var j = firstAfter(spans, p.start);
+    while (true) : ({
+        i += 1;
+        j += 1;
+    }) {
+        const in_k = i < kept.spans.len and kept.spans[i][0] < k.end;
+        const in_p = j < spans.len and spans[j][0] < p.end;
+        if (in_k != in_p) return false;
+        if (!in_k) return true;
+        const a = clip(kept.spans[i], k);
+        const b = clip(spans[j], p);
+        if (a[0] != b[0] or a[1] != b[1]) return false;
+    }
+}
+
+/// The first span ending after `at` (spans are ordered and disjoint).
+fn firstAfter(spans: []const Span, at: usize) usize {
+    var lo: usize = 0;
+    var hi = spans.len;
+    while (lo < hi) {
+        const mid = lo + (hi - lo) / 2;
+        if (spans[mid][1] <= at) lo = mid + 1 else hi = mid;
+    }
+    return lo;
+}
+
+/// A span clipped to a segment, relative to its start.
+fn clip(p: Span, s: Segment) Span {
+    return .{ @max(s.start, p[0]) - s.start, @min(s.end, p[1]) - s.start };
+}
+
+test {
+    _ = @import("kept_test.zig");
+}
diff --git a/zig/src/core/tokenizer/kept_test.zig b/zig/src/core/tokenizer/kept_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8f05525c0851e379070bf9540b049948251d65d2
--- /dev/null
+++ b/zig/src/core/tokenizer/kept_test.zig
@@ -0,0 +1,169 @@
+//! Kept pieces against a fresh encodeMasked on random texts: masked added spellings, strips, merges, refusals.
+const std = @import("std");
+const tok = @import("tokenizer.zig");
+const kept = @import("kept.zig");
+const t = std.testing;
+
+// Merges span a whole gap; "<V>" is vocabulary (a request spelling it is refused); "<S>>" lengthens "<S>".
+const source =
+    \\{"added_tokens":[{"content":"<S>","special":true,"normalized":false},
+    \\{"content":"<S>>","special":true,"normalized":false},
+    \\{"content":"<L>","special":true,"normalized":false,"lstrip":true},
+    \\{"content":"<R>","special":true,"normalized":false,"rstrip":true},
+    \\{"content":"<N>","special":true,"normalized":true},
+    \\{"content":"<V>","special":true,"normalized":false}],
+    \\"model":{"type":"BPE","unk_token":"?","vocab":{"a":0,"b":1,"c":2," ":3,"<":4,">":5,"S":6,"L":7,"R":8,"N":9,
+    \\"V":10,"\n":11,"ab":12,"abc":13,"?":14,"<V":15,"<V>":16,"bc":17},"merges":["a b","ab c","b c","< V","<V >"]}}
+;
+
+const words = [_][]const u8{ "<S>", "<L>", "<R>", "<N>", "<V>", " ", "  ", "a", "b", "c", "ab", "bc", "\n", "<", "S>", ">", "\u{e9}", "\xff" };
+
+const Part = struct { word: u8, request: bool };
+
+fn text(a: std.mem.Allocator, parts: []const Part) !struct { text: []u8, spans: []tok.Span } {
+    var out: std.ArrayList(u8) = .empty;
+    var spans: std.ArrayList(tok.Span) = .empty;
+    for (parts) |p| {
+        const at = out.items.len;
+        try out.appendSlice(a, words[p.word]);
+        if (!p.request) continue;
+        // adjacent request parts are one span, as a template writes one string
+        if (spans.items.len > 0 and spans.items[spans.items.len - 1][1] == at) spans.items[spans.items.len - 1][1] = out.items.len else try spans.append(a, .{ at, out.items.len });
+    }
+    return .{ .text = out.items, .spans = spans.items };
+}
+
+fn part(r: std.Random, invalid: bool) Part {
+    const n: u8 = if (invalid) words.len else words.len - 1;
+    return .{ .word = r.uintLessThan(u8, n), .request = r.boolean() };
+}
+
+fn same(a: std.mem.Allocator, tokenizer: *const tok.Tokenizer, k: *const kept.Kept, probe: []const u8, spans: []const tok.Span) !void {
+    const want = tokenizer.encodeMasked(a, probe, spans);
+    const got = kept.pieces(tokenizer, a, k, probe, spans);
+    if (want) |ids| {
+        const p = try got;
+        try t.expectEqualSlices(u32, ids, try std.mem.concat(a, u32, &.{ p.head, p.mid, p.tail }));
+    } else |err| try t.expectError(err, got);
+}
+
+test "kept pieces: a segment starting the text encodes apart from the same bytes later in it" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var tokenizer = try tok.parse(a,
+        \\{"added_tokens":[{"content":"<S>","special":true,"normalized":false}],
+        \\"pre_tokenizer":{"type":"Metaspace","replacement":"\u2581","prepend_scheme":"first","split":false},
+        \\"model":{"type":"WordLevel","unk_token":"?","vocab":{"?":0,"ab":1,"\u2581ab":2}}}
+    );
+    defer tokenizer.deinit();
+    const held = try kept.keep(&tokenizer, a, "<S>ab", &.{.{ 3, 5 }});
+    const want = try tokenizer.encodeMasked(a, "ab", &.{.{ 0, 2 }});
+    // the same two bytes, but first in the text: Metaspace prepends to them only there
+    try t.expect(!std.mem.eql(u32, want, held.ids[1..]));
+    const got = try kept.pieces(&tokenizer, a, &held, "ab", &.{.{ 0, 2 }});
+    try t.expectEqualSlices(u32, want, try std.mem.concat(a, u32, &.{ got.head, got.mid, got.tail }));
+}
+
+test "kept pieces: random edits of a masked text give encodeMasked's ids or its error" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var tokenizer = try tok.parse(a, source);
+    defer tokenizer.deinit();
+    tokenizer.memo = try tok.Memo.create(a, 1 << 20);
+    var prng = std.Random.DefaultPrng.init(0x6b657074);
+    const r = prng.random();
+    var reused: usize = 0;
+    for (0..3000) |round| {
+        const invalid = round % 10 == 0;
+        var base: std.ArrayList(Part) = .empty;
+        for (0..r.uintLessThan(usize, 40)) |_| try base.append(a, part(r, invalid));
+        const b = try text(a, base.items);
+        const want = tokenizer.encodeMasked(a, b.text, b.spans);
+        const k = kept.keep(&tokenizer, a, b.text, b.spans);
+        if (want) |ids| try t.expectEqualSlices(u32, ids, (try k).ids) else |err| {
+            try t.expectError(err, k);
+            continue;
+        }
+        const held = try k;
+        var probe = try base.clone(a);
+        for (0..1 + r.uintLessThan(usize, 3)) |_| {
+            const at = if (probe.items.len == 0) 0 else r.uintLessThan(usize, probe.items.len + 1);
+            switch (r.uintLessThan(u8, 6)) {
+                0 => try probe.insert(a, at, part(r, invalid)),
+                1 => if (at < probe.items.len) {
+                    _ = probe.orderedRemove(at);
+                },
+                2 => if (at < probe.items.len) {
+                    probe.items[at] = part(r, invalid);
+                },
+                3 => if (at < probe.items.len) {
+                    probe.items[at].request = !probe.items[at].request;
+                },
+                4 => try probe.append(a, part(r, invalid)),
+                else => probe.shrinkRetainingCapacity(at),
+            }
+        }
+        const p = try text(a, probe.items);
+        try same(a, &tokenizer, &held, p.text, p.spans);
+        const got = kept.pieces(&tokenizer, a, &held, p.text, p.spans) catch continue;
+        if (got.head.len + got.tail.len > 0) reused += 1;
+    }
+    // the reuse itself must be exercised, or the comparison above proves nothing about it
+    try t.expect(reused > 500);
+}
+
+test "kept pieces: a cut text's fixed ids lead every longer text's encoding, errors included" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var tokenizer = try tok.parse(a, source);
+    defer tokenizer.deinit();
+    var prng = std.Random.DefaultPrng.init(0x637574);
+    const r = prng.random();
+    var fixed: usize = 0;
