     \\  glm-keep-seqs-check       TF_GLM_OVN_KEEP_SEQS: kept sequences, as left and poisoned, against fresh ones, byte for byte
@@ -23,6 +25,8 @@
 pub fn run(gpu: check.Gpu, cmd: []const u8, rest: []const [:0]const u8) !bool {
     if (std.mem.eql(u8, cmd, "glm-draft-onepass")) {
         try glm_draft_onepass.run(gpu);
+    } else if (std.mem.eql(u8, cmd, "glm-ey-direct-check")) {
+        try glm_ey_direct_check.run(gpu);
     } else if (std.mem.eql(u8, cmd, "glm-index-ovn-check")) {
         try glm_index_ovn_check.run(gpu);
     } else if (std.mem.eql(u8, cmd, "glm-index-regroup-check")) {
