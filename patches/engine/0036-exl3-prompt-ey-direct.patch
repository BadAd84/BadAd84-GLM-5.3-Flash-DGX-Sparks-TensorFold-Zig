diff --git a/zig/tests/cuda/glm_ey_direct_check.zig b/zig/tests/cuda/glm_ey_direct_check.zig
new file mode 100644
--- /dev/null
+++ b/zig/tests/cuda/glm_ey_direct_check.zig
@@ -0,0 +1,185 @@
+//! `glm-ey-direct-check`: TF_GLM_OVN_EY_DIRECT's prompt chunks, ey and the layer output, against the copy path.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+const Rig = @import("quant_ref_tests.zig").RigT;
+
+const E = 16; // routed experts; the shared expert is id E, which no pair takes
+const D = 4096; // GLM-5.3-Flash's hidden size
+const slots = glm.exl3.top_k + 1;
+const limit: f32 = 10.0;
+/// Prompt rows a case runs: one, a few, odd counts, one whole call, and two calls (the second of 6 rows).
+const row_counts = [_]usize{ 1, 8, 17, 255, glm.exl3.chunk_rows, glm.exl3.chunk_rows + 6 };
+
+fn sign(r: *Rig, scale: f16) f16 {
+    return if (r.rng.boolean()) scale else -scale;
+}
+
+/// E random K x N trellis matrices as the loader lays them out, and their scales; `rot`: every expert's one suh.
+fn matrix(r: *Rig, k: usize, n: usize, rot: ?[]const f16, suh: *u64, svh: *u64) !u64 {
+    const words = k / 16 * (n / 16) * 64;
+    const tr = try r.a.alloc(i16, E * words);
+    for (tr) |*v| v.* = r.rng.int(i16);
+    const su = try r.a.alloc(f16, E * k);
+    for (su, 0..) |*v, j| v.* = if (rot) |s| s[j % k] else sign(r, 1.0);
+    const sv = try r.a.alloc(f16, E * n);
+    for (sv) |*v| v.* = sign(r, 0.02);
+    suh.* = try r.dev(std.mem.sliceAsBytes(su));
+    svh.* = try r.dev(std.mem.sliceAsBytes(sv));
+    const base = try r.dev(std.mem.sliceAsBytes(tr));
+    const ptrs = try r.a.alloc(u64, E);
+    for (ptrs, 0..) |*p, e| p.* = base + e * words * 2;
+    return r.dev(std.mem.sliceAsBytes(ptrs));
+}
+
+/// A layer's experts at a rank's width `n`; `shx`: every expert's gate and up input under one rotation.
+fn experts(r: *Rig, n: usize, shx: bool) !glm.exl3.Experts {
+    const k2: [E]i32 = @splat(8);
+    var w: glm.exl3.Experts = .{ .gt = 0, .ut = 0, .dt = 0, .k2 = try r.dev(std.mem.sliceAsBytes(&k2)), .suh_g = 0, .suh_u = 0, .svh_g = 0, .svh_u = 0, .suh_d = 0, .svh_d = 0, .shx = shx };
+    var rot: ?[]f16 = null;
+    if (shx) {
+        rot = try r.a.alloc(f16, D);
+        for (rot.?) |*v| v.* = sign(r, 1.0);
+    }
+    w.gt = try matrix(r, D, n, rot, &w.suh_g, &w.svh_g);
+    w.ut = try matrix(r, D, n, rot, &w.suh_u, &w.svh_u);
+    w.dt = try matrix(r, n, D, null, &w.suh_d, &w.svh_d);
+    return w;
+}
+
+/// Each row's 8 distinct routed experts, then the shared expert's id.
+fn picks(r: *Rig, rows: usize) ![]i32 {
+    const out = try r.a.alloc(i32, rows * slots);
+    for (0..rows) |row| {
+        var seen: [E]bool = @splat(false);
+        for (0..slots - 1) |j| {
+            var e = r.rng.uintLessThan(usize, E);
+            while (seen[e]) e = r.rng.uintLessThan(usize, E);
+            seen[e] = true;
+            out[row * slots + j] = @intCast(e);
+        }
+        out[row * slots + slots - 1] = E;
+    }
+    return out;
+}
+
+/// cuda_moe.fill's tail on a chunk's slot rows: the shared expert's rows into slot 8, then the 9 slots' weighted sum.
+const Tail = struct {
+    put_slot: cuda.Function,
+    glue: *const glm.glue.Kernels,
+
+    fn run(t: Tail, r: *Rig, ey: u64, sy: u64, wts: u64, out: u64, rows: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(sy);
+        a.add(ey);
+        for ([_]usize{ rows, D, slots, glm.exl3.top_k, 0 }) |v| a.add(@as(c_int, @intCast(v)));
+        try cuda.launch.launch(t.put_slot, .{ .grid = .{ .x = @intCast((rows * D + 255) / 256) }, .block = .{ .x = 256 } }, r.s, &a);
+        try glm.glue.combine(.{ .glue = t.glue }, r.s, ey, true, wts, out, rows, D, slots);
+    }
+};
+
+/// One dispatch's slot rows ey [rows][slots][D] fp32 and its arena, every byte 0xff before the run.
+const Out = struct { ey: u64, arena: u64 };
+
+/// glm.exl3.run on prompt rows, Scratch.ey_direct = `direct`, the copy path's arena size; `shift` slots off: a control.
+fn dispatch(r: *Rig, k: *const glm.exl3.Kernels, ek: *const glm.experts.Kernels, w: glm.exl3.Experts, n: usize, x: u64, pk: u64, rows: usize, direct: bool, shift: usize) !Out {
+    const P = rows * glm.exl3.top_k;
+    const wide = P > cuda.grouped.small;
+    const plan: cuda.grouped.Plan = .{
+        .members = try r.zeros(P * 4),
+        .items = try r.zeros(cuda.grouped.maxItems(P, E, glm.experts.staged_tile) * 12),
+        .counts = try r.zeros(8),
+        .rank = try r.zeros((if (wide) P else 1) * 4),
+        .hist = try r.zeros((if (wide) (P + 1023) / 1024 * E else 1) * 4),
+    };
+    const sz = glm.exl3.scratchBytes(rows, D, n, true, w.shx, direct);
+    const arena = try r.zeros(glm.exl3.scratchBytes(rows, D, n, true, w.shx, false)[0]);
+    const sc: glm.exl3.Scratch = .{ .picks = arena, .xg = try r.zeros(sz[1]), .xu = try r.zeros(sz[2]), .z = try r.zeros(sz[3]), .ey_direct = direct };
+    const ey = try r.zeros((rows * slots + shift) * D * 4);
+    try glm.exl3.run(k, ek, r.s, w, sc, plan, x, D, pk, slots, rows, E, D, n, limit, true, ey + shift * D * 4, 0);
+    try r.s.synchronize();
+    return .{ .ey = ey, .arena = arena };
+}
+
+/// Random fp32 values in [-1, 1) on the device.
+fn floats(r: *Rig, n: usize) !u64 {
+    const v = try r.a.alloc(f32, n);
+    for (v) |*f| f.* = r.rng.float(f32) * 2 - 1;
+    return r.dev(std.mem.sliceAsBytes(v));
+}
+
+/// The copy path, the direct one and the control (the direct values one slot over) on the same rows, compared.
+fn case(r: *Rig, k: *const glm.exl3.Kernels, ek: *const glm.experts.Kernels, tail: Tail, w: glm.exl3.Experts, n: usize, rows: usize) !void {
+    const mark = r.bufs.items.len;
+    defer {
+        for (r.bufs.items[mark..]) |*b| b.free();
+        r.bufs.shrinkRetainingCapacity(mark);
+    }
+    var host: std.heap.ArenaAllocator = .init(r.gpu.gpa);
+    defer host.deinit();
+    const keep = r.a;
+    r.a = host.allocator();
+    defer r.a = keep;
+    const name = try std.fmt.allocPrint(r.a, "width {d}, {s}, {d} rows", .{ n, if (w.shx) "one rotation" else "a rotation an expert", rows });
+    const x = try r.dev(std.mem.sliceAsBytes(try r.bfs(rows * D, 1.0)));
+    const pk = try r.dev(std.mem.sliceAsBytes(try picks(r, rows)));
+    const copied = try dispatch(r, k, ek, w, n, x, pk, rows, false, 0);
+    const direct = try dispatch(r, k, ek, w, n, x, pk, rows, true, 0);
+    const control = try dispatch(r, k, ek, w, n, x, pk, rows, true, 1);
+    const bytes = rows * slots * D * 4;
+    const want = try r.back(copied.ey, bytes);
+    try check.sameBytes(try std.fmt.allocPrint(r.a, "{s}: ey against the copy path", .{name}), try r.back(direct.ey, bytes), want);
+    const off = std.mem.indexOfDiff(u8, try r.back(control.ey, bytes), want) orelse
+        return check.expect(false, "{s}: the control (ey one slot over) equals the copy path, so the check cannot fail", .{name});
+    const full = glm.exl3.scratchBytes(rows, D, n, true, w.shx, false)[0];
+    const used = glm.exl3.scratchBytes(rows, D, n, true, w.shx, true)[0];
+    if (std.mem.indexOfNone(u8, try r.back(direct.arena + used, full - used), &.{0xff})) |i|
+        return check.expect(false, "{s}: the direct run wrote byte {d} of the arena bytes the knob frees", .{ name, i });
+    try check.expect(std.mem.indexOfNone(u8, try r.back(copied.arena + used, full - used), &.{0xff}) != null, "{s}: the copy path's y is not in the bytes the knob frees", .{name});
+    const sy = try floats(r, rows * D);
+    const wts = try floats(r, rows * slots);
+    var outs: [3]u64 = undefined;
+    for ([_]u64{ copied.ey, direct.ey, control.ey }, &outs) |ey, *out| {
+        out.* = try r.zeros(rows * D * 4);
+        try tail.run(r, ey, sy, wts, out.*, rows);
+    }
+    const layer = try r.back(outs[0], rows * D * 4);
+    try check.sameBytes(try std.fmt.allocPrint(r.a, "{s}: the layer output against the copy path's", .{name}), try r.back(outs[1], rows * D * 4), layer);
+    try check.expect(!std.mem.eql(u8, try r.back(outs[2], rows * D * 4), layer), "{s}: the control's layer output equals the copy path's", .{name});
+    std.debug.print("RESULT {s}: ey ({d} bytes) and the layer output equal the copy path's, the freed {d} arena bytes untouched; control differs at byte {d}\n", .{ name, bytes, full - used, off });
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var prng = std.Random.DefaultPrng.init(11);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = stream, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var pm = try cuda.Module.load(gpu.d, cuda.kernels.experts);
+    defer pm.unload();
+    var k = try glm.exl3.Kernels.load(gpu.d);
+    defer k.unload();
+    var ek = try glm.experts.Kernels.load(gpu.d, pm, @intCast(try gpu.ctx.attribute(.multiprocessor_count)), false);
+    defer ek.unload();
+    var ops = try cuda.Module.load(gpu.d, cuda.kernels.glm_ops);
+    defer ops.unload();
+    var gm = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer gm.unload();
+    const gk = try glm.glue.Kernels.load(gm);
+    const tail: Tail = .{ .put_slot = try ops.function("tf_glm_put_slot"), .glue = &gk };
+    var cases: usize = 0;
+    for ([_]usize{ 640, 768 }) |n| for ([_]bool{ true, false }) |shx| { // TP=3's two shares, both rotation kinds
+        const w = try experts(&r, n, shx);
+        for (row_counts) |rows| {
+            try case(&r, &k, &ek, tail, w, n, rows);
+            cases += 1;
+        }
+    };
+    check.pass("glm-ey-direct-check: {d} cases of {any} rows, ey and the layer output equal the copy path's byte for byte, the freed arena untouched, every control different", .{ cases, row_counts });
+}
