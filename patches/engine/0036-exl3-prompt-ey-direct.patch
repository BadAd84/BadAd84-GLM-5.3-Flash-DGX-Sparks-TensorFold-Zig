 test "GLM EXL3 X3: the knobs are off unset, each reaches the decode options, and X3_NC refuses a third depth" {
diff --git a/zig/src/families/glm/cuda_exl3_ey_test.zig b/zig/src/families/glm/cuda_exl3_ey_test.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/families/glm/cuda_exl3_ey_test.zig
@@ -0,0 +1,261 @@
+//! TF_GLM_OVN_EY_DIRECT: a prompt chunk's down kernel writes ey's routed slot rows, so no y is held and none copied.
+const std = @import("std");
+const cuda = @import("cuda");
+const exl3 = @import("cuda_exl3.zig");
+const experts = @import("cuda_experts.zig");
+const state = @import("cuda_state.zig");
+const weights = @import("cuda_weights.zig");
+const shard = @import("cuda_shard.zig");
+const ex = cuda.exl3_experts;
+const t = std.testing;
+
+const D = 4096; // GLM-5.3-Flash's hidden size
+const N = 768; // rank 0's routed-expert share at TP=3
+const count = 288; // routed experts
+const slots = exl3.top_k + 1;
+
+/// The function handles of the launches compared argument by argument.
+const id = struct {
+    const rot_in = 2;
+    const rotate = 11;
+    const gateup = 12;
+    const down = 13;
+    const down_out = 14;
+};
+
+/// Where the recorded dispatch's buffers are: the x3 arena (Scratch.picks), the rows, the picks and ey.
+const at = struct {
+    const arena: u64 = 0x1_0000_0000;
+    const x: u64 = 0x2_0000_0000;
+    const picks: u64 = 0x3_0000_0000;
+    const ey: u64 = 0x4_0000_0000;
+};
+
+/// One launch: its function, grid and block, and every argument of the prompt kernels and rot_in.
+const Call = struct { id: usize, grid: [3]u32, block: u32, args: [16]u64 = @splat(0) };
+
+/// The driver: launches and 2-D copies recorded in order, nothing executed.
+const Rec = struct {
+    var calls: [512]Call = undefined;
+    var n: usize = 0;
+    var copies: [16]cuda.abi.Memcpy2D = undefined;
+    var copied: usize = 0;
+
+    /// Each argument's bytes as the kernel declares them, for the launches compared argument by argument.
+    fn sizes(f: usize) []const u8 {
+        return switch (f) {
+            id.rot_in => &.{ 8, 4, 4, 8, 8, 8, 8, 8, 4, 4, 4 },
+            id.rotate => &.{ 8, 4, 8, 8, 4 },
+            id.gateup => &.{ 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 4, 4, 4, 4, 4 },
+            id.down => &.{ 8, 8, 8, 8, 8, 8, 8, 4, 4, 4 },
+            id.down_out => &.{ 8, 8, 8, 8, 8, 8, 8, 4, 4, 4, 4 },
+            else => &.{},
+        };
+    }
+
+    fn launch(f: cuda.abi.Function, gx: c_uint, gy: c_uint, gz: c_uint, bx: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+        var c: Call = .{ .id = @intFromPtr(f), .grid = .{ gx, gy, gz }, .block = bx };
+        for (sizes(c.id), 0..) |size, i| {
+            const b: [*]const u8 = @ptrCast(args.?[i].?);
+            c.args[i] = if (size == 8) std.mem.readInt(u64, b[0..8], .little) else std.mem.readInt(u32, b[0..4], .little);
+        }
+        if (n < calls.len) calls[n] = c;
+        n += 1;
+        return cuda.abi.success;
+    }
+
+    fn copy(m: *const cuda.abi.Memcpy2D, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        if (copied < copies.len) copies[copied] = m.*;
+        copied += 1;
+        return cuda.abi.success;
+    }
+};
+
+/// A dispatch's record: its launches and its copies.
+const Plan = struct { calls: []const Call, copies: []const cuda.abi.Memcpy2D };
+
+fn fun(d: *const cuda.Driver, handle: usize) cuda.Function {
+    return .{ .d = d, .handle = @ptrFromInt(handle) };
+}
+
+/// The recorded kernels, each its own handle, and the family's router.
+const Fake = struct {
+    d: cuda.Driver,
+    k: ex.Experts,
+    ek: experts.Kernels,
+
+    fn init(f: *Fake) void {
+        Rec.n = 0;
+        Rec.copied = 0;
+        f.d = undefined;
+        f.d.api.cuLaunchKernel = Rec.launch;
+        f.d.api.cuMemcpy2DAsync_v2 = Rec.copy;
+        const d = &f.d;
+        f.k = .{ .mod = undefined, .group = fun(d, 1), .rot_in = fun(d, id.rot_in), .grouped = .{ fun(d, 3), fun(d, 6), fun(d, 7) }, .gateup = fun(d, 4), .down_combine = fun(d, 5) };
+        f.k.prompt = .{ .rotate = fun(d, id.rotate), .gateup = fun(d, id.gateup), .down = fun(d, id.down), .down_out = fun(d, id.down_out) };
+        f.k.plan_rotate = fun(d, 15);
+        f.k.plan_finish = fun(d, 16);
+        f.k.plan_finish_after = fun(d, 17);
+        f.k.ovn_walk = fun(d, 18);
+        f.k.ovn_nc = .{ fun(d, 19), fun(d, 27) };
+        f.ek = .{ .nvfp4 = undefined, .b32 = null, .router = .{ .plan_small = fun(d, 20), .plan_rank = fun(d, 21), .plan_offsets = fun(d, 22), .plan_scatter = fun(d, 23), .plan_rows = fun(d, 24), .plan_rank_rows = fun(d, 25), .plan_scatter_rows = fun(d, 26) } };
+    }
+
+    fn stream(f: *Fake) cuda.Stream {
+        return .{ .d = &f.d, .handle = null };
+    }
+};
+
+const plan_buf: cuda.grouped.Plan = .{ .items = 10000, .members = 20000, .counts = 30000, .rank = 40000, .hist = 50000 };
+
+/// exl3.run on `rows` rows through the recording driver; `direct`: the arena's Scratch.ey_direct.
+fn dispatch(a: std.mem.Allocator, rows: usize, prompt: bool, shx: bool, direct: bool) !Plan {
+    var f: Fake = undefined;
+    f.init();
+    const w: exl3.Experts = .{ .gt = 100, .ut = 200, .dt = 300, .k2 = 400, .suh_g = 500, .suh_u = 600, .svh_g = 700, .svh_u = 800, .suh_d = 900, .svh_d = 1000, .shx = shx };
+    const sc: exl3.Scratch = .{ .picks = at.arena, .xg = 0, .xu = 0, .z = 0, .ey_direct = direct };
+    try exl3.run(&f.k, &f.ek, f.stream(), w, sc, plan_buf, at.x, D, at.picks, slots, rows, count, D, N, 10, prompt, at.ey, 0);
+    try t.expect(Rec.n <= Rec.calls.len and Rec.copied <= Rec.copies.len);
+    return .{ .calls = try a.dupe(Call, Rec.calls[0..Rec.n]), .copies = try a.dupe(cuda.abi.Memcpy2D, Rec.copies[0..Rec.copied]) };
+}
+
+test "GLM EY direct: the knob reads off unset and at 0, on at 1" {
+    for ([_]?[]const u8{ null, "0", "1" }, [_]bool{ false, false, true }) |raw, on| {
+        cuda.ovn.fake("EY_DIRECT", raw);
+        try t.expectEqual(on, exl3.eyDirect());
+    }
+    cuda.ovn.fake("EY_DIRECT", null);
+}
+
+test "GLM EY direct: a prompt arena is the same bytes less y at every share, and a decode window's is unchanged" {
+    const rows = state.prefill_rows;
+    for ([_]usize{ 640, 768, 1024, 2048 }) |width| for ([_]bool{ false, true }) |shx| { // TP=3's two shares, TP=2, TP=1
+        const own = exl3.scratchBytes(rows, D, width, true, shx, false)[0];
+        try t.expectEqual(own - rows * exl3.top_k * D * 4, exl3.scratchBytes(rows, D, width, true, shx, true)[0]);
+        for ([_]usize{ 1, 17, 64 }) |r| try t.expectEqual(exl3.scratchBytes(r, D, width, false, shx, false), exl3.scratchBytes(r, D, width, false, shx, true));
+    };
+    // what the knob gives back a rank at TP=3's two shares, so it is a number the gate holds
+    try t.expectEqual(@as(usize, 37_814_272), exl3.scratchBytes(rows, D, 640, true, true, true)[0]);
+    try t.expectEqual(@as(usize, 42_008_576), exl3.scratchBytes(rows, D, 768, true, true, true)[0]);
+    var l: ex.Layer = .{ .gate = 0, .up = 0, .down = 0, .gate_k2 = 0, .up_k2 = 0, .down_k2 = 0, .suh_g = 0, .suh_u = 0, .svh_g = 0, .svh_u = 0, .suh_d = 0, .svh_d = 0, .dims = 512, .width = 256, .experts = 9, .codebook = .mcg, .uniform_k2 = 8 };
+    for ([_]usize{ 1, 7, 64, 1023 }) |r| for ([_]usize{ 1, 8, 32 }) |s| for ([_]bool{ false, true }) |shared| {
+        l.shared_input = shared;
+        const own = try ex.prompt.scratch(4096, l, r, s);
+        const direct = try ex.prompt.directScratch(4096, l, r, s);
+        try t.expect(direct.xg == own.xg and direct.xu == own.xu and direct.xd == own.xd and direct.y == 0);
+        try t.expectEqual(try ex.prompt.bytes(l, r, s) - std.mem.alignForward(usize, r * s * l.dims * 4, 256), try ex.prompt.directBytes(l, r, s));
+    };
+}
+
+test "GLM EY direct: prefill buffers made with the knob hold their prompt arena less y, and their scratch says so" {
+    const Driver = struct {
+        var next: u64 = 0x100000000;
+        fn alloc(out: *u64, bytes: usize) callconv(.c) c_int {
+            out.* = next;
+            next += std.mem.alignForward(u64, bytes, 256);
+            return 0;
+        }
+        fn free(_: u64) callconv(.c) c_int {
+            return 0;
+        }
+        fn fill(_: u64, _: u8, _: usize) callconv(.c) c_int {
+            return 0;
+        }
+    };
+    var d: cuda.Driver = undefined;
+    d.api.cuMemAlloc_v2 = Driver.alloc;
+    d.api.cuMemFree_v2 = Driver.free;
+    d.api.cuMemsetD8_v2 = Driver.fill;
+    var layers: [45]weights.Layer = undefined;
+    var w: weights.Weights = undefined;
+    w.config = .{};
+    w.config.exl3 = true;
+    w.share = try shard.Share.of(&w.config, 0, 3);
+    for (&layers, 0..) |*l, i| l.mixer = if (w.config.kind(@intCast(i)) == .mla) .{ .mla = undefined } else .{ .kda = undefined };
+    w.layers = &layers;
+    w.exl3_shx = true;
+    var prompt_bytes: [2]usize = undefined;
+    var window_bytes: [2]usize = undefined;
+    for ([_]?[]const u8{ null, "1" }, 0..) |raw, i| {
+        cuda.ovn.fake("EY_DIRECT", raw);
+        defer cuda.ovn.fake("EY_DIRECT", null);
+        var b = try state.Buffers.init(&d, &w, state.prefill_rows, true, 8256);
+        defer b.deinit();
+        var twin = try state.Buffers.initTwin(&d, &w, &b, 8256);
+        defer twin.deinit();
+        var window = try state.Buffers.init(&d, &w, state.window_rows, false, 8256);
+        defer window.deinit();
+        for ([_]bool{ b.moe.x3.ey_direct, twin.moe.x3.ey_direct, window.moe.x3.ey_direct }) |flag| try t.expectEqual(raw != null, flag);
+        prompt_bytes[i] = b.arena.buf.len;
+        window_bytes[i] = window.arena.buf.len;
+    }
+    try t.expectEqual(prompt_bytes[0] - state.prefill_rows * exl3.top_k * D * 4, prompt_bytes[1]);
+    try t.expectEqual(window_bytes[0], window_bytes[1]);
+}
+
+test "GLM EY direct: on, a prompt chunk's down launch writes ey's routed slots and nothing is copied; else the off plan" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]usize{ 1, 8, 17, 255, exl3.chunk_rows, exl3.chunk_rows + 6 }) |rows| for ([_]bool{ true, false }) |shx| {
+        const off = try dispatch(a, rows, true, shx, false);
+        const on = try dispatch(a, rows, true, shx, true);
+        const calls = (rows + exl3.chunk_rows - 1) / exl3.chunk_rows;
+        try t.expectEqual(2 * calls, off.copies.len); // each call: its compact picks, then its routed slots
+        try t.expectEqual(calls, on.copies.len); // each call: its compact picks alone
+        try t.expectEqual(off.calls.len, on.calls.len);
+        const full = exl3.scratchBytes(rows, D, N, true, shx, false)[0];
+        const used = exl3.scratchBytes(rows, D, N, true, shx, true)[0];
+        var downs: usize = 0;
+        for (off.calls, on.calls) |was, now| {
+            try t.expectEqual(was.grid, now.grid);
+            try t.expectEqual(was.block, now.block);
+            for (now.args) |v| try t.expect(v < at.arena + used or v >= at.arena + full); // none in the bytes the knob frees
+            if (was.id != id.down) {
+                try t.expectEqual(was.id, now.id);
+                try t.expectEqualSlices(u64, &was.args, &now.args);
+                continue;
+            }
+            const first = downs * exl3.chunk_rows;
+            try t.expectEqual(@as(usize, id.down_out), now.id);
+            try t.expectEqualSlices(u64, was.args[0..6], now.args[0..6]); // xd, the trellis, the plan, svh
+            try t.expectEqual(at.ey + first * slots * D * 4, now.args[6]); // the call's ey rows, not y
+            try t.expectEqualSlices(u64, was.args[7..10], now.args[7..10]); // K, D and the 8 pairs a row
+            try t.expectEqual(@as(u64, slots), now.args[10]); // 9 slot rows a row: the shared slot left alone
+            try t.expectEqual(at.arena + used, was.args[6]); // off, y starts where the knob's arena ends
+            const c = off.copies[2 * downs + 1]; // off: the call's routed slots, y into ey's rows
+            try t.expect(c.src == was.args[6] and c.dst == now.args[6] and c.height == @min(exl3.chunk_rows, rows - first));
+            try t.expect(c.width == exl3.top_k * D * 4 and c.src_pitch == exl3.top_k * D * 4 and c.dst_pitch == slots * D * 4);
+            try t.expect(std.meta.eql(off.copies[2 * downs], on.copies[downs])); // the compact picks, the same copy
+            downs += 1;
+        }
+        try t.expectEqual(calls, downs);
+    };
+}
+
+test "GLM EY direct: a decode window's launches and copies are the same with the arena's flag set" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]usize{ 1, 8, 17, 64 }) |rows| for ([_]bool{ true, false }) |shx| {
+        const off = try dispatch(a, rows, false, shx, false);
+        const on = try dispatch(a, rows, false, shx, true);
+        try t.expect(off.calls.len > 0 and off.calls.len == on.calls.len and off.copies.len == on.copies.len);
+        for (off.calls, on.calls) |was, now| try t.expect(std.meta.eql(was, now));
+        for (off.copies, on.copies) |was, now| try t.expect(std.meta.eql(was, now));
+    };
+}
+
+test "GLM EY direct: the common prompt run refuses slot rows that overlap or pass i32, and takes them a row apart" {
+    var f: Fake = undefined;
+    f.init();
+    const l: ex.Layer = .{ .gate = 100, .up = 200, .down = 300, .gate_k2 = 400, .up_k2 = 400, .down_k2 = 400, .suh_g = 500, .suh_u = 600, .svh_g = 700, .svh_u = 800, .suh_d = 900, .svh_d = 1000, .experts = count, .dims = D, .width = N, .codebook = .mcg, .uniform_k2 = 8, .shared_input = true };
+    const sc = try ex.prompt.directScratch(at.arena, l, 64, exl3.top_k);
+    for ([_]usize{ 0, exl3.top_k - 1, @as(usize, std.math.maxInt(i32)) + 1 }) |ys| {
+        try t.expectError(error.Exl3Shape, f.k.prompt.run(&f.k, f.ek.router, f.stream(), l, at.x, D, at.picks, 64, sc, plan_buf, .{ .y = at.ey, .ys = ys }));
