From c60ce5fd181de2ea0d167a42afda3eeda081a85b Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:55:07 +0000
Subject: [PATCH] cuda: ovn knob helper, TF_GLM_OVN_<NAME> read once per
 process

The speed-hunt branches each add default-off knobs; this is the one place that reads them.
---
 zig/src/cuda/ovn.zig  | 39 +++++++++++++++++++++++++++++++++++++++
 zig/src/cuda/root.zig |  1 +
 2 files changed, 40 insertions(+)
 create mode 100644 zig/src/cuda/ovn.zig

diff --git a/zig/src/cuda/ovn.zig b/zig/src/cuda/ovn.zig
new file mode 100644
index 000000000..2ccf70c98
--- /dev/null
+++ b/zig/src/cuda/ovn.zig
@@ -0,0 +1,39 @@
+//! Speed-hunt knobs (`TF_GLM_OVN_<NAME>`): read from the environment once per process, default off.
+//! Every rank runs with the same environment, so every rank sees the same value.
+const std = @import("std");
+
+fn raw(comptime name: []const u8) ?[]const u8 {
+    const v = std.c.getenv("TF_GLM_OVN_" ++ name) orelse return null;
+    const s = std.mem.span(v);
+    return if (s.len == 0) null else s;
+}
+
+/// `TF_GLM_OVN_<name>` as text (unset or empty: null), cached after the first read.
+pub fn text(comptime name: []const u8) ?[]const u8 {
+    const S = struct {
+        var read = false;
+        var value: ?[]const u8 = null;
+    };
+    if (!S.read) {
+        S.value = raw(name);
+        S.read = true;
+    }
+    return S.value;
+}
+
+/// `TF_GLM_OVN_<name>` as an unsigned integer; unset or empty is `default`, a value that does not parse is refused.
+pub fn int(comptime name: []const u8, default: u64) error{BadOvnKnob}!u64 {
+    const s = text(name) orelse return default;
+    return std.fmt.parseInt(u64, s, 10) catch error.BadOvnKnob;
+}
+
+/// `TF_GLM_OVN_<name>` as a switch: unset, empty or "0" is off, anything else is on.
+pub fn on(comptime name: []const u8) bool {
+    const s = text(name) orelse return false;
+    return !std.mem.eql(u8, s, "0");
+}
+
+test "ovn: an unset knob is off and takes its default" {
+    try std.testing.expect(!on("NO_SUCH_KNOB_FOR_TESTS"));
+    try std.testing.expectEqual(@as(u64, 7), try int("NO_SUCH_KNOB_FOR_TESTS", 7));
+}
diff --git a/zig/src/cuda/root.zig b/zig/src/cuda/root.zig
index 5489b019b..82184c7b1 100644
--- a/zig/src/cuda/root.zig
+++ b/zig/src/cuda/root.zig
@@ -40,6 +40,7 @@ pub const nvfp4 = @import("nvfp4.zig");
 pub const segments = @import("segments.zig");
 pub const grouped = @import("grouped.zig");
 pub const qlinear = @import("qlinear.zig");
+pub const ovn = @import("ovn.zig");
 pub const w4a8 = @import("w4a8.zig");
 pub const norms = @import("norms.zig");
 pub const embed_rows = @import("embed_rows.zig");
