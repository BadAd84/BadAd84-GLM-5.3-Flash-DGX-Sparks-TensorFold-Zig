+/// The scratch from row `lo` on: each row-indexed buffer moved down `lo` rows (`row_width`: the fused stack's).
+pub fn fromRow(heads: usize, row_width: usize, s: Scratch, lo: usize) Scratch {
+    const n = heads * kda.dk;
+    var v = s;
+    v.p += lo * row_width * 2;
+    v.ka += lo * n * 2;
+    v.kg += lo * n * 2;
+    v.saves.out += lo * n * 2;
+    v.saves.k += lo * n * 4;
+    v.saves.v += lo * n * 2;
+    v.saves.g += lo * n * 4;
+    v.saves.b += lo * heads * 4;
+    v.wide.q += lo * n * 4;
+    v.wide.y += lo * n * 2;
+    return v;
+}
+
+/// TF_GLM_OVN_PIECE_KDA: the chain over rows lo..hi alone, bits as the whole chain's; `conv`: the three rows before lo.
+pub fn chainRange(ks: *const kda.Kernels, stream: cuda.Stream, l: Layer, s: Scratch, lo: usize, hi: usize, conv: u64, state_in: u64, state_out: u64) !void {
+    var v = fromRow(l.heads, l.matWidth(), s, lo);
+    v.saves.state_out = state_out;
+    try chainRows(ks, stream, l, v, hi - lo, conv, state_in, true, null);
+}
+
+/// The conv window a chain range at `lo` (three rows or more) reads: the projected rows before it.
+pub fn convWindow(set: glue.Set, stream: cuda.Stream, l: Layer, s: Scratch, lo: usize) !u64 {
+    const window = s.state + l.heads * kda.dk * kda.dv * 4;
+    try commitConv(set, stream, l, s, lo, window);
+    return window;
+}
+
+/// A prompt chunk's conv window commit: the layer's window takes the chunk's last three projected rows.
+pub fn commitConv(set: glue.Set, stream: cuda.Stream, l: Layer, s: Scratch, rows: usize, conv_state: u64) !void {
+    try glue.convShift(set, stream, conv_state, s.p, rows, rows * l.matWidth(), l.matWidth(), 1, 3 * l.heads * kda.dk);
+}
+
+/// Chain range `i` of `n`: the first reads `first`, the last writes `out`, the others alternate with `other`.
+pub fn hop(i: usize, n: usize, first: u64, out: u64, other: u64) struct { from: u64, to: u64 } {
+    return .{ .from = if (i == 0) first else if ((n - i) % 2 == 0) out else other, .to = if ((n - 1 - i) % 2 == 0) out else other };
+}
+
 test {
     _ = @import("cuda_kda_tp3_test.zig");
 }
