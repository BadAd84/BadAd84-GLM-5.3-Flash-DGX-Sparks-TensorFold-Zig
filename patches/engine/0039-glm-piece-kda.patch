index 0000000000000000000000000000000000000000..f5a76c55a8b94790b1300c53333179e4c96d182d
--- /dev/null
+++ b/zig/src/families/glm/cuda_piece_kda_test.zig
@@ -0,0 +1,112 @@
+//! TF_GLM_OVN_PIECE_KDA: a KDA site's chain by pieces: the switch, the opening pieces, the state hops, the row offsets.
+const std = @import("std");
+const cuda = @import("cuda");
+const pieces = @import("cuda_forward_pieces.zig");
+const kda_block = @import("cuda_kda_block.zig");
+const chain = @import("cuda_forward_chain.zig");
+const kda = cuda.kda;
+
+test "TF_GLM_OVN_PIECE_KDA: off unless set to 1" {
+    defer cuda.ovn.fake("PIECE_KDA", null);
+    cuda.ovn.fake("PIECE_KDA", null);
+    try std.testing.expect(!pieces.pieceKda());
+    cuda.ovn.fake("PIECE_KDA", "1");
+    try std.testing.expect(pieces.pieceKda());
+    cuda.ovn.fake("PIECE_KDA", "0");
+    try std.testing.expect(!pieces.pieceKda());
+}
+
+test "cuda_forward_chain.opening: a range opens at its first piece, a piece of the range before opens nothing" {
+    var out: [pieces.max_pieces]?usize = undefined;
+    const cases = [_]struct { len: usize, last: []const usize, want: []const ?usize }{
+        .{ .len = 4, .last = &.{ 0, 1, 2, 3 }, .want = &.{ 0, 1, 2, 3 } },
+        .{ .len = 4, .last = &.{ 0, 1, 3 }, .want = &.{ 0, 1, 2, null } }, // a short last piece joined to the one before it
+        .{ .len = 2, .last = &.{1}, .want = &.{ 0, null } },
+        .{ .len = 1, .last = &.{0}, .want = &.{0} },
+    };
+    for (cases) |c| {
+        @memset(&out, 99); // a piece the function leaves alone would read 99, not null
+        chain.opening(c.len, c.last, &out);
+        try std.testing.expectEqualSlices(?usize, c.want, out[0..c.len]);
+    }
+}
+
+test "cuda_forward_chain.opening: for every chunk and piece count, the ranges open in order, cover the rows once, and hold their pieces" {
+    var rows: usize = 1;
+    while (rows <= 6000) : (rows += 37) {
+        for (1..pieces.max_pieces + 1) |count| {
+            var cut: [pieces.max_pieces][2]usize = undefined;
+            const piece_count = pieces.ranges(rows, count, &cut);
+            var spans: [pieces.max_pieces][2]usize = undefined;
+            var last: [pieces.max_pieces]usize = undefined;
+            const n = pieces.frontRanges(cut[0..piece_count], 0, &spans, &last);
+            var opens: [pieces.max_pieces]?usize = undefined;
+            chain.opening(piece_count, last[0..n], &opens);
+            var seen: usize = 0;
+            var next_row: usize = 0;
+            for (cut[0..piece_count], 0..) |piece, q| {
+                if (opens[q]) |range| {
+                    try std.testing.expectEqual(seen, range);
+                    try std.testing.expectEqual(next_row, spans[range][0]);
+                    try std.testing.expectEqual(piece[0], spans[range][0]);
+                    next_row = spans[range][1];
+                    seen += 1;
+                }
+                try std.testing.expect(seen > 0);
+                try std.testing.expect(piece[0] >= spans[seen - 1][0] and piece[1] <= spans[seen - 1][1]);
+            }
+            try std.testing.expectEqual(n, seen);
+            try std.testing.expectEqual(rows, next_row);
+        }
+    }
+}
+
+test "kda_block.hop: the first range reads the layer's state, the last writes the committed buffer, none reads what it writes" {
+    const first: u64 = 1000;
+    const out: u64 = 2000;
+    const other: u64 = 3000;
+    var n: usize = 1;
+    while (n <= pieces.max_pieces) : (n += 1) {
+        var wrote: u64 = first;
+        for (0..n) |i| {
+            const h = kda_block.hop(i, n, first, out, other);
+            try std.testing.expectEqual(wrote, h.from); // it reads what the range before it wrote
+            try std.testing.expect(h.from != h.to);
+            try std.testing.expect(h.to != first); // the layer's old state survives until the commit
+            wrote = h.to;
+        }
+        try std.testing.expectEqual(out, wrote);
+    }
+}
+
+test "kda_block.fromRow: each row-indexed buffer moves down by its own row size" {
+    const s: kda_block.Scratch = .{
+        .p = 1 << 20,
+        .ka = 2 << 20,
+        .kg = 3 << 20,
+        .saves = .{ .out = 4 << 20, .state_out = 99, .k = 5 << 20, .v = 6 << 20, .g = 7 << 20, .b = 8 << 20 },
+        .wide = .{ .q = 9 << 20, .y = 10 << 20 },
+        .mm_part = 11 << 20,
+        .tmp = 12 << 20,
+        .state = 13 << 20,
+    };
+    const heads = 11;
+    const width = 4296;
+    const n = heads * kda.dk;
+    const v = kda_block.fromRow(heads, width, s, 384);
+    try std.testing.expectEqual(s.p + 384 * width * 2, v.p); // the fused stack's bf16 rows
+    try std.testing.expectEqual(s.ka + 384 * n * 2, v.ka);
+    try std.testing.expectEqual(s.kg + 384 * n * 2, v.kg);
+    try std.testing.expectEqual(s.saves.out + 384 * n * 2, v.saves.out); // bf16
+    try std.testing.expectEqual(s.saves.k + 384 * n * 4, v.saves.k); // fp32
+    try std.testing.expectEqual(s.saves.v + 384 * n * 2, v.saves.v); // bf16
+    try std.testing.expectEqual(s.saves.g + 384 * n * 4, v.saves.g); // fp32
+    try std.testing.expectEqual(s.saves.b + 384 * heads * 4, v.saves.b); // fp32, a value a head
+    try std.testing.expectEqual(s.wide.q + 384 * n * 4, v.wide.q); // fp32
+    try std.testing.expectEqual(s.wide.y + 384 * n * 2, v.wide.y); // bf16
+    try std.testing.expectEqual(s.saves.state_out, v.saves.state_out); // not row-indexed
+    try std.testing.expectEqual(s.mm_part, v.mm_part);
+    try std.testing.expectEqual(s.tmp, v.tmp);
+    try std.testing.expectEqual(s.state, v.state);
+    try std.testing.expect(std.meta.eql(s, kda_block.fromRow(heads, width, s, 0)));
+}
