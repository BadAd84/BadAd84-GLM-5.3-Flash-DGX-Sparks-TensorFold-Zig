 }
 
 /// TF_GLM_OVN_PIECE_FRONT: the projections of rows lo..hi alone, into those rows of s.p, s.ka and s.kg.
@@ -175,6 +175,47 @@ pub fn chainRows(ks: *const kda.Kernels, stream: cuda.Stream, l: Layer, s: Scrat
     try kda.chain(ks, stream, c, rows, s.saves, if (wide or rows >= kda.wide_rows) s.wide else null);
