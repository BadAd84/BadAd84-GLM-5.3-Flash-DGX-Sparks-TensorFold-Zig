@@ -0,0 +1,71 @@
+//! A KDA mixer site's chain run piece by piece, each range's rows chained ahead of their pieces' o_proj and exchange.
+const std = @import("std");
+const weights = @import("cuda_weights.zig");
+const kda_block = @import("cuda_kda_block.zig");
+const kda_chunk = @import("cuda_kda_chunk.zig");
+const kda = @import("cuda").kda;
+const fw = @import("cuda_forward.zig");
+const pieces = @import("cuda_forward_pieces.zig");
+const Forward = fw.Forward;
+const Pieces = fw.Pieces;
+
+/// Whether layer j's mixer site runs its chain by pieces: a KDA layer, a chunk the whole chain takes the wide way.
+pub fn handsChain(f: *const Forward, enabled: bool, j: usize, rows: usize) bool {
+    if (!enabled or f.prof != null or f.l2pfFor() != null or rows < kda.wide_rows) return false;
+    if (std.meta.activeTag(f.ranks[0].w.layers[j].mixer) != .kda) return false;
+    for (f.ranks) |r| {
+        if (r.segs.len > 0 or kda_chunk.prompt(&f.m.chunked, r.st.pos) != null) return false;
+    }
+    return true;
+}
+
+/// What a KDA mixer does before its chain: the projections of every row, none when the previous ffn site fronted them.
+pub fn project(f: *const Forward, r: fw.Rank, l: weights.Layer, rows: usize, fronted: bool) !void {
+    if (fronted) return;
+    var s = r.b.kda;
+    s.p = r.b.kproj;
+    try kda_block.project(f.set(), f.stream, l.mixer.kda, s, r.b.normed, r.w.config.hidden, rows);
+}
+
+/// Range `i` of `n` (rows `span`) of layer j's chain on every rank: its conv window and the states it reads and writes.
+fn chainRange(f: *const Forward, j: usize, li: usize, i: usize, n: usize, span: [2]usize) !void {
+    for (f.ranks) |r| {
+        const k = r.w.layers[j].mixer.kda;
+        const st = r.st;
+        const cur = st.cur[li];
+        var s = r.b.kda;
+        s.p = r.b.kproj;
+        const hop = kda_block.hop(i, n, st.recAt(cur, li), st.recAt(1 - cur, li), s.state);
+        const conv = if (span[0] == 0) st.conv + li * 3 * st.conv_c * 2 else try kda_block.convWindow(f.set(), f.stream, k, s, span[0]);
+        try kda_block.chainRange(&f.m.kda, f.stream, k, s, span[0], span[1], conv, hop.from, hop.to);
+    }
+}
+
+/// Per piece, the range whose chain runs just before it (`last[r]`: range r's last piece), null inside a range.
+pub fn opening(cut_len: usize, last: []const usize, out: *[fw.max_pieces]?usize) void {
+    @memset(out[0..cut_len], null);
+    var piece: usize = 0;
+    for (last, 0..) |end, range| {
+        out[piece] = range;
+        piece = end + 1;
+    }
+}
+
+/// A KDA mixer site with its chain by pieces: each range's chain, its pieces' o_proj and exchanges, then the commit.
+pub fn exchange(f: *const Forward, p: *const Pieces, j: usize, li: usize, cut: []const [2]usize) !void {
+    var spans: [fw.max_pieces][2]usize = undefined;
+    var last: [fw.max_pieces]usize = undefined;
+    const n = pieces.frontRanges(cut, 0, &spans, &last);
+    var opens: [fw.max_pieces]?usize = undefined;
+    opening(cut.len, last[0..n], &opens);
+    for (cut, 0..) |piece, q| {
+        if (opens[q]) |range| try chainRange(f, j, li, range, n, spans[range]);
+        try pieces.exchangePiece(f, p, j, .mixer, q, piece);
+    }
+    for (f.ranks) |r| {
+        var s = r.b.kda;
+        s.p = r.b.kproj;
+        try kda_block.commitConv(f.set(), f.stream, r.w.layers[j].mixer.kda, s, cut[cut.len - 1][1], r.st.conv + li * 3 * r.st.conv_c * 2);
+        r.st.cur[li] = 1 - r.st.cur[li]; // the last range wrote the other buffer: the layer commits now
+    }
+}
