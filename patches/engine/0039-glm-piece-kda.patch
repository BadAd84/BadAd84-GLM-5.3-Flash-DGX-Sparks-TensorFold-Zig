diff --git a/zig/tests/cuda/glm_kda_pieces_check.zig b/zig/tests/cuda/glm_kda_pieces_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..44b152cc024598e33754f548526c9d41d8364164
--- /dev/null
+++ b/zig/tests/cuda/glm_kda_pieces_check.zig
@@ -0,0 +1,170 @@
+//! glm-kda-pieces: TF_GLM_OVN_PIECE_KDA's chain by ranges of rows against the whole chain, byte for byte (synthetic).
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const qr = @import("quant_ref_tests.zig");
+const glm = @import("glm_cuda");
+const Rig = qr.RigT;
+
+const kb = glm.kda_block;
+const kda = glm.kda;
+const dk = kda.dk;
+
+/// What a planted control gets wrong: nothing (the schedule as built), the conv window, or each range's start state.
+const Wrong = enum { none, window, state };
+
+const Case = struct { heads: usize, rows: usize, pieces: usize };
+const cases = [_]Case{
+    .{ .heads = 11, .rows = 4096, .pieces = 4 },
+    .{ .heads = 11, .rows = 4096, .pieces = 8 },
+    .{ .heads = 10, .rows = 2048, .pieces = 3 },
+    .{ .heads = 11, .rows = 1326, .pieces = 4 },
+    .{ .heads = 10, .rows = 1160, .pieces = 4 }, // the last piece is 8 rows and joins the one before it
+    .{ .heads = 11, .rows = 129, .pieces = 4 }, // one range of every row
+    .{ .heads = 11, .rows = 300, .pieces = 3 },
+};
+
+fn floats(r: *Rig, count: usize, lo: f32, hi: f32) ![]f32 {
+    const out = try r.a.alloc(f32, count);
+    for (out) |*v| v.* = lo + r.rng.float(f32) * (hi - lo);
+    return out;
+}
+
+/// One layer's inputs on the device, shared by the whole chain and the ranges (read only).
+const Inputs = struct { layer: kb.Layer, p: u64, a: u64, g: u64, state: u64, window: []const u8 };
+
+fn inputs(r: *Rig, heads: usize, rows: usize) !Inputs {
+    const n = heads * dk;
+    const w = kb.rowWidth(heads);
+    const layer: kb.Layer = .{
+        .proj = .{ .bf16 = 0 },
+        .fb = 0,
+        .gb = 0,
+        .o = .{ .bf16 = 0 },
+        .conv_w = try r.dev(std.mem.sliceAsBytes(try floats(r, 3 * n * 4, -0.5, 0.5))),
+        .a_log = try r.dev(std.mem.sliceAsBytes(try floats(r, heads, -1, 1))),
+        .dt_bias = try r.dev(std.mem.sliceAsBytes(try floats(r, n, -0.5, 0.5))),
+        .norm_w = try r.dev(std.mem.sliceAsBytes(try r.bfs(dk, 1.0))),
+        .eps = 1e-6,
+        .lower = -5.0,
+        .heads = heads,
+        .dims = 64,
+    };
+    return .{
+        .layer = layer,
+        .p = try r.dev(std.mem.sliceAsBytes(try r.bfs(rows * w, 1.0))),
+        .a = try r.dev(std.mem.sliceAsBytes(try r.bfs(rows * n, 2.0))),
+        .g = try r.dev(std.mem.sliceAsBytes(try r.bfs(rows * n, 2.0))),
+        .state = try r.dev(std.mem.sliceAsBytes(try floats(r, heads * kda.dv * dk, -0.05, 0.05))),
+        .window = std.mem.sliceAsBytes(try r.bfs(3 * 3 * n, 1.0)),
+    };
+}
+
+/// A layer's chain scratch for `rows` rows, every byte 0xff until a kernel writes it.
+fn scratch(r: *Rig, in: Inputs, rows: usize) !kb.Scratch {
+    const heads = in.layer.heads;
+    const n = heads * dk;
+    return .{
+        .p = in.p,
+        .ka = in.a,
+        .kg = in.g,
+        .saves = .{ .out = try r.zeros(rows * n * 2), .state_out = try r.zeros(heads * kda.dv * dk * 4), .k = try r.zeros(rows * n * 4), .v = try r.zeros(rows * n * 2), .g = try r.zeros(rows * n * 4), .b = try r.zeros(rows * heads * 4) },
+        .wide = .{ .q = try r.zeros(rows * n * 4), .y = try r.zeros(rows * n * 2) },
+        .mm_part = 0,
+        .state = try r.zeros(heads * dk * kda.dv * 4 + 3 * 3 * n * 2),
+    };
+}
+
+/// The whole chain and the conv window commit of production's path (bodyRest), into `s`; `conv` is the layer's window.
+fn whole(r: *Rig, ks: *const kda.Kernels, set: glm.glue.Set, in: Inputs, s: kb.Scratch, rows: usize, conv: u64) !void {
+    try kb.chainRows(ks, r.s, in.layer, s, rows, conv, in.state, true, null);
+    try kb.commitConv(set, r.s, in.layer, s, rows, conv);
+}
+
+/// The ranges as cuda_forward_chain.exchange runs them (the pieces as cut, a last one under a row step joined).
+fn byRanges(r: *Rig, ks: *const kda.Kernels, set: glm.glue.Set, in: Inputs, s: kb.Scratch, rows: usize, pieces: usize, conv: u64, wrong: Wrong) !void {
+    var cut: [glm.forward.max_pieces][2]usize = undefined;
+    const pieces_cut = glm.forward.ranges(rows, pieces, &cut);
+    var spans: [glm.forward.max_pieces][2]usize = undefined;
+    var last: [glm.forward.max_pieces]usize = undefined;
+    const n = glm.forward.frontRanges(cut[0..pieces_cut], 0, &spans, &last);
+    for (spans[0..n], 0..) |span, i| {
+        const hop = kb.hop(i, n, in.state, s.saves.state_out, s.state);
+        const from = if (wrong == .state) in.state else hop.from;
+        const window = if (span[0] == 0 or wrong == .window) conv else try kb.convWindow(set, r.s, in.layer, s, span[0]);
+        try kb.chainRange(ks, r.s, in.layer, s, span[0], span[1], window, from, hop.to);
+    }
+    try kb.commitConv(set, r.s, in.layer, s, rows, conv);
+}
+
+/// The bytes a scratch's chain wrote, in the order compared: out, the final state, saved k, v and decay, the window.
+fn written(r: *Rig, in: Inputs, s: kb.Scratch, rows: usize, conv: u64) ![6][]u8 {
+    const heads = in.layer.heads;
+    const n = heads * dk;
+    return .{
+        try r.back(s.saves.out, rows * n * 2),
+        try r.back(s.saves.state_out, heads * kda.dv * dk * 4),
+        try r.back(s.saves.k, rows * n * 4),
+        try r.back(s.saves.v, rows * n * 2),
+        try r.back(s.saves.g, rows * n * 4),
+        try r.back(conv, in.window.len),
+    };
+}
+
+const labels = [6][]const u8{ "out", "the final state", "saved k", "saved v", "saved decay", "the conv window" };
+
+fn runCase(r: *Rig, ks: *const kda.Kernels, set: glm.glue.Set, c: Case, wrong: Wrong) !struct { whole: [6][]u8, ranges: [6][]u8 } {
+    const in = try inputs(r, c.heads, c.rows);
+    const sa = try scratch(r, in, c.rows);
+    const ca = try r.dev(in.window);
+    try whole(r, ks, set, in, sa, c.rows, ca);
+    const sb = try scratch(r, in, c.rows);
+    const cb = try r.dev(in.window);
+    try byRanges(r, ks, set, in, sb, c.rows, c.pieces, cb, wrong);
+    return .{ .whole = try written(r, in, sa, c.rows, ca), .ranges = try written(r, in, sb, c.rows, cb) };
+}
+
+/// The planted control: a wrong window or a wrong state is a difference, and the chain writes what it compares.
+fn planted(r: *Rig, ks: *const kda.Kernels, set: glm.glue.Set) !void {
+    const c = Case{ .heads = 11, .rows = 1326, .pieces = 4 };
+    for ([_]Wrong{ .window, .state }) |wrong| {
+        const got = try runCase(r, ks, set, c, wrong);
+        var differs = false;
+        for (got.whole, got.ranges) |w, g| differs = differs or !std.mem.eql(u8, w, g);
+        try check.expect(differs, "glm-kda-pieces: the control with a wrong {s} is a difference", .{@tagName(wrong)});
+        var wrote: usize = 0;
+        for (got.whole[0]) |v| wrote += @intFromBool(v != 0xff);
+        try check.expect(wrote > got.whole[0].len / 2, "glm-kda-pieces: the whole chain writes its output", .{});
+    }
+    check.pass("glm-kda-pieces: the planted controls: a wrong conv window and a wrong state each change the bytes, the chain writes its output", .{});
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var prng = std.Random.DefaultPrng.init(7077);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer {
+        for (r.bufs.items) |*b| b.free();
+        r.bufs.deinit(gpu.gpa);
+    }
+    var kda_mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_kda);
+    defer kda_mod.unload();
+    const ks = try kda.Kernels.load(kda_mod);
+    var glue_mod = try cuda.Module.load(gpu.d, cuda.kernels.glm_glue);
+    defer glue_mod.unload();
+    const gk = try glm.glue.Kernels.load(glue_mod);
+    const set: glm.glue.Set = .{ .glue = &gk };
+    try planted(&r, &ks, set);
+    for (cases) |c| {
+        const got = try runCase(&r, &ks, set, c, .none);
+        var name: [128]u8 = undefined;
+        for (got.whole, got.ranges, labels) |w, g, label| {
+            const text = try std.fmt.bufPrint(&name, "glm-kda-pieces: {d} heads, {d} rows in {d} pieces: {s}", .{ c.heads, c.rows, c.pieces, label });
+            try check.sameBytes(text, g, w);
+        }
+    }
+    check.pass("glm-kda-pieces: {d} cases: the chain by ranges equals the whole chain in out, state, saved rows and conv window", .{cases.len});
+}
