diff --git a/zig/src/families/glm/cuda_lanes_step.zig b/zig/src/families/glm/cuda_lanes_step.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6754a8f3facc0f81993e485ace6838cf1a841df7
--- /dev/null
+++ b/zig/src/families/glm/cuda_lanes_step.zig
@@ -0,0 +1,36 @@
+//! One chunk of a stream's prompt pass (Lanes.prefillStep), beside cuda_lanes.zig's other vtable entries.
+const lanes = @import("lanes");
+const share_mod = @import("cuda_share.zig");
+const L = @import("cuda_lanes.zig").Lanes;
+
+/// One chunk of the stream's prompt pass (other rounds run between); true once the first token is drawn.
+pub fn prefillStepFn(ptr: *anyopaque, s: *lanes.Stream, _: u32) anyerror!bool {
+    return prefillStep(L.of(ptr), s);
+}
+pub fn prefillStep(self: anytype, s: *lanes.Stream) !bool {
+    const going: ?usize = if (self.lanes.getPtr(s)) |l| l.fill else null;
+    const from = if (going == null) try self.opening(s) else null;
+    if (going == null) try self.images(s, from);
+    const l = self.lanes.getPtr(s).?;
+    if (going != null) try self.x.bind(l.slot);
+    const at = going orelse if (from) |r| r.at else 0;
+    errdefer l.fill = null;
+    var sink: L.Sink = .{ .gpa = self.x.e.gpa, .s = s };
+    try sink.prepare();
+    self.x.e.prompt_logprobs = sink.want();
+    defer self.x.e.prompt_logprobs = null;
+    var keeps: share_mod.Keeps = undefined;
+    const step = try self.x.chunk(s.prompt(), at, !@import("cuda_prompt_solo.zig").othersDecode(&self.lanes, s), from, .{ .ptr = s, .check = L.cancelled }, self.marksOf(s, &keeps));
+    if (step.first) |first| {
+        lanes.prefill_widths.completed(self.x.e.gpa, s, step.rows);
+        l.first = self.take(first);
+        l.fill = null;
+        return true;
+    }
+    l.fill = at + step.rows; // a cold pass's cut (cuda_prompt_cuts), so uncapped; the share still works by time
+    if (s.settle_step) { // its tail would land in the next decode round's time
+        try self.x.e.stream.synchronize();
+        lanes.prefill_widths.completed(self.x.e.gpa, s, step.rows);
+    }
+    return false;
+}
