-/// glm_index_scores' grid: rows in CTAs of 8, the `nb` pool blocks in runs of score_tiles.
+/// The 64-pool tiles a CTA scores: score_tiles runs for prompt chunks, one tile a CTA for a decode window.
+pub fn tileLoop(rows: usize) usize {
+    return if (rows >= rows_from) score_tiles else 1;
+}
+
+/// glm_index_scores' grid: rows in CTAs of 8, the `nb` pool blocks in runs of tileLoop(rows).
