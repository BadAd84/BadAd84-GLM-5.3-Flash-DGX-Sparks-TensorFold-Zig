From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Subject: [PATCH] glm dsa: remove two duplicated sparse-attention launches (0016's porting slip)

0016 inserted the TF_GLM_OVN_SPARSE_ONEPASS hook but left the original
`latent.sparseAttentionFormat` call in place as well, so both DSA prompt passes ran the
attention TWICE on the default path:

    try latent.sparseAttentionFormat(k.set, ...);   <- the port's copy
    if (k.set.onepass) |f| { ... }                  <- the hook, now stranded
    try latent.sparseAttentionFormat(set, ...);     <- the pin's call

The dense pass (line 169 of the block) and the sparse pass (227) each carried one. A
double launch is not just wasted work: `cuda_kv8_test` counts the sequence-owned scale
reads and measured `expected 1, found 2`, which is how this surfaced.

Both passes now run the hook first and exactly one call after it, the pin's own.

Gates on pin+0001..0029: check-native-cuda-host green, whole-tree fmt green, lean
base-vs-head 0 new, test-cuda-host drops the kv8 failure (3 to 2) with no new ones.
diff --git a/zig/src/families/glm/cuda_dsa_block.zig b/zig/src/families/glm/cuda_dsa_block.zig
index b7fa7d8ba..c2fe61012 100644
--- a/zig/src/families/glm/cuda_dsa_block.zig
+++ b/zig/src/families/glm/cuda_dsa_block.zig
@@ -166,7 +166,6 @@ pub fn attend(k: Kernels, stream: cuda.Stream, l: Layer, c: Caches, s: Scratch,
         if (k.set.onepass) |f| {
             if (onepass.takes(k.set.prompt, c.ls, l.heads, l.lw)) return onepass.run(f, stream, v.qa, c.lc, c.ls, t, v.tokens, v.counts, sparse.width, v.ol, rows, l.heads, scale);
         }
-        try latent.sparseAttentionFormat(k.set, stream, v.qa, c.lc, c.ls, t, v.tokens, v.counts, sparse.width, v.partials, v.ol, rows, l.heads, l.lw, scale);
         if (c.pks != 0) if (kv_host.active) |*g| { // host rows: gather the picks into device slots, attend there
             const slots = try g.gather(k.ops, stream, ix.gate, c.lc, c.pt, t.page_rows, pos, v.tokens, v.counts, rows, sparse.width);
             return latent.sparseAttentionFormat(set, stream, v.qa, slots, 0, .{}, v.tokens, v.counts, sparse.width, v.partials, v.ol, rows, l.heads, l.lw, scale);
@@ -224,7 +223,6 @@ fn attendLastRow(k: Kernels, stream: cuda.Stream, l: Layer, c: Caches, s: Scratc
         try sparse.selectTokensProfile(k.set, k.ops, stream, v.qi, s.ikr + r0 * (ix.d + ix.heads) * 2 + ix.d * 2, ix.d + ix.heads, c.pk, tk, at, host_pos + r0, 1, ix.heads, ix.d, c.pk_rows - 2, v.select, v.tokens, v.counts, null, k.prof);
         var stamp = prof.span(k.prof, stream, .mla);
         defer stamp.end();
-        try latent.sparseAttentionFormat(k.set, stream, v.qa, c.lc, c.ls, t, v.tokens, v.counts, sparse.width, v.partials, v.ol, 1, l.heads, l.lw, scale);
         // TF_GLM_OVN_SPARSE_ONEPASS: prompt rows in one pass a row (production's kernel and bits), no partials or merge
         if (k.set.onepass) |f| {
             if (onepass.takes(false, c.ls, l.heads, l.lw)) return onepass.run(f, stream, v.qa, c.lc, c.ls, t, v.tokens, v.counts, sparse.width, v.ol, rows, l.heads, scale);
