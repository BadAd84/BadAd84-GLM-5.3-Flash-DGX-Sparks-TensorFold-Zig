new file mode 100644
index 0000000000000000000000000000000000000000..562d69f3a75e858fb0e973ab556658d95b2cc25e
--- /dev/null
+++ b/zig/src/cuda/ovn.zig
@@ -0,0 +1,77 @@
+//! Speed-hunt knobs (`TF_GLM_OVN_<NAME>`): each a `.glm` row of platform/environment.zig, read once a process.
+const std = @import("std");
+const environment = @import("sys").environment;
+
+/// One setting's cache: `key` names it, giving every knob its own type and statics.
+fn Cache(comptime key: [:0]const u8) type {
+    return struct {
+        const name = key; // the knob this cache holds; a distinct key is a distinct type
+        var read = false;
+        var text: ?[]const u8 = null; // the environment's text, null when unset
+        var value: environment.Error!?u64 = null; // `text` as its row parses it: null when unset or blank
+    };
+}
+
+/// `key`'s value as its row parses it, read once; a name without a row does not compile.
+fn get(comptime key: [:0]const u8) environment.Error!?u64 {
+    comptime environment.registered(key);
+    if (!Cache(key).read) set(key, @import("profile").lookup(key));
+    return Cache(key).value;
+}
+
+/// `key` holds `raw` from now on; text its row refuses is logged by name and kept as the error.
+fn set(comptime key: [:0]const u8, raw: ?[]const u8) void {
+    const S = Cache(key);
+    S.text = raw;
+    S.value = if (environment.check(key, raw)) |_| environment.parse(key, raw) else |err| err;
+    S.read = true;
+}
+
+/// `TF_GLM_OVN_<name>` as a switch: its row takes 0 or 1, unset or blank is off; GLM's open refuses other text.
+pub fn on(comptime name: []const u8) bool {
+    return ((get("TF_GLM_OVN_" ++ name) catch null) orelse 0) != 0;
+}
+
+/// `TF_GLM_OVN_<name>` as its row's whole number; unset or blank is `default`, text the row refuses an error.
+pub fn int(comptime name: []const u8, default: u64) error{BadOvnKnob}!u64 {
+    return (get("TF_GLM_OVN_" ++ name) catch return error.BadOvnKnob) orelse default;
+}
+
+/// `TF_GLM_OVN_<name>` as its row's finite real (unset or blank: null); text the row refuses is an error.
+pub fn real(comptime name: []const u8) error{BadOvnKnob}!?f64 {
+    const n = (get("TF_GLM_OVN_" ++ name) catch return error.BadOvnKnob) orelse return null;
+    return @bitCast(n);
+}
+
+/// `TF_GLM_OVN_<name>`'s text as its `.path` row keeps it (no control characters; unset or blank: null).
+pub fn text(comptime name: []const u8) error{BadOvnKnob}!?[]const u8 {
+    const key = "TF_GLM_OVN_" ++ name;
+    _ = get(key) catch return error.BadOvnKnob;
+    return environment.path(key, Cache(key).text) catch error.BadOvnKnob;
+}
+
+/// Test-only override: a knob holds `value` as if the environment did (an in-process read, checked by its row).
+pub fn fake(comptime name: []const u8, value: ?[]const u8) void {
+    if (!@import("builtin").is_test) @compileError("ovn.fake is for tests");
+    set("TF_GLM_OVN_" ++ name, value);
+}
+
+test "ovn: a setting reads as its row parses it, and every name keeps its own value" {
+    set("TF_GLM_PROF", "1");
+    set("TF_GLM_DFLASH2_LOG", null);
+    try std.testing.expectEqual(@as(?u64, 1), try get("TF_GLM_PROF"));
+    try std.testing.expectEqual(@as(?u64, null), try get("TF_GLM_DFLASH2_LOG"));
+    set("TF_GLM_DFLASH2_LOG", "8");
+    try std.testing.expectEqual(@as(?u64, 8), try get("TF_GLM_DFLASH2_LOG"));
+    try std.testing.expectEqual(@as(?u64, 1), try get("TF_GLM_PROF"));
+}
+
+test "ovn: blank text is unset and text the row refuses is an error" {
+    set("TF_GLM_PROF", " \t");
+    try std.testing.expectEqual(@as(?u64, null), try get("TF_GLM_PROF"));
+    for ([_][]const u8{ "yes", "2", "01" }) |bad| {
+        set("TF_GLM_PROF", bad);
+        try std.testing.expectError(error.InvalidEnvironment, get("TF_GLM_PROF"));
+    }
+    set("TF_GLM_PROF", null);
+}
