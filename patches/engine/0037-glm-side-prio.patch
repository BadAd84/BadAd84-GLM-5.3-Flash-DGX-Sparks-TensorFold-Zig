diff --git a/zig/src/families/glm/cuda_forward_pieces.zig b/zig/src/families/glm/cuda_forward_pieces.zig
index c713c513f..353b1a27f 100644
--- a/zig/src/families/glm/cuda_forward_pieces.zig
+++ b/zig/src/families/glm/cuda_forward_pieces.zig
@@ -36,10 +36,15 @@ pub const Pieces = struct {
     shared: [max_pieces]cuda.Event, // split: every rank's glued rows of a piece in
     owns_side: bool = true, // a paired step's second chunk (initTwin) runs on the first's side stream
 
-    /// With `pair` (TF_GLM_PROMPT_PAIR) the side stream runs at the highest priority, ahead of the main stream's grids.
-    pub fn init(d: *const cuda.Driver, count: usize, pair: bool) !Pieces {
+    /// Whether the side stream runs at the highest priority: with a pair (TF_GLM_PROMPT_PAIR) or TF_GLM_OVN_SIDE_PRIO.
+    pub fn high(pair: bool) bool {
+        return pair or cuda.ovn.on("SIDE_PRIO");
+    }
+
+    /// With `at_high` the side stream runs at the highest priority, ahead of the main stream's grids.
+    pub fn init(d: *const cuda.Driver, count: usize, at_high: bool) !Pieces {
         if (count == 0 or count > max_pieces) return error.BadPieces;
-        return make(d, count, if (pair) try cuda.Stream.initPriority(d, .highest) else try cuda.Stream.init(d, false), true);
+        return make(d, count, if (at_high) try cuda.Stream.initPriority(d, .highest) else try cuda.Stream.init(d, false), true);
     }
 
     /// A paired step's second chunk on `of`'s side stream: every rank posts both chunks' exchanges in one order.
diff --git a/zig/src/families/glm/cuda_side_prio_test.zig b/zig/src/families/glm/cuda_side_prio_test.zig
new file mode 100644
index 000000000..219a71612
--- /dev/null
+++ b/zig/src/families/glm/cuda_side_prio_test.zig
@@ -0,0 +1,16 @@
+//! TF_GLM_OVN_SIDE_PRIO: which prompt exchanges' side streams run at the highest priority.
+const std = @import("std");
+const cuda = @import("cuda");
+const Pieces = @import("cuda_forward_pieces.zig").Pieces;
+
+test "TF_GLM_OVN_SIDE_PRIO: the side stream is at the highest priority with a pair or the switch, and not otherwise" {
+    defer cuda.ovn.fake("SIDE_PRIO", null);
+    cuda.ovn.fake("SIDE_PRIO", null);
+    try std.testing.expect(!Pieces.high(false));
+    try std.testing.expect(Pieces.high(true));
+    cuda.ovn.fake("SIDE_PRIO", "1");
+    try std.testing.expect(Pieces.high(false));
+    cuda.ovn.fake("SIDE_PRIO", "0");
+    try std.testing.expect(!Pieces.high(false));
+    try std.testing.expect(Pieces.high(true));
+}
