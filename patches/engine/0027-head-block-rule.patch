diff --git a/zig/src/families/glm/cuda_latent.zig b/zig/src/families/glm/cuda_latent.zig
index 781843f0f9420d3e4a3398f45b51aad783a1d20f..eb4fe7a145da967379556acf53ef978f3bb8cf0a 100644
--- a/zig/src/families/glm/cuda_latent.zig
+++ b/zig/src/families/glm/cuda_latent.zig
@@ -17,6 +17,12 @@ pub fn headBlock(rows: usize) usize {
     return if (rows >= 64) heads_tile_wide else heads_tile;
 }
 
+/// The head block a launch takes with its head count in view: TP=3's 17-24 heads widen from 5 rows.
+pub fn headBlockOf(rows: usize, heads: usize) usize {
+    if (rows >= prompt_rows) return heads_tile_wide;
+    return if (rows >= 5 and heads >= 17 and heads <= 24) heads_tile_wide else heads_tile;
+}
+
 /// latent.chunks_for: 512-key chunks to cover `length` keys.
 pub fn chunksFor(length: usize) usize {
     return (length + chunk - 1) / chunk;
@@ -152,7 +158,7 @@ pub fn sparseAttention(set: glue.Set, stream: cuda.Stream, qa: u64, cache: u64,
 
 pub fn sparseAttentionFormat(set: glue.Set, stream: cuda.Stream, qa: u64, cache: u64, scales: u64, t: Table, tokens: u64, counts: u64, w: usize, p: Partials, out: u64, rows: usize, heads: usize, lw: usize, scale: f32) !void {
     const nch = chunksFor(w);
-    const hb = headBlock(rows); // the pin's headBlock takes rows alone
+    const hb = headBlockOf(rows, heads); // 17-24 heads widen from 5 rows
     if (fuses(set.mla, rows, hb)) return fused(set, stream, qa, cache, scales, t, 0, tokens, counts, out, rows, heads, lw, nch, w, scale, true);
     try chunks(set, stream, qa, cache, scales, t, 0, tokens, counts, p, rows, heads, lw, nch, w, scale, hb, true);
     try merge(set, stream, p, out, counts, rows, heads, lw, nch, true);
@@ -167,6 +173,8 @@ fn merge(set: glue.Set, stream: cuda.Stream, p: Partials, out: u64, counts: u64,
 
 test "latent.py's tiling rules" {
     try std.testing.expectEqual(@as(usize, 16), headBlock(8));
+    try std.testing.expectEqual(@as(usize, 32), headBlockOf(8, 22)); // 17-24 heads widen from 5 rows
+    try std.testing.expectEqual(@as(usize, 16), headBlockOf(2, 22));
     try std.testing.expectEqual(@as(usize, 32), headBlock(64));
     try std.testing.expectEqual(@as(usize, 3), chunksFor(1025));
     try std.testing.expectEqual(@as(usize, 1), chunksFor(512));
