@@ -37,9 +37,19 @@ pub fn resumes(len: usize, cuts: []const u32, at: u32, kept_below: u64) bool {
     return coldCut(len, cuts, at) and kept_below == below(cuts, at);
 }
 
+/// A solo step's rows: the plan's next two chunks, the first a grid step; `to_start`: the second may end at a start.
+pub fn soloRows(len: usize, cuts: []const u32, start: usize, to_start: bool) ?usize {
+    const mid = start + prefill_rows;
+    if (nextCut(len, cuts, start) != mid) return null;
+    const end = nextCut(len, cuts, mid);
+    if (!to_start and end != @min(len, start + state.solo_rows)) return null;
+    return end - start;
+}
+
 /// Rank 0's step rows from `start` (Leader.chunk): a solo or paired step's if `wide`, else to the next cut.
-pub fn leaderRows(len: usize, cuts: []const u32, start: usize, wide: bool) usize {
-    return if (wide) state.solo_rows else nextCut(len, cuts, start) - start;
+pub fn leaderRows(len: usize, cuts: []const u32, start: usize, wide: bool, to_start: bool) !usize {
+    if (!wide) return nextCut(len, cuts, start) - start;
+    return soloRows(len, cuts, start, to_start) orelse error.BadChunk;
 }
 
 /// A sequence's request chunk starts (TF_GLM_REQUEST_STARTS) into `list`: ascending and after 0, else error.BadCuts.
@@ -55,13 +65,11 @@ pub fn cutInside(cuts: []const u32, start: usize, rows: usize) bool {
     return false;
 }
 
-/// A prompt step's rows from `start` with `part_len` ids: to the next cut, or a solo pass's when no start is inside it.
-pub fn stepRows(len: usize, cuts: []const u32, start: usize, part_len: usize) !usize {
+/// A prompt step's rows from `start` with `part_len` ids: to the next cut, or soloRows' for a longer part.
+pub fn stepRows(len: usize, cuts: []const u32, start: usize, part_len: usize, to_start: bool) !usize {
     if (start >= len or !coldCut(len, cuts, start)) return error.BadChunk;
     if (part_len <= prefill_rows + 1) return nextCut(len, cuts, start) - start;
-    const rows = @min(len - start, state.solo_rows);
-    if (cutInside(cuts, start, rows)) return error.BadChunk; // a solo pass would step over a request start
-    return rows;
+    return soloRows(len, cuts, start, to_start) orelse error.BadChunk; // a solo pass would step over a request start
 }
 
