+/// The starts the server sends (chunk_plan Plan.starts and withCut): a grid step from each start or message, and `cut`.
+fn planStarts(buf: []u32, len: usize, messages: []const u32, cut: u32) []const u32 {
+    const min_chunk = @import("cuda_native.zig").request_min_chunk;
+    var plan: [64]u32 = undefined;
+    var n: usize = 0;
+    var last: usize = 0;
+    var i: usize = 0;
+    while (true) {
+        while (i < messages.len and messages[i] < last + min_chunk) i += 1; // too close to the last start: merged
+        var next = last + prefill_rows;
+        if (i < messages.len and messages[i] < next) next = messages[i];
+        if (next >= len) break;
+        plan[n] = @intCast(next);
+        n += 1;
+        last = next;
+    }
+    var out: usize = 0;
+    for (plan[0..n]) |s| if (@max(s, cut) - @min(s, cut) >= min_chunk) { // starts too near the cut go
+        buf[out] = s;
+        out += 1;
+    };
+    buf[out] = cut;
+    out += 1;
+    std.mem.sort(u32, buf[0..out], {}, std.sort.asc(u32));
+    return buf[0..out];
+}
