-/// Rank 0's choice for the step at `start`; not beside what reads a chunk's rows, nor with request starts (cut there).
+/// Rank 0's choice for the step at `start`; not beside what reads a chunk's rows, nor across a request start.
 pub fn at(e: *const Engine, start: usize, len: usize, from: ?engine.Resume, marks: ?engine.Marks) bool {
-    if (e.bp.rows < fw.solo_rows or e.prompt_logprobs != null or e.prompt_profs[3] != null or e.cur.cuts.items.len > 0) return false;
+    if (e.bp.rows < fw.solo_rows or e.prompt_logprobs != null or e.prompt_profs[3] != null) return false;
     if (e.images) |v| if (v.rowCount() > 0) return false;
     if (!takesTwo(start, len, if (marks) |m| m.at else &.{})) return false;
+    if (prompt_cuts.cutInside(e.cur.cuts.items, start, rowsAt(start, len))) return false; // the cold plan cuts there
     // a resumed step restores its kept state, and the rings' base, after this choice
     const base = if (from) |r| (e.snaps.get(r.id) orelse return false).bases[0] else e.cur.st.base;
     return ringsAgree(base, e.cur.st.ring_rows, start, rowsAt(start, len));
@@ -42,7 +44,8 @@
 
 /// Whether a pass of `rows` past a chunk may run: `at`'s rule on every rank, its kept state restored.
 pub fn allowed(e: *const Engine, start: usize, rows: usize) bool {
-    if (e.bp.rows < rows or e.prompt_logprobs != null or e.cur.cuts.items.len > 0) return false;
+    if (e.bp.rows < rows or e.prompt_logprobs != null) return false;
+    if (prompt_cuts.cutInside(e.cur.cuts.items, start, rows)) return false;
     return ringsAgree(e.cur.st.base, e.cur.st.ring_rows, start, rows);
 }
 
@@ -85,3 +88,34 @@
     try std.testing.expectEqual(@as(usize, fw.prefill_rows), bufferRows(false));
     try std.testing.expectEqual(@as(usize, fw.solo_rows), bufferRows(true));
 }
+
+test "a solo pass: taken between request starts, refused where one is inside it, in rank 0's choice and the check" {
+    const gpa = std.testing.allocator;
+    const C = fw.prefill_rows;
+    const Seq = @import("cuda_engine_types.zig").Seq;
+    var seq: Seq = .{ .st = undefined };
+    defer seq.cuts.deinit(gpa);
+    seq.st.base = 0;
+    seq.st.ring_rows = fw.solo_rows; // a pass from past C rebases the rings at its first row, as chunks do
+    var e: Engine = undefined;
+    e.bp.rows = fw.solo_rows;
+    e.prompt_logprobs = null;
+    e.prompt_profs = @splat(null);
+    e.images = null;
+    e.cur = &seq;
+    const len = 5 * C + 7;
+    const start = C + 12;
+    const cases = [_]struct { cuts: []const u32, solo: bool }{
+        .{ .cuts = &.{}, .solo = true },
+        .{ .cuts = &.{start}, .solo = true }, // a start where the step begins
+        .{ .cuts = &.{ start, start + fw.solo_rows }, .solo = true }, // and one where it ends
+        .{ .cuts = &.{ start, start + C }, .solo = false }, // one at its middle grid point
+        .{ .cuts = &.{ start, start + fw.solo_rows - 1 }, .solo = false }, // one row before its end
+        .{ .cuts = &.{ 100, start + 1 }, .solo = false }, // one row in
+    };
+    for (cases) |c| {
+        try prompt_cuts.set(gpa, &seq.cuts, c.cuts);
+        try std.testing.expectEqual(c.solo, at(&e, start, len, null, null));
+        try std.testing.expectEqual(c.solo, allowed(&e, start, fw.solo_rows));
+    }
+}
