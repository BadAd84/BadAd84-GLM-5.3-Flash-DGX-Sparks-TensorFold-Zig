+/// The starts the server sends (chunk_plan Plan.starts and withCut): a grid step from each start or message, and `cut`.
+fn planStarts(buf: []u32, len: usize, messages: []const u32, cut: u32) []const u32 {
+    const min_chunk = @import("cuda_native.zig").request_min_chunk;
+    var plan: [64]u32 = undefined;
+    var n: usize = 0;
+    var last: usize = 0;
+    var i: usize = 0;
+    while (true) {
+        while (i < messages.len and messages[i] < last + min_chunk) i += 1; // too close to the last start: merged
+        var next = last + prefill_rows;
+        if (i < messages.len and messages[i] < next) next = messages[i];
+        if (next >= len) break;
+        plan[n] = @intCast(next);
+        n += 1;
+        last = next;
+    }
+    var out: usize = 0;
+    for (plan[0..n]) |s| if (@max(s, cut) - @min(s, cut) >= min_chunk) { // starts too near the cut go
+        buf[out] = s;
+        out += 1;
+    };
+    buf[out] = cut;
+    out += 1;
+    std.mem.sort(u32, buf[0..out], {}, std.sort.asc(u32));
+    return buf[0..out];
+}
+
+test "glm request starts: the server's list has a start every grid step, and a walk takes solo steps between messages" {
+    // lists as the server sends them: a start at every grid step from the last start, so a solo step always spans one
+    const cases = [_]struct { len: usize, messages: []const u32, cut: u32 }{
+        .{ .len = 30 * prefill_rows + 5, .messages = &.{}, .cut = 12 }, // a system end, then one long message
+        .{ .len = 30 * prefill_rows + 5, .messages = &.{20 * prefill_rows + 301}, .cut = 12 }, // and a message deep in
+        .{ .len = 12 * prefill_rows, .messages = &.{ 5 * prefill_rows + 1, 5 * prefill_rows + 701 }, .cut = 4 },
+        .{ .len = 9 * prefill_rows + 3, .messages = &.{}, .cut = 1000 },
+    };
+    var buf: [64]u32 = undefined;
+    var solo_steps: usize = 0;
+    var off_pool: usize = 0;
+    for (cases) |c| {
+        const cuts = planStarts(&buf, c.len, c.messages, c.cut);
+        try std.testing.expect(cuts.len >= c.len / prefill_rows);
+        var start: usize = 0;
+        while (start < c.len) {
+            try std.testing.expect(coldCut(c.len, cuts, start));
+            const left = c.len - start;
+            const takes_two = start + prefill_rows + 1 < c.len; // prompt_solo.takesTwo
+            const wide = takes_two and !cutInside(cuts, start, @min(left, state.solo_rows)); // as prompt_solo.at
+            if (takes_two) { // solo exactly where the plan's next two chunks are the grid's two
+                const first = nextCut(c.len, cuts, start);
+                const two = first == start + prefill_rows and nextCut(c.len, cuts, first) == start + @min(left, state.solo_rows);
+                try std.testing.expectEqual(two, wide);
+            }
+            const n = leaderRows(c.len, cuts, start, wide);
+            const rows = try stepRows(c.len, cuts, start, @min(left, n + 1));
+            try std.testing.expectEqual(@min(left, n), rows);
+            solo_steps += @intFromBool(wide);
+            off_pool += @intFromBool(wide and start % 4 != 0);
+            start += rows;
+        }
+        try std.testing.expectEqual(c.len, start);
+    }
+    try std.testing.expect(solo_steps > 25);
+    try std.testing.expect(off_pool > 5); // the grid from a message start is off the pool's edge
+}
