             }
@@ -189,6 +213,31 @@
     }
 }
 
+test "glm request starts: a walk taking solo steps where no start is inside them starts every step on a cold cut" {
+    const extra = [_]Pass{
+        .{ .len = 5 * prefill_rows + 7, .cuts = &.{500} },
+        .{ .len = 9 * prefill_rows, .cuts = &.{ 10, 2 * prefill_rows + 10 } },
+        .{ .len = 6 * prefill_rows, .cuts = &.{ 700, 700 + state.solo_rows, 700 + 2 * state.solo_rows } },
+    };
+    var solo_steps: usize = 0;
+    for (passes ++ extra) |c| {
+        var start: usize = 0;
+        while (start < c.len) {
+            try std.testing.expect(coldCut(c.len, c.cuts, start));
+            const left = c.len - start;
+            const takes_two = start + prefill_rows + 1 < c.len; // prompt_solo.takesTwo
+            const wide = takes_two and !cutInside(c.cuts, start, @min(left, state.solo_rows)); // as prompt_solo.at
+            const n = leaderRows(c.len, c.cuts, start, wide);
+            const rows = try stepRows(c.len, c.cuts, start, @min(left, n + 1));
+            try std.testing.expectEqual(@min(left, n), rows);
+            solo_steps += @intFromBool(wide);
+            start += rows;
+        }
+        try std.testing.expectEqual(c.len, start);
+    }
+    try std.testing.expect(solo_steps > 5);
+}
+
