+    try std.testing.expectEqual(s, try stepRows(3 * m, &.{}, 0, s + 1));
     try std.testing.expectEqual(@as(usize, 500), try stepRows(3 * m, &.{500}, 0, 501));
     try std.testing.expectEqual(@as(usize, m), try stepRows(3 * m, &.{500}, 500, m + 1));
-    try std.testing.expectError(error.BadChunk, stepRows(3 * m, &.{500}, 0, state.solo_rows + 1));
+    try std.testing.expectError(error.BadChunk, stepRows(3 * m, &.{500}, 0, s + 1));
     try std.testing.expectError(error.BadChunk, stepRows(3 * m, &.{500}, m, m + 1)); // the old grid point, not a cut here
     try std.testing.expectError(error.BadChunk, stepRows(3 * m, &.{}, 3 * m, 1));
+    // a solo step from a start has none inside it, and a start at its end is fine
+    try std.testing.expectEqual(s, try stepRows(5 * m, &.{500}, 500, s + 1));
+    try std.testing.expectEqual(s, try stepRows(5 * m, &.{ 500, 500 + s }, 500, s + 1));
+    // a start at its middle grid point, or one row short of its end, is inside it
+    try std.testing.expectError(error.BadChunk, stepRows(5 * m, &.{ 500, 500 + m }, 500, s + 1));
+    try std.testing.expectError(error.BadChunk, stepRows(5 * m, &.{ 500, 500 + s - 1 }, 500, s + 1));
+}
+
+test "glm request starts: a start is inside a step when it falls past the step's first row and before its end" {
+    const s: usize = state.solo_rows;
+    try std.testing.expect(!cutInside(&.{}, 0, s));
+    try std.testing.expect(!cutInside(&.{500}, 500, s)); // where the step begins
+    try std.testing.expect(cutInside(&.{500}, 499, s)); // one row in
+    try std.testing.expect(cutInside(&.{s - 1}, 0, s)); // one row before its end
+    try std.testing.expect(!cutInside(&.{s}, 0, s)); // at its end
+    try std.testing.expect(!cutInside(&.{ 100, 200 }, 200, s)); // before it
 }
 
