+/// Whether a start is inside the step of `rows` from `start`: past its first row, before its end, not at its middle.
+pub fn cutInside(cuts: []const u32, start: usize, rows: usize) bool {
+    for (cuts) |c| if (c > start and c < start + rows and c != start + prefill_rows) return true;
+    return false;
+}
+
+/// A prompt step's rows from `start` with `part_len` ids: to the next cut, or soloRows' for a longer part.
+pub fn stepRows(len: usize, cuts: []const u32, start: usize, part_len: usize, to_start: bool) !usize {
     if (start >= len or !coldCut(len, cuts, start)) return error.BadChunk;
     if (part_len <= prefill_rows + 1) return nextCut(len, cuts, start) - start;
-    if (cuts.len > 0) return error.BadChunk; // a solo pass would step over a request start
-    return @min(len - start, state.solo_rows);
+    return soloRows(len, cuts, start, to_start) orelse error.BadChunk; // a solo pass would step over a request start
 }
 
