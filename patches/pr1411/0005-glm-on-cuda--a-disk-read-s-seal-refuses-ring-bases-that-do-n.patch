From d526c36df9074154c1425e9430eb5daaf3866b76 Mon Sep 17 00:00:00 2001
From: Robert Wojciechowski <24755+wojo@users.noreply.github.com>
Date: Tue, 27 Oct 2026 12:12:18 -0400
Subject: [PATCH] GLM on CUDA: a disk read's seal refuses ring bases that do not hold the state's rows

An index ring based at `base` holds the rows from `base` up to the state's position, and the image keeps
at most a ring's rows of each. The seal now checks the words' main base against the state's position and
the head's base against its rows, so an image whose words name a ring that starts past them, or too far
back to be held, is refused before the blank state is made whole.
---

diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
index cf959b98d7233cbe98d9ca178a7ff9e549ca8079..57b4633f22e01332a23473eb0849c8ed103bea6b 100644
--- a/zig/src/families/glm/cuda_disk_image_test.zig
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -260,6 +260,8 @@ test "GLM disk image: a disk read's blank state is refused until sealed, and its
     try expectError(error.UnsealedState, snaps.restore(&e, 7));
     try expectError(error.DiskWords, snaps.seal(&e, 7, at + @import("cuda_state.zig").window_rows + 1, .{ 0, 0 }, 0)); // a head past its verify window
     try expectError(error.DiskWords, snaps.seal(&e, 7, at, .{ 0, 0 }, @as(u64, 1) << @intCast(e.cur.st.cur.len))); // a copy bit no layer has
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at - 1, .{ at + 1, 0 }, 0)); // a main ring based past the state
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at - 1, .{ 0, at }, 0)); // a head ring based past its rows
     try snaps.seal(&e, 7, at - 1, .{ 3, 5 }, 0b01);
     const s = e.snaps.get(7).?;
     const sh = try image.Shape.of(&e.cur.st, &e.c, capacity, true);
@@ -268,6 +270,22 @@ test "GLM disk image: a disk read's blank state is refused until sealed, and its
     try expectEqual([2]usize{ 3, 5 }, s.bases);
     try std.testing.expectEqualSlices(u1, &.{ 1, 0 }, s.cur);
     try expectError(error.StateKept, snaps.seal(&e, 7, at, .{ 0, 0 }, 0));
+    const far: u32 = capacity - 1024; // a state past the rings' rows
+    const back: u32 = far - @as(u32, @intCast(e.cur.st.ring_rows)); // the least base whose ring still holds its rows
+    try snaps.blankAs(&e, 8, far);
+    defer {
+        var held = e.snaps.get(8).?;
+        snaps.free(&e, &held);
+    }
+    try expectError(error.DiskWords, snaps.seal(&e, 8, far, .{ back - 1, back }, 0)); // a main ring too far back
+    try expectError(error.DiskWords, snaps.seal(&e, 8, far, .{ back, back - 1 }, 0)); // a head ring too far back
+    try snaps.seal(&e, 8, far, .{ back, back }, 0);
+    try snaps.blankAs(&e, 9, far);
+    defer {
+        var held = e.snaps.get(9).?;
+        snaps.free(&e, &held);
+    }
+    try snaps.seal(&e, 9, 0, .{ back, 0 }, 0); // no head rows yet (as without drafts): the main ring holds the state's rows
 }
 
 /// A state's store image at `at` for two ranks, rank 1's prefix a copy of rank 0's: what the load's probe gathers.
diff --git a/zig/src/families/glm/cuda_snapshots.zig b/zig/src/families/glm/cuda_snapshots.zig
index bc6d314ed3844ff9a149020868994588853f0fe4..da47e99e171e69546028a05d2761507d6a3444d1 100644
--- a/zig/src/families/glm/cuda_snapshots.zig
+++ b/zig/src/families/glm/cuda_snapshots.zig
@@ -131,6 +131,11 @@ pub fn blankAs(e: anytype, id: u64, at: usize) !void {
     e.snaps.putAssumeCapacityNoClobber(id, .{ .lease = lease, .len = 0, .pos = at, .mtp_len = 0, .cur = cur, .bases = .{ 0, 0 } });
 }
 
+/// Whether an index ring of `rows` rows based at `base` holds every row up to `len`, as the image's ring bytes do.
+fn ringHolds(base: usize, len: usize, rows: usize) bool {
+    return base <= len and len - base <= rows;
+}
+
 /// A blank state made whole from its image's words (its bytes are in or follow): a restore takes it from here.
 pub fn seal(e: anytype, id: u64, mtp_len: usize, bases: [2]usize, cur: u64) !void {
     const s = e.snaps.getPtr(id) orelse return error.NoKeptState;
@@ -138,6 +143,8 @@ pub fn seal(e: anytype, id: u64, mtp_len: usize, bases: [2]usize, cur: u64) !voi
     if (s.cur.len > 64 or (s.cur.len < 64 and cur >> @intCast(s.cur.len) != 0)) return error.DiskWords;
     const head = if (e.mtp) @min(e.capacity, s.pos + @import("cuda_state.zig").window_rows) else 0;
     if (mtp_len > head) return error.DiskWords;
+    const rows = e.cur.st.ring_rows;
+    if (!ringHolds(bases[0], s.pos, rows) or !ringHolds(bases[1], mtp_len, rows)) return error.DiskWords;
     const n = try layout.Plan.size(&e.cur.st, &e.c, e.capacity, s.pos, if (e.mtp) mtp_len else null, s.shared);
     if (n == 0 or n > s.lease.ids.items.len * pages.page) return error.SnapshotSize;
     for (s.cur, 0..) |*b, i| b.* = @intCast(cur >> @intCast(i) & 1);
