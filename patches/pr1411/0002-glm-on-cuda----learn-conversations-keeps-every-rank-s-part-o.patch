+
+fn whole(ptr: *anyopaque, saved: api.prompt_cache.Saved) bool {
+    const k: *Kept = @ptrCast(@alignCast(saved));
+    const s = engineOf(ptr).snaps.get(k.id) orelse return false;
+    return s.len != 0;
