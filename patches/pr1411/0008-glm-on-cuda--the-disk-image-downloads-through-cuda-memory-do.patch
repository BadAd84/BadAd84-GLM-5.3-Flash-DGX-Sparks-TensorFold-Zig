From 5361d4ecbe0fcc6180d1583f2052170a0656da14 Mon Sep 17 00:00:00 2001
From: Robert Wojciechowski <24755+wojo@users.noreply.github.com>
Date: Fri, 6 Nov 2026 22:46:26 -0500
Subject: [PATCH] GLM on CUDA: the disk image downloads through cuda.memory.download, the shared-store refusal names TF_KV_SHARE

- A kept state's device pages are read out with cuda.memory.download, which stages through the pinned buffer on an
  integrated GPU (#2103, #2289), as every other synchronous readback does; the copy back in stays a direct HtoD.
- The refusal beside share_pages names TF_KV_SHARE, the switch behind it since #2211, in its message and comment.
- The disk image test's driver answers cuCtxGetDevice and cuDeviceGetAttribute (a discrete card).
---

diff --git a/zig/src/families/glm/cuda_disk_image.zig b/zig/src/families/glm/cuda_disk_image.zig
index 20edee5139c523ad88ea284f90289d97232c0ea1..706a224b161b0190ed25ad97da821bfa69455fbe 100644
--- a/zig/src/families/glm/cuda_disk_image.zig
+++ b/zig/src/families/glm/cuda_disk_image.zig
@@ -268,7 +268,7 @@ pub const Copy = struct {
             const dev = arena.ptr() + @as(u64, c.lease.ids.items[@intCast(x / pages.page)]) * pages.page + x % pages.page;
             const p = host[done..][0..n];
             if (out) {
-                try c.d.check(c.d.api.cuMemcpyDtoH_v2(p.ptr, dev, n), "cuMemcpyDtoH");
+                try cuda.memory.download(c.d, dev, p); // staged through the pinned buffer on an integrated GPU
             } else try c.d.check(c.d.api.cuMemcpyHtoD_v2(dev, p.ptr, n), "cuMemcpyHtoD");
             done += n;
         }
diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
index 57b4633f22e01332a23473eb0849c8ed103bea6b..77a5c3e3b232322cdf580ab070b14e2437b0c8c3 100644
--- a/zig/src/families/glm/cuda_disk_image_test.zig
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -54,6 +54,14 @@ pub const H = struct {
     fn wait(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
         return 0;
     }
+    fn contextDevice(out: *cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0;
+        return 0;
+    }
+    fn deviceAttribute(out: *c_int, _: cuda.abi.DeviceAttribute, _: cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0; // a discrete card: cuda.memory.download copies straight to the host
+        return 0;
+    }
     pub fn driver() cuda.Driver {
         var d: cuda.Driver = undefined;
         d.api.cuMemAlloc_v2 = alloc;
@@ -63,6 +71,8 @@ pub const H = struct {
         d.api.cuMemcpyDtoH_v2 = dtoh;
         d.api.cuMemcpyHtoD_v2 = htod;
         d.api.cuStreamSynchronize = wait;
+        d.api.cuCtxGetDevice = contextDevice;
+        d.api.cuDeviceGetAttribute = deviceAttribute;
         return d;
     }
 };
diff --git a/zig/src/native/cuda_glm_disk.zig b/zig/src/native/cuda_glm_disk.zig
index 6b61eacfb4a36d84276c9c93596b75a492d96f52..4798d2f80a0d68b631559f70ae914e7f8c74400e 100644
--- a/zig/src/native/cuda_glm_disk.zig
+++ b/zig/src/native/cuda_glm_disk.zig
@@ -161,9 +161,9 @@ fn probe(a: Allocator, io: std.Io, backend: lanes.backend.Backend, e: *Engine) !
     return .{ .hash = std.hash.Wyhash.hash(0x676c6d, bytes), .rate = @as(f64, @floatFromInt(toks.len)) / (@as(f64, @floatFromInt(@max(ns, 1))) / 1e9) };
 }
 
-/// What --learn-conversations refuses before it reads a rank: TF_GLM_KV_SHARE, and more ranks than `prefix_buf` holds.
+/// What --learn-conversations refuses before it reads a rank: TF_KV_SHARE, and more ranks than `prefix_buf` holds.
 fn refusal(e: *const Engine) !void {
-    // TF_GLM_KV_SHARE leaves a kept state's prefix pages in the pool's prompt cache, outside the lease the image reads
+    // TF_KV_SHARE leaves a kept state's prefix pages in the pool's prompt cache, outside the lease the image reads
     if (e.share_pages) return error.KvShareWithLearnConversations;
     if (e.share.world > prefix_buf.len) return error.TooManyRanks;
 }
@@ -172,7 +172,7 @@ fn refusal(e: *const Engine) !void {
 pub fn attach(a: Allocator, io: std.Io, ctx: *const cuda.Context, o: api.Open, root: []const u8, kernels: ?[]const u8, loaded: anytype, store: *api.prompt_cache.Store) !void {
     const e: *Engine = loaded.target;
     refusal(e) catch |err| {
-        if (err == error.KvShareWithLearnConversations) std.log.err("--learn-conversations: GLM-5.3-Flash's disk images read a kept state's whole lease, and TF_GLM_KV_SHARE leaves its prefix pages out of it; serve without one of them", .{});
+        if (err == error.KvShareWithLearnConversations) std.log.err("--learn-conversations: GLM-5.3-Flash's disk images read a kept state's whole lease, and TF_KV_SHARE leaves its prefix pages out of it; serve without one of them", .{});
         return err;
     };
     try ranks.prefixes(e, prefix_buf[0..e.share.world], window_buf[0..e.share.world]);
@@ -195,7 +195,7 @@ pub fn attach(a: Allocator, io: std.Io, ctx: *const cuda.Context, o: api.Open, r
     std.log.info("glm: conversation states on disk in {s} ({d} states, {d} MiB of {d} MiB; {d} ranks' parts)", .{ r.dir, r.states.items.len, r.held() >> 20, r.cap >> 20, prefixes.len });
 }
 
-test "GLM disk attach: TF_GLM_KV_SHARE and more ranks than the prefixes hold are refused by name" {
+test "GLM disk attach: TF_KV_SHARE and more ranks than the prefixes hold are refused by name" {
     const e = try std.testing.allocator.create(Engine);
     defer std.testing.allocator.destroy(e);
     e.share_pages = false;
