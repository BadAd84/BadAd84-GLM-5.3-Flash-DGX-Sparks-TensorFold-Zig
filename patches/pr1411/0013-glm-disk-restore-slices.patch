+
+/// Once a turn, outside the lock: the restore under way takes a slice (the rest when none is admitted), or one begins.
+pub fn slice(h: *LaneHost) void {
+    const store = h.cache orelse return;
+    if (h.disk.restore) |x| return advance(h, store, x);
+    if (slices.budget() == 0) return;
+    const job = next(h) orelse return;
+    var guard = @import("lane_cache_queue.zig").Snapshot.init(h, job) catch return;
+    defer guard.entries.deinit(h.gpa);
+    const before = store.reservation_guard;
+    store.reservation_guard = guard.guard(); // a lookup's room, never evicting what a queued or admitted request extends
+    const x = slices.begin(store, job.fetch.name.?, job.cacheKey(), job.request.bornLen(), job.request.chunks, h.spans(job.request));
+    store.reservation_guard = before;
+    h.disk.restore = x orelse {
+        h.lock();
+        job.fetch.unsliced = true; // read at admission, as before
+        h.unlock();
+        return;
+    };
+    advance(h, store, x.?);
