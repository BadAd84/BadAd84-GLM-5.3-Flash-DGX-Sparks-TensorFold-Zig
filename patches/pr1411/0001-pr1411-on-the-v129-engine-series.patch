diff --git a/zig/src/core/rows_slices.zig b/zig/src/core/rows_slices.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2779afb8014f9e41dfed0c5242cd00e97671f813
--- /dev/null
+++ b/zig/src/core/rows_slices.zig
@@ -0,0 +1,173 @@
+//! TF_GLM_OVN_DISK_SLICE_MIB: a queued request's read-ahead state scattered a slice a turn while other streams run.
+const std = @import("std");
+const platform = @import("sys");
+const pc = @import("prompt_cache.zig");
+const modes = @import("cache_modes.zig");
+const image = @import("rows_image.zig");
+const rows_store = @import("rows_store.zig");
+const prefetch = @import("rows_prefetch.zig");
+const read = @import("rows_read.zig");
+const write = @import("rows_write.zig");
+const Rows = rows_store.Rows;
+const Name = @import("rows_chain.zig").Name;
+
+const knob = "TF_GLM_OVN_DISK_SLICE_MIB";
+var known = false;
+var turn_bytes: u64 = 0;
+
+/// Bytes a turn scatters while other streams run (0: off, a state read whole at admission); its .glm row read once.
+pub fn budget() u64 {
+    if (!known) {
+        turn_bytes = of((platform.environment.Process{}).get(knob));
+        known = true;
+    }
+    return turn_bytes;
+}
+
+/// The knob's text as bytes a turn: a whole MiB count; unset, blank or refused text is 0 (GLM's open refuses it first).
+pub fn of(raw: ?[]const u8) u64 {
+    const mib = platform.environment.value(u64, knob, raw, 0) catch 0;
+    return std.math.mul(u64, mib, 1 << 20) catch std.math.maxInt(u64);
+}
+
+/// Tests only: the budget reads as `bytes` from now on, as if the environment held it.
+pub fn fake(bytes: u64) void {
+    if (!@import("builtin").is_test) @compileError("rows_slices.fake is for tests");
+    known = true;
+    turn_bytes = bytes;
+}
+
+/// One restore under way: the read it scatters, the kept state it fills, its RAM entry's fields, and the next byte.
+pub const Restore = struct {
+    r: *Rows,
+    f: *prefetch.Prefetch,
+    name: Name,
+    at: u32,
+    rd: *prefetch.Read, // claimed from `f`: freed by `finish` or `abort`
+    saved: pc.Saved,
+    held: u64, // what the store holds for it until it is an entry
+    bytes: u64, // the room `read.place` made: the entry's charge unless its family charges its own
+    born: u32,
+    shared: bool,
+    tokens: []u32,
+    spans: []modes.Span,
+    last: []u32,
+    piece: usize = 0, // the next byte: this piece of the read's plan,
+    range: usize = 0, // this range of it,
+    into: u64 = 0, // this far into that range,
+    pos: u64 = 0, // and this far into the piece's payload
+    slices: u32 = 0,
+    since: i128,
+
+    fn free(x: *Restore, a: std.mem.Allocator) void {
+        a.free(x.tokens);
+        a.free(x.spans);
+        a.free(x.last);
+        a.destroy(x);
+    }
+};
+
+/// `name`'s ready read begun as a restore when a lookup of `prompt` reads that state now; null: read at admission.
+pub fn begin(s: *pc.Store, name: Name, prompt: []const u32, born: u32, starts: []const u32, spans: []const modes.Span) ?*Restore {
+    const r = s.disk orelse return null;
+    const f = r.fetch orelse return null;
+    if (s.imprint != null) return null; // with --learn a lookup may resume a learned state first
+    var before: ?u32 = null;
+    const c = (read.place(s, r, prompt, born, starts, spans, s.find(prompt, starts, spans), &before) catch return null) orelse return null;
+    const st = r.states.items[c.i];
+    var plan = prefetch.Plan.of(r, r.gpa, &st) catch return null;
+    defer plan.deinit(r.gpa);
+    const rd = f.claim(name, &plan) orelse return null; // the chosen state's plan: a read of another state stays
+    return start(s, r, f, rd, st, c.bytes, prompt, born) catch |err| {
+        f.done(rd);
+        pc.note("disk restore of {d} tokens failed ({s}); its request reads it at admission", .{ st.at, @errorName(err) });
+        return null;
+    };
+}
+
+fn start(s: *pc.Store, r: *Rows, f: *prefetch.Prefetch, rd: *prefetch.Read, st: rows_store.State, bytes: u64, prompt: []const u32, born: u32) !*Restore {
+    const a = s.gpa;
+    const x = try a.create(Restore);
+    errdefer a.destroy(x);
+    const tokens = try a.dupe(u32, st.tokens);
+    errdefer a.free(tokens);
+    const spans = try a.dupe(modes.Span, st.spans);
+    errdefer a.free(spans);
+    const last = try a.dupe(u32, prompt);
+    errdefer a.free(last);
+    const saved = try r.img.blank(r.family.ptr, st.at);
+    const held = if (s.family.vtable.charged) |g| g(s.family.ptr, saved) else bytes;
+    s.held += held; // a keep beside the restore sees it taken, as it will be once the state is an entry
+    x.* = .{ .r = r, .f = f, .name = st.name, .at = st.at, .rd = rd, .saved = saved, .held = held, .bytes = bytes, .born = born, .shared = st.shared, .tokens = tokens, .spans = spans, .last = last, .since = write.nowNs() };
+    return x;
+}
+
+/// Up to `bytes` more scattered (0: the rest) in plan order, a call a piece; a range at image byte 0 goes whole.
+pub fn step(x: *Restore, bytes: u64) !bool {
+    const plan = &x.rd.plan;
+    var left: u64 = if (bytes == 0) std.math.maxInt(u64) else bytes;
+    var cut: [128]image.Range = undefined;
+    while (x.piece < plan.pieces.len and left > 0) {
+        const p = plan.pieces[x.piece];
+        const all = plan.rangesOf(p);
+        var n: usize = 0;
+        var len: u64 = 0;
+        while (x.range < all.len and n < cut.len and left > 0) : (n += 1) {
+            const g = all[x.range];
+            const take = if (g.off == 0) g.len else @min(g.len - x.into, left); // a family's words open its own file
+            cut[n] = .{ .off = g.off + x.into, .len = take };
+            len += take;
+            left -|= take;
+            x.into += take;
+            if (x.into == g.len) {
+                x.range += 1;
+                x.into = 0;
+            }
+        }
+        if (n > 0) try read.scatter(x.r, p.name, prefetch.ext(p.kind), x.saved, cut[0..n], x.rd.payload(p)[@intCast(x.pos)..][0..@intCast(len)]);
+        x.pos += len;
+        if (x.range == all.len) {
+            x.piece += 1;
+            x.range = 0;
+            x.pos = 0;
+        }
+    }
+    x.slices += 1;
+    return x.piece == plan.pieces.len;
+}
+
+/// The whole state a RAM entry, entered as a lookup's read back enters one (`read.enter`); null: dropped. Frees `x`.
+pub fn finish(s: *pc.Store, x: *Restore) ?*pc.Entry {
+    const a = s.gpa;
+    read.counted(x.r, x.r.find(x.name), x.at, x.rd.disk, x.rd.ns, true);
+    const ms = @as(f64, @floatFromInt(write.nowNs() - x.since)) / 1e6;
+    if (!@import("builtin").is_test) std.log.info("imprint: {d} tokens scattered in {d} slices over {d:.0} ms beside other streams", .{ x.at, x.slices, ms });
+    s.held -= x.held;
+    x.f.done(x.rd);
+    const e = a.create(pc.Entry) catch {
+        x.r.family.vtable.drop(x.r.family.ptr, x.saved);
+        x.free(a);
+        return null;
+    };
+    e.* = .{ .tokens = x.tokens, .at = x.at, .saved = x.saved, .bytes = x.bytes, .born = x.born, .used = s.clock, .last = x.last, .shared = x.shared, .decode_spans = x.spans };
+    if (!read.enter(s, e)) {
+        a.destroy(e);
+        x.free(a);
+        return null;
+    }
+    a.destroy(x);
+    return e;
+}
+
+/// A restore that cannot go on (`why`; null: the host stops): its state dropped, its hold and read given back.
+pub fn abort(s: *pc.Store, x: *Restore, why: ?anyerror) void {
+    if (why) |err| pc.note("disk restore of {d} tokens failed ({s}) after {d} slices; its request reads it at admission", .{ x.at, @errorName(err), x.slices });
+    x.r.family.vtable.drop(x.r.family.ptr, x.saved);
+    s.held -= x.held;
+    x.f.done(x.rd);
+    x.free(s.gpa);
+}
+
+test {
+    _ = @import("rows_slices_test.zig");
+}
diff --git a/zig/src/core/rows_slices_test.zig b/zig/src/core/rows_slices_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b8f2b76fdcf4f6b1d8b3ab7f578de7e417e5c326
--- /dev/null
+++ b/zig/src/core/rows_slices_test.zig
@@ -0,0 +1,215 @@
+//! TF_GLM_OVN_DISK_SLICE_MIB: a read-ahead state scattered in slices against the same state read whole.
+const std = @import("std");
+const platform = @import("sys");
+const pc = @import("prompt_cache.zig");
+const rows = @import("rows_store.zig");
+const prefetch = @import("rows_prefetch.zig");
+const slices = @import("rows_slices.zig");
+const ahead = @import("rows_prefetch_test.zig");
+const Fake = @import("rows_fake.zig").Fake;
+const fresh = @import("rows_fake.zig").fresh;
+const rmTree = @import("prompt_imprint_test.zig").rmTree;
+const Allocator = std.mem.Allocator;
+const gpa = std.testing.allocator;
+const t = std.testing;
+
+const rules: pc.Rules = .{ .lookahead = 1, .min_prompt = 0, .min_gap = 1 };
+const words = 16; // the fake's first part: a family's words, which open its own file
+const at = 800;
+
+/// The fake family behind a recorder: each scatter call's first offset and bytes, and GLM's rule for the words.
+const Rec = struct {
+    f: Fake = .{ .gpa = gpa },
+    inner: pc.Snapshots = undefined,
+    image: rows.Image = undefined,
+    vt: pc.Snapshots.VTable = undefined,
+    calls: usize = 0,
+    step_bytes: u64 = 0, // bytes the calls since the last `turn` carried, words aside
+    worst: u64 = 0, // the most one turn carried, words aside
+    words_cut: bool = false, // a call opened at byte 0 with less than the whole words
+    fail_after: ?usize = null, // scatter calls that succeed before every later one fails
+
+    fn init(x: *Rec) void {
+        x.inner = x.f.snapshots();
+        x.image = x.inner.vtable.rows.?.*;
+        x.image.scatter = scatter;
+        x.vt = x.inner.vtable.*;
+        x.vt.rows = &x.image;
+    }
+
+    fn snapshots(x: *Rec) pc.Snapshots {
+        return .{ .ptr = x.inner.ptr, .vtable = &x.vt };
+    }
+
+    fn scatter(ptr: *anyopaque, saved: pc.Saved, ranges: []const rows.image.Range, in: []const u8) anyerror!void {
+        const x: *Rec = @fieldParentPtr("f", @as(*Fake, @ptrCast(@alignCast(ptr))));
+        if (x.fail_after) |n| if (x.calls >= n) return error.ScatterFailed;
+        x.calls += 1;
+        var n: u64 = 0;
+        for (ranges) |g| {
+            if (g.off == 0 and g.len < words) x.words_cut = true;
+            if (g.off >= words) n += g.len else n += g.len -| words;
+        }
+        x.step_bytes += n;
+        return x.inner.vtable.rows.?.scatter(ptr, saved, ranges, in);
+    }
+
+    fn turn(x: *Rec) void {
+        x.worst = @max(x.worst, x.step_bytes);
+        x.step_bytes = 0;
+    }
+};
+
+const Server = struct {
+    rec: Rec = .{},
+    r: *rows.Rows = undefined,
+    s: pc.Store = undefined,
+
+    fn open(x: *Server, dir: []const u8) !void {
+        x.rec.init();
+        x.r = try rows.Rows.open(gpa, x.rec.snapshots(), .{ .sync_writes = true, .root = dir, .identity = 9, .cap = 1 << 34, .floor = 0, .daily = 1 << 40, .lookahead = 1 });
+        x.s = pc.Store.init(gpa, x.rec.snapshots(), rules, 1 << 30);
+        x.s.disk = x.r;
+    }
+
+    fn close(x: *Server) void {
+        x.s.deinit();
+        x.r.deinit();
+    }
+
+    fn request(x: *Server, a: Allocator, p: []const u32, history: u32) !struct { from: u32, sum: u64 } {
+        x.rec.f.prompt = p;
+        const plan = try x.s.begin(a, p, history, &.{}, &.{}, null, &.{});
+        return .{ .from = plan.from, .sum = x.rec.f.pass(&x.s, plan) };
+    }
+};
+
+fn root(buf: []u8, tag: []const u8) []const u8 {
+    return std.fmt.bufPrint(buf, "/tmp/tf-slices-{s}-{d}", .{ tag, platform.c.getpid() }) catch unreachable;
+}
+
+/// A conversation's first turn of `at` + 100 tokens kept at `at` and written under `dir`; its next turn's prompt.
+fn seeded(a: Allocator, dir: []const u8) ![]u32 {
+    var x: Server = .{};
+    try x.open(dir);
+    defer x.close();
+    const first = try a.alloc(u32, at + 100);
+    for (first, 0..) |*w, i| w.* = @intCast(1000 + i * 7 % 997);
+    _ = try x.request(a, first, at);
+    while (rows.write.step(x.r)) {}
+    try t.expectEqual(@as(usize, 1), x.r.states.items.len);
+    return std.mem.concat(a, u32, &.{ first[0 .. at + 1], &[_]u32{ 4, 4 } });
+}
+
+/// The next turn's disk state read ahead and ready in a new server over `dir`: its name.
+fn readAhead(x: *Server, next: []const u32) !rows.chain.Name {
+    const f = try prefetch.make(x.r, t.io, .{});
+    const name = f.start(x.r, prefetch.choose(&x.s, next, &.{}, &.{}) orelse return error.NoState) orelse return error.NotReadAhead;
+    try t.expectEqual(@as(?prefetch.Phase, .ready), ahead.settled(f, name));
+    return name;
+}
+
+test "disk slices: slices of any size leave the image one whole read leaves; the turn resumes from RAM, read once" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]u64{ 1, 13, 256, 4096, 0 }, 0..) |b, k| {
+        var buf: [128]u8 = undefined;
+        const dir = root(&buf, &.{@as(u8, 'a') + @as(u8, @intCast(k))});
+        defer rmTree(dir);
+        const next = try seeded(a, dir);
+        var x: Server = .{};
+        try x.open(dir);
+        defer x.close();
+        const name = try readAhead(&x, next);
+        x.rec.f.prompt = next;
+        const restore = slices.begin(&x.s, name, next, @intCast(next.len), &.{}, &.{}) orelse return error.NotBegun;
+        try t.expectEqual(@as(usize, 1), x.rec.f.blanks);
+        try t.expect(restore.held > 0);
+        try t.expectEqual(restore.held, x.s.held); // a keep meanwhile sees the state's storage taken
+        var turns: usize = 0;
+        while (true) {
+            turns += 1;
+            const whole = try slices.step(restore, b);
+            x.rec.turn();
+            if (whole) break;
+            try t.expectEqual(@as(usize, 0), x.s.entries.items.len); // no lookup can resume half a state
+        }
+        try t.expect(!x.rec.words_cut);
+        if (b == 0) try t.expectEqual(@as(usize, 1), turns) else {
+            try t.expect(turns > 1);
+            try t.expect(x.rec.worst <= b);
+        }
+        const e = slices.finish(&x.s, restore) orelse return error.NotEntered;
+        try t.expectEqual(@as(u32, at), e.at);
+        try t.expectEqual(e.bytes, x.s.held);
+        try t.expectEqual(@as(u64, 1), x.r.counts.reads);
+        const k2 = ahead.counts(x.r.fetch.?);
+        try t.expectEqual(@as(u64, 1), k2.used);
+        try t.expectEqual(@as(u64, 1), k2.freed);
+        const got = try x.request(a, next, @intCast(next.len - 1));
+        try t.expectEqual(@as(u32, at), got.from);
+        try t.expectEqual(fresh(next), got.sum);
+        try t.expect(x.rec.f.restored_ok); // every byte equals the image a fresh pass leaves
+        try t.expectEqual(@as(u64, 1), x.r.counts.reads); // resumed from RAM: no second read
+        try t.expectEqual(@as(usize, 1), x.rec.f.blanks);
+    }
+}
+
+test "disk slices: a slice that fails drops the state and gives back its hold and read; the turn reads at admission" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var buf: [128]u8 = undefined;
+    const dir = root(&buf, "fail");
+    defer rmTree(dir);
+    const next = try seeded(a, dir);
+    var x: Server = .{};
+    try x.open(dir);
+    defer x.close();
+    const name = try readAhead(&x, next);
+    x.rec.f.prompt = next;
+    const restore = slices.begin(&x.s, name, next, @intCast(next.len), &.{}, &.{}) orelse return error.NotBegun;
+    x.rec.fail_after = 1;
+    try t.expect(!try slices.step(restore, 64));
+    try t.expectError(error.ScatterFailed, slices.step(restore, 64));
+    slices.abort(&x.s, restore, error.ScatterFailed);
+    try t.expectEqual(@as(u64, 0), x.s.held);
+    try t.expectEqual(@as(usize, 0), x.rec.f.live); // the half-filled state dropped
+    try t.expectEqual(@as(u64, 1), ahead.counts(x.r.fetch.?).freed);
+    x.rec.fail_after = null;
+    const got = try x.request(a, next, @intCast(next.len - 1));
+    try t.expectEqual(@as(u32, at), got.from); // read from disk at admission, as without the knob
+    try t.expectEqual(fresh(next), got.sum);
+    try t.expect(x.rec.f.restored_ok);
+    try t.expectEqual(@as(u64, 1), x.r.counts.reads);
+}
+
+test "disk slices: a read the lookup does not choose now does not begin, and stays to be read at admission" {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var buf: [128]u8 = undefined;
+    const dir = root(&buf, "other");
+    defer rmTree(dir);
+    const next = try seeded(a, dir);
+    var x: Server = .{};
+    try x.open(dir);
+    defer x.close();
+    const name = try readAhead(&x, next);
+    var other = name;
+    other[0] ^= 1;
+    try t.expect(slices.begin(&x.s, other, next, @intCast(next.len), &.{}, &.{}) == null);
+    try t.expectEqual(@as(usize, 0), x.rec.f.blanks);
+    try t.expect(x.r.fetch.?.ready(name));
+    try t.expectEqual(@as(u64, 0), x.s.held);
+}
+
+test "disk slices: TF_GLM_OVN_DISK_SLICE_MIB is a whole MiB count a turn; unset, blank or refused text is off" {
+    try t.expectEqual(@as(u64, 3 << 20), slices.of("3"));
+    try t.expectEqual(@as(u64, 0), slices.of("0"));
+    try t.expectEqual(@as(u64, 0), slices.of(null));
+    try t.expectEqual(@as(u64, 0), slices.of(" "));
+    for ([_][]const u8{ "32M", "-1", "1.5" }) |bad| try t.expectEqual(@as(u64, 0), slices.of(bad));
+    try t.expectError(error.InvalidEnvironment, platform.environment.parse("TF_GLM_OVN_DISK_SLICE_MIB", "32M"));
+}
