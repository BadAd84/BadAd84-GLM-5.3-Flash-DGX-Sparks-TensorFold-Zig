+
+/// One slice of `x`, a whole RAM entry once its last one is in; a failure or a store without its disk ends it.
+fn advance(h: *LaneHost, store: *@import("prompt_cache.zig").Store, x: *slices.Restore) void {
+    if (store.disk == null or store.disk.? != x.r) return end(h, store, x, error.NoDisk);
+    const whole = slices.step(x, if (h.admitted.items.len > 0) slices.budget() else 0) catch |err| return end(h, store, x, err);
+    if (!whole) return;
+    h.disk.restore = null;
+    _ = slices.finish(store, x);
+}
+
+fn end(h: *LaneHost, store: *@import("prompt_cache.zig").Store, x: *slices.Restore, why: ?anyerror) void {
+    h.disk.restore = null;
+    slices.abort(store, x, why);
+}
+
+/// Stop notifications after engine drain; a blocked read keeps only its private memory, a restore under way goes.
 pub fn stop(h: *LaneHost) void {
+    if (h.disk.restore) |x| end(h, h.cache.?, x, null);
     const f = ((h.cache orelse return).disk orelse return).fetch orelse return;
     f.stopAt(write.nowNs());
 }
