diff --git a/zig/src/families/glm/cuda_disk_image.zig b/zig/src/families/glm/cuda_disk_image.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9e27aebdde0c7f1f77e80ae3de0f8956979abf9e
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_image.zig
@@ -0,0 +1,297 @@
+//! A GLM kept state's disk image on one rank: its parts at a position, and where each image byte sits in its lease.
+const std = @import("std");
+const cuda = @import("cuda");
+const st_mod = @import("cuda_state.zig");
+const sparse = @import("cuda_sparse.zig");
+const Config = @import("config.zig").Config;
+const pages = @import("cuda_snapshot_pages.zig");
+const State = st_mod.State;
+const window_rows = st_mod.window_rows;
+
+/// The image's first bytes: the format, the position, the head's rows, both ring bases, the KDA copy bits, the layout.
+pub const Words = struct {
+    at: u64,
+    mtp_len: u64,
+    base: u64,
+    mtp_base: u64,
+    cur: u64,
+    world: u64, // the ranks that wrote it
+    layout: Layout = .unsplit,
+    owner: u64 = no_owner, // the rank holding its latent rows alone (split layouts); unsplit: no_owner
+
+    pub const count = 9;
+    pub const bytes: u64 = count * 8;
+    const format: u64 = 1;
+
+    /// Which rows each rank's image holds: unsplit, every rank every row (the only layout written so far).
+    pub const Layout = enum(u64) { unsplit = 0, _ };
+    pub const no_owner: u64 = std.math.maxInt(u64);
+
+    pub fn encode(w: Words) [count]u64 {
+        return .{ format, w.at, w.mtp_len, w.base, w.mtp_base, w.cur, w.world, @backingInt(w.layout), w.owner };
+    }
+
+    /// Words read back, refused by name unless this format at `at`, written by `world` ranks in this server's `layout`.
+    pub fn decode(x: [count]u64, at: u32, world: u32, layout: Layout) !Words {
+        if (x[0] != format or x[1] != at) return error.DiskWords;
+        if (x[6] != world) return error.DiskWorld;
+        const l: Layout = @fromBackingInt(@intCast(x[7]));
+        if (l != layout) return error.DiskLayout;
+        if (if (l == .unsplit) x[8] != no_owner else x[8] >= world) return error.DiskLayout;
+        return .{ .at = x[1], .mtp_len = x[2], .base = x[3], .mtp_base = x[4], .cur = x[5], .world = x[6], .layout = l, .owner = x[8] };
+    }
+};
+
+/// A part as the rows store takes it: `row` bytes for each `per` tokens from position 0, or the state's own (row 0).
+pub const Part = struct { bytes: u64, row: u32 = 0, per: u32 = 1 };
+
+/// `len` image bytes from `img`: the words, `lease` bytes into the state's lease, or zeros the lease does not hold.
+pub const Seg = struct { img: u64, len: u64, from: union(enum) { words, lease: u64, zeros } };
+
+/// What a rank's kept state holds, read from a sequence of the engine (its addresses are not used past here).
+pub const Shape = struct {
+    prefix: u64, // the sequence's own fields before its caches: KDA conv and states, a window's saved rows
+    tail: u64, // its fields after them: the head's position and first-draft row
+    layers: u32, // DSA layers, whose rows are shared by position
+    latent: u32, // a latent row's bytes
+    scales: bool, // fp8 latent rows: a 4-byte scale each
+    ring_rows: u32,
+    ring_row: u32,
+    pk_rows: u32,
+    pooled_row: u32,
+    capacity: u32,
+    head: bool, // the MTP head's caches are kept (drafting)
+    window: u64, // the prefix's bytes before a verify window's rows (its KDA projections and saves, read by its keep)
+    draft: u64, // the tail's bytes before the first-draft row (written at a prompt pass's end)
+
+    pub fn of(st: *const State, c: *const Config, capacity: usize, head: bool) !Shape {
+        if (st.rings.len == 0) return error.SnapshotShape;
+        const base = st.arena.buf.ptr;
+        const first = if (st.table != 0) st.rings[0] else if (st.caches.len > 0) st.caches[0].lc else st.mtp_caches.lc;
+        const end = if (st.table != 0) st.table else base + st.arena.buf.len;
+        if (first < base or st.mtp_pos_dev < first or end < st.mtp_pos_dev) return error.SnapshotShape;
+        if (st.proj < base or first < st.proj or st.prompt_hidden < st.mtp_pos_dev or end < st.prompt_hidden) return error.SnapshotShape;
+        const fp8 = st.mtp_caches.ls != 0;
+        return .{
+            .window = st.proj - base,
+            .draft = st.prompt_hidden - st.mtp_pos_dev,
+            .prefix = first - base,
+            .tail = end - st.mtp_pos_dev,
+            .layers = @intCast(st.caches.len),
+            .latent = c.kv_lora * @as(u32, if (fp8) 1 else 2),
+            .scales = fp8,
+            .ring_rows = @intCast(st.ring_rows),
+            .ring_row = @intCast(st.ring_row),
+            .pk_rows = @intCast(capacity / sparse.pool + 2),
+            .pooled_row = c.i_dim * 2,
+            .capacity = @intCast(capacity),
+            .head = head,
+        };
+    }
+
+    /// Rows the image keeps of the head's caches at `at`: a verify window past it, as the cache charges a state.
+    pub fn headRows(sh: Shape, at: u32) u32 {
+        return @min(sh.capacity, at + window_rows);
+    }
+};
+
+/// One cache's parts in the lease's order, for `n` rows: latent, scales, the two index rings, the pooled keys.
+fn cache(sh: Shape, n: u64) [5]u64 {
+    return .{
+        n * sh.latent,
+        if (sh.scales) n * 4 else 0,
+        @min(n, sh.ring_rows) * sh.ring_row,
+        @min(n, sh.ring_rows) * sh.ring_row,
+        @min(n / sparse.pool + 2, sh.pk_rows) * sh.pooled_row,
+    };
+}
+
+/// The longest state an image holds: the capacity's whole pools (`parts` takes no other position).
+pub fn longest(sh: Shape) u32 {
+    return sh.capacity - sh.capacity % sparse.pool;
+}
+
+/// The image at `at` (a chunk start): the words, the prefix, each DSA layer's rows, the head's caches, the tail.
+pub fn parts(sh: Shape, at: u32, out: *std.ArrayList(Part), a: std.mem.Allocator) !void {
+    if (at == 0 or at % sparse.pool != 0 or at > sh.capacity) return error.SnapshotShape;
+    try out.appendSlice(a, &.{ .{ .bytes = Words.bytes }, .{ .bytes = sh.prefix } });
+    const pooled: u64 = at / sparse.pool;
+    for (0..sh.layers) |_| {
+        const c = cache(sh, at);
+        try out.append(a, .{ .bytes = c[0], .row = sh.latent });
+        if (sh.scales) try out.append(a, .{ .bytes = c[1], .row = 4 });
+        try out.appendSlice(a, &.{ .{ .bytes = c[2] }, .{ .bytes = c[3] } });
+        // whole pools are rows by position; the pool past them and the spare row stay the state's own
+        try out.appendSlice(a, &.{ .{ .bytes = pooled * sh.pooled_row, .row = sh.pooled_row, .per = sparse.pool }, .{ .bytes = c[4] - pooled * sh.pooled_row } });
+    }
+    if (sh.head) for (cache(sh, sh.headRows(at))) |n| if (n > 0) try out.append(a, .{ .bytes = n });
+    try out.append(a, .{ .bytes = sh.tail });
+}
+
+/// The image's segments in order for a state at `at` whose head holds `mtp_len` rows (0 without a head).
+pub fn segments(sh: Shape, at: u32, mtp_len: u64, out: *std.ArrayList(Seg), a: std.mem.Allocator) !void {
+    if (sh.head and mtp_len > sh.headRows(at)) return error.SnapshotShape;
+    var img: u64 = Words.bytes;
+    var lease: u64 = 0;
+    try out.append(a, .{ .img = 0, .len = Words.bytes, .from = .words });
+    const f = front(sh, at);
+    try out.append(a, .{ .img = img, .len = f, .from = .{ .lease = 0 } });
+    img += f;
+    lease += f;
+    if (sh.head) for (cache(sh, sh.headRows(at)), cache(sh, mtp_len)) |full, held| {
+        if (held > 0) try out.append(a, .{ .img = img, .len = held, .from = .{ .lease = lease } });
+        if (full > held) try out.append(a, .{ .img = img + held, .len = full - held, .from = .zeros });
+        img += full;
+        lease += held;
+    };
+    if (sh.tail > 0) try out.append(a, .{ .img = img, .len = sh.tail, .from = .{ .lease = lease } });
+}
+
+/// The image bytes after the words that sit in the lease as in the image: the prefix and every DSA layer's parts.
+pub fn front(sh: Shape, at: u32) u64 {
+    var n: u64 = sh.prefix;
+    for (0..sh.layers) |_| for (cache(sh, at)) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// The lease bytes of a state at `at` whose head holds `mtp_len` rows (layout.Plan's length for it).
+pub fn leaseBytes(sh: Shape, at: u32, mtp_len: u64) u64 {
+    var n: u64 = sh.prefix + sh.tail;
+    for (0..sh.layers) |_| for (cache(sh, at)) |x| {
+        n += x;
+    };
+    if (sh.head) for (cache(sh, mtp_len)) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// Rank 0's image bytes at `at` (its head counted at a verify window past `at`).
+pub fn imageBytes(sh: Shape, at: u32) u64 {
+    var n: u64 = Words.bytes + front(sh, at) + sh.tail;
+    if (sh.head) for (cache(sh, sh.headRows(at))) |x| {
+        n += x;
+    };
+    return n;
+}
+
+/// `len` bytes at `off` of rank `rank`'s image; `shared`: past rank 0's prefix, the same bytes every rank holds.
+pub const Piece = struct { rank: u32, off: u64, len: u64, shared: bool };
+
+/// The store's image at `at`: rank 0's, then each other rank's prefix (rank 0's bytes stand for all the rest).
+pub fn storeParts(sh: Shape, prefixes: []const u64, at: u32, out: *std.ArrayList(Part), a: std.mem.Allocator) !void {
+    try parts(sh, at, out, a);
+    for (prefixes[1..]) |p| try out.append(a, .{ .bytes = p });
+}
+
+/// Store image bytes [off, off + len) split by rank: rank 0's image, then rank r's prefix after its words.
+pub fn route(sh: Shape, prefixes: []const u64, at: u32, off: u64, len: u64, out: *std.ArrayList(Piece), a: std.mem.Allocator) !void {
+    const own = Words.bytes + sh.prefix; // rank 0's bytes no other rank holds
+    var start: u64 = 0; // the section's first store byte
+    for (prefixes, 0..) |p, r| {
+        const size = if (r == 0) imageBytes(sh, at) else p;
+        defer start += size;
+        const lo = @max(off, start);
+        const hi = @min(off + len, start + size);
+        if (lo >= hi) continue;
+        if (r > 0) {
+            try out.append(a, .{ .rank = @intCast(r), .off = Words.bytes + lo - start, .len = hi - lo, .shared = false });
+            continue;
+        }
+        if (lo < own) try out.append(a, .{ .rank = 0, .off = lo, .len = @min(hi, own) - lo, .shared = false });
+        if (hi > own) try out.append(a, .{ .rank = 0, .off = @max(lo, own), .len = hi - @max(lo, own), .shared = true });
+    }
+    if (off + len > start) return error.SnapshotShape;
+}
+
+/// `len` store image bytes at `off`.
+pub const Span = struct { off: u64, len: u64 };
+
+/// Store image bytes no prompt pass to `at` writes: each rank's window rows, pools past the whole ones, the draft row.
+pub fn unwritten(sh: Shape, prefixes: []const u64, windows: []const u64, at: u32, mtp_len: u64, out: *std.ArrayList(Span), a: std.mem.Allocator) !void {
+    if (windows.len != prefixes.len or windows.len == 0 or windows[0] != sh.window) return error.SnapshotShape;
+    if (sh.head and mtp_len > sh.headRows(at)) return error.SnapshotShape;
+    var img: u64 = Words.bytes + sh.prefix;
+    try out.append(a, .{ .off = Words.bytes + sh.window, .len = sh.prefix - sh.window });
+    for (0..sh.layers) |_| {
+        const c = cache(sh, at);
+        const whole = at / sparse.pool * sh.pooled_row;
+        img += c[0] + c[1] + c[2] + c[3];
+        try out.append(a, .{ .off = img + whole, .len = c[4] - whole });
+        img += c[4];
+    }
+    if (sh.head) {
+        const full = cache(sh, sh.headRows(at));
+        const held = cache(sh, mtp_len)[4];
+        const whole = mtp_len / sparse.pool * sh.pooled_row;
+        img += full[0] + full[1] + full[2] + full[3];
+        try out.append(a, .{ .off = img + whole, .len = held - whole }); // past `held`, the image's zeros
+        img += full[4];
+    }
+    try out.append(a, .{ .off = img + sh.draft, .len = sh.tail - sh.draft });
+    img += sh.tail;
+    for (prefixes[1..], windows[1..]) |p, w| {
+        if (w > p) return error.SnapshotShape;
+        try out.append(a, .{ .off = img + w, .len = p - w }); // a rank's section is its prefix alone
+        img += p;
+    }
+}
+
+/// Zeros `spans` of `bytes`, store image bytes from `from`, where they overlap.
+pub fn clear(spans: []const Span, from: u64, bytes: []u8) void {
+    for (spans) |s| {
+        const lo = @max(s.off, from);
+        const hi = @min(s.off + s.len, from + bytes.len);
+        if (lo < hi) @memset(bytes[@intCast(lo - from)..@intCast(hi - from)], 0);
+    }
+}
+
+/// Copies between `host` and image bytes [off, off + host.len) of a lease: out (lease to host) or in.
+pub const Copy = struct {
+    d: *const cuda.Driver,
+    pool: *const pages.Pool,
+    lease: *const pages.Lease,
+    segs: []const Seg,
+    words: *[Words.count]u64,
+
+    pub fn run(c: Copy, off: u64, host: []u8, out: bool) !void {
+        const end = off + host.len;
+        for (c.segs) |s| {
+            const lo = @max(off, s.img);
+            const hi = @min(end, s.img + s.len);
+            if (lo >= hi) continue;
+            const h = host[@intCast(lo - off)..][0..@intCast(hi - lo)];
+            switch (s.from) {
+                .words => {
+                    const w = std.mem.asBytes(c.words)[@intCast(lo - s.img)..][0..h.len];
+                    if (out) @memcpy(h, w) else @memcpy(w, h);
+                },
+                .zeros => if (out) @memset(h, 0),
+                .lease => |at| try c.leased(at + (lo - s.img), h, out),
+            }
+        }
+    }
+
+    /// Lease bytes from `at`, a page at a time (each page is a run of the snapshot arena).
+    fn leased(c: Copy, at: u64, host: []u8, out: bool) !void {
+        const arena = c.pool.arena orelse return error.NoSnapshotRoom;
+        if (at + host.len > c.lease.ids.items.len * pages.page) return error.SnapshotSize;
+        var done: usize = 0;
+        while (done < host.len) {
+            const x = at + done;
+            const n = @min(host.len - done, pages.page - x % pages.page);
+            const dev = arena.ptr() + @as(u64, c.lease.ids.items[@intCast(x / pages.page)]) * pages.page + x % pages.page;
+            const p = host[done..][0..n];
+            if (out) {
+                try cuda.memory.download(c.d, dev, p); // staged through the pinned buffer on an integrated GPU
+            } else try c.d.check(c.d.api.cuMemcpyHtoD_v2(dev, p.ptr, n), "cuMemcpyHtoD");
+            done += n;
+        }
+    }
+};
+
+test {
+    _ = @import("cuda_disk_image_test.zig");
+}
diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e45bc4030e043d31ce9c4f1d6a3fb3038ab1a320
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -0,0 +1,412 @@
+//! GLM's disk image on a driver whose device memory is host memory: sizes against the snapshot plan, a round trip.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("cuda_weights.zig");
+const shard = @import("cuda_shard.zig");
+const image = @import("cuda_disk_image.zig");
+const State = @import("cuda_state.zig").State;
+const Plan = @import("cuda_snapshot_layout.zig").Plan;
+const pages = @import("cuda_snapshot_pages.zig");
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+const expectError = std.testing.expectError;
+
+/// Device addresses are host addresses: allocations from the page allocator, copies and fills as memcpy and memset.
+pub const H = struct {
+    var held: [16]struct { ptr: u64 = 0, len: usize = 0 } = @splat(.{});
+    fn bytes(p: u64, n: usize) []u8 {
+        return @as([*]u8, @ptrFromInt(p))[0..n];
+    }
+    fn alloc(out: *u64, n: usize) callconv(.c) cuda.abi.Result {
+        const m = std.heap.page_allocator.alloc(u8, n) catch return 2;
+        for (&held) |*h| if (h.ptr == 0) {
+            h.* = .{ .ptr = @intFromPtr(m.ptr), .len = n };
+            out.* = h.ptr;
+            return 0;
+        };
+        std.heap.page_allocator.free(m);
+        return 2;
+    }
+    fn free(p: u64) callconv(.c) cuda.abi.Result {
+        for (&held) |*h| if (h.ptr == p) {
+            std.heap.page_allocator.free(bytes(h.ptr, h.len));
+            h.* = .{};
+            return 0;
+        };
+        return 1;
+    }
+    fn set(p: u64, v: u8, n: usize) callconv(.c) cuda.abi.Result {
+        @memset(bytes(p, n), v);
+        return 0;
+    }
+    fn dtod(dst: u64, src: u64, n: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        @memcpy(bytes(dst, n), bytes(src, n));
+        return 0;
+    }
+    fn dtoh(dst: ?*anyopaque, src: u64, n: usize) callconv(.c) cuda.abi.Result {
+        @memcpy(@as([*]u8, @ptrCast(dst.?))[0..n], bytes(src, n));
+        return 0;
+    }
+    fn htod(dst: u64, src: ?*const anyopaque, n: usize) callconv(.c) cuda.abi.Result {
+        @memcpy(bytes(dst, n), @as([*]const u8, @ptrCast(src.?))[0..n]);
+        return 0;
+    }
+    fn wait(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn contextDevice(out: *cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0;
+        return 0;
+    }
+    fn deviceAttribute(out: *c_int, _: cuda.abi.DeviceAttribute, _: cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0; // a discrete card: cuda.memory.download copies straight to the host
+        return 0;
+    }
+    pub fn driver() cuda.Driver {
+        var d: cuda.Driver = undefined;
+        d.api.cuMemAlloc_v2 = alloc;
+        d.api.cuMemFree_v2 = free;
+        d.api.cuMemsetD8_v2 = set;
+        d.api.cuMemcpyDtoDAsync_v2 = dtod;
+        d.api.cuMemcpyDtoH_v2 = dtoh;
+        d.api.cuMemcpyHtoD_v2 = htod;
+        d.api.cuStreamSynchronize = wait;
+        d.api.cuCtxGetDevice = contextDevice;
+        d.api.cuDeviceGetAttribute = deviceAttribute;
+        return d;
+    }
+};
+
+pub const capacity = 6144; // past the index rings' 4,096 rows, so a state at the end holds a full ring
+
+/// TP=2 rank 0's shapes on KDA, DSA, KDA, DSA layers.
+pub const Model = struct {
+    layers: [4]weights.Layer,
+    w: weights.Weights,
+
+    pub fn init(m: *Model) !void {
+        for (&m.layers, [_]bool{ false, true, false, true }) |*l, mla| l.mixer = if (mla) .{ .mla = undefined } else .{ .kda = undefined };
+        m.w = undefined;
+        m.w.config = .{};
+        m.w.share = try shard.Share.of(&m.w.config, 0, 2);
+        m.w.layers = &m.layers;
+    }
+};
+
+test "GLM disk image: the lease bytes the image counts are the snapshot plan's, at each position and head length" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    for ([_]bool{ false, true }) |kv8| {
+        var st = try State.initFormat(std.testing.allocator, &d, &m.w, capacity, kv8);
+        defer st.deinit();
+        for ([_]bool{ false, true }) |head| {
+            const sh = try image.Shape.of(&st, &m.w.config, capacity, head);
+            for ([_]u32{ 2048, 4096, 6144 }) |at| {
+                for ([_]u64{ at - 1, at, sh.headRows(at) }) |mtp| {
+                    const plan = try Plan.init(&st, &m.w.config, at, if (head) mtp else null, 0);
+                    try expectEqual(@as(u64, plan.len), image.leaseBytes(sh, at, if (head) mtp else 0));
+                }
+            }
+        }
+    }
+}
+
+test "GLM disk image: the longest state is a position the store's parts take, so the staging floor prices it" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    // capacities off and on a pool's edge: rows.attach prices `longest` and falls back to its default on an error
+    for ([_]usize{ capacity, capacity + 1, capacity + 3 }) |cap| {
+        var st = try State.initFormat(a, &d, &m.w, cap, false);
+        defer st.deinit();
+        const sh = try image.Shape.of(&st, &m.w.config, cap, true);
+        const at = image.longest(sh);
+        try expect(at <= cap and cap - at < 4 and at % 4 == 0);
+        var parts: std.ArrayList(image.Part) = .empty;
+        defer parts.deinit(a);
+        try image.storeParts(sh, &.{ sh.prefix, sh.prefix }, at, &parts, a);
+        try expect(parts.items.len > 0);
+        try expectError(error.SnapshotShape, image.storeParts(sh, &.{ sh.prefix, sh.prefix }, at + 4, &parts, a));
+    }
+}
+
+test "GLM disk image: the store's rows are by position from 0 in whole blocks; rings, pools in progress and the head are its own" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    var st = try State.initFormat(std.testing.allocator, &d, &m.w, capacity, true);
+    defer st.deinit();
+    const sh = try image.Shape.of(&st, &m.w.config, capacity, true);
+    const a = std.testing.allocator;
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(a);
+    const at: u32 = 6144;
+    try image.parts(sh, at, &list, a);
+    try image.segments(sh, at, at, &segs, a);
+    var total: u64 = 0;
+    var rows: usize = 0;
+    for (list.items) |p| {
+        total += p.bytes;
+        if (p.row == 0) continue;
+        rows += 1;
+        try expect(256 % p.per == 0);
+        try expectEqual(@as(u64, at / p.per) * p.row, p.bytes); // a pooled part counts the whole pools alone
+    }
+    try expectEqual(@as(usize, 3 * 2), rows); // each DSA layer's latent rows, scales and whole pools
+    const last = segs.items[segs.items.len - 1];
+    try expectEqual(total, last.img + last.len);
+    try expectEqual(@as(u64, 2 * 256), list.items[7].bytes); // layer 0's pools past `at`: the spare rows
+    try expectError(error.SnapshotShape, image.segments(sh, at, sh.headRows(at) + 1, &segs, a));
+}
+
+test "GLM disk image: a kept state's image read out of its lease restores every planned byte into another sequence" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    const c = &m.w.config;
+    var st = try State.initFormat(a, &d, &m.w, capacity, false);
+    defer st.deinit();
+    for (H.bytes(st.arena.buf.ptr, st.arena.buf.len), 0..) |*b, i| b.* = @truncate(i *% 31 +% 7);
+    var pool = try pages.Pool.init(a, &d, 64 << 20, false);
+    defer pool.deinit();
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    const at: u32 = 2048;
+    const mtp: u64 = at - 1; // a head one row behind: its last image row is not in the lease
+    const sh = try image.Shape.of(&st, c, capacity, true);
+    const plan = try Plan.init(&st, c, at, mtp, 0);
+    var kept = try pool.take(plan.len);
+    defer pool.give(&kept);
+    try pool.move(stream, &kept, &plan, true);
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(a);
+    try image.segments(sh, at, mtp, &segs, a);
+    const last = segs.items[segs.items.len - 1];
+    const img = try a.alloc(u8, @intCast(last.img + last.len));
+    defer a.free(img);
+    var words = (image.Words{ .at = at, .mtp_len = mtp, .base = 0, .mtp_base = 0, .cur = 0b10, .world = 2 }).encode();
+    const out: image.Copy = .{ .d = &d, .pool = &pool, .lease = &kept, .segs = segs.items, .words = &words };
+    const cut = [_]u64{ 0, 1000, plan.len / 2, img.len }; // the store asks for ranges, not the whole image
+    for (cut[0..3], cut[1..]) |lo, hi| try out.run(lo, img[@intCast(lo)..@intCast(hi)], true);
+    for (segs.items) |s| if (s.from == .zeros) for (img[@intCast(s.img)..][0..@intCast(s.len)]) |b| try expectEqual(@as(u8, 0), b);
+    // a blank state as a disk read takes it (room for the head's whole window), filled from the image
+    var blank = try pool.take(@intCast(image.leaseBytes(sh, at, sh.headRows(at))));
+    defer pool.give(&blank);
+    var back: [image.Words.count]u64 = undefined;
+    const in: image.Copy = .{ .d = &d, .pool = &pool, .lease = &blank, .segs = segs.items, .words = &back };
+    try in.run(0, img, false);
+    const w = try image.Words.decode(back, at, 2, .unsplit);
+    try expectEqual(mtp, w.mtp_len);
+    try expectEqual(@as(u64, 0b10), w.cur);
+    try expectError(error.DiskWords, image.Words.decode(back, at + 2048, 2, .unsplit));
+    var fresh = try State.initFormat(a, &d, &m.w, capacity, false);
+    defer fresh.deinit();
+    const into = try Plan.init(&fresh, c, at, w.mtp_len, 0);
+    try expectEqual(plan.len, into.len);
+    try pool.move(stream, &blank, &into, false);
+    for (plan.parts[0..plan.count], into.parts[0..into.count]) |x, y| {
+        try std.testing.expectEqualSlices(u8, H.bytes(x.live, x.len), H.bytes(y.live, y.len));
+    }
+}
+
+test "GLM disk image: the store's image is rank 0's then each other rank's prefix, and routes every byte once" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    var st = try State.initFormat(a, &d, &m.w, capacity, true);
+    defer st.deinit();
+    const sh = try image.Shape.of(&st, &m.w.config, capacity, true);
+    const at: u32 = 4096;
+    const prefixes = [_]u64{ sh.prefix, sh.prefix - 4096, sh.prefix + 512 }; // TP=3: heads one by one
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    try image.storeParts(sh, &prefixes, at, &list, a);
+    var total: u64 = 0;
+    for (list.items) |p| total += p.bytes;
+    try expectEqual(image.imageBytes(sh, at) + prefixes[1] + prefixes[2], total);
+    var pieces: std.ArrayList(image.Piece) = .empty;
+    defer pieces.deinit(a);
+    var seen: [3]u64 = .{ 0, 0, 0 };
+    var shared: u64 = 0;
+    const cuts = [_]u64{ 0, 40, image.Words.bytes + sh.prefix - 8, image.imageBytes(sh, at) + 100, total }; // ranges across the seams
+    for (cuts[0 .. cuts.len - 1], cuts[1..]) |lo, hi| {
+        pieces.clearRetainingCapacity();
+        try image.route(sh, &prefixes, at, lo, hi - lo, &pieces, a);
+        var n: u64 = 0;
+        for (pieces.items) |p| {
+            n += p.len;
+            seen[p.rank] += p.len;
+            if (p.shared) shared += p.len;
+            if (p.rank > 0) try expect(p.off >= image.Words.bytes and p.off + p.len <= image.Words.bytes + prefixes[p.rank] and !p.shared);
+            if (p.shared) try expect(p.rank == 0 and p.off >= image.Words.bytes + sh.prefix);
+        }
+        try expectEqual(hi - lo, n);
+    }
+    try expectEqual(image.imageBytes(sh, at), seen[0]);
+    try expectEqual(prefixes[1], seen[1]);
+    try expectEqual(prefixes[2], seen[2]);
+    try expectEqual(image.imageBytes(sh, at) - image.Words.bytes - sh.prefix, shared);
+    try expectError(error.SnapshotShape, image.route(sh, &prefixes, at, total - 4, 8, &pieces, a));
+}
+
+/// The fields of an engine the kept-state functions read, over a host-memory driver.
+const Fake = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    c: @import("config.zig").Config,
+    cur: struct { st: State, in_head: usize = 0 },
+    capacity: usize = capacity,
+    mtp: bool = true,
+    head: bool = true, // the head absorbs (no DFlash2): kept states carry its rows, as these tests read them
+    snaps: std.AutoHashMapUnmanaged(u64, @import("cuda_engine_types.zig").Snap) = .empty,
+    snap_pages: ?pages.Pool = null,
+    share_pages: bool = false,
+};
+
+test "GLM disk image: a disk read's blank state is refused until sealed, and its seal checks the words" {
+    const snaps = @import("cuda_snapshots.zig");
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    var e: Fake = .{ .gpa = a, .d = &d, .stream = .{ .d = &d, .handle = null }, .c = m.w.config, .cur = .{ .st = try State.initFormat(a, &d, &m.w, capacity, false) } };
+    defer e.cur.st.deinit();
+    e.snap_pages = try pages.Pool.init(a, &d, 256 << 20, false);
+    defer e.snap_pages.?.deinit();
+    try e.snaps.ensureTotalCapacity(a, 8);
+    defer e.snaps.deinit(a);
+    const at: u32 = 2048;
+    try snaps.blankAs(&e, 7, at);
+    defer {
+        var s = e.snaps.get(7).?;
+        snaps.free(&e, &s);
+    }
+    try expectError(error.StateKept, snaps.blankAs(&e, 7, at));
+    try expectError(error.UnsealedState, snaps.restore(&e, 7));
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at + @import("cuda_state.zig").window_rows + 1, .{ 0, 0 }, 0)); // a head past its verify window
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at, .{ 0, 0 }, @as(u64, 1) << @intCast(e.cur.st.cur.len))); // a copy bit no layer has
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at - 1, .{ at + 1, 0 }, 0)); // a main ring based past the state
+    try expectError(error.DiskWords, snaps.seal(&e, 7, at - 1, .{ 0, at }, 0)); // a head ring based past its rows
+    try snaps.seal(&e, 7, at - 1, .{ 3, 5 }, 0b01);
+    const s = e.snaps.get(7).?;
+    const sh = try image.Shape.of(&e.cur.st, &e.c, capacity, true);
+    try expectEqual(image.leaseBytes(sh, at, at - 1), @as(u64, s.len));
+    try expectEqual(@as(usize, at - 1), s.mtp_len);
+    try expectEqual([2]usize{ 3, 5 }, s.bases);
+    try std.testing.expectEqualSlices(u1, &.{ 1, 0 }, s.cur);
+    try expectError(error.StateKept, snaps.seal(&e, 7, at, .{ 0, 0 }, 0));
+    const far: u32 = capacity - 1024; // a state past the rings' rows
+    const back: u32 = far - @as(u32, @intCast(e.cur.st.ring_rows)); // the least base whose ring still holds its rows
+    try snaps.blankAs(&e, 8, far);
+    defer {
+        var held = e.snaps.get(8).?;
+        snaps.free(&e, &held);
+    }
+    try expectError(error.DiskWords, snaps.seal(&e, 8, far, .{ back - 1, back }, 0)); // a main ring too far back
+    try expectError(error.DiskWords, snaps.seal(&e, 8, far, .{ back, back - 1 }, 0)); // a head ring too far back
+    try snaps.seal(&e, 8, far, .{ back, back }, 0);
+    try snaps.blankAs(&e, 9, far);
+    defer {
+        var held = e.snaps.get(9).?;
+        snaps.free(&e, &held);
+    }
+    try snaps.seal(&e, 9, 0, .{ back, 0 }, 0); // no head rows yet (as without drafts): the main ring holds the state's rows
+}
+
+test "GLM disk image: the words record the world, the layout and the owner, and a read refuses another by name" {
+    const at: u32 = 4096;
+    const w: image.Words = .{ .at = at, .mtp_len = 7, .base = 1, .mtp_base = 2, .cur = 0b1, .world = 3 };
+    const x = w.encode();
+    try expectEqual(@as(u64, 72), image.Words.bytes);
+    try expectEqual(@as(usize, image.Words.bytes), @sizeOf(@TypeOf(x)));
+    // an unsplit state: every rank holds every row, so no rank owns it
+    try std.testing.expectEqualSlices(u64, &.{ 3, 0, image.Words.no_owner }, x[6..]);
+    try expectEqual(w, try image.Words.decode(x, at, 3, .unsplit));
+    try expectError(error.DiskWorld, image.Words.decode(x, at, 2, .unsplit)); // written by three ranks, read by two
+    try expectError(error.DiskWorld, image.Words.decode(x, at, 4, .unsplit));
+    const split: image.Words.Layout = @fromBackingInt(@intCast(1));
+    try expectError(error.DiskLayout, image.Words.decode(x, at, 3, split)); // this server splits, the image does not
+    var y = x;
+    y[7] = 1; // an image of a split layout read unsplit
+    try expectError(error.DiskLayout, image.Words.decode(y, at, 3, .unsplit));
+    const owned = try image.Words.decode(y[0..8].* ++ [1]u64{2}, at, 3, split);
+    try expectEqual(@as(u64, 2), owned.owner);
+    try expectError(error.DiskLayout, image.Words.decode(y, at, 3, split)); // a split image names an owner rank
+    try expectError(error.DiskLayout, image.Words.decode(y[0..8].* ++ [1]u64{3}, at, 3, split));
+    y = x;
+    y[8] = 0; // an unsplit image that names an owner
+    try expectError(error.DiskLayout, image.Words.decode(y, at, 3, .unsplit));
+    y = x;
+    y[0] = 2; // the format comes first: a format this server does not read is DiskWords, whatever its layout
+    try expectError(error.DiskWords, image.Words.decode(y, at, 2, .unsplit));
+}
+
+/// A state's store image at `at` for two ranks, rank 1's prefix a copy of rank 0's: what the load's probe gathers.
+fn storeImage(a: std.mem.Allocator, d: *const cuda.Driver, pool: *pages.Pool, st: *const State, c: *const @import("config.zig").Config, sh: image.Shape, at: u32, mtp: u64) ![]u8 {
+    const plan = try Plan.init(st, c, at, mtp, 0);
+    var kept = try pool.take(plan.len);
+    defer pool.give(&kept);
+    try pool.move(.{ .d = d, .handle = null }, &kept, &plan, true);
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(a);
+    try image.segments(sh, at, mtp, &segs, a);
+    const own = image.imageBytes(sh, at);
+    const out = try a.alloc(u8, @intCast(own + sh.prefix));
+    errdefer a.free(out);
+    @memset(out[0..image.Words.bytes], 0); // the words are not the probe's question
+    const copy: image.Copy = .{ .d = d, .pool = pool, .lease = &kept, .segs = segs.items, .words = undefined };
+    try copy.run(image.Words.bytes, out[image.Words.bytes..@intCast(own)], true);
+    @memcpy(out[@intCast(own)..], out[image.Words.bytes..][0..@intCast(sh.prefix)]);
+    return out;
+}
+
+test "GLM disk image: the probe's hash leaves out what a prompt pass does not write, whatever the slot ran before" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    const c = &m.w.config;
+    var st = try State.initFormat(a, &d, &m.w, capacity, false);
+    defer st.deinit();
+    for (H.bytes(st.arena.buf.ptr, st.arena.buf.len), 0..) |*b, i| b.* = @truncate(i *% 31 +% 7);
+    var pool = try pages.Pool.init(a, &d, 64 << 20, false);
+    defer pool.deinit();
+    const at: u32 = 2048;
+    const mtp: u64 = at - 1; // the head a row behind: its last pool unfinished
+    const sh = try image.Shape.of(&st, c, capacity, true);
+    const prefixes = [_]u64{ sh.prefix, sh.prefix };
+    var loose: std.ArrayList(image.Span) = .empty;
+    defer loose.deinit(a);
+    try image.unwritten(sh, &prefixes, &.{ sh.window, sh.window }, at, mtp, &loose, a);
+    try expectError(error.SnapshotShape, image.unwritten(sh, &prefixes, &.{ sh.window + 1, sh.window }, at, mtp, &loose, a));
+    const before = try storeImage(a, &d, &pool, &st, c, sh, at, mtp);
+    defer a.free(before);
+    // what load's timed windows leave in the slot: a window's rows, keys past `at`'s whole pools, the first-draft row
+    const row = c.i_dim * 2;
+    const pool_rows = @import("cuda_sparse.zig").pool;
+    @memset(H.bytes(st.proj, st.caches[0].lc - st.proj), 0xa5);
+    for (st.caches) |x| @memset(H.bytes(x.pk + at / pool_rows * row, 2 * row), 0xa5);
+    @memset(H.bytes(st.mtp_caches.pk + mtp / pool_rows * row, 2 * row), 0xa5);
+    @memset(H.bytes(st.prompt_hidden, c.hidden * 2), 0xa5);
+    const after = try storeImage(a, &d, &pool, &st, c, sh, at, mtp);
+    defer a.free(after);
+    try expect(!std.mem.eql(u8, before, after)); // the image carries them: hashed whole, two loads named two stores
+    image.clear(loose.items, 0, before);
+    image.clear(loose.items, 0, after);
+    try std.testing.expectEqualSlices(u8, before, after);
+    // what the prompt writes still names the store: a KDA state, a whole pool's keys
+    for ([_]u64{ st.conv, st.caches[1].pk }) |p| {
+        H.bytes(p, 1)[0] ^= 1;
+        defer H.bytes(p, 1)[0] ^= 1;
+        const changed = try storeImage(a, &d, &pool, &st, c, sh, at, mtp);
+        defer a.free(changed);
+        image.clear(loose.items, 0, changed);
+        try expect(!std.mem.eql(u8, before, changed));
+    }
+}
diff --git a/zig/src/families/glm/cuda_disk_ranks.zig b/zig/src/families/glm/cuda_disk_ranks.zig
new file mode 100644
index 0000000000000000000000000000000000000000..43698e35fc9a8eef498fd7b9c7225be9025d7a9f
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_ranks.zig
@@ -0,0 +1,176 @@
+//! A GLM kept state's disk image across ranks: rank 0's engine thread leases, fills, reads and seals each rank's copy.
+const std = @import("std");
+const follow = @import("cuda_follow.zig");
+const image = @import("cuda_disk_image.zig");
+const snapshots = @import("cuda_snapshots.zig");
+const Engine = @import("cuda_engine.zig").Engine;
+
+/// Rank 0 at TP: its follow link, set by Link.lead, cleared by its deinit; null: one rank, every op local.
+pub var link: ?*follow.Link = null;
+
+/// A disk step's op (Header.flags); its id is `a`, its image offset `seed`, its bytes `depth`, its rank `top_k`.
+pub const Op = enum(u32) { blank = 1, put, take, seal, prefixes };
+const kind = @backingInt(follow.Kind.disk); // each op crosses the follow link as a disk step, its bytes as the ids
+
+/// This rank's image shape (every sequence of the engine has the same).
+pub fn shape(e: *const Engine) !image.Shape {
+    return image.Shape.of(&e.cur.st, &e.c, e.capacity, e.mtp);
+}
+
+/// The words of a kept state on this rank: its position, head rows, ring bases, KDA copy bits and layout (unsplit).
+pub fn wordsOf(e: *const Engine, id: u64) !image.Words {
+    const s = e.snaps.get(id) orelse return error.NoKeptState;
+    if (s.cur.len > 64) return error.SnapshotShape;
+    var cur: u64 = 0;
+    for (s.cur, 0..) |b, i| cur |= @as(u64, b) << @intCast(i);
+    return .{ .at = s.pos, .mtp_len = s.mtp_len, .base = s.bases[0], .mtp_base = s.bases[1], .cur = cur, .world = e.share.world };
+}
+
+/// Bytes [off, off + host.len) of this rank's image of `id`, out (lease to host) or in; unsealed: before its head only.
+pub fn copy(e: *Engine, id: u64, off: u64, host: []u8, out: bool) !void {
+    const s = e.snaps.get(id) orelse return error.NoKeptState;
+    const sh = try shape(e);
+    const at: u32 = @intCast(s.pos);
+    if (s.len == 0 and off + host.len > image.Words.bytes + image.front(sh, at)) return error.DiskOrder;
+    var segs: std.ArrayList(image.Seg) = .empty;
+    defer segs.deinit(e.gpa);
+    try image.segments(sh, at, s.mtp_len, &segs, e.gpa);
+    var w = (try wordsOf(e, id)).encode();
+    const pool = if (e.snap_pages) |*p| p else return error.NoSnapshotCache;
+    try (image.Copy{ .d = e.d, .pool = pool, .lease = &s.lease, .segs = segs.items, .words = &w }).run(off, host, out);
+}
+
+/// Rank 0's link at TP, else null (one rank: every op is local).
+fn leader(e: *Engine) ?follow.Leader {
+    return .{ .e = e, .link = link orelse return null };
+}
+
+/// Rank 0: whether the other ranks sleep on their lines (no stream), and putting them back to sleep after disk steps.
+pub fn asleep(e: *Engine) bool {
+    return if (leader(e)) |x| x.link.asleep else false;
+}
+
+pub fn rest(e: *Engine) !void {
+    if (leader(e)) |x| try x.idle();
+}
+
+/// Rank 0: a new id leased at `at` on every rank (rank 0 first: the ranks' pools match, so theirs cannot fail apart).
+pub fn blank(e: *Engine, at: u32) !u64 {
+    if (e.next_snap > std.math.maxInt(u32)) return error.SnapshotIdLimit;
+    const id = e.next_snap;
+    try snapshots.blankAs(e, id, at);
+    e.next_snap += 1;
+    // a failed step: rank 0's lease goes back, and its id is dropped at the next step (another rank may hold it)
+    errdefer snapshots.drop(e, id);
+    if (leader(e)) |x| try x.disk(.{ .kind = kind, .flags = @backingInt(Op.blank), .a = id, .seed = at }, &.{});
+    return id;
+}
+
+/// Rank 0: `bytes` into rank `rank`'s image of `id` at `off` (rank 0's own lease, or through the link in pieces).
+pub fn put(e: *Engine, rank: u32, id: u64, off: u64, bytes: []const u8) !void {
+    if (rank == 0) return copy(e, id, off, @constCast(bytes), false);
+    const x = leader(e) orelse return error.NoRank;
+    const room = x.link.ids.len * 4;
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = @min(room, bytes.len - done);
+        const words = (n + 3) / 4;
+        @memcpy(std.mem.sliceAsBytes(x.link.ids[0..words])[0..n], bytes[done..][0..n]);
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.put), .a = id, .seed = off + done, .depth = @intCast(n), .top_k = rank }, x.link.ids[0..words]);
+        done += n;
+    }
+}
+
+/// Rank 0: rank `rank`'s image bytes of `id` from `off` into `out`.
+pub fn take(e: *Engine, rank: u32, id: u64, off: u64, out: []u8) !void {
+    if (rank == 0) return copy(e, id, off, out, true);
+    const x = leader(e) orelse return error.NoRank;
+    const room = x.link.ids.len * 4;
+    var done: usize = 0;
+    while (done < out.len) {
+        const n = @min(room, out.len - done);
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.take), .a = id, .seed = off + done, .depth = @intCast(n), .top_k = rank }, &.{});
+        try x.link.from(rank, n);
+        try x.link.buf.download(64, out[done..][0..n]);
+        done += n;
+    }
+}
+
+/// Rank 0: each other rank's bytes of `id` past its prefix (`each`) equal to `shared`, but for `loose` (zeros there).
+pub fn same(e: *Engine, id: u64, each: []const u64, shared: []const u8, loose: []const image.Span, theirs: []u8) !void {
+    for (each[1..], 1..) |q, r| {
+        try take(e, @intCast(r), id, image.Words.bytes + q, theirs);
+        image.clear(loose, 0, theirs);
+        if (!std.mem.eql(u8, shared, theirs)) return error.RanksDiffer;
+    }
+}
+
+/// Words read back for a state at `at`: refused by name unless this server's world and layout (unsplit) wrote them.
+pub fn decode(e: *const Engine, x: [image.Words.count]u64, at: u32) !image.Words {
+    return image.Words.decode(x, at, @intCast(e.share.world), .unsplit);
+}
+
+/// Rank 0: every rank's blank `id` sealed with `w` (its head's rows, ring bases and KDA copy bits).
+pub fn seal(e: *Engine, id: u64, w: image.Words) !void {
+    try snapshots.seal(e, id, w.mtp_len, .{ w.base, w.mtp_base }, w.cur);
+    if (leader(e)) |x| {
+        const words = w.encode();
+        try x.disk(.{ .kind = kind, .flags = @backingInt(Op.seal), .a = id }, std.mem.bytesAsSlice(u32, std.mem.sliceAsBytes(&words)));
+    }
+}
+
+/// Rank 0: every rank's prefix bytes in rank order (what it holds alone), and where its window rows begin in it.
+pub fn prefixes(e: *Engine, out: []u64, windows: []u64) !void {
+    const sh = try shape(e);
+    if (windows.len != out.len) return error.NoRank;
+    const x = leader(e) orelse {
+        if (out.len != 1) return error.NoRank;
+        out[0] = sh.prefix;
+        windows[0] = sh.window;
+        return;
+    };
+    try x.disk(.{ .kind = kind, .flags = @backingInt(Op.prefixes) }, &.{});
+    try gather(x.link, e, sh.prefix, out);
+    try gather(x.link, e, sh.window, windows);
+}
+
+fn gather(l: *follow.Link, e: *const Engine, mine: u64, out: []u64) !void {
+    try @import("cuda_ranks.zig").gather(u64, l.d, l.lib, l.comm, l.stream, e.share.rank, mine, out);
+}
+
+/// A rank other than 0: rank 0's disk step on this rank's copy of its state.
+pub fn step(e: *Engine, l: *follow.Link, h: follow.Header, ids: []const u32) !void {
+    if (h.flags < @backingInt(Op.blank) or h.flags > @backingInt(Op.prefixes)) return error.BadStep;
+    const op: Op = @fromBackingInt(h.flags);
+    const rank: u32 = @intCast(e.share.rank);
+    switch (op) {
+        .blank => try snapshots.blankAs(e, h.a, @intCast(h.seed)),
+        .seal => {
+            if (ids.len != image.Words.count * 2) return error.BadStep;
+            var x: [image.Words.count]u64 = undefined;
+            @memcpy(std.mem.sliceAsBytes(&x), std.mem.sliceAsBytes(ids));
+            const w = try decode(e, x, @intCast((e.snaps.get(h.a) orelse return error.NoKeptState).pos));
+            try snapshots.seal(e, h.a, w.mtp_len, .{ w.base, w.mtp_base }, w.cur);
+        },
+        .put => if (h.top_k == rank) {
+            if (h.depth > ids.len * 4) return error.BadStep;
+            try copy(e, h.a, h.seed, @constCast(std.mem.sliceAsBytes(ids))[0..h.depth], false);
+        },
+        .take => {
+            if (h.depth > l.ids.len * 4) return error.BadStep;
+            if (h.top_k == rank) {
+                const host = std.mem.sliceAsBytes(l.ids)[0..h.depth];
+                try copy(e, h.a, h.seed, host, true);
+                try l.buf.uploadAsync(64, host, l.stream.handle);
+            }
+            try l.from(h.top_k, h.depth);
+        },
+        .prefixes => {
+            var out: [64]u64 = undefined;
+            if (e.share.world > out.len) return error.BadStep;
+            const sh = try shape(e);
+            try gather(l, e, sh.prefix, out[0..e.share.world]);
+            try gather(l, e, sh.window, out[0..e.share.world]);
+        },
+    }
+}
diff --git a/zig/src/families/glm/cuda_disk_ranks_test.zig b/zig/src/families/glm/cuda_disk_ranks_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6f6a3666fc069c68135474d24a0711dcecd09800
--- /dev/null
+++ b/zig/src/families/glm/cuda_disk_ranks_test.zig
@@ -0,0 +1,233 @@
+//! GLM disk steps across ranks on host memory and a fake link: a failed blank, byte order, refusals, shared bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const ranks = @import("cuda_disk_ranks.zig");
+const image = @import("cuda_disk_image.zig");
+const follow = @import("cuda_follow.zig");
+const snapshots = @import("cuda_snapshots.zig");
+const pages = @import("cuda_snapshot_pages.zig");
+const fixture = @import("cuda_disk_image_test.zig");
+const State = @import("cuda_state.zig").State;
+const Seq = @import("cuda_engine_types.zig").Seq;
+const Engine = @import("cuda_engine.zig").Engine;
+const t = std.testing;
+
+/// The link's kernel and NCCL: the put kernel records each step's header; a broadcast fails, or brings a rank's bytes.
+const Wire = struct {
+    var fail = false;
+    var odd: c_int = 0; // a rank whose bytes differ from rank 0's (0: none)
+    var sent: [8]follow.Header = undefined;
+    var steps: usize = 0;
+    var casts: usize = 0;
+
+    fn reset() void {
+        fail = false;
+        odd = 0;
+        steps = 0;
+        casts = 0;
+    }
+    fn byte(i: usize) u8 {
+        return @truncate(i *% 13 +% 5);
+    }
+    fn put(_: cuda.abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, params: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
+        const w: *align(1) const follow.Words = @ptrCast(params.?[2].?);
+        if (steps < sent.len) @memcpy(std.mem.asBytes(&sent[steps]), std.mem.sliceAsBytes(w.w[0..16]));
+        steps += 1;
+        return 0;
+    }
+    fn broadcast(_: cuda.abi.DevicePtr, dst: cuda.abi.DevicePtr, n: usize, _: cuda.nccl.DataType, root: c_int, _: cuda.nccl.Comm, _: cuda.abi.Stream) callconv(.c) cuda.nccl.Result {
+        if (fail) return 1;
+        casts += 1;
+        if (root != 0) for (@as([*]u8, @ptrFromInt(dst))[0..n], 0..) |*b, i| {
+            b.* = byte(i) ^ @intFromBool(root == odd);
+        };
+        return 0;
+    }
+    fn device(out: *cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0;
+        return 0;
+    }
+    fn attribute(out: *c_int, _: cuda.abi.DeviceAttribute, _: cuda.abi.Device) callconv(.c) cuda.abi.Result {
+        out.* = 0; // a discrete card: a download copies straight to the host
+        return 0;
+    }
+};
+
+/// A TP=2 engine's rank 0 over host memory (the fields the disk steps read), its snapshot pool and its link.
+const Rig = struct {
+    m: fixture.Model,
+    d: cuda.Driver,
+    lib: cuda.nccl.Library,
+    seq: Seq,
+    e: *Engine,
+    buf: [64 + 64 * 4]u8 align(8), // the link's device buffer: header, then ids
+    ids: [64]u32,
+    link: follow.Link,
+
+    fn init(x: *Rig) !void {
+        const a = t.allocator;
+        Wire.reset();
+        try x.m.init();
+        x.d = fixture.H.driver();
+        x.d.api.cuLaunchKernel = Wire.put;
+        x.d.api.cuCtxGetDevice = Wire.device;
+        x.d.api.cuDeviceGetAttribute = Wire.attribute;
+        x.lib = .{ .lib = undefined, .api = undefined };
+        x.lib.api.ncclBroadcast = Wire.broadcast;
+        x.seq = .{ .st = try State.initFormat(a, &x.d, &x.m.w, fixture.capacity, false) };
+        errdefer x.seq.st.deinit();
+        const e = try a.create(Engine);
+        e.gpa = a;
+        e.d = &x.d;
+        e.c = x.m.w.config;
+        e.share = x.m.w.share;
+        e.cur = &x.seq;
+        e.capacity = fixture.capacity;
+        e.mtp = true;
+        e.head = true; // the head absorbs: a blank state's lease counts the head rows seal's mtp_len takes
+        e.slot = 0;
+        e.stream = .{ .d = &x.d, .handle = null };
+        e.m.glue.put_words = .{ .d = &x.d, .handle = null };
+        e.share_pages = false;
+        e.next_snap = 1;
+        e.announce = 0;
+        e.snaps = .empty;
+        e.dropped = .empty;
+        e.snap_pages = null;
+        x.e = e;
+        errdefer x.free();
+        try e.snaps.ensureTotalCapacity(a, 8);
+        try e.dropped.ensureTotalCapacity(a, 9);
+        e.snap_pages = try pages.Pool.init(a, &x.d, 256 << 20, false);
+        x.link = .{ .d = &x.d, .lib = &x.lib, .comm = null, .stream = e.stream, .buf = .{ .d = &x.d, .ptr = @intFromPtr(&x.buf), .len = x.buf.len, .borrowed = true }, .ids = &x.ids, .gpa = a, .wait = false };
+    }
+
+    fn free(x: *Rig) void {
+        const e = x.e;
+        var it = e.snaps.valueIterator();
+        while (it.next()) |s| snapshots.free(e, s);
+        e.snaps.deinit(e.gpa);
+        e.dropped.deinit(e.gpa);
+        if (e.snap_pages) |*p| p.deinit();
+        e.gpa.destroy(e);
+    }
+
+    fn deinit(x: *Rig) void {
+        ranks.link = null;
+        x.free();
+        x.seq.st.deinit();
+    }
+};
+
+const disk = @backingInt(follow.Kind.disk);
+
+fn op(o: ranks.Op) u32 {
+    return @backingInt(o);
+}
+
+test "GLM disk ranks: a blank whose step fails on the link gives rank 0's lease back, and the next step drops it" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    ranks.link = &x.link;
+    const pool = &x.e.snap_pages.?;
+    const all = pool.spare();
+    Wire.fail = true;
+    try t.expectError(error.NcclFailed, ranks.blank(x.e, 2048));
+    try t.expectEqual(@as(u32, 0), x.e.snaps.count());
+    try t.expectEqual(all, pool.spare());
+    try t.expectEqualSlices(u32, &.{1}, x.e.dropped.items); // the step may have reached the others: they drop it
+    Wire.reset();
+    const id = try ranks.blank(x.e, 2048);
+    try t.expectEqual(@as(u64, 2), id); // the dropped id is not used again
+    try t.expectEqual(@as(usize, 2), Wire.steps);
+    try t.expectEqual(@backingInt(follow.Kind.drop), Wire.sent[0].kind);
+    try t.expectEqual(@as(u32, 1), Wire.sent[0].n);
+    try t.expectEqual(disk, Wire.sent[1].kind);
+    try t.expectEqual(op(.blank), Wire.sent[1].flags);
+    try t.expectEqual(id, Wire.sent[1].a);
+    try t.expect(pool.spare() < all);
+}
+
+test "GLM disk ranks: rank 0's link carries the disk steps at TP only, and its deinit leaves none behind" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    var l = x.link;
+    l.ids = try t.allocator.alloc(u32, 4);
+    l.lead(true, 1); // one rank: every op stays local
+    try t.expect(l.asleep and ranks.link == null);
+    l.lead(false, 2);
+    try t.expect(!l.asleep and ranks.link == &l);
+    var other = x.link;
+    other.ids = try t.allocator.alloc(u32, 4);
+    other.deinit(); // another link's end leaves rank 0's
+    try t.expect(ranks.link == &l);
+    l.deinit();
+    try t.expect(ranks.link == null);
+}
+
+test "GLM disk ranks: a blank state takes bytes past its words and front only once sealed" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    const at: u32 = 2048;
+    const id = try ranks.blank(x.e, at); // one rank: no link
+    const front: usize = @intCast(image.Words.bytes + image.front(try ranks.shape(x.e), at));
+    const buf = try t.allocator.alloc(u8, front + 64);
+    defer t.allocator.free(buf);
+    @memset(buf, 0);
+    try ranks.copy(x.e, id, 0, buf[0..front], false);
+    try t.expectError(error.DiskOrder, ranks.copy(x.e, id, front - 8, buf[0..16], false)); // across the front
+    try t.expectError(error.DiskOrder, ranks.copy(x.e, id, front, buf[0..1], true)); // read out, too
+    try snapshots.seal(x.e, id, at - 1, .{ 0, 0 }, 0);
+    try ranks.copy(x.e, id, front - 8, buf[0..16], false);
+    try ranks.copy(x.e, id, front, buf[0..1], true);
+}
+
+test "GLM disk ranks: a follower refuses a disk step rank 0 does not send, before its states or the link" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    x.e.share.rank = 1;
+    const room = x.link.ids.len * 4;
+    const bad = [_]struct { h: follow.Header, n: usize }{
+        .{ .h = .{ .kind = disk, .flags = 0 }, .n = 0 }, // no op
+        .{ .h = .{ .kind = disk, .flags = op(.prefixes) + 1 }, .n = 0 }, // past the last op
+        .{ .h = .{ .kind = disk, .flags = op(.seal), .a = 1 }, .n = 1 }, // words of another length
+        .{ .h = .{ .kind = disk, .flags = op(.put), .a = 1, .depth = 4 * 4 + 1, .top_k = 1 }, .n = 4 }, // past its ids
+        .{ .h = .{ .kind = disk, .flags = op(.take), .a = 1, .depth = @intCast(room + 1), .top_k = 0 }, .n = 0 }, // past the link
+    };
+    for (bad) |b| try t.expectError(error.BadStep, ranks.step(x.e, &x.link, b.h, x.ids[0..b.n]));
+    x.e.share.world = 65; // more ranks than a gather holds
+    try t.expectError(error.BadStep, ranks.step(x.e, &x.link, .{ .kind = disk, .flags = op(.prefixes) }, &.{}));
+    try t.expectEqual(@as(u32, 0), x.e.snaps.count());
+    try t.expectEqual(@as(usize, 0), Wire.casts);
+}
+
+test "GLM disk ranks: each other rank's shared bytes come from past its own prefix and must equal rank 0's" {
+    var x: Rig = undefined;
+    try x.init();
+    defer x.deinit();
+    ranks.link = &x.link;
+    const prefixes = [_]u64{ 4096, 1024, 2048 }; // TP=3: each rank's own bytes first
+    var shared: [100]u8 = undefined;
+    for (&shared, 0..) |*b, i| b.* = Wire.byte(i);
+    var theirs: [100]u8 = undefined;
+    try ranks.same(x.e, 7, &prefixes, &shared, &.{}, &theirs);
+    try t.expectEqual(@as(usize, 2), Wire.steps);
+    for (Wire.sent[0..2], 1..) |h, r| {
+        try t.expectEqual(op(.take), h.flags);
+        try t.expectEqual(@as(u64, 7), h.a);
+        try t.expectEqual(@as(u32, @intCast(r)), h.top_k);
+        try t.expectEqual(image.Words.bytes + prefixes[r], h.seed);
+        try t.expectEqual(@as(u32, theirs.len), h.depth);
+    }
+    // bytes a prompt pass does not write are left out: rank 0's as zeros, each other rank's whatever it holds there
+    const loose = [_]image.Span{.{ .off = 10, .len = 20 }};
+    image.clear(&loose, 0, &shared);
+    try t.expectError(error.RanksDiffer, ranks.same(x.e, 7, &prefixes, &shared, &.{}, &theirs));
+    try ranks.same(x.e, 7, &prefixes, &shared, &loose, &theirs);
+    Wire.odd = 2;
+    try t.expectError(error.RanksDiffer, ranks.same(x.e, 7, &prefixes, &shared, &loose, &theirs));
+}
