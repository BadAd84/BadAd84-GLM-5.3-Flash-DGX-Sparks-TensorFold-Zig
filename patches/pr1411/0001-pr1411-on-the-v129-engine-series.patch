+
+/// The first queued request whose ready read may begin a restore: others admitted, no memory pressure (lock taken).
+fn next(h: *LaneHost) ?*Job {
+    const f = ((h.cache orelse return null).disk orelse return null).fetch orelse return null;
+    h.lock();
+    defer h.unlock();
+    if (h.admitted.items.len == 0 or @import("lane_host_pressure.zig").holds(h)) return null;
+    for (h.queued.items) |job| if (job.fetch.name) |n| if (!job.fetch.unsliced and f.ready(n)) return job;
+    return null;
