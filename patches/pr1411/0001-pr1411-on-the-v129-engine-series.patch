+//! TF_GLM_OVN_DISK_SLICE_MIB on a lane host's queue: which queued request waits for its slices, and when it goes.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const rows = @import("rows_store.zig");
+const fetch = @import("lane_host_fetch.zig");
+const prefetch = @import("rows_prefetch.zig");
+const slices = @import("rows_slices.zig");
+const fixture = @import("rows_async_fixture.zig");
+const ahead = @import("rows_prefetch_test.zig");
+const waits = @import("rows_test_wait.zig");
+const t = std.testing;
+
+/// States at 600 of `tokens` (and `more`) on disk; a host (thread never started), one request admitted, `n` queued.
+const Rig = struct {
+    x: *fixture.Fixture,
+    cfg: lanes.Config,
+    core: lanes.Engine,
+    host: api.LaneHost,
+    theirs: [1100]u32,
+    tokens: [1100]u32,
+    more: [1100]u32,
+    other_request: api.Request,
+    request: api.Request,
+    request2: api.Request,
+    other: api.LaneHost.Job,
+    job: api.LaneHost.Job,
+    job2: api.LaneHost.Job,
+    f: *prefetch.Prefetch,
+
+    fn init(g: *Rig, tag: []const u8, n: usize) !void {
+        g.x = try fixture.Fixture.open(tag, .evicted, false, 1 << 20);
+        errdefer g.x.close();
+        g.tokens = fixture.prompt(5);
+        g.more = fixture.prompt(7);
+        g.theirs = fixture.prompt(6);
+        const seeds = [_]*const [1100]u32{ &g.tokens, &g.more };
+        for (seeds[0..n]) |p| {
+            try g.x.keep(p, 600);
+            g.x.s.remove(0);
+        }
+        try g.x.settle();
+        try t.expectEqual(n, g.x.r.states.items.len);
+        g.cfg = try lanes.Config.init(t.allocator, .{}, 1, 0);
+        g.core = undefined;
+        g.core.cfg = &g.cfg;
+        g.host = api.LaneHost.init(t.allocator, t.io, &g.core, .{ .lanes = 2 });
+        g.host.cache = &g.x.s;
+        g.other_request = .{ .prompt = &g.theirs, .max_tokens = 1 };
+        g.request = .{ .prompt = &g.tokens, .max_tokens = 1 };
+        g.request2 = .{ .prompt = &g.more, .max_tokens = 1 };
+        g.other = .{ .host = &g.host, .id = 1, .request = &g.other_request, .sink = undefined };
+        g.job = .{ .host = &g.host, .id = 2, .request = &g.request, .sink = undefined };
+        g.job2 = .{ .host = &g.host, .id = 3, .request = &g.request2, .sink = undefined };
+        try g.host.admitted.append(t.allocator, &g.other);
+        const queued = [_]*api.LaneHost.Job{ &g.job, &g.job2 };
+        for (queued[0..n]) |j| try g.host.queued.append(t.allocator, j);
+        g.f = try prefetch.make(g.x.r, t.io, .{ .reads = n });
+        const end = waits.deadline();
+        while (!ready(g, &g.job) or (n > 1 and !ready(g, &g.job2))) {
+            if (rows.write.nowNs() >= end) return error.PrefetchTimedOut;
+            fetch.queue(&g.host);
+            rows.write.io.nap();
+        }
+    }
+
+    fn ready(g: *Rig, j: *const api.LaneHost.Job) bool {
+        return j.fetch.name != null and g.f.ready(j.fetch.name.?);
+    }
+
+    fn deinit(g: *Rig) void {
+        fetch.stop(&g.host);
+        g.host.queued.deinit(t.allocator);
+        g.host.admitted.deinit(t.allocator);
+        g.cfg.deinit(t.allocator);
+        g.x.close();
+    }
+};
+
+test "disk slices: a queued request waits while its restore goes a slice a turn, then resumes from RAM" {
+    slices.fake(64);
+    defer slices.fake(0);
+    var g: Rig = undefined;
+    try g.init("slices-turns", 1);
+    defer g.deinit();
+    try t.expect(fetch.held(&g.host, &g.job)); // ready while another request runs: it waits for its slices
+    var turns: usize = 0;
+    while (true) {
+        fetch.slice(&g.host);
+        turns += 1;
+        if (g.host.disk.restore == null) break;
+        try t.expect(fetch.held(&g.host, &g.job));
+        try t.expectEqual(@as(usize, 0), g.x.s.entries.items.len);
+    }
+    try t.expect(turns > 5); // more turns than the state's five files
+    try t.expect(!fetch.held(&g.host, &g.job));
+    try t.expectEqual(@as(usize, 1), g.x.s.entries.items.len);
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    g.x.f.prompt = &g.tokens;
