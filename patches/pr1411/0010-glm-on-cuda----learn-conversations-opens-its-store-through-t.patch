From d730aff64a2daf4f8c10f8f737084edc5cc87326 Mon Sep 17 00:00:00 2001
From: Robert Wojciechowski <24755+wojo@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:27:30 -0500
Subject: [PATCH] GLM on CUDA: --learn-conversations opens its store through the shared attach, so a long state is staged whole

cuda_glm_disk.attach opened the store with rows.Rows.open, which keeps the 1 GiB default staging permit and
skips the floor rows.attach applies (the longest state's charge, within the RAM store's budget). At about
18.5 KiB a token that stopped every state past roughly 55K tokens: `imprint: saving 124928 tokens skipped
(StagingFull)`, whatever --learn-gib said, and a long conversation was recomputed cold after a restart
(found by crystal8194 on #1411).

attach now goes through rows.attach, as Qwen 3.5 27B does, with `longest` the capacity's whole pools
(`image.longest`, the last position `parts` takes; rows.attach falls back to the default when pricing it
fails, so the position matters). Spill stays off and the slots unset, as before. The start-up line gains the
permit: "a save stages up to N MiB".

Tests:
- test-cuda-disk-open-host: GLM's own open over a store of 18,944-byte tokens. A 124,928-token state's charge
  is past the 1 GiB default and within the permit, which is the longest state's charge; with a RAM store too
  small to keep the state the permit stays the default. It fails with the floor gone (the permit is 1 GiB).
  It prices the permit a save's stage step asks; it does not write 2.3 GiB.
- The GLM set: `longest` is a position the store's parts take at capacities on and off a pool's edge, and the
  next pool past it is refused.
---

diff --git a/zig/src/families/glm/cuda_disk_image.zig b/zig/src/families/glm/cuda_disk_image.zig
index 491d6d754c6ff885e8d536d9c154e7e6c5711055..9e27aebdde0c7f1f77e80ae3de0f8956979abf9e 100644
--- a/zig/src/families/glm/cuda_disk_image.zig
+++ b/zig/src/families/glm/cuda_disk_image.zig
@@ -106,6 +106,11 @@ fn cache(sh: Shape, n: u64) [5]u64 {
     };
 }
 
+/// The longest state an image holds: the capacity's whole pools (`parts` takes no other position).
+pub fn longest(sh: Shape) u32 {
+    return sh.capacity - sh.capacity % sparse.pool;
+}
+
 /// The image at `at` (a chunk start): the words, the prefix, each DSA layer's rows, the head's caches, the tail.
 pub fn parts(sh: Shape, at: u32, out: *std.ArrayList(Part), a: std.mem.Allocator) !void {
     if (at == 0 or at % sparse.pool != 0 or at > sh.capacity) return error.SnapshotShape;
diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
index b6c04680380bc07b28b4a692a3f6419a77cb4698..9b2e7c6d812a71d0ac5b13e8156d6a7017ce243f 100644
--- a/zig/src/families/glm/cuda_disk_image_test.zig
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -112,6 +112,26 @@ test "GLM disk image: the lease bytes the image counts are the snapshot plan's,
     }
 }
 
+test "GLM disk image: the longest state is a position the store's parts take, so the staging floor prices it" {
+    var m: Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    // capacities off and on a pool's edge: rows.attach prices `longest` and falls back to its default on an error
+    for ([_]usize{ capacity, capacity + 1, capacity + 3 }) |cap| {
+        var st = try State.initFormat(a, &d, &m.w, cap, false);
+        defer st.deinit();
+        const sh = try image.Shape.of(&st, &m.w.config, cap, true);
+        const at = image.longest(sh);
+        try expect(at <= cap and cap - at < 4 and at % 4 == 0);
+        var parts: std.ArrayList(image.Part) = .empty;
+        defer parts.deinit(a);
+        try image.storeParts(sh, &.{ sh.prefix, sh.prefix }, at, &parts, a);
+        try expect(parts.items.len > 0);
+        try expectError(error.SnapshotShape, image.storeParts(sh, &.{ sh.prefix, sh.prefix }, at + 4, &parts, a));
+    }
+}
+
 test "GLM disk image: the store's rows are by position from 0 in whole blocks; rings, pools in progress and the head are its own" {
     var m: Model = undefined;
     try m.init();
diff --git a/zig/src/native/cuda_glm_disk.zig b/zig/src/native/cuda_glm_disk.zig
index 8cca4349bf052e7478f96d660ae769cc56422137..65c2e0f51cc5ceca7c82ef4b53a22c263aa18cfa 100644
--- a/zig/src/native/cuda_glm_disk.zig
+++ b/zig/src/native/cuda_glm_disk.zig
@@ -183,16 +183,20 @@ pub fn attach(a: Allocator, io: std.Io, ctx: *const cuda.Context, o: api.Open, r
     try facts.appendSlice(a, prefixes);
     const p = try probe(a, io, loaded.backend, e);
     const id = try cuda_disk.identityOf(a, io, ctx, o.dir, kernels, facts.items, p.hash, .{ .family = o.model_type, .backend = "cuda" });
+    const r = try open(store, o, root, id, img.longest(sh));
+    r.prefill_rate = p.rate;
+    std.log.info("glm: conversation states on disk in {s} ({d} states, {d} MiB of {d} MiB; {d} ranks' parts; a save stages up to {d} MiB)", .{ r.dir, r.states.items.len, r.held() >> 20, r.cap >> 20, prefixes.len, r.staging_bytes >> 20 });
+}
+
+/// The store for `id` through the shared attach, whose staging floor takes a `longest`-token state whole (rows.attach).
+fn open(store: *api.prompt_cache.Store, o: api.Open, root: []const u8, id: u64, longest: u32) !*rows.Rows {
     const gibs = struct {
         fn bytes(g: f64) u64 {
             return @intFromFloat(g * (1 << 30));
         }
     }.bytes;
     // spill stays off: an eviction would gather on rank 0 mid-pass while the other ranks wait in the gate's all-reduce
-    const r = try rows.Rows.open(store.gpa, store.family, .{ .root = root, .identity = id, .cap = gibs(o.learn_gib), .floor = gibs(o.learn_min_free_gib), .daily = gibs(o.learn_daily_gib), .lookahead = store.rules.lookahead, .planned = store.rules.planned, .grid = store.rules.grid });
-    r.prefill_rate = p.rate;
-    store.disk = r;
-    std.log.info("glm: conversation states on disk in {s} ({d} states, {d} MiB of {d} MiB; {d} ranks' parts)", .{ r.dir, r.states.items.len, r.held() >> 20, r.cap >> 20, prefixes.len });
+    return rows.attach(store.gpa, store, .{ .root = root, .identity = id, .cap = gibs(o.learn_gib), .floor = gibs(o.learn_min_free_gib), .daily = gibs(o.learn_daily_gib), .lookahead = store.rules.lookahead, .planned = store.rules.planned, .grid = store.rules.grid, .longest = longest });
 }
 
 test "GLM disk attach: TF_KV_SHARE and more ranks than the prefixes hold are refused by name" {
@@ -208,6 +212,51 @@ test "GLM disk attach: TF_KV_SHARE and more ranks than the prefixes hold are ref
     try std.testing.expectError(error.KvShareWithLearnConversations, refusal(e));
 }
 
+test "CUDA disk open: GLM's store takes the shared attach's staging floor, so a 125K-token state is staged, not StagingFull" {
+    const gpa = std.testing.allocator;
+    const T = struct {
+        const token = 18_944; // about 18.5 KiB a token, as a served state's files measure (683 MiB at 36,864 tokens)
+        fn parts(_: *anyopaque, at: u32, out: *std.ArrayList(rows.image.Part), a: Allocator) anyerror!void {
+            try out.append(a, .{ .bytes = @as(u64, at) * token, .row = token });
+        }
+        fn bytes(_: *anyopaque, _: u32) u64 {
+            return 0;
+        }
+        fn save(_: *anyopaque, _: ?*anyopaque, _: u32) anyerror!api.prompt_cache.Saved {
+            return error.Unused;
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: api.prompt_cache.Saved) anyerror!void {}
+        fn drop(_: *anyopaque, _: api.prompt_cache.Saved) void {}
+    };
+    const sized: rows.Image = .{ .parts = T.parts, .gather = gather, .blank = blank, .scatter = scatter, .whole = whole };
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(std.testing.io, ".", gpa);
+    defer gpa.free(root);
+    var family: u8 = 0;
+    const vt: api.prompt_cache.Snapshots.VTable = .{ .bytes = T.bytes, .save = T.save, .restore = T.restore, .drop = T.drop, .rows = &sized };
+    const default = (rows.Options{ .root = "", .identity = 0, .cap = 0, .floor = 0, .daily = 0 }).staging_bytes;
+    const window = 131_072;
+    // a RAM store that keeps the state, and one too small for it: the floor is the state's charge within that budget
+    for ([_]u64{ 8 << 30, 1 << 29 }) |budget| {
+        var store = api.prompt_cache.Store.init(gpa, .{ .ptr = &family, .vtable = &vt }, .{ .lookahead = 1 }, budget);
+        const r = open(&store, .{ .dir = "d", .model_type = "glm", .learn = root, .learn_conversations = true }, root, 7, window) catch |e| {
+            store.deinit();
+            return e;
+        };
+        defer r.deinit();
+        defer store.deinit(); // the store before its disk, as the rows fixtures close them
+        try std.testing.expectEqual(r, store.disk.?);
+        try std.testing.expectEqual(rows.Spill.off, r.spill);
+        const long = try rows.write.coldCharge(r, 124_928); // the conversation the default skipped (StagingFull)
+        try std.testing.expect(long > default);
+        if (budget > long) {
+            try std.testing.expect(r.staging_bytes >= long); // the permit a save's stage step asks `fits` of
+            try std.testing.expectEqual(try rows.write.coldCharge(r, window), r.staging_bytes); // the longest, whole
+        } else try std.testing.expectEqual(default, r.staging_bytes);
+    }
+}
+
 test {
     std.testing.refAllDecls(@This());
 }
