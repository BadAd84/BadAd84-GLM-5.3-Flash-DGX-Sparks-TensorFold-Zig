From e6b0aea971c19069229011bababf51c4747c1e8e Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:27:15 +0000
Subject: [PATCH] glm tests: the disk-image fake has the head flag snapshots.bytes reads

patches/engine/0028 (the MTP head's own passes run only without a DFlash2 drafter) adds Engine.head and
makes cuda_snapshots.bytes read e.head; the PR's cuda_disk_image_test Fake engine has only mtp, so the GLM
host tests stop compiling (test-cuda-host: cuda_snapshots.zig:35:55 no field named 'head'). The fake is an
engine whose head absorbs (its tests keep head rows), so head is true. The fork's e6b0aea97 line for line.
---

diff --git a/zig/src/families/glm/cuda_disk_image_test.zig b/zig/src/families/glm/cuda_disk_image_test.zig
index 9b2e7c6d812a71d0ac5b13e8156d6a7017ce243f..e45bc4030e043d31ce9c4f1d6a3fb3038ab1a320 100644
--- a/zig/src/families/glm/cuda_disk_image_test.zig
+++ b/zig/src/families/glm/cuda_disk_image_test.zig
@@ -263,6 +263,7 @@ const Fake = struct {
     cur: struct { st: State, in_head: usize = 0 },
     capacity: usize = capacity,
     mtp: bool = true,
+    head: bool = true, // the head absorbs (no DFlash2): kept states carry its rows, as these tests read them
     snaps: std.AutoHashMapUnmanaged(u64, @import("cuda_engine_types.zig").Snap) = .empty,
     snap_pages: ?pages.Pool = null,
     share_pages: bool = false,
