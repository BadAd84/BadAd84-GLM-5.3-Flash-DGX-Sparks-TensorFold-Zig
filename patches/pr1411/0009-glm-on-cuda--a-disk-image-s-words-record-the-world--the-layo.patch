     try snapshots.seal(e, id, w.mtp_len, .{ w.base, w.mtp_base }, w.cur);
@@ -141,10 +146,10 @@ pub fn step(e: *Engine, l: *follow.Link, h: follow.Header, ids: []const u32) !vo
     switch (op) {
