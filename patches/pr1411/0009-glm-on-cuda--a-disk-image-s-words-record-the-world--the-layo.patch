From 4f4da8e250b48dbf2e88038ee8f7b47865b1260c Mon Sep 17 00:00:00 2001
From: Robert Wojciechowski <24755+wojo@users.noreply.github.com>
Date: Fri, 6 Nov 2026 20:45:30 -0500
Subject: [PATCH] GLM on CUDA: a disk image's words record the world, the layout and the owner, and a read refuses another by name

The image's words gain three: the ranks that wrote it, its layout and the rank that owns its latent rows.
Every image is unsplit so far (every rank holds every row): it records this server's world, layout 0 and
no owner. A read refuses words of another world (DiskWorld) or another layout, or an owner its layout
does not have (DiskLayout), before the blank state is sealed. The words are 72 bytes, the seal step 18
words. #1431's split states fill the layout and owner without another format.

A disk read forgets a state's file refused as DiskWorld or DiskLayout after one recall, as it does one
refused as DiskWords (rows_read.refused); rows_refusal_test.zig's cases include both.
---

diff --git a/zig/src/core/rows_read.zig b/zig/src/core/rows_read.zig
index 87ba18efd71126e7ec81a4392399f783d65604d8..129a86b22029b8343a2ad6915084971f3c02b3bb 100644
--- a/zig/src/core/rows_read.zig
+++ b/zig/src/core/rows_read.zig
@@ -51,10 +51,10 @@ fn one(r: *Rows, name: Name, kind: file.Kind, ext: []const u8, at: u32, ranges:
     return o.trailer.payload + o.trailer.meta + @sizeOf(file.Trailer);
 }
 
-/// Whether a family refused what a file holds (words that differ, a size or a range that does not fit its blank).
+/// Whether a family refused what a file holds (words that differ, of another world or layout; a size or range unfit).
 fn refused(err: anyerror) bool {
     return switch (err) {
-        error.SnapshotSize, error.BadKeptRange, error.DiskWords, error.KeptWordsDiffer => true,
+        error.SnapshotSize, error.BadKeptRange, error.DiskWords, error.KeptWordsDiffer, error.DiskWorld, error.DiskLayout => true,
         else => false,
     };
 }
diff --git a/zig/src/core/rows_refusal_test.zig b/zig/src/core/rows_refusal_test.zig
index 5b298996e9be4f591141a9e5002334da358cec32..668a9884ceeacb5133b848d0a634284c3bd63674 100644
--- a/zig/src/core/rows_refusal_test.zig
+++ b/zig/src/core/rows_refusal_test.zig
@@ -84,6 +84,8 @@ const cases = [_]Case{
     .{ .piece = .shared, .err = error.BadKeptRange, .mine = false, .other = false },
     .{ .piece = .own, .err = error.DiskWords, .mine = false, .other = true }, // the state's own file
     .{ .piece = .own, .err = error.KeptWordsDiffer, .mine = false, .other = true },
+    .{ .piece = .own, .err = error.DiskWorld, .mine = false, .other = true }, // written by another number of ranks
+    .{ .piece = .own, .err = error.DiskLayout, .mine = false, .other = true }, // or in another layout
     .{ .piece = .own, .err = error.ScatterFailed, .mine = true, .other = true }, // a link failing: the disk is fine
     .{ .piece = .shared, .err = error.OutOfMemory, .mine = true, .other = true },
 };
diff --git a/zig/src/families/glm/cuda_disk_image.zig b/zig/src/families/glm/cuda_disk_image.zig
index 706a224b161b0190ed25ad97da821bfa69455fbe..491d6d754c6ff885e8d536d9c154e7e6c5711055 100644
--- a/zig/src/families/glm/cuda_disk_image.zig
