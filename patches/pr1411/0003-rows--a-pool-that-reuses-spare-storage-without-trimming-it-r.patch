From 422bac28a6289f747b15da5ebdc9779d59ea514f Mon Sep 17 00:00:00 2001
From: Robert Wojciechowski <24755+wojo@users.noreply.github.com>
Date: Mon, 26 Oct 2026 11:31:02 -0400
Subject: [PATCH] rows: a pool that reuses spare storage without trimming it reads a disk state into that storage

A family whose kept states live in preallocated storage it reuses (GLM's snapshot pages on CUDA) and
cannot trim never had a disk read chosen: the selection counted its spare storage as fixed and its
kept states as not reclaimable, so no state ever fit. Such a family's room for a read is now its
spare storage plus what evicting unborrowed states frees, and a read is ready once the family says
its spare storage takes the state, as a keep's admission already asks. Families with trim, or
without reused storage, are unchanged.
---

diff --git a/zig/src/core/rows_pool_select_test.zig b/zig/src/core/rows_pool_select_test.zig
index b15e756c8a0d54a2e80c7f09b47a3dd4a5c1aae7..499c69976f3c7e91d687c0ba6a444665cb9b54d3 100644
--- a/zig/src/core/rows_pool_select_test.zig
+++ b/zig/src/core/rows_pool_select_test.zig
@@ -86,3 +86,53 @@ test "restore selection: pooled buffers trim only when supported and never steal
         s.release(borrowed);
     }
 }
+
+test "restore selection: a pool without trim reads into the spare storage an eviction leaves, as a keep would" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(t.io, ".", a);
+    defer a.free(dir);
+    var prompt: [64]u32 = undefined;
+    for (&prompt, 0..) |*token, i| token.* = @intCast(100 + i);
+    const rules: pc.Rules = .{ .min_prompt = 0, .min_gap = 1, .lookahead = 1 };
+    {
+        var f: Fake = .{ .gpa = a, .at = 20, .sum = fresh(prompt[0..20]) };
+        var table = f.pooled().vtable.*;
+        table.rows = &Image.api;
+        const family: pc.Snapshots = .{ .ptr = &f, .vtable = &table };
+        const r = try rows.Rows.open(a, family, options(dir));
+        defer r.deinit();
+        var s = pc.Store.init(a, family, rules, 1000);
+        defer s.deinit();
+        s.disk = r;
+        try t.expect(s.keep(&prompt, 20, null, &.{}, &.{}));
+        while (rows.write.step(r)) {}
+    }
+    var f: Fake = .{ .gpa = a, .at = 5, .sum = fresh(prompt[0..5]) };
+    var table = f.pooled().vtable.*;
+    table.rows = &Image.api;
+    table.trim = null;
+    const family: pc.Snapshots = .{ .ptr = &f, .vtable = &table };
+    const r = try rows.Rows.open(a, family, options(dir));
+    defer r.deinit();
+    var s = pc.Store.init(a, family, rules, 240);
+    defer s.deinit();
+    try t.expect(s.keep(&prompt, 5, null, &.{}, &.{}));
+    const borrowed = s.entries.items[0];
+    borrowed.borrowers = 1;
+    prompt[0] = 999;
+    f.at = 30; // another conversation's state: its storage, once evicted, can take the read (120 >= 110)
+    f.sum = fresh(prompt[0..30]);
+    try t.expect(s.keep(&prompt, 30, null, &.{}, &.{}));
+    prompt[0] = 100;
+    s.disk = r;
+    try t.expectEqual(.disk, rows.read.resumable(&s, &prompt, &.{}, &.{}).from);
+    const restored = rows.read.recall(&s, &prompt, 64, &.{}, &.{}, borrowed).?;
+    try t.expectEqual(@as(u32, 20), restored.at);
+    try t.expectEqual(@as(u64, 1), r.counts.reads);
+    try t.expectEqual(@as(u64, 1), s.counts.evicted);
+    try t.expect(s.held + s.spare() <= s.budget);
+    try family.vtable.restore(family.ptr, null, restored.saved);
+    try t.expectEqual(fresh(&prompt), f.pass(&s, &prompt, .{ .from = restored.at }));
+    s.release(borrowed);
+}
diff --git a/zig/src/core/rows_read.zig b/zig/src/core/rows_read.zig
index 244367d3af22a241abdc27c5de9fa76a978ce8b4..bb02f9ac3a73213b7a8fd26c79a89bb58150d5de 100644
--- a/zig/src/core/rows_read.zig
+++ b/zig/src/core/rows_read.zig
@@ -128,9 +128,9 @@ fn attempt(s: *pc.Store, prompt: []const u32, born: u32, starts: []const u32, sp
     const name = candidate.name;
     const bytes = r.blankBytes(candidate.at);
     if (bytes > s.budget or s.most == 0) return have;
-    if (!ready(s, bytes)) present(r, chosen) catch |err| return failed(before, candidate.at, err, have); // nothing goes to make room for a state whose file is gone
+    if (!ready(s, candidate.at, bytes)) present(r, chosen) catch |err| return failed(before, candidate.at, err, have); // nothing goes to make room for a state whose file is gone
     if (r.spill != .off) r.touch(chosen); // the newest: the spills that make room for it push older states off first
-    while (!ready(s, bytes)) {
+    while (!ready(s, candidate.at, bytes)) {
         if (s.family.vtable.trim) |trim| {
             const spare = s.spare();
             trim(s.family.ptr, s.budget -| s.held -| bytes);
@@ -165,8 +165,9 @@ fn attempt(s: *pc.Store, prompt: []const u32, born: u32, starts: []const u32, sp
     return e;
 }
 
-fn ready(s: *const pc.Store, bytes: u64) bool {
+fn ready(s: *const pc.Store, at: u32, bytes: u64) bool {
     if (s.held > s.budget or s.entries.items.len >= s.most) return false;
+    if (s.family.vtable.reuses) |f| if (f(s.family.ptr, at)) return true; // spare storage takes it, as a keep's would
     const room = s.budget - s.held;
     const spare = s.spare();
     return spare <= room and bytes <= room - spare;
diff --git a/zig/src/core/rows_select.zig b/zig/src/core/rows_select.zig
index 55bf71960c10b2f42f6d688212f4c61901aa7688..9cbc538d1b600c60c9ab5dd1878087d1ee2387b4 100644
--- a/zig/src/core/rows_select.zig
+++ b/zig/src/core/rows_select.zig
@@ -62,12 +62,15 @@ fn capacity(s: *const pc.Store, have: ?*pc.Entry) ?u64 {
     var protected: usize = 0;
     const f = s.family.vtable;
     for (s.entries.items) |e| {
-        if (e == have or e.borrowers > 0) protected += 1 else if (f.spare == null or f.trim != null) {
+        if (e == have or e.borrowers > 0) protected += 1 else if (f.spare == null or f.trim != null or f.reuses != null) {
             reclaimable +|= e.bytes;
         }
     }
+    if (protected >= s.most) return null;
+    // a pool that reuses spare storage without trimming it (GLM's snapshot pages): a read takes spare or evicted pages
+    if (f.reuses != null and f.trim == null) return s.spare() +| reclaimable;
     const fixed = (s.held -| reclaimable) +| if (f.trim == null) s.spare() else 0;
-    if (protected >= s.most or fixed > s.budget) return null;
+    if (fixed > s.budget) return null;
     return s.budget - fixed;
 }
 
