From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:30:00 +0000
Subject: [PATCH] engine api: five field comments on their fields' lines, so the file stays at 600

On v1.2.7 plus patches/engine and pr1411, core/engine_api.zig is 600 lines; 0001 adds five, which the lean
gate counts as a new problem (over 600 lines). The doc comments of Request.cache_key, Request.salted,
Info.prompt_logprobs, Info.prompt_cache and Info.cache_salt move onto their fields' lines; no code changes.
---

diff --git a/zig/src/core/engine_api.zig b/zig/src/core/engine_api.zig
index db49455dde6a51379b582a945e23d558fa1c3068..eb00ede1ec808345e7ca41325cc2b88db40160dc 100644
--- a/zig/src/core/engine_api.zig
+++ b/zig/src/core/engine_api.zig
@@ -87,10 +87,8 @@ pub const Request = struct {
     prompt_logprobs: ?u8 = null,
     /// Images whose rows replace placeholder tokens of ``prompt``, in order; only when ``Info.vision`` is set.
     images: []const Image = &.{},
-    /// The prompt as the prompt cache matches it (each image's placeholders by its content); empty: ``prompt``.
-    cache_key: []const u32 = &.{},
-    /// ``cache_key`` is salted (cache_salt): the lane host neither drafts from nor adds to Recall's shared record.
-    salted: bool = false,
+    cache_key: []const u32 = &.{}, // the prompt as the prompt cache matches it (images by content); empty: ``prompt``
+    salted: bool = false, // ``cache_key`` is salted (cache_salt): the lane host skips Recall's shared record
 
     /// The prompt as the prompt cache matches it: an image request's placeholders stand for their images.
     pub fn cacheKey(r: *const Request) []const u32 {
@@ -193,16 +191,13 @@ pub const Info = struct {
     logprobs: bool = false,
     /// Requests' presence_penalty and frequency_penalty change the draws (false: nonzero is refused).
     penalties: bool = false,
-    /// Requests may ask for ``prompt_logprobs`` (a prompt pass from 0 that reads every row).
-    prompt_logprobs: bool = false,
+    prompt_logprobs: bool = false, // requests may ask for ``prompt_logprobs`` (a prompt pass from 0 reading every row)
     /// Prompt rows a prefill chunk at most, for the server's chunk starts (0: the engine cuts prompts itself).
     prefill_step: u32 = 0,
     /// The minimum distance between template message cuts; exact-start families may keep adjacent turns.
     prefill_min_chunk: u32 = 256,
-    /// The engine keeps prompt states between requests, so ``prefilled`` counts the tokens it restored.
-    prompt_cache: bool = false,
-    /// Requests may carry cache_salt: its prompt cache goes by Request.cacheKey() (the lane host's), apart per salt.
-    cache_salt: bool = false,
+    prompt_cache: bool = false, // prompt states kept between requests; ``prefilled`` counts the tokens restored
+    cache_salt: bool = false, // requests may carry cache_salt: the lane host's cache goes by Request.cacheKey()
     /// Startup cache budget and the smallest state admitted by the family's existing keep plan.
     prompt_cache_capacity: ?PromptCacheCapacity = null,
     /// The policy the engine runs under, one line (`/health` shows it); empty: none.
