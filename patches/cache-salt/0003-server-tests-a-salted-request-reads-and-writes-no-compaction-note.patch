From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adam Hillson <598804+BadAd84@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:00:00 +0000
Subject: [PATCH] server tests: a salted request reads and writes no compaction note

The PR's checks that compact_mem.loadMem and storeMem skip a salted request (a note is keyed by the messages
alone, so another salt's request would read it) live in its private_files_test.zig, which v1.2.7 does not
have. The same three assertions, on a note store in a temporary folder, in a file of their own.
---

diff --git a/zig/src/server/compact_mem_salt_test.zig b/zig/src/server/compact_mem_salt_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1550293dc80fdf39631678248870c777d8e864f7
--- /dev/null
+++ b/zig/src/server/compact_mem_salt_test.zig
@@ -0,0 +1,27 @@
+//! A salted request neither reads the --compact-memory note of its messages nor writes one another salt would read.
+const std = @import("std");
+const json = @import("json");
+const compact_mem = @import("compact_mem.zig");
+const Server = @import("server.zig").Server;
+const testing = std.testing;
+
+test "compact memory: a salted request reads no shared note and writes none another salt's request would read" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const io = testing.io;
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try std.fs.path.join(a, &.{ try tmp.dir.realPathFileAlloc(io, ".", a), "notes" });
+    var srv: Server = undefined;
+    srv.config = .{ .served_name = "test", .model_ids = &.{"test"}, .compact_memory = dir };
+    srv.io = io;
+    const msgs = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"hello\"}]")).ok.items().?;
+    compact_mem.storeMem(&srv, a, msgs, 1, "a shared summary", 0);
+    try testing.expectEqualStrings("a shared summary", compact_mem.loadMem(&srv, a, msgs, 0).?.note);
+    try testing.expect(compact_mem.loadMem(&srv, a, msgs, 0x5a17) == null); // a salted request reads no shared note
+    const other = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"salted\"}]")).ok.items().?;
+    compact_mem.storeMem(&srv, a, other, 1, "a salted summary", 0x5a17); // nor writes one another salt would read
+    const note = try std.fmt.allocPrint(a, "notes/{s}.md", .{try compact_mem.conversationKey(a, other)});
+    try testing.expectError(error.FileNotFound, tmp.dir.readFileAlloc(io, note, a, .limited(64)));
+}
diff --git a/zig/src/server/root.zig b/zig/src/server/root.zig
index f9b00c0dcc5d5fd8efcd77b9c451fa45c736a0e1..2bfea160f335321c14efde0e1d9429baa1d48e93 100644
--- a/zig/src/server/root.zig
+++ b/zig/src/server/root.zig
@@ -73,6 +73,7 @@ test {
     _ = @import("grammar.zig");
     _ = @import("cache_salt.zig");
     _ = @import("cache_salt_test.zig");
+    _ = @import("compact_mem_salt_test.zig");
     _ = @import("pyrepr.zig");
     _ = @import("metrics.zig");
     _ = @import("load_metrics.zig");
