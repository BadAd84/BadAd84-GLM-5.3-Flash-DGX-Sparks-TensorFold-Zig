diff --git a/zig/src/core/cache_salt_disk_test.zig b/zig/src/core/cache_salt_disk_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f74397f38b4511661cbefb1e2b015af3bf66aacb
--- /dev/null
+++ b/zig/src/core/cache_salt_disk_test.zig
@@ -0,0 +1,62 @@
+//! A salted state never reaches disk, and a salted lookup never reads a plain disk state; plain ones restore as before.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const rows = @import("rows_store.zig");
+const fake = @import("rows_fake.zig");
+const salt_key = @import("cache_salt_key.zig");
+const t = std.testing;
+const a = t.allocator;
+const rules: pc.Rules = .{ .min_prompt = 0, .min_gap = 1, .lookahead = 1 };
+
+fn options(root: []const u8) rows.Options {
+    return .{ .sync_writes = true, .root = root, .identity = 853, .cap = 1 << 26, .floor = 0, .daily = 1 << 28, .lookahead = 1 };
+}
+
+test "the disk store keeps salted and plain apart: a salted state is not written, a salted lookup reads no plain one" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", a);
+    defer a.free(root);
+    var prompt: [3000]u32 = undefined;
+    for (&prompt, 0..) |*token, i| token.* = @intCast(29 + i % 983);
+    const key = try salt_key.salted(a, &prompt, 0x5a17);
+    defer a.free(key);
+    {
+        var f: fake.Fake = .{ .gpa = a, .prompt = &prompt };
+        const r = try rows.Rows.open(a, f.snapshots(), options(root));
+        defer r.deinit();
+        var s = pc.Store.init(a, f.snapshots(), rules, 1 << 30);
+        defer s.deinit();
+        s.disk = r;
+        f.at = 2000;
+        try t.expect(s.keep(&prompt, 2000, null, &.{}, &.{}));
+        while (rows.write.step(r)) {}
+        f.prompt = key;
+        f.at = 2500;
+        try t.expect(s.keep(key, 2500, null, &.{}, &.{})); // kept in RAM like any state
+        while (rows.write.step(r)) {}
+        try t.expectEqual(@as(usize, 1), r.states.items.len); // only the plain state went to disk
+        try t.expectEqual(@as(u32, 2000), r.states.items[0].at);
+        for (r.states.items[0].tokens) |w| try t.expect(w & 0x8000_0000 == 0); // no salted word, nor the salt, on disk
+    }
+    // a new store over the same folder: the plain prompt restores from disk, the salted key reads nothing
+    var f: fake.Fake = .{ .gpa = a, .prompt = &prompt };
+    const r = try rows.Rows.open(a, f.snapshots(), options(root));
+    defer r.deinit();
+    var s = pc.Store.init(a, f.snapshots(), rules, 1 << 30);
+    defer s.deinit();
+    s.disk = r;
+    const plain = try s.begin(a, &prompt, 2900, &.{}, &.{}, null, &.{});
+    defer a.free(plain.marks);
+    try t.expectEqual(@as(u32, 2000), plain.from);
+    try t.expectEqual(fake.fresh(&prompt), f.pass(&s, plain));
+    const reads = r.counts.reads;
+    for (s.entries.items) |e| e.expired = true;
+    s.collectExpired();
+    f.prompt = key;
+    const salted = try s.begin(a, key, 2900, &.{}, &.{}, null, &.{});
+    defer a.free(salted.marks);
+    try t.expectEqual(@as(u32, 0), salted.from); // the whole prompt prefilled
+    try t.expectEqual(fake.fresh(key), f.pass(&s, salted));
+    try t.expectEqual(reads, r.counts.reads); // no disk read for it
+}
diff --git a/zig/src/core/cache_salt_key.zig b/zig/src/core/cache_salt_key.zig
new file mode 100644
index 0000000000000000000000000000000000000000..397588a9d1c2cf2dce0d8163c46b3c28c9001cfb
--- /dev/null
+++ b/zig/src/core/cache_salt_key.zig
@@ -0,0 +1,41 @@
+//! A salted prompt-cache key: its first words masked by the salt, so only the same salt's requests share states.
+const std = @import("std");
+
+/// Key words a salt masks: four 31-bit masks must all agree before two salts' keys share a prefix.
+pub const words = 4;
+
+/// `base` with its first words high-bit and masked by `salt`; such words never go to disk (cache_images.diskSafe).
+pub fn salted(a: std.mem.Allocator, base: []const u32, salt: u64) std.mem.Allocator.Error![]u32 {
+    const out = try a.dupe(u32, base);
+    for (out[0..@min(words, out.len)], 0..) |*w, i| w.* = 0x8000_0000 | ((w.* ^ mask(salt, i)) & 0x7fff_ffff);
+    return out;
+}
+
+/// The salt's mask for word `i`: a mask, not a hash, so one salt never maps two text tokens to the same word.
+fn mask(salt: u64, i: usize) u32 {
+    return @truncate(std.hash.Wyhash.hash(salt, std.mem.asBytes(&@as(u64, i))));
+}
+
+test "one salt keeps every text token apart, as an unsalted key does; two salts differ in every masked word" {
+    const t = std.testing;
+    var base: [words]u32 = undefined;
+    var seen = std.AutoHashMap(u32, void).init(t.allocator);
+    defer seen.deinit();
+    for (0..1 << 16) |token| { // the same token at every position, under one salt: a different word for each token
+        base = @splat(@intCast(token));
+        const k = try salted(t.allocator, &base, 0x5a17);
+        defer t.allocator.free(k);
+        for (k) |w| try t.expect(w & 0x8000_0000 != 0);
+        try t.expect(!(try seen.getOrPut(k[0])).found_existing);
+    }
+    base = .{ 1, 2, 3, 4 };
+    const one = try salted(t.allocator, &base, 1);
+    defer t.allocator.free(one);
+    const two = try salted(t.allocator, &base, 2);
+    defer t.allocator.free(two);
+    for (one, two) |p, q| try t.expect(p != q);
+}
+
+test {
+    _ = @import("cache_salt_disk_test.zig");
+}
