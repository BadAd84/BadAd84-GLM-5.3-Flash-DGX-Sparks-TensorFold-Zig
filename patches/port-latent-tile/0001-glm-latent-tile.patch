+/// Which kernel an absorb / expand launch picks, decided on the host so routing and precedence are unit-testable.
+pub const Latent = enum { kvb8, tile, tile2, vec, base };
+
+/// absorbQ's choice: KVB8 first (E4M3 kv_b, untouched), then LATENT_TILE (prompt, aligned), then VEC, then today's.
+fn absorbPick(set: glue.Set, sk: u64, q: u64, wk: u64) Latent {
+    if (sk != 0) return .kvb8;
+    if (set.prompt and set.mla.tile != 0 and q % 16 == 0 and wk % 16 == 0) return if (set.mla.tile == 2) .tile2 else .tile;
+    if (set.mla.vec and wk % 16 == 0) return .vec;
+    return .base;
+}
+
+/// expandV's choice, the same precedence; VEC and TILE both need o_lat and wv on 16 bytes.
+fn expandPick(set: glue.Set, sv: u64, ol: u64, wv: u64) Latent {
+    if (sv != 0) return .kvb8;
+    if (set.prompt and set.mla.tile != 0 and ol % 16 == 0 and wv % 16 == 0) return if (set.mla.tile == 2) .tile2 else .tile;
+    if (set.mla.vec and wv % 16 == 0 and ol % 16 == 0) return .vec;
+    return .base;
+}
+
 /// latent.absorb_q: out [rows][heads][lw] bf16 = q [rows][heads][d] . wk [heads][d][lw], fp32 sums; sk: E4M3 kv_b's.
 pub fn absorbQ(set: glue.Set, stream: cuda.Stream, q: u64, wk: u64, sk: u64, out: u64, rows: usize, heads: usize, d: usize, lw: usize) !void {
     if (d != 256 or lw != 512) return error.LatentShape;
-    if (sk != 0) { // TF_GLM_OVN_KVB8: wk E4M3 [heads][d][lw], sk fp32 [heads][d][lw / 128]
-        if (wk % 8 != 0) return error.LatentShape;
-        return rowBlocks(set.glue.absorb_q8, stream, .{ q, wk, sk, out }, rows, heads, lw / 32);
+    switch (absorbPick(set, sk, q, wk)) {
+        .kvb8 => { // TF_GLM_OVN_KVB8: wk E4M3 [heads][d][lw], sk fp32 [heads][d][lw / 128]
+            if (wk % 8 != 0) return error.LatentShape;
+            return rowBlocks(set.glue.absorb_q8, stream, .{ q, wk, sk, out }, rows, heads, lw / 32);
+        },
+        .tile => return tileBlocks(set.glue.absorb_tile, stream, .{ q, wk, out }, rows, heads, lw / 32, prompt_tile_g),
+        .tile2 => return tileBlocks(set.glue.absorb_tile_g2, stream, .{ q, wk, out }, rows, heads, lw / 32, prompt_tile_g2),
+        .vec, .base => try rowBlocks(absorbFn(set, wk), stream, .{ q, wk, out }, rows, heads, lw / 32),
     }
-    try rowBlocks(absorbFn(set, wk), stream, .{ q, wk, out }, rows, heads, lw / 32);
 }
 
 /// The absorb and expand launches (pointers, then rows, heads, rb): rows in one block in decode, prompt_rb in prompts.
@@ -72,14 +100,28 @@ fn rowBlocks(f: cuda.Function, stream: cuda.Stream, ptrs: anytype, rows: usize,
     try cuda_pdl.launch(f, .{ .grid = .{ .x = @intCast(heads), .y = @intCast(cols), .z = cdiv(rows, rb) }, .block = .{ .x = 128 } }, stream, &a);
 }
 
+/// A tile launch (absorb_tile / expand_tile, a G=2 or G=4 block, or a check control): G strips a block.
+pub fn tileBlocks(f: cuda.Function, stream: cuda.Stream, ptrs: anytype, rows: usize, heads: usize, cols: usize, g: usize) !void {
+    const rb = if (rows >= prompt_rows) prompt_tile_rb else rows;
+    var a: cuda.Args = .{};
+    inline for (ptrs) |v| a.add(@as(u64, v));
+    inline for (.{ @as(i64, @intCast(rows)), @as(i64, @intCast(heads)), @as(i64, @intCast(rb)) }) |v| a.add(v);
+    const grid = .{ .x = @intCast(heads), .y = cdiv(cols, g), .z = cdiv(rows, rb) };
+    try cuda_pdl.launch(f, .{ .grid = grid, .block = .{ .x = @intCast(128 * g) } }, stream, &a);
+}
+
