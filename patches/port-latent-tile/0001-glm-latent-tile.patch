+            if (wv % 8 != 0) return error.LatentShape;
+            return rowBlocks(set.glue.expand_v8, stream, .{ ol, wv, sv, out }, rows, heads, dv / 16);
+        },
+        .tile => return tileBlocks(set.glue.expand_tile, stream, .{ ol, wv, out }, rows, heads, dv / 16, prompt_tile_g),
+        .tile2 => return tileBlocks(set.glue.expand_tile_g2, stream, .{ ol, wv, out }, rows, heads, dv / 16, prompt_tile_g2),
+        .vec, .base => try rowBlocks(expandFn(set, wv, ol), stream, .{ ol, wv, out }, rows, heads, dv / 16),
     }
-    try rowBlocks(expandFn(set, wv, ol), stream, .{ ol, wv, out }, rows, heads, dv / 16);
 }
 
 /// A latent cache holds BF16 rows, or E4M3 rows followed by one FP32 scale per row.
@@ -203,8 +245,10 @@ test "latent.py's tiling rules" {
 const Rec = struct {
