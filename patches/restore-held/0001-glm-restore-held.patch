diff --git a/zig/src/families/glm/cuda_restore_held_test.zig b/zig/src/families/glm/cuda_restore_held_test.zig
new file mode 100644
index 000000000..35fc33b8f
--- /dev/null
+++ b/zig/src/families/glm/cuda_restore_held_test.zig
@@ -0,0 +1,281 @@
+//! TF_GLM_OVN_RESTORE_HELD on a driver whose device memory is host memory: what a restore copies and what it leaves.
+const std = @import("std");
+const cuda = @import("cuda");
+const fixture = @import("cuda_disk_image_test.zig");
+const image = @import("cuda_disk_image.zig");
+const snaps = @import("cuda_snapshots.zig");
+const pages = @import("cuda_snapshot_pages.zig");
+const types = @import("cuda_engine_types.zig");
+const Plan = @import("cuda_snapshot_layout.zig").Plan;
+const max_by_position = @import("cuda_snapshot_layout.zig").max_by_position;
+const State = @import("cuda_state.zig").State;
+const Held = @import("cuda_state.zig").Held;
+const H = fixture.H;
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+
+/// Device addresses are host addresses on the fixture's driver.
+fn hostBytes(p: u64, n: usize) []u8 {
+    return @as([*]u8, @ptrFromInt(p))[0..n];
+}
+
+/// The fixture's driver with device-to-device copies counted by bytes, and the 32-bit fill a state's position takes.
+const D = struct {
+    var copied: usize = 0;
+    var inner: cuda.Driver = undefined;
+    fn dtod(dst: u64, src: u64, n: usize, s: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        copied += n;
+        return inner.api.cuMemcpyDtoDAsync_v2(dst, src, n, s);
+    }
+    fn set32(p: u64, v: c_uint, n: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        for (0..n) |i| std.mem.writeInt(u32, hostBytes(p + 4 * i, 4)[0..4], v, .little);
+        return 0;
+    }
+    fn driver() cuda.Driver {
+        inner = H.driver();
+        var d = inner;
+        d.api.cuMemcpyDtoDAsync_v2 = dtod;
+        d.api.cuMemsetD32Async = set32;
+        return d;
+    }
+};
+
+/// What keepAs and restore read of an engine: a bound sequence (its state carries the mark) and the snapshot pages.
+const Fake = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    c: @import("config.zig").Config,
+    cur: struct { st: State, in_head: usize = 0, cuts: std.ArrayList(u32) = .empty },
+    capacity: usize = fixture.capacity,
+    mtp: bool = false, // DFlash2 drafting: a kept state holds no head rows
+    head: bool = false,
+    snaps: std.AutoHashMapUnmanaged(u64, types.Snap) = .empty,
+    snap_pages: ?pages.Pool = null,
+    share_pages: bool = false,
+};
+
+/// A plan's bytes in order, read from the live sequence.
+fn gather(plan: *const Plan, out: []u8) void {
+    var at: usize = 0;
+    for (plan.parts[0..plan.count]) |p| {
+        @memcpy(out[at..][0..p.len], hostBytes(p.live, p.len));
+        at += p.len;
+    }
+}
+
+/// Other bytes over a live range, by offset from the arena's first byte.
+const Scribble = struct {
+    base: u64,
+    fn run(s: @This(), at: u64, n: usize) anyerror!void {
+        for (hostBytes(at, n), 0..) |*b, i| b.* = @truncate((at - s.base + i) *% 17 +% 3);
+    }
+};
+
+test "restore held: a copy leaves out the ranges it is told, piece by piece" {
+    const a = std.testing.allocator;
+    const Got = struct {
+        list: *std.ArrayList([2]u64),
+        fn add(g: @This(), at: u64, n: usize) anyerror!void {
+            try g.list.append(std.testing.allocator, .{ at, n });
+        }
+    };
+    var got: std.ArrayList([2]u64) = .empty;
+    defer got.deinit(a);
+    const but = [_][2]u64{ .{ 100, 200 }, .{ 300, 310 }, .{ 500, 900 } };
+    const cases = [_]struct { live: u64, n: usize, want: []const [2]u64 }{
+        .{ .live = 0, .n = 50, .want = &.{.{ 0, 50 }} }, // before every range
+        .{ .live = 0, .n = 150, .want = &.{.{ 0, 100 }} }, // into one
+        .{ .live = 100, .n = 100, .want = &.{} }, // one range exactly
+        .{ .live = 150, .n = 200, .want = &.{ .{ 200, 100 }, .{ 310, 40 } } }, // out of one, across the next
+        .{ .live = 50, .n = 1000, .want = &.{ .{ 50, 50 }, .{ 200, 100 }, .{ 310, 190 }, .{ 900, 150 } } },
+        .{ .live = 250, .n = 20, .want = &.{.{ 250, 20 }} }, // between two
+        .{ .live = 600, .n = 100, .want = &.{} }, // inside one
+        .{ .live = 890, .n = 20, .want = &.{.{ 900, 10 }} },
+        .{ .live = 900, .n = 5, .want = &.{.{ 900, 5 }} }, // from a range's end
+    };
+    for (cases) |c| {
+        got.clearRetainingCapacity();
+        try pages.eachBut(c.live, c.n, &but, Got{ .list = &got }, Got.add);
+        try std.testing.expectEqualSlices([2]u64, c.want, got.items);
+    }
+    got.clearRetainingCapacity();
+    try pages.eachBut(7, 9, &.{}, Got{ .list = &got }, Got.add); // no range: the whole copy
+    try std.testing.expectEqualSlices([2]u64, &.{.{ 7, 9 }}, got.items);
+}
+
+test "restore held: the by-position ranges are each DSA layer's latent rows, scales and whole pools, as the disk image counts them" {
+    var m: fixture.Model = undefined;
+    try m.init();
+    var d = H.driver();
+    const a = std.testing.allocator;
+    var list: std.ArrayList(image.Part) = .empty;
+    defer list.deinit(a);
+    for ([_]bool{ false, true }) |kv8| {
+        var st = try State.initFormat(a, &d, &m.w, fixture.capacity, kv8);
+        defer st.deinit();
+        const sh = try image.Shape.of(&st, &m.w.config, fixture.capacity, false);
+        for ([_]u32{ 1, 3, 4, 2048, 2051, 6141, 6144 }) |at| {
+            var buf: [max_by_position][2]u64 = undefined;
+            const ranges = Plan.byPosition(&st, &m.w.config, at, &buf);
+            list.clearRetainingCapacity();
+            try image.parts(sh, at, &list, a);
+            var want_bytes: u64 = 0;
+            var want_count: usize = 0;
+            for (list.items) |p| if (p.row != 0 and p.bytes > 0) {
+                want_bytes += p.bytes;
+                want_count += 1;
+            };
+            var bytes: u64 = 0;
+            const plan = try Plan.init(&st, &m.w.config, at, null, 0);
+            for (ranges, 0..) |r, i| {
+                try expect(r[1] > r[0]);
+                if (i > 0) try expect(r[0] >= ranges[i - 1][1]); // ascending and apart
+                bytes += r[1] - r[0];
+                var parts: usize = 0; // each lies in one part of the plan, from that part's first byte
+                for (plan.parts[0..plan.count]) |p| parts += @intFromBool(r[0] == p.live and r[1] <= p.live + p.len);
+                try expectEqual(@as(usize, 1), parts);
+            }
+            try expectEqual(want_count, ranges.len);
+            try expectEqual(want_bytes, bytes);
+            try expect(bytes < plan.len); // the head, the rings and the pools in progress are never among them
+        }
+    }
+}
+
+test "restore held: a restore into the sequence that kept the state copies its own parts alone, and every planned byte is the kept one" {
+    var m: fixture.Model = undefined;
+    try m.init();
+    var d = D.driver();
+    const a = std.testing.allocator;
+    defer cuda.ovn.fake("RESTORE_HELD", null);
+    for ([_]bool{ false, true }) |kv8| for ([_]u32{ 2048, 2051, 4099 }) |at| {
+        var e: Fake = .{ .gpa = a, .d = &d, .stream = .{ .d = &d, .handle = null }, .c = m.w.config, .cur = .{ .st = try State.initFormat(a, &d, &m.w, fixture.capacity, kv8) } };
+        defer e.cur.st.deinit();
+        e.snap_pages = try pages.Pool.init(a, &d, 256 << 20, false);
+        defer e.snap_pages.?.deinit();
+        try e.snaps.ensureTotalCapacity(a, 8);
+        defer e.snaps.deinit(a);
+        defer for ([_]u64{ 7, 8, 9 }) |id| if (e.snaps.getPtr(id)) |s| snaps.free(&e, s);
+        const live = hostBytes(e.cur.st.arena.buf.ptr, e.cur.st.arena.buf.len);
+        for (live, 0..) |*b, i| b.* = @truncate(i *% 31 +% 7);
+        const cur = try a.dupe(u1, e.cur.st.cur);
+        defer a.free(cur);
+        try e.cur.st.restoreHost(e.stream, at, 0, cur, .{ 0, 0 }); // the sequence stands at `at`
+        cuda.ovn.fake("RESTORE_HELD", "1");
+        try snaps.keepAs(&e, 7);
+        try expectEqual(@as(?Held, .{ .id = 7, .at = at }), e.cur.st.held);
+        const plan = try Plan.init(&e.cur.st, &e.c, at, null, 0);
+        const kept = try a.alloc(u8, plan.len);
+        defer a.free(kept);
+        const now = try a.alloc(u8, plan.len);
+        defer a.free(now);
+        gather(&plan, kept);
+        var buf: [max_by_position][2]u64 = undefined;
+        const held = Plan.byPosition(&e.cur.st, &e.c, at, &buf);
+        var held_bytes: usize = 0;
+        for (held) |r| held_bytes += @intCast(r[1] - r[0]);
+        try expect(held_bytes > 0 and held_bytes < plan.len);
+        // the sequence goes on: every byte a later pass may write gets another value, its rows below `at` stay
+        const base = e.cur.st.arena.buf.ptr;
+        try pages.eachBut(base, live.len, held, Scribble{ .base = base }, Scribble.run);
+        try e.cur.st.restoreHost(e.stream, at + 40, 0, cur, .{ 4, 0 });
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len - held_bytes, D.copied);
+        gather(&plan, now);
+        try std.testing.expectEqualSlices(u8, kept, now);
+        try expectEqual(@as(usize, at), e.cur.st.pos);
+        try expectEqual(@as(usize, 0), e.cur.st.base);
+        try expectEqual(@as(?Held, .{ .id = 7, .at = at }), e.cur.st.held);
+        // the control: a held byte changed behind the mark's back is not repaired, so that restore did not copy it
+        hostBytes(held[0][0], 1)[0] ^= 0xFF;
+        try snaps.restore(&e, 7);
+        gather(&plan, now);
+        try expect(!std.mem.eql(u8, kept, now));
+        // a forward at `at` or past it keeps the mark; one below clears it, and the next restore is whole
+        for ([_]usize{ at, at + 5, at - 1 }) |pos| {
+            try e.cur.st.restoreHost(e.stream, pos, 0, cur, .{ at - 3, 0 });
+            try e.cur.st.ready(e.stream, 1);
+            try expectEqual(pos >= at, e.cur.st.held != null);
+        }
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len, D.copied);
+        gather(&plan, now);
+        try std.testing.expectEqualSlices(u8, kept, now);
+        // a restore sets the mark as a keep does: the same state again copies its own parts alone
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len - held_bytes, D.copied);
+        // off, every restore is whole, mark or not
+        cuda.ovn.fake("RESTORE_HELD", null);
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len, D.copied);
+        // another kept state's mark is no match: after a keep four rows on, the first state comes back whole
+        cuda.ovn.fake("RESTORE_HELD", "1");
+        try e.cur.st.restoreHost(e.stream, at + 4, 0, cur, .{ 0, 0 });
+        try snaps.keepAs(&e, 8);
+        try expectEqual(@as(?Held, .{ .id = 8, .at = at + 4 }), e.cur.st.held);
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len, D.copied);
+        try expectEqual(@as(?Held, .{ .id = 7, .at = at }), e.cur.st.held);
+        gather(&plan, now);
+        try std.testing.expectEqualSlices(u8, kept, now);
+        // the same position under another id is another state, other rows and all: the first comes back whole
+        try e.cur.st.restoreHost(e.stream, at, 0, cur, .{ 0, 0 });
+        for (live, 0..) |*b, i| b.* = @truncate(i *% 13 +% 5);
+        try snaps.keepAs(&e, 9);
+        try expectEqual(@as(?Held, .{ .id = 9, .at = at }), e.cur.st.held);
+        D.copied = 0;
+        try snaps.restore(&e, 7);
+        try expectEqual(plan.len, D.copied);
+        gather(&plan, now);
+        try std.testing.expectEqualSlices(u8, kept, now);
+    };
+}
+
+test "restore held: a paged sequence names no by-position range, its rows being on pages" {
+    var m: fixture.Model = undefined;
+    try m.init();
+    var d = D.driver();
+    const a = std.testing.allocator;
+    const paged: @import("cuda_state.zig").Paged = .{ .kv = 1 << 30, .pages = @import("cuda_pages.zig").tableLen(fixture.capacity), .page_bytes = @import("cuda_state.zig").pageBytes(&m.w) };
+    var st = try State.initPaged(a, &d, &m.w, fixture.capacity, paged);
+    defer st.deinit();
+    var buf: [max_by_position][2]u64 = undefined;
+    try expectEqual(@as(usize, 0), Plan.byPosition(&st, &m.w.config, 2048, &buf).len);
+}
+
+test "restore held: a restore that fails midway leaves no mark, and the next one is whole" {
+    var m: fixture.Model = undefined;
+    try m.init();
+    var d = D.driver();
+    const a = std.testing.allocator;
+    defer cuda.ovn.fake("RESTORE_HELD", null);
+    var e: Fake = .{ .gpa = a, .d = &d, .stream = .{ .d = &d, .handle = null }, .c = m.w.config, .cur = .{ .st = try State.initFormat(a, &d, &m.w, fixture.capacity, false) } };
+    defer e.cur.st.deinit();
+    e.snap_pages = try pages.Pool.init(a, &d, 256 << 20, false);
+    defer e.snap_pages.?.deinit();
+    try e.snaps.ensureTotalCapacity(a, 8);
+    defer e.snaps.deinit(a);
+    defer if (e.snaps.getPtr(7)) |s| snaps.free(&e, s);
+    const cur = try a.dupe(u1, e.cur.st.cur);
+    defer a.free(cur);
+    try e.cur.st.restoreHost(e.stream, 2048, 0, cur, .{ 0, 0 });
+    cuda.ovn.fake("RESTORE_HELD", "1");
+    try snaps.keepAs(&e, 7);
+    try expectEqual(@as(?Held, .{ .id = 7, .at = 2048 }), e.cur.st.held);
+    const lease = &e.snaps.getPtr(7).?.lease;
+    lease.ids.items.len -= 1; // one page short: the copy refuses before it moves a byte
+    if (snaps.restore(&e, 7)) |_| return error.TestExpectedError else |err| try expectEqual(error.SnapshotSize, err);
+    try expectEqual(@as(?Held, null), e.cur.st.held); // part of the sequence may be the state's and part not
+    lease.ids.items.len += 1;
+    D.copied = 0;
+    const plan = try Plan.init(&e.cur.st, &e.c, 2048, null, 0);
+    try snaps.restore(&e, 7);
+    try expectEqual(plan.len, D.copied);
+    try expectEqual(@as(?Held, .{ .id = 7, .at = 2048 }), e.cur.st.held);
+}
