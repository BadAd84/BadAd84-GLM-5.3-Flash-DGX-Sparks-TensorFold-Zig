+    /// TF_GLM_OVN_RESTORE_HELD: the free slot whose sequence still holds the kept state the stream resumes, if any.
+    pub fn heldSlot(self: *const Lanes, s: *const lanes.Stream) ?u32 {
+        if (!snapshots.restoreHeld() or self.x.e.pages != null) return null;
+        const k: *const engine.Kept = @ptrCast(@alignCast(s.reuse.saved orelse return null));
+        for (self.x.e.seqs.items, 0..) |q, slot| {
+            const h = (q orelse continue).st.held orelse continue;
+            if (h.id != k.id) continue;
+            var it = self.lanes.valueIterator();
+            while (it.next()) |l| {
+                if (l.slot == slot) break;
+            } else return @as(u32, @intCast(slot));
+        }
+        return null;
+    }
+
     pub fn claim(self: *Lanes, s: *const lanes.Stream) !*Lane {
+        if (self.lanes.getPtr(s)) |existing| return existing;
+        if (self.heldSlot(s)) |slot| return self.claimAt(s, slot);
         return self.claimUsing(s, freeSlot);
     }
 
     pub fn claimUsing(self: *Lanes, s: *const lanes.Stream, comptime choose: anytype) !*Lane {
         if (self.lanes.getPtr(s)) |existing| return existing;
-        const slot = choose(self);
+        return self.claimAt(s, choose(self));
+    }
+
+    fn claimAt(self: *Lanes, s: *const lanes.Stream, slot: u32) !*Lane {
         const gop = try self.lanes.getOrPut(self.x.e.gpa, s);
         gop.value_ptr.* = .{ .slot = slot };
         return gop.value_ptr;
