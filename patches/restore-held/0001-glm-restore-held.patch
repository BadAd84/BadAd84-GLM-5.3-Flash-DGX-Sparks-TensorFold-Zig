index 000000000..5d7d6f6ee
--- /dev/null
+++ b/zig/tests/cuda/glm_restore_held_check.zig
@@ -0,0 +1,200 @@
+//! `glm-restore-held-check CKPT ID_PATH`: TF_GLM_OVN_RESTORE_HELD's restore against a whole one, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const openComm = @import("glm_lanes_tests.zig").openComm;
+const glm = @import("glm_cuda");
+
+/// Greedy steps a run records after its prompt, and the MTP head's drafts at each.
+const steps = 12;
+const depth = 2;
+
+/// A first request of `first` rows keeps its state at `at` (in `cuts`, or on the grid); the next one has `next` rows.
+const Case = struct { name: []const u8, first: usize, at: u32, cuts: []const u32 = &.{}, next: usize };
+const cases = [_]Case{
+    .{ .name = "kept on the grid", .first = 3000, .at = 2048, .next = 3548 },
+    .{ .name = "kept inside a pool", .first = 2600, .at = 2051, .cuts = &.{2051}, .next = 2951 },
+    .{ .name = "kept where the index rings are nearly full", .first = 4500, .at = 4099, .cuts = &.{4099}, .next = 5299 },
+};
+
+/// One run's record: each step's drawn token, its logits row (bf16) and the MTP head's drafts after it.
+const Trace = struct {
+    tokens: [steps]u32 = undefined,
+    drafts: [steps * depth]u32 = undefined,
+    logits: []u16,
+
+    fn init(a: std.mem.Allocator, v: usize) !Trace {
+        return .{ .logits = try a.alloc(u16, steps * v) };
+    }
+
+    fn equals(t: *const Trace, o: *const Trace) bool {
+        return std.mem.eql(u32, &t.tokens, &o.tokens) and std.mem.eql(u32, &t.drafts, &o.drafts) and std.mem.eql(u16, t.logits, o.logits);
+    }
+};
+
+/// The mark's hook: the state kept where the pass stands at `at`.
+const Keep = struct {
+    e: *glm.engine.Engine,
+    at: [1]u32,
+    id: u64 = 0,
+
+    fn call(ctx: *anyopaque, at: u32) void {
+        const k: *Keep = @ptrCast(@alignCast(ctx));
+        if (at == k.at[0]) k.id = k.e.keepState() catch 0;
+    }
+};
+
+const Run = struct {
+    gpu: check.Gpu,
+    e: *glm.engine.Engine,
+    x: glm.follow.Leader,
+    v: usize,
+
+    /// A request's prompt pass on `slot`, a chunk a step, from row 0 or a kept state; `keep` keeps a state at its row.
+    fn prompt(r: Run, slot: u32, p: []const u32, starts: []const u32, from: ?glm.engine.Resume, keep: ?*Keep) !u32 {
+        try r.x.bind(slot);
+        try r.x.begin(null);
+        if (starts.len > 0) try r.x.cuts(starts);
+        const marks: ?glm.engine.Marks = if (keep) |k| .{ .at = &k.at, .ctx = k, .call = Keep.call } else null;
+        var at: usize = if (from) |f| f.at else 0;
+        var again = from;
+        while (true) {
+            const c = try r.x.chunk(p, at, false, again, null, marks);
+            again = null;
+            if (c.first) |t| return t;
+            at += c.rows;
+        }
+    }
+
+    /// Lone greedy steps from `first` on the bound sequence, recorded.
+    fn decode(r: Run, token: u32, out: *Trace) !void {
+        var t = token;
+        var held: [glm.engine.max_drafts]u32 = undefined;
+        try r.x.draft(true, &.{t}, depth, &held, null);
+        for (0..steps) |s| {
+            var o: [1]u32 = undefined;
+            try r.x.verify(&.{t}, &o, 0);
+            try cuda.memory.download(r.gpu.d, r.e.bd.logits, std.mem.sliceAsBytes(out.logits[s * r.v ..][0..r.v]));
+            try r.x.keep(1);
+            try r.x.draft(false, &o, depth, &held, null);
+            out.tokens[s] = o[0];
+            @memcpy(out.drafts[s * depth ..][0..depth], held[0..depth]);
+            t = o[0];
+        }
+    }
+
+    /// The bound sequence's state as a keep here would copy it: the snapshot plan's parts, in order.
+    fn planned(r: Run, a: std.mem.Allocator) ![]u8 {
+        const st = &r.e.cur.st;
+        try r.e.stream.synchronize();
+        const plan = try glm.snapshots.layout.Plan.init(st, &r.e.c, st.pos, if (r.e.mtp) st.mtp_len else null, 0);
+        const out = try a.alloc(u8, plan.len);
+        var at: usize = 0;
+        for (plan.parts[0..plan.count]) |p| {
+            try cuda.memory.download(r.gpu.d, p.live, out[at..][0..p.len]);
+            at += p.len;
+        }
+        return out;
+    }
+
+    /// A first request on `slot` that keeps its state at the case's row and then decodes; the kept state's id.
+    fn first(r: Run, slot: u32, c: Case, p: []const u32, a: std.mem.Allocator) !u64 {
+        var keep: Keep = .{ .e = r.e, .at = .{c.at} };
+        var scratch = try Trace.init(a, r.v);
+        try r.decode(try r.prompt(slot, p[0..c.first], c.cuts, null, &keep), &scratch);
+        try check.expect(keep.id != 0 and r.e.holds(keep.id), "{s}: no state was kept at row {d}", .{ c.name, c.at });
+        return keep.id;
+    }
+};
+
+/// `n` prompt ids from `seed`, inside the vocabulary.
+fn ids(a: std.mem.Allocator, n: usize, seed: u64, vocab: usize) ![]u32 {
+    const out = try a.alloc(u32, n);
+    var r = std.Random.DefaultPrng.init(seed);
+    for (out) |*u| u.* = r.random().uintLessThan(u32, @intCast(vocab));
+    return out;
+}
+
+pub fn run(gpu: check.Gpu, rest: []const [:0]const u8) !void {
+    if (rest.len < 2) return check.expect(false, "usage: glm-restore-held-check CKPT ID_PATH (TF_GLM_LAYERS=2 on glm-synth's checkpoint)", .{});
+    const on = glm.snapshots.restoreHeld();
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var lib = try cuda.nccl.Library.open();
+    defer lib.close();
+    const comm = try openComm(gpu, &lib, 0, 1, rest[1]);
+    defer _ = lib.api.ncclCommDestroy(comm);
+    var problem: []const u8 = "";
+    var set = glm.ranks.Settings.read(&glm.ranks.environment, &problem) catch |err| {
+        std.debug.print("REFUSE {s}\n", .{problem});
+        return err;
+    };
+    var failed = false;
+    var planted: usize = 0;
+    for ([_]bool{ false, true }) |kv8| {
+        set.kv8 = kv8;
+        const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, rest[0], &lib, comm, 0, 1, .{ .capacity = 8192, .mtp = true, .settings = set });
+        defer e.deinit();
+        var link = try glm.follow.Link.init(gpu.gpa, gpu.d, &lib, comm, e.stream, 8192);
+        defer link.deinit();
+        const r: Run = .{ .gpu = gpu, .e = e, .x = .{ .e = e, .link = &link }, .v = e.share.vocab.len() };
+        try r.x.snapshots(1 << 30);
+        for (cases, 0..) |c, ci| {
+            const base: u32 = @intCast(10 * ci + 1);
+            // the next request shares the first's rows to `at` and goes its own way after
+            const p = try ids(a, c.first, 11 + ci, e.c.vocab);
+            const q = try ids(a, c.next, 31 + ci, e.c.vocab);
+            @memcpy(q[0..c.at], p[0..c.at]);
+            // the sequence that kept the state resumes it: under the switch its by-position rows stay where they are
+            const id = try r.first(base, c, p, a);
+            var got = try Trace.init(a, r.v);
+            const t1 = try r.prompt(base, q, c.cuts, .{ .id = id, .at = c.at }, null);
+            const held = try r.planned(a);
+            try r.decode(t1, &got);
+            // another sequence resumes the same state: a whole restore
+            var whole = try Trace.init(a, r.v);
+            const t2 = try r.prompt(base + 1, q, c.cuts, .{ .id = id, .at = c.at }, null);
+            const copied = try r.planned(a);
+            try r.decode(t2, &whole);
+            // a third runs the request cold
+            var cold = try Trace.init(a, r.v);
+            try r.decode(try r.prompt(base + 2, q, c.cuts, null, null), &cold);
+            if (!std.mem.eql(u8, held, copied)) {
+                std.debug.print("FAIL kv8={}, {s}: the resumed sequence's state differs from a whole restore's (first byte {?d} of {d})\n", .{ kv8, c.name, std.mem.indexOfDiff(u8, held, copied), held.len });
+                failed = true;
+            }
+            if (!got.equals(&whole) or !got.equals(&cold)) {
+                std.debug.print("FAIL kv8={}, {s}: {d} steps differ (against a whole restore {}, against a cold run {})\n", .{ kv8, c.name, steps, got.equals(&whole), got.equals(&cold) });
+                failed = true;
+            }
+            // the planted control: one byte of a row the sequence holds, changed before it resumes its own state
+            const id2 = try r.first(base + 3, c, p, a);
+            var ranges: [glm.snapshots.layout.max_by_position][2]u64 = undefined;
+            const rows = glm.snapshots.layout.Plan.byPosition(&r.e.cur.st, &r.e.c, c.at, &ranges);
+            try check.expect(rows.len > 0, "{s}: no by-position rows", .{c.name});
+            const at = rows[0][0] + (rows[0][1] - rows[0][0]) / 2;
+            var one: [1]u8 = undefined;
+            try r.e.stream.synchronize();
+            try cuda.memory.download(gpu.d, at, &one);
+            const byte: cuda.DeviceBuffer = .{ .d = gpu.d, .ptr = at, .len = 1, .borrowed = true };
+            try byte.fill8(one[0] ^ 0xFF, e.stream.handle);
+            _ = try r.prompt(base + 3, q, c.cuts, .{ .id = id2, .at = c.at }, null);
+            const poisoned = try r.planned(a);
+            const same = std.mem.eql(u8, poisoned, copied);
+            if (on and same) {
+                std.debug.print("FAIL kv8={}, {s}: a changed byte of a held row was repaired, so the restore copied it and the check cannot fail\n", .{ kv8, c.name });
+                failed = true;
+            } else if (!on and !same) {
+                std.debug.print("FAIL kv8={}, {s}: off, a whole restore left a changed byte (first {?d})\n", .{ kv8, c.name, std.mem.indexOfDiff(u8, poisoned, copied) });
+                failed = true;
+            } else planted += 1;
+            for ([_]u64{ id, id2 }) |k| e.dropState(k);
+        }
+        try r.x.end();
+    }
+    if (failed) return error.TestFailed;
+    if (on) {
+        check.pass("TF_GLM_OVN_RESTORE_HELD=1: a state resumed by the sequence that kept it equals a whole restore's in every planned byte and {d} greedy steps equal a cold run's, {d} cases, fp8 and bf16 caches; {d} planted controls (a held byte changed) stayed changed", .{ steps, cases.len, planted });
+    } else check.pass("TF_GLM_OVN_RESTORE_HELD off: every restore is whole, {d} cases, fp8 and bf16 caches; {d} planted controls (a held byte changed) were repaired", .{ cases.len, planted });
+}
