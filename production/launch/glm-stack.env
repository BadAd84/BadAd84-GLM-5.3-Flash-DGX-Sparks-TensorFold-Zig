# glm-stack.env - the ONE place that names the GLM stack the Spark helpers drive.
# Sourced (bash) on the head, spark1, by spark-model, glm-watchdog.sh and glm-boot-hygiene.sh.
# Box copy: ~/.config/glm-stack.env. A stack change (new engine, new worker, new port) is an
# edit HERE only; the helpers carry no worker IP, port or container name of their own.

# Stack id, recorded in the watchdog log and in docs/spark-live-state.json.
# tf-v110: MiaAI-Lab recipe v1.10 (TensorFold v0.6.0) at TP=3 with the OTS patches (scripts/glm53/v110/); replaced
# tf-v18 (recipe v1.8, kept as the rollback: scripts/glm53/v18/) on 2026-10-08, which replaced tf-v15 on 2026-10-07.
GLM_STACK=tf-v110

# Which API the watchdog reads: tensorfold (JSON /health) or vllm (Prometheus /metrics).
GLM_API=tensorfold

# OpenAI-compatible serve port on the head.
GLM_PORT=8888

# Every container of this stack starts with this prefix, on every node.
GLM_CONTAINER_PREFIX=glm53-flash-tf
GLM_HEAD_CONTAINER=glm53-flash-tf

# Worker ssh targets in rank order (rank 1 = spark2, rank 2 = spark3), over the management LAN.
# The ConnectX ring carries only NCCL and RoCE; it has no address that reaches every node from the head.
# Names (UniFi DNS), not raw IPs, so a LAN reservation remap never breaks the serve.
# The worker ssh targets, in rank order, are set per box in its ~/.config/glm-stack.env (untracked);
# this tracked copy carries placeholders only (the doc-inventory gate counts them).
GLM_WORKERS="worker1 worker2"

# Launcher and stop command (scripts/glm53/v110/glm-v110-start.sh / glm-v110-stop.sh, box copies in ~; both read
# ~/v110.env, a symlink to the settings served: production ~/v110ots.env).
GLM_START="$HOME/glm-v110-start.sh"
GLM_STOP="$HOME/glm-v110-stop.sh"

# Docker images this stack expects PRESENT on every node (space-separated). scripts/refresh-spark-state.sh
# records the box's image list and scripts/check-doc-inventory.sh fails if one of these is missing. The production
# image is the rebased stack built on each Spark from the current MiaAI recipe base plus the lane stack and the two
# knobs (tensorfold-glm53:v110hunt4-shard), promoted 2026-11-05.
GLM_IMAGES="tensorfold-glm53:v110hunt4-shard"

# 1 = run glm-disk-guard.sh before (re)starts and keep the head's glm-disk-guard.timer pruning the disk tier. The
# recipe's spill tier (SPILL_GIB=120, 0128) caps and makes room itself (SPILL_MIN_FREE_GIB 50), as our retired kvtier
# did, so no external guard: 0.
GLM_DISK_GUARD=0
