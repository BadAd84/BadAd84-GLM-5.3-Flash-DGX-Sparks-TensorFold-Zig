# v110ots.env (spark1 ~/v110ots.env; ~/v110.env points here when the OTS image serves): the rebased production stack,
# promoted 2026-11-05 (notes 9.46-9.49, qual-promote PASS: replies equal bar the one realdec-prose prompt line, TTFT
# within 10%, RigMark +3.13% mean). It is the current MiaAI recipe (bf5f945, 123 patches, TensorFold v0.6.0) plus the
# verified OTS lane stack and the two ported knobs, built as tensorfold-glm53:v110hunt4 (sync/*-ported.patch's 19 ports
# + the hunt stack's ~119 patches + sync/knobs/knobs-synced.patch; the 30 obsolete ots*.patch are gone from this base,
# README-OTS-PATCHES.md). Every TF_GLM_* variable reaches every rank (start.sh env_args).
export IMAGE=tensorfold-glm53:v110hunt4-shard PREPARE=0
# Pool and display span (2032 MiB through kindling's dispramd: recipe patch 0087, our former 0072), the owner's 4
# streams, RoCE.
export KV_POOL_GIB=31 DISPLAY_KV_MIB=2032 DISPLAY_KV_BACKEND=dispram
export PARALLEL=4 COMM=roce
# Recipe switches that replace OTS ones: TF_GLM_EXL3_DEC_ORDER (recipe's, our former 0079); the recipe's loop guard
# (TF_GLM_LOOP_GUARD) replaces our 0074.
export TF_GLM_EXL3_DEC_ORDER=1
export TF_GLM_LOOP_GUARD=1
# Kept prompt states and the fill-fast window (the lane stack's: a pool-sized kept-state count, 400 ms fill-fast).
export TF_GLM_CACHE_ENTRIES=96
export TF_GLM_FILL_FAST_MS=400
# Prompt chunks of 4,096 rows (F91): prefill 4-6% faster, the same bits. To go back: 2048 / 2048.
export TF_GLM_PREFILL_ROWS=4096 TF_GLM_FILL_ROWS=4096
# The DSA indexer sharded over the ranks for prompt chunks (ots0101, F97; replies bit-identical). 0 turns it off.
export TF_GLM_INDEXER_SHARD=prefill
# The experts' wide share spread over the ranks by MoE layer (ots0105, F100; replies bit-identical). 0 restores the old
# split (then KV_POOL_GIB back to 30).
export TF_GLM_EXPERT_ROTATE=10,16,16
# Prompt fills yield to decoding every FILL_BUDGET_MS of layer work; the recipe's 200 ms is KEPT (notes 9.53): an A/B at
# 30 ms left decode unchanged (26.2 vs 27.2 tok/s, noise) and made a 30k-token fill 16x slower (276.6 s against 16.7),
# the per-slice overhead dominating. Two knobs that DO address repeated prefills and reply latency:
#   KEEP_PER_CHAT 2: at most two of one conversation's own kept states (0, the default, is no limit, so one 850k
#     conversation could fill entries and evict everyone else's, each eviction costing the next turn a re-prefill).
#   STREAM_SMOOTH 0: no 400 ms playout buffer, so streamed text is released as decoded (the same text and tool calls;
#     the recipe's default holds every token 400 ms for smoothness).
export TF_GLM_KEEP_PER_CHAT=2
export STREAM_SMOOTH=0   # config.sh reads the un-prefixed name and exports TF_GLM_STREAM_SMOOTH
# The two ported knobs (sync/knobs): bit-exact at P1 and P4 (kdig2, kdig4), production speed on the rebased base alone
# (knobs5), part of the +3 to +6% the lane stack gives over upstream (ladder). DraftBuckets wide draft, PooledKeys pack.
export TF_GLM_DRAFT_WIDE=2176:prompt TF_GLM_POOLED_PACK=2
# The kept states' memory budget (upstream's TF_GLM_KEPT_BYTES_GIB): the entry cap (TF_GLM_CACHE_ENTRIES) bounds the
# COUNT of kept prompt states, but each state owns tensors outside the pool (its DFlash2 window copy and other per-
# state copies - for a long conversation hundreds of MiB), so under real agent traffic 96 entries grew past 14 GiB and
# the node OOM'ed (2026-11-07; /health kept_bytes 5.5 GB at 86 states, kept_bytes_cap 0). Rank 0 drops states past this
# budget, by the cap's victim order. 8 GiB: ~2x today's worst pre-traffic floor.
export TF_GLM_KEPT_BYTES_GIB=8
# KV sharding (recipe 0129, TF_GLM_KV_SHARD): the latent cache stored once on each conversation's owner instead of
# on every rank, so the three Sparks share it (~1.88x the tokens in the same memory at two ranks, more at three) and
# rank 0 no longer carries the whole cache (measured 2026-11-10: rank 0 fell to ~4 GiB free under traffic while the
# workers held 14+). Same bits as unsharded. Needs --parallel above 1 and two or more ranks (we run 4 and 3).
export TF_GLM_KV_SHARD=1
# The recipe's disk tier (0128 glm-spill-blocks: our PR #118 block-store design inside upstream's spill tier) at the old
# 120 GiB cap, default SPILL_DIR (~/.cache/tensorfold-spill a node), default SPILL_MIN_FREE_GIB 50. Replaces our retired
# TF_GLM_KV_TIER (inert on this base). Measured (tier_chain): a ~620k conversation resumes from disk after a kill -9
# (18-23 s) and a clean restart (12-13 s); a +23k turn writes ~0.21 GiB a node.
export SPILL_GIB=120
