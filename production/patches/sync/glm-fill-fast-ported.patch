+    def _slice_end(self, pending, busy: bool) -> int:
+        """Rank 0: the layer the pending prompt chunk's next slice runs to. Every layer left when no stream decodes;
+        else the slice TF_GLM_FILL_BUDGET_MS takes (``LayerCosts.stop``), a decode round after it - unless, OTS 0122
+        (TF_GLM_FILL_FAST_MS), the chunk ends every prompt in it (its layers left are all those prompts still fill)
+        and they are estimated at most that many ms (``LayerCosts.remaining``): then every layer left, so the
+        prompts take their first tokens without a decode round between their slices. /health's ``fill_fast``
+        counts the chunks this kept from being sliced (the budget's slice would have ended earlier)."""
+
+        layers = len(self.w.layers)
+        if not busy:
+            return layers
+        hi = self.fill_costs.stop(pending.rows, pending.layer, self.fill_budget)
+        if (hi < layers and self.fill_fast and all(stop == len(lane.s.prompt) for lane, stop in pending.group)
+                and self.fill_costs.remaining(pending.rows, pending.layer) <= self.fill_fast):
+            self.fast_fills += 1
+            return layers
+        return hi
+
