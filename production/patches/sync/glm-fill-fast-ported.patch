+def fast_ms(value: str | None = None, smooth: bool | None = None, hold_ms: float | None = None) -> float:
+    """TF_GLM_FILL_FAST_MS (OTS 0122; 0, the default: off): beside decoding streams, a prompt chunk that ends every
+    prompt in it and whose layers left are estimated (``LayerCosts.remaining``) at most this many milliseconds runs
+    them all now, in one slice, instead of in TF_GLM_FILL_BUDGET_MS slices with a decode round after each: a short
+    prompt or warm turn gets its first token one or more rounds sooner, and the decoding streams pause up to this
+    long, which a smooth-streaming playout buffer at least as long hides (``tensorfold.cuda.stream_pacing``: a
+    pause shorter than its hold is spread over the tokens queued). The same bits either way (scheduling only).
+    With TF_GLM_STREAM_SMOOTH=1 it may not exceed TF_GLM_STREAM_SMOOTH_MS (``smooth`` / ``hold_ms``: those)."""
+
+    from tensorfold.cuda import stream_pacing
+
+    raw = os.environ.get("TF_GLM_FILL_FAST_MS", "") if value is None else value
+    try:
+        ms = float(raw.strip() or "0")
+    except ValueError:
+        ms = -1.0
+    if not math.isfinite(ms) or ms < 0:
+        raise ValueError(f"TF_GLM_FILL_FAST_MS: finite milliseconds >= 0 (0: off), not {raw!r}")
+    if ms and (stream_pacing.smooth_streaming() if smooth is None else smooth):     # off: nothing else read
+        hold = stream_pacing.hold_seconds() * 1000 if hold_ms is None else hold_ms
+        if ms > hold:
+            raise ValueError(f"TF_GLM_FILL_FAST_MS={ms:g}: the decoding streams would pause longer than the "
+                             f"{hold:g} ms smooth-streaming playout hides (TF_GLM_STREAM_SMOOTH_MS): at most that")
+    return ms
+
