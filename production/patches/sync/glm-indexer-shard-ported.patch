+    slot = (tl.cumsum(t, 0) - t).to(tl.int64)
+    j = tl.arange(0, PL)
+    tl.store(TOK + r * W + slot[:, None] * PL + j[None, :], (gp.to(tl.int64)[:, None] * PL + j[None, :]).to(tl.int32),
