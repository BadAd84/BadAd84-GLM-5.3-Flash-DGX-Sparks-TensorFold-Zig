+#!/usr/bin/env python3
+"""indexer_shard.py: the SHARDED DSA indexer (lane-IdeasFable51 idea 1 / lane-IdeasOpus55 idea 1; OTS 0101 + 0107,
+named shard.py on the v1.10 stack and renamed beside upstream's KV shard, cuda/shard.py). The indexer is
+replicated on every rank - the only O(context) work in the serve - so shard it over the TP ranks and gather
+the small per-row results. TF_GLM_INDEXER_SHARD = 0 (off, the default) | prefill | decode | all wires it at
+forward.dsa_rows (prompt chunks: prefill, all) and forward.dsa_segments (decode windows: decode, all; per window
+by decode_window's threshold rule, through verify.BatchedVerify's second set of graphs); a bad value is refused
+at load. The exactness suites and the timings live in ots-infra scripts/glm53/v110/lanes/ShardMimo
+(test_shard_exact.py, the prefill half) and lanes/DecShardFable (test_decode_shard.py, the decode half: every
+case bit-identical to the unsharded path).
+
+Prefill row shard: rank r of `world` owns rows [r*ceil(R/world), (r+1)*ceil(R/world)) of the piece, scores and
+selects them with sparse._prompt_rank_pools (the chunk-wide NP = pool_count(pos, R, np_max) and the same
+per-row positions and kernels, so each row's masked columns, threshold and ties are unchanged), one
+all-gather of the pieces' pools [R, 512] int32 (2 KB a row), then _tokens over ALL R rows on every rank (the
+integer formula; per-row bits unchanged, so the token lists are identical by row independence).
+
+Decode pool shard (OTS 0107, lane DecShardFable, replacing 0101's prototype): each segment's pool blocks
+(BP = 64 pools) split in contiguous thirds between the ranks - rank r's pools [r*cb*64, min((r+1)*cb*64, npm)),
+cb = ceil(ceil(npm/64)/world) - expressed with the production scoring launchers UNMODIFIED: a per-rank segment
+table (_shard_tables: seg_pbase + offset, the shard's extent as seg_pools) rebases p = 0 to the shard's first
+pool, so seg_scores.cu and _seg_scores store the shard's scores compacted into the window's own scores scratch
+(column p = global pool offset + p; a score reads only its own row's queries and its own pool's key, so per-score
+bits are unchanged). Each rank then takes its shard's top-512 by _seg_shard_select, 0096's one-pass selection
+(a floor key from a sample, one pass compacting the pools at or above it, the radix select in registers, or
+_seg_select's passes when the floor misses) over the row's VISIBLE prefix of the compacted row only: NB =
+clamp(npool - offset, 0, extent) columns, every one of which the scoring kernels stored this call (they store p
+< npool for the segment's p < extent), so nothing past them is ever read and no -inf mask exists. Its (order
+key, global pool) pairs, ascending by pool, go through one gather (4 KB a row a rank: the RoCE one-shot path
+under TF_ROCE_MAX_KB), and _seg_shard_merge takes the K best of the world x 512 candidates by the same radix
+select over the order keys: rank order IS pool order (contiguous thirds, each rank's list ascending), so the
+ties at the K-th key go to the lowest pools by cumsum position alone, no sort, and the tokens are written
+ascending as _seg_select_floor writes them, with its tail and count. A pool in the global top-512 has fewer
+pools preceding it (score desc, pool asc) inside its shard than globally, so it is inside its shard's top-512:
+the merge over the union is the global top-512 (integer logic only, no floating-point sum anywhere).
+
+Everything is device-only and capturable (the per-rank tables derived ON DEVICE from rows.seg_pools, the
+exchange through the comm's graph-replayable gather, no host syncs and no pageable copies), so the whole call
+captures into the batched window's CUDA graph; the host decides per window, from its segments' rows and
+positions alone (the same on every rank), whether the sharded graph of that row count pays (decode_window)."""
+from __future__ import annotations
+
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+from tensorfold.families.glm5_next.cuda import kv8, sparse
+from tensorfold.families.glm5_next.cuda.sparse import POOL, SPARSE_FROM, TOPK_POOLS, TOKENS, pool_count, pool_bucket
+
+NEG_INF_BITS = -8_388_608              # float32 -inf's bits read as int32 (0xFF800000): a not-visible column's key
+
+
+# ---------------------------------------------------------------- the mode switch ---------------------------
+
+_MODES = ("0", "prefill", "decode", "all")   # TF_GLM_INDEXER_SHARD: off | the prompt rows | the pool blocks | both
+
+
+def _mode_from(value: str) -> str:
+    """TF_GLM_INDEXER_SHARD's value: 0 (off) | prefill | decode | all; anything else is refused."""
+    if value not in _MODES:
+        raise ValueError(f"TF_GLM_INDEXER_SHARD is 0, prefill, decode or all, not {value!r}")
+    return value
+
+
+def _routing(value: str) -> tuple[bool, bool]:
+    """(the prompt chunk's rows sharded, the decode window's pool blocks sharded) for a validated switch value."""
+    return value in ("prefill", "all"), value in ("decode", "all")
+
+
+SHARD_MODE = _mode_from(__import__("os").environ.get("TF_GLM_INDEXER_SHARD", "0"))   # refused at load, not at first use
+
+
+def prefill_on() -> bool:
+    """forward.dsa_rows shards the prompt chunk's rows (TF_GLM_INDEXER_SHARD prefill or all)."""
+    return _routing(SHARD_MODE)[0]
+
+
+def decode_on() -> bool:
+    """forward.dsa_segments may shard a decode window's pool blocks (TF_GLM_INDEXER_SHARD decode or all): the
+    batched window captures a sharded graph beside each unsharded one and decode_window picks per window."""
+    return _routing(SHARD_MODE)[1]
+
+
+# ---------------------------------------------------------------- prefill: rank r's rows -------------------
+
+
+def shard_rows(R: int, world: int) -> list[tuple[int, int]]:
+    """The rows each rank owns: contiguous [lo, hi) slices of ceil(R/world) rows (the last one short)."""
+    step = -(-R // world)
+    out = [(min(r * step, R), min((r + 1) * step, R)) for r in range(world)]
+    assert out[0][0] == 0 and out[-1][1] == R and sum(hi - lo for lo, hi in out) == R
+    return out
+
+
+def prefill_rank_pools(qi, wts, pk, pos: int, R: int, np_max: int, pos_dev, lo: int, hi: int, buf, cand):
+    """One rank's share of the piece's pools [hi - lo, TOPK_POOLS] int32 ascending: sparse._prompt_rank_pools,
+    the one implementation (the prototype's copy of the loop folded into _select_prompt there)."""
+    return sparse._prompt_rank_pools(qi, wts, pk, pos, R, np_max, pos_dev, lo, hi, buf, cand)
+
+
+def prefill_shard(qi, wts, pk, pos: int, R: int, np_max: int, pos_dev, world: int = 3, bufs=None):
+    """The sharded prefill path's whole answer: every rank's share through prefill_rank_pools, the simulated
+    all-gather of the pools [R, 512] int32 (rank r writes its slice of the gathered buffer; on 3 GPUs one
+    all-gather), then _tokens over ALL R rows. Returns (tokens, counts, pools)."""
+    dev = qi.device
+    NP = pool_count(pos, R, np_max)
+    B = min(R, sparse.SELECT_ROWS)
+    cap = sparse.prompt_tile(NP)[0]
+    if bufs is None:
+        buf = torch.empty((B * pool_bucket(pos, R, np_max),), dtype=torch.float32, device=dev)
+        cand = torch.empty((B * 2 * cap,), dtype=torch.int32, device=dev)
+    else:
+        buf, cand = bufs
+    pools = torch.empty((R, TOPK_POOLS), dtype=torch.int32, device=dev)       # the gathered buffer
+    for lo, hi in shard_rows(R, world):
+        if hi > lo:
+            pools[lo:hi] = prefill_rank_pools(qi, wts, pk, pos, R, np_max, pos_dev, lo, hi, buf, cand)
+    tokens = torch.empty((R, TOKENS), dtype=torch.int32, device=dev)
+    counts = torch.empty((R,), dtype=torch.int32, device=dev)
+    sparse._tokens[(R,)](pools, pos_dev, tokens, counts, W=TOKENS, K=TOPK_POOLS, PL=POOL, BLOCK=1024, num_warps=4)
+    return tokens, counts, pools
+
+
+# ---------------------------------------------------------------- decode: rank r's pool blocks -------------
+
+
+def shard_extents(npm: np.ndarray, world: int):
+    """Per segment the shards' (offset, extent) in POOLS: the segment's pool blocks (BP = 64) split in contiguous
+    thirds - [rank*cb*64, min((rank+1)*cb*64, npm)) a rank, cb = ceil(ceil(npm/64) / world). Returns int64
+    [world, segs] arrays (offs, exts) and the widest extent. The host form of _shard_tables (tests, the rule)."""
+    offs = np.zeros((world, len(npm)), dtype=np.int64)
+    exts = np.zeros((world, len(npm)), dtype=np.int64)
+    for s, n in enumerate(npm):
+        cb = -(-((n + 63) // 64) // world)
+        for r in range(world):
+            off = r * cb * 64
+            offs[r, s], exts[r, s] = off, max(0, min(cb * 64, n - off))
+    return offs, exts, int(exts.max()) if len(npm) else 0
+
+
+@triton.jit
+def _shard_tables(SEG_PBASE, SEG_POOLS, PBASE_R, POOLS_R, S, rank, world, BLK: tl.constexpr):
+    """One program: rank ``rank``'s segment tables for the production scoring launchers - the pooled base rebased
+    to the shard's first pool (seg_pbase + rank*cb*64) and the shard's extent as its pool count (shard_extents's
+    formula, on the device: the graph replays over new segments)."""
+    s = tl.arange(0, BLK)
+    ok = s < S
+    npm = tl.load(SEG_POOLS + s, mask=ok, other=0)
+    pbase = tl.load(SEG_PBASE + s, mask=ok, other=0)
+    cb = ((npm + 63) // 64 + world - 1) // world
+    off = rank * cb * 64
+    ext = tl.minimum(tl.maximum(npm - off, 0), cb * 64)
+    tl.store(PBASE_R + s, pbase + off, mask=ok)
+    tl.store(POOLS_R + s, ext, mask=ok)
+
+
+def seg_shard_scores(qi, wts, pk, rows, scores, pbase_r, pools_r, tri):
+    """seg_select_tokens' scoring (0095's CUDA kernel for the segments of SEG_SCORE_CUDA_ROWS+ rows, Triton
+    _seg_scores for the rest - the production launchers verbatim) over one rank's pool blocks only: the
+    segment tables rebased so p = 0 is the shard's first pool (pbase_r) and the pool count is the shard's extent
+    (pools_r), the scores stored compacted into ``scores`` (a row's column p is its GLOBAL pool offset + p). The
+    kernels store a row's columns p < npool (its global visible count) below the extent: every column of the
+    row's visible prefix NB = clamp(npool - offset, 0, extent), which is all the selection reads."""
+    H = wts.shape[1]
+    D = qi.shape[1] // H
+    wscale = 1.0 / 5.656854249492381 if H == 32 else H ** -0.5
+    pkv, pks, rs, fp8 = kv8.parts(pk)
+    pools = pools_r
+    # as sparse.seg_select_tokens on this base: the extension is None when it is not used (another Triton release
+    # than sparse.TRITON_PTX, or a failed build or load), and then _seg_scores serves every segment
+    ext = sparse._seg_scores_ext() if fp8 and H == 32 and D == 128 and sparse.seg_scores_cuda() else None
+    if ext is not None:
+        pools = tri                     # the CUDA kernel writes the small segments' extents here, 0 for its own
+        ext.seg_scores(qi, wts, wts.stride(0), pk, rs, scores, scores.stride(0), rows.pos, rows.sparse,
+                       rows.seg_start, rows.seg_rows, pbase_r, pools_r, tri, rows.max_segs, D ** -0.5, wscale,
+                       sparse.SEG_SCORE_CTAS, sparse.SEG_SCORE_STAGES, sparse.SEG_SCORE_CUDA_ROWS)
+    grid = min(sparse.SEG_SCORE_GRID, triton.cdiv(scores.shape[1], 64))
+    sparse._seg_scores[(rows.max_segs, grid)](qi, wts, wts.stride(0), pkv, pks, scores, scores.stride(0), rows.pos,
+                                              rows.sparse, rows.seg_start, rows.seg_rows, pbase_r, pools,
+                                              D ** -0.5, wscale, H=H, HP=max(16, triton.next_power_of_2(H)), D=D,
+                                              BP=64, G=grid, RS=rs, FP8=fp8, num_warps=4)
+
+
+def order_key(scores: torch.Tensor) -> torch.Tensor:
+    """sparse._order_key in torch: a float32 score's uint32 order key as int32 bits (-0 counted as +0)."""
+    bits = (scores + 0.0).view(torch.int32)
+    return bits ^ ((bits >> 31) | torch.full((), -2147483648, dtype=torch.int32, device=scores.device))
+
+
+@triton.jit
+def _pair_take(CK, r, take, u, gp, written, K: tl.constexpr):
+    """Pairs (order key u, global pool gp) where take into row r's slots written + their rank among them (the
+    index order of the tile: ascending by pool); returns written + their count."""
+    t = take.to(tl.int32)
+    slot = written + tl.cumsum(t, 0) - t
+    base = CK + r * (2 * K)
+    tl.store(base + slot, u.to(tl.int32, bitcast=True), mask=take)
+    tl.store(base + K + slot, gp.to(tl.int32), mask=take)
+    return written + tl.sum(t, 0)
+
+
+@triton.jit
+def _seg_shard_select(S, s_stride, POS, SPR, SEG, SEG_POOLS, CK, CAND, rank, world, K: tl.constexpr,
+                      PL: tl.constexpr, CAP: tl.constexpr, NS: tl.constexpr, TARGET: tl.constexpr,
+                      BLOCK: tl.constexpr):
+    """Program r: rank ``rank``'s K best pools of row r as pairs into CK[r] ([K] order keys, then [K] global pools,
+    ascending by pool; slots past the shard's candidates get pool -1, a dense row's all -1), from the row's
+    visible prefix NB = clamp(npool - rank*cb*64, 0, cb*64) of its compacted scores (seg_shard_scores) by
+    _seg_select_floor's one pass and radix select, or its passes over the whole prefix when the floor misses;
+    a shard with at most K visible pools sends them all. CAND: int32, 2 * CAP a row."""
+    r = tl.program_id(0).to(tl.int64)
+    kk = tl.arange(0, K)
+    if tl.load(SPR + r) == 0:
+        tl.store(CK + r * (2 * K) + K + kk, -1)
+        return
+    qpos = tl.load(POS + r).to(tl.int64)
+    npool = ((qpos + 1) // PL).to(tl.int32)                 # the row's visible pools, all shards
+    npm = tl.load(SEG_POOLS + tl.load(SEG + r))              # its segment's (the last row's)
+    cb = ((npm + 63) // 64 + world - 1) // world
+    off = rank * cb * 64                                     # the shard's first pool
+    NP = tl.minimum(tl.maximum(npool - off, 0), cb * 64)     # this shard's visible prefix
+    row = S + r * s_stride
+    c = tl.arange(0, CAP)
+    n = NP
+    ck = CAND + r * (2 * CAP)
+    if NP > CAP:
+        lo = sparse._sample_floor(row, NP, NS, TARGET)
+        n = NP * 0
+        for b in range(0, NP, BLOCK):
+            i = b + tl.arange(0, BLOCK)
+            ok = i < NP
+            u = sparse._order_key(tl.load(row + i, mask=ok, other=0.0))
+            sel = ok & (u >= lo)
+            t = sel.to(tl.int32)
+            m = tl.sum(t, 0)
+            if m > 0:
+                at = n + tl.cumsum(t, 0) - t
+                put = sel & (at < CAP)
+                tl.store(ck + at, u.to(tl.int32, bitcast=True), mask=put)
+                tl.store(ck + CAP + at, i.to(tl.int32), mask=put)
+            n += m
+        tl.debug_barrier()                               # the candidates other threads stored, before reading them
+    written = NP * 0
+    if NP <= K:                                          # every visible pool of the shard
+        ok = c < NP
+        u = sparse._order_key(tl.load(row + c, mask=ok, other=0.0))
+        written = _pair_take(CK, r, ok, u, c + off, written, K)
+    elif (n >= K) & (n <= CAP):
+        ok = c < n
+        if NP > CAP:
+            u = tl.load(ck + c, mask=ok, other=0).to(tl.uint32, bitcast=True)
+            idx = tl.load(ck + CAP + c, mask=ok, other=0)
+        else:
+            u = sparse._order_key(tl.load(row + c, mask=ok, other=0.0))
+            idx = c
+        prefix = tl.zeros((), dtype=tl.uint32)
+        fixed = tl.zeros((), dtype=tl.uint32)
+        need = K
+        for p in tl.static_range(4):
+            hist = tl.histogram(((u >> (24 - 8 * p)) & 0xFF).to(tl.int32), 256, mask=ok & ((u & fixed) == prefix))
+            need, prefix, fixed = sparse._radix_step(hist, need, prefix, fixed, p)
+        eq = (ok & (u == prefix)).to(tl.int32)
+        take = (ok & (u > prefix)) | ((eq == 1) & (tl.cumsum(eq, 0) - eq < need))
+        written = _pair_take(CK, r, take, u, idx + off, written, K)
+    else:                                                # _seg_select's passes over the whole prefix
+        prefix = tl.zeros((), dtype=tl.uint32)
+        fixed = tl.zeros((), dtype=tl.uint32)
+        need = K
+        for p in tl.static_range(4):
+            hist = tl.zeros((256,), dtype=tl.int32)
+            for b in range(0, NP, BLOCK):
+                i = b + tl.arange(0, BLOCK)
+                ok = i < NP
+                u = sparse._order_key(tl.load(row + i, mask=ok, other=0.0))
+                hist += tl.histogram(((u >> (24 - 8 * p)) & 0xFF).to(tl.int32), 256,
+                                     mask=ok & ((u & fixed) == prefix))
+            need, prefix, fixed = sparse._radix_step(hist, need, prefix, fixed, p)
+        equal_seen = NP * 0
+        for b in range(0, NP, BLOCK):
+            i = b + tl.arange(0, BLOCK)
+            ok = i < NP
+            u = sparse._order_key(tl.load(row + i, mask=ok, other=0.0))
+            eq = (ok & (u == prefix)).to(tl.int32)
+            take = (ok & (u > prefix)) | ((eq == 1) & (tl.cumsum(eq, 0) - eq + equal_seen < need))
+            written = _pair_take(CK, r, take, u, i + off, written, K)
+            equal_seen += tl.sum(eq, 0)
+    tl.store(CK + r * (2 * K) + K + kk, -1, mask=kk >= written)
+
+
+@triton.jit
+def _seg_shard_merge(RECV, rank_stride, POS, SPR, TOK, CNT, W: tl.constexpr, K: tl.constexpr, PL: tl.constexpr,
+                     WORLD: tl.constexpr, NC: tl.constexpr):
+    """Program r (a sparse row): row r's K best of the WORLD shards' gathered pairs (RECV: rank blocks rank_stride
+    apart, each [rows, 2 K]: keys, then pools, -1 past a shard's candidates) by _select_rows' radix select over
+    the order keys; the candidates come in pool order (contiguous thirds in rank order, each shard's list
+    ascending), so the ties at the K-th key go to the lowest pools by their cumsum position, as _seg_select_floor
+    takes them, and the tokens are written ascending as it writes them, with its tail and count. A dense row
+    gets count 0. NC: a power of two of at least WORLD * K."""
+    r = tl.program_id(0).to(tl.int64)
+    if tl.load(SPR + r) == 0:
+        tl.store(CNT + r, 0)
+        return
+    qpos = tl.load(POS + r).to(tl.int64)
+    NP = (qpos + 1) // PL
+    c = tl.arange(0, NC)
+    inb = c < WORLD * K
+    src = RECV + (c // K).to(tl.int64) * rank_stride + r * (2 * K) + c % K
+    u = tl.load(src, mask=inb, other=0).to(tl.uint32, bitcast=True)
+    gp = tl.load(src + K, mask=inb, other=-1)
+    ok = inb & (gp >= 0)
+    prefix = tl.zeros((), dtype=tl.uint32)
+    fixed = tl.zeros((), dtype=tl.uint32)
+    need = K
+    for p in tl.static_range(4):
+        hist = tl.histogram(((u >> (24 - 8 * p)) & 0xFF).to(tl.int32), 256, mask=ok & ((u & fixed) == prefix))
+        need, prefix, fixed = sparse._radix_step(hist, need, prefix, fixed, p)
