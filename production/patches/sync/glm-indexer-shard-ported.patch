+class ShardScratch:
+    """The sharded decode path's buffers beside a window's SelectScratch (whose scores, split (the candidate
+    list), tokens and counts it shares): this rank's pairs [rows, 2 K] int32 (the gather's send: 4 KB a row),
+    the gathered [world * rows * 2 K] (rank blocks of the window's R rows), and the per-rank segment tables for
+    the scoring launchers ([max_segs] int32: the rebased pooled bases, the shard extents, and the small
+    segments' extents the CUDA kernel hands the Triton kernel). Made once, before any capture."""
+
+    def __init__(self, rows: int, world: int, max_segs: int, device) -> None:
+        self.rows, self.world = rows, world
+        self.send = torch.zeros((rows, 2 * TOPK_POOLS), dtype=torch.int32, device=device)
+        self.recv = torch.zeros((world * rows * 2 * TOPK_POOLS,), dtype=torch.int32, device=device)
+        self.pbase = torch.zeros((max_segs,), dtype=torch.int32, device=device)
+        self.pools = torch.zeros((max_segs,), dtype=torch.int32, device=device)
+        self.tri = torch.zeros((max_segs,), dtype=torch.int32, device=device)
+
+
+def scratch_for(sel, world: int, max_segs: int):
+    """The ShardScratch cached on a SelectScratch (made at the first eager call: the batched window's warm-up
+    runs precede its capture)."""
+    got = getattr(sel, "shard", None)
+    if got is None or got.world != world or got.rows < sel.rows or got.pbase.numel() < max_segs:
+        got = sel.shard = ShardScratch(sel.rows, world, max_segs, sel.scores.device)
+    return got
+
+
+def seg_shard_rank(qi, wts, pk, rows, sel, rank: int, world: int):
+    """Rank ``rank``'s share of the decode answer, the part one rank runs before the gather: its segment tables,
+    its pool blocks scored compacted into sel.scores by the production kernels, its K best pairs a row into
+    sel.shard.send[:R]. Returns the send view [R, 2 K]."""
+    R = qi.shape[0]
+    sc = scratch_for(sel, world, rows.max_segs)
+    if sel.split.numel() < R * 2 * sparse.SEG_FLOOR[0]:
+        raise ValueError("seg_shard_rank: the scratch's split buffer holds no candidates")
+    _shard_tables[(1,)](rows.seg_pbase, rows.seg_pools, sc.pbase, sc.pools, rows.max_segs, rank, world, BLK=8)
+    seg_shard_scores(qi, wts, pk, rows, sel.scores, sc.pbase, sc.pools, sc.tri)
+    send = sc.send[:R]
+    _seg_shard_select[(R,)](sel.scores, sel.scores.stride(0), rows.pos, rows.sparse, rows.seg, rows.seg_pools, send,
+                            sel.split, rank, world, K=TOPK_POOLS, PL=POOL, CAP=sparse.SEG_FLOOR[0],
+                            NS=sparse.PROMPT_SECTORS, TARGET=sparse.SEG_FLOOR[1], BLOCK=sparse.SEG_FLOOR[2],
+                            num_warps=sparse.SEG_FLOOR[3])
+    return send
+
+
+def seg_shard_merge(recv, rows, sel, R: int, world: int):
+    """The merge every rank runs after the gather (recv: [world * R * 2 K] int32, rank blocks): tokens, counts."""
+    tokens, counts = sel.tokens[:R], sel.counts[:R]
+    _seg_shard_merge[(R,)](recv, R * 2 * TOPK_POOLS, rows.pos, rows.sparse, tokens, counts, W=TOKENS, K=TOPK_POOLS,
+                           PL=POOL, WORLD=world, NC=triton.next_power_of_2(world * TOPK_POOLS), num_warps=8)
+    return tokens, counts
+
+
+# ---------------------------------------------------------------- the decode threshold rule ----------------
+# Where the sharded decode call pays (GB10, spark5, lanes/DecShardFable/bench_decode_shard.py: 150 windows of 1-6
+# streams x 1-16 rows at 35k-600k as CUDA graphs with every call on its own key arena, so the L2 carries nothing
+# between calls - between the serve's DSA layers the other kernels evict the keys; fit_rule.py's least squares,
+# rms error 27 us on the unsharded call and 11 on the share): the unsharded call costs about U = U0 + C * max pools
+# + sum over the window's sparse segments of pools * (A + B * rows) us (the scoring: compute-bound in rows,
+# memory-bound in pools; the one-pass selection: the longest row); a rank's share the same shape over its third,
+# plus the merge (8 us) and the gather. The gather's wall cost is not measurable on one GPU: GATHER_US is the
+# ledger's RoCE one-shot figure (F4 / F33; roce.py's 30-50 us for NCCL is the bound) - the live TF_GLM_PROFILE
+# "dsa: select tokens" of a sharded window measures it, and moving it by 15 us moves the boundary by one or two of
+# the 150 windows, each within 20 us a call. The rule shards when the modelled saving clears SHARD_MARGIN_US:
+# against the measured truth at 40 us it is wrong on 5 of 150 windows, each by at most 16 us a call (0.2 ms a
+# round). Speed only: the sharded and unsharded windows give the same tokens and counts.
+SHARD_COEF = (29.82, 0.000566, 0.0000746, 0.000180)    # (U0, A, B, C) us: the unsharded call
+SHARD_SHARE = (29.29, 0.000553, 0.0000814, 0.000305)   # (S0, A', B', C') us: a rank's share over its third
+GATHER_US = 40.0                      # the gather's wall cost a call (the ledger; see above)
+MERGE_US = 8.0                        # the merge a call (every rank; measured 7.4-10.7 us at 1-64 rows)
+SHARD_MARGIN_US = 10.0                # shard only when the modelled saving clears this
+SHARD_ROWS_MIN = 2                    # windows under this many rows never shard (no sharded graph is captured):
+#                                       a 1-row window saves at most the gather itself (1 x 1 x 600k: +39 us before it)
+
+
+def window_pools(spans) -> list[tuple[int, int]]:
+    """A window's segments as (rows, pools): pools = what SegRows.fill stores as seg_pools (the pools the
+    segment's last row sees when it has sparse rows, else 0), from spans [(base, pos, rows[, ring])]."""
+    out = []
+    for seg in spans:
+        pos, n = int(seg[1]), int(seg[2])
+        last = pos + n - 1
+        out.append((n, (last + 1) // POOL if last >= SPARSE_FROM else 0))
+    return out
+
+
+def decode_cost(segs, world: int) -> tuple[float, float]:
+    """(the unsharded call's modelled us, the sharded call's: the slowest rank's share + merge + gather) for a
+    window of segments (rows, pools)."""
+    U0, A, B, C = SHARD_COEF
+    S0, A2, B2, C2 = SHARD_SHARE
+    full = U0 + C * max((p for _, p in segs), default=0)
+    share = S0
+    widest = 0
+    for n, p in segs:
+        if p == 0:
+            continue
+        full += p * (A + B * n)
+        cb = -(-((p + 63) // 64) // world)
+        ext = min(cb * 64, p)                          # rank 0's third is the widest
+        widest = max(widest, ext)
+        share += ext * (A2 + B2 * n)
+    share += C2 * widest
+    return full, share + MERGE_US + GATHER_US
+
+
+def decode_window(spans, world: int) -> bool:
+    """The threshold rule: shard this window's decode selection? From its spans alone (rows and positions: the
+    same on every rank), never from the switch - the caller checks decode_on() and the comm. False under
+    SHARD_ROWS_MIN rows (no sharded graph exists for them) and for a window with no sparse row."""
+    segs = window_pools(spans)
+    if sum(n for n, _ in segs) < SHARD_ROWS_MIN or not any(p for _, p in segs):
+        return False
+    full, sharded = decode_cost(segs, world)
+    return full - sharded >= SHARD_MARGIN_US
+
+
+# ---------------------------------------------------------------- the production entries -------------------
+
+
+def _all_gather(comm, mine: torch.Tensor) -> torch.Tensor:
+    """Every rank's copy of ``mine`` concatenated in rank order [world * numel] int32 through the family's
+    comm (forward's w.comm: NCCL, or RoceComm whose small gathers take its one-shot RoCE path and whose
+    device-side epoch makes the gather CUDA-graph replayable)."""
+    send = mine.contiguous().view(-1)
+    got = torch.empty((comm.world * send.numel(),), dtype=torch.int32, device=send.device)
+    comm.all_gather(send, got)
+    return got
+
+
+def prompt_shard(qi, wts, pk, pos: int, R: int, np_max: int, pos_dev, comm, bucket: int | None = None):
+    """select_tokens' prompt path (sparse.select_tokens -> _select_prompt) over the ranks: this rank scores and
+    selects its rows' share, one all-gather of the pieces' pools [R, 512] int32, then _tokens over all rows.
+    The same tokens and counts as the unsharded path (per-row bits unchanged). ``bucket`` ignored, as
+    _select_prompt's is (it scores pool_count's columns)."""
+    dev = qi.device
+    NP = sparse.pool_count(pos, R, np_max)
+    B = min(R, sparse.SELECT_ROWS)
+    cap = sparse.prompt_tile(NP)[0]
+    buf = torch.empty((B * sparse.pool_bucket(pos, R, np_max),), dtype=torch.float32, device=dev)
+    cand = torch.empty((B * 2 * cap,), dtype=torch.int32, device=dev)
+    step = -(-R // comm.world)                                # every rank sends step rows (the last padded)
+    lo, hi = min(comm.rank * step, R), min((comm.rank + 1) * step, R)
+    mine = torch.zeros((step, TOPK_POOLS), dtype=torch.int32, device=dev)
+    mine[:hi - lo] = prefill_rank_pools(qi, wts, pk, pos, R, np_max, pos_dev, lo, hi, buf, cand)
+    pools = _all_gather(comm, mine).view(comm.world, step, TOPK_POOLS).reshape(-1, TOPK_POOLS)[:R]
+    tokens = torch.empty((R, TOKENS), dtype=torch.int32, device=dev)
+    counts = torch.empty((R,), dtype=torch.int32, device=dev)
+    sparse._tokens[(R,)](pools, pos_dev, tokens, counts, W=TOKENS, K=TOPK_POOLS, PL=POOL, BLOCK=1024, num_warps=4)
+    return tokens, counts
+
+
+def seg_shard(qi, wts, pk, rows, sel, comm):
+    """seg_select_tokens over the ranks (the module docstring's decode pool shard): this rank's share
+    (seg_shard_rank), one gather of the pairs (4 KB a row a rank, rank blocks of R rows), the merge on every
+    rank. The same tokens and counts as sparse.seg_select_tokens on ``sel``."""
+    R = qi.shape[0]
+    world = comm.world
+    send = seg_shard_rank(qi, wts, pk, rows, sel, comm.rank, world)
+    recv = sel.shard.recv[:world * R * 2 * TOPK_POOLS]
+    comm.all_gather(send.reshape(-1), recv)
+    return seg_shard_merge(recv, rows, sel, R, world)
