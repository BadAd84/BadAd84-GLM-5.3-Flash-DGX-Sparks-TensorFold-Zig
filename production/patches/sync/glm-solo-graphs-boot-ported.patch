+def solo_graphs(parallel: int, env=None) -> bool:
+    """OTS 0104: whether the one-stream CUDA graphs are captured at start (``decode.Engine``'s ``graphs``: a dense and
+    a sparse graph for every verify width and KDA parity, the sparse ones for every pool bucket - 9 widths x 2
+    parities x (1 + 12 buckets) = 234 graphs at the production pool, each after two warm-up forwards: ~30 s of every
+    boot, the longest phase after the weights). Under --parallel every request runs through the scheduler's batched
+    windows (``multi.BatchedVerify``, graphs of its own), so ``Engine.forward`` - the only replay site - is reached
+    only by a lone stream moved home (TF_GLM_MULTI_LONE=1), by the serial verify seam (TF_GLM_MULTI_VERIFY=serial:
+    ``verify.SerialVerify``, where a stream at the graphs' home replays them) and by the startup comparison
+    (TF_GLM_MULTI_PROFILE); with all three off nothing ever replays them and they are not captured (``_calibrate``
+    then times eager windows, which only the fcost policies read). TF_GLM_SOLO_GRAPHS=1 captures them as before.
+    Every rank decides alike (the inputs are in the ranks' settings comparison): the warm-up forwards all-gather, so
+    one rank capturing alone would hang."""
+
+    e = os.environ if env is None else env
+    forced = (e.get("TF_GLM_SOLO_GRAPHS", "") or "0").strip()
+    if forced not in ("0", "1"):
+        raise ValueError(f"TF_GLM_SOLO_GRAPHS is 0 or 1, not {forced!r}")
+    if forced == "1" or int(parallel) <= 1:
+        return True
+    from .multi import verify_kind
+    from .multi_tune import MultiSettings
+
+    s = MultiSettings.from_env(e)
+    return bool(s.lone or s.profile or verify_kind(e.get("TF_GLM_MULTI_VERIFY", "")) == "serial")
+
