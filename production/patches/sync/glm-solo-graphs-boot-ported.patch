+++ tensorfold/families/glm5_next/cuda/fastboot.py	2026-10-29 12:47:43.574092817 +0000
@@ -0,0 +1,63 @@
+"""The boot timeline: ``mark(phase)`` prints one ``[boot]`` line a phase on every rank with the seconds since the
+launch, the phase's own seconds (since the previous mark) and the memory state, so a restart's phases stop being
+inferred from the gaps between unrelated log lines (OTS: the first step of the boot-time work; the prepared rank
+folders of built weights, jayleaton's 0140 adapted, extend this module in the next step).
+
+The launch time is TF_GLM_LAUNCH_T0 or TF_GLM_T0 (epoch seconds, set by a launcher) when given, else this module's
+import. No torch at import.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from pathlib import Path
+
+_IMPORT_T = time.time()
+_last = [None]
+_rank = [None]
+
+
+# -- boot timeline --------------------------------------------------------------------------------------------------
+def boot_t0() -> float:
+    for var in ("TF_GLM_LAUNCH_T0", "TF_GLM_T0"):
+        try:
+            v = float(os.environ.get(var, "") or 0)
+        except ValueError:
+            v = 0.0
+        if v > 0:
+            return v
+    return _IMPORT_T
+
+
+def meminfo() -> dict:
+    """/proc/meminfo in GiB (MemFree is what CUDA can still allocate on GB10; MemAvailable adds reclaimable cache)."""
+
+    out: dict = {}
+    try:
+        for line in Path("/proc/meminfo").read_text().splitlines():
+            k, v = line.split(":", 1)
+            if k in ("MemFree", "MemAvailable", "Cached"):
+                out[k] = int(v.split()[0]) / 2 ** 20
+    except OSError:
+        pass
+    return out
+
+
+def set_rank(rank: int) -> None:
+    _rank[0] = rank
+
+
+def mark(phase: str, detail: str = "") -> float:
+    """One timeline line: seconds since the launch, the phase, its own seconds (since the previous mark), memory.
+    Returns the phase's seconds."""
+
+    now = time.time()
+    prev = _last[0] if _last[0] is not None else boot_t0()
+    _last[0] = now
+    m = meminfo()
+    mem = f" | MemFree {m.get('MemFree', 0):.1f} GiB, MemAvailable {m.get('MemAvailable', 0):.1f} GiB" if m else ""
+    who = f"r{_rank[0]} " if _rank[0] is not None else ""
+    print(f"[boot] {who}+{now - boot_t0():.1f}s {phase}{': ' + detail if detail else ''} ({now - prev:.1f}s){mem}",
+          flush=True)
+    return now - prev
