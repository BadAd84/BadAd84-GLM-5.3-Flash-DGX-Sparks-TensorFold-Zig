+def stream_ids(s, array: bool = True) -> tuple[list[int], np.ndarray | None]:
+    """Rank 0: a waiting request's prompt ids as a list of ints and (``array``) as an int64 array, made once for the
+    prompt object it holds and kept on the stream (``ids_cache``): ``prefix_wait``, ``prestage`` and ``admit`` read the
+    same ids, and at 600k tokens each conversion is 10-20 ms of rank 0's host before the first token. A stream holding
+    another prompt object (``_admitted`` copies it) makes them again; ``admit`` drops them once the stream is in."""
+
+    c = getattr(s, "ids_cache", None)
+    if c is None or c[0] is not s.prompt:
+        c = (s.prompt, list(map(int, s.prompt)), None)
+    if array and c[2] is None:
+        c = (c[0], c[1], np.asarray(c[1], dtype=np.int64))
+    s.ids_cache = c
+    return c[1], c[2]
+
