+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    ok = offs < total
+    acc = tl.load(G + offs, mask=ok, other=0.0)
+    for r in tl.static_range(1, WORLD):
+        acc = acc + tl.load(G + r * total + offs, mask=ok, other=0.0)
+    tl.store(OUT + offs, acc.to(tl.bfloat16), mask=ok)
+
