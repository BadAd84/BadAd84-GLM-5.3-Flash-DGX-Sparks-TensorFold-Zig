+def _rank_sum_kernel(G, OUT, total, WORLD: tl.constexpr, BLOCK: tl.constexpr):
+    """out = bf16(((g[0] + g[1]) + g[2]) ...): the gathered fp32 partials added in rank order, one rounding (the
+    bits of ``acc = g[0].clone(); acc += g[1]; ...; acc.to(bf16)``, in one launch)."""
