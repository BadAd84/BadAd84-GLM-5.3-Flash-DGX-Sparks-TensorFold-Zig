+def draft_window(t: dict) -> tuple[int, str]:
+    """GLM DFlash2's attention window in tokens (the drafter config's ``sliding_window``: a block row sees the last
+    ``window - 1`` context rows and its block) and where it came from (OTS 0114). TF_GLM_DRAFT_WINDOW (a positive
+    int) wins; else the window of a drafter whose layers all slide; a full-attention drafter (canada-quant's -F and
+    -G: ``layer_types`` all ``full_attention``, ``sliding_window`` null) runs at DRAFT_WINDOW, so its context stays a
+    ring of the window and block as the incoai drafter's instead of the whole conversation's rows."""
+
+    kinds = set(t.get("layer_types") or ())
+    if len(kinds) > 1:
+        raise ValueError(f"drafter layer_types {sorted(kinds)}: one window for every layer is ported, not a mix")
+    own = t.get("sliding_window") if kinds != {"full_attention"} else None
+    if kinds == {"sliding_attention"} and not own:
+        raise ValueError("drafter sliding_attention layers without a sliding_window")
+    env = os.environ.get("TF_GLM_DRAFT_WINDOW", "").strip()
+    if env:
+        if not env.isdigit() or int(env) < 1:
+            raise ValueError(f"TF_GLM_DRAFT_WINDOW={env!r}: a positive number of tokens")
+        return int(env), f"TF_GLM_DRAFT_WINDOW (the drafter's own: {int(own) if own else 'none'})"
+    if own:
+        return int(own), "the drafter's sliding_window"
+    return DRAFT_WINDOW, "default: the drafter has full attention"
+
