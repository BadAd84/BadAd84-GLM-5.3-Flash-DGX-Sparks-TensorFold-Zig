+def check_shipped(f, names: list[str], target_dir: Path, rows: int = 64) -> None:
+    """A drafter's own copies of the target's tables (``geometry.DRAFT_SHIPPED``: canada-quant's -F / -G ship
+    ``embed_tokens`` and ``lm_head``) are never loaded: the drafts read the target's (OTS 0114). So ``rows`` evenly
+    spaced rows of each must equal the target checkpoint's as the serve loads them (bf16), bit for bit; a drafter
+    trained against other tables refuses to load. A target storing the table packed (MLX 4-bit) cannot be compared:
+    said on stderr."""
+
+    if not names:
+        return
+    index = target_dir / "model.safetensors.index.json"
+    where = json.loads(index.read_text())["weight_map"] if index.exists() else None
+    for name in names:
+        tname = PREFIX + name if name == "embed_tokens.weight" else name
+        tfile = where.get(tname) if where is not None else "model.safetensors"
+        if tfile is None:
+            raise ValueError(f"the target at {target_dir} has no {tname} to compare the drafter's {name} with")
+        with safe_open(str(target_dir / tfile), framework="pt", device="cpu") as t:
+            ours, theirs = f.get_slice(name), t.get_slice(tname)
+            if not theirs[0:1].is_floating_point():
+                print(f"[tensorfold] drafter: its {name} is not compared with the target's {tname} "
+                      f"({theirs.get_dtype()})", file=sys.stderr, flush=True)
+                continue
+            if ours.get_shape() != theirs.get_shape():
+                raise ValueError(f"drafter {name} {ours.get_shape()}, the target's {tname} {theirs.get_shape()}")
+            n = ours.get_shape()[0]
+            for r in sorted({i * (n - 1) // (rows - 1) for i in range(rows)}):
+                a, b = (s[r:r + 1].to(torch.bfloat16).view(torch.int16) for s in (ours, theirs))
+                if not torch.equal(a, b):
+                    raise ValueError(f"drafter {name} row {r} is not the target's {tname} row: it was trained "
+                                     "against other tables than the ones its drafts would read")
+
