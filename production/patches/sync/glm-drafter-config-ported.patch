+def read_mask_embedding(path: Path, mask_id: int, dim: int) -> torch.Tensor | None:
+    """``mask_embedding.pt`` beside a drafter's weights (canada-quant's -F / -G; vLLM's ``_read_mask_embedding``):
+    the learned input row of every mask id, [dim] on the host (OTS 0114); None without the file (the target's
+    embedding row of the mask id, as the incoai drafter was trained)."""
+
+    p = path / "mask_embedding.pt"
+    if not p.exists():
+        return None
+    state = torch.load(p, map_location="cpu", weights_only=True)
+    if isinstance(state, dict):
+        if int(state.get("mask_token_id", mask_id)) != mask_id:
+            raise ValueError(f"{p}: mask_token_id {state.get('mask_token_id')}, the drafter config's {mask_id}")
+        state = state["embedding"]
+    row = state.reshape(-1)
+    if row.numel() != dim:
+        raise ValueError(f"{p}: {row.numel()} values, not the drafter's hidden_size {dim}")
+    return row
+
