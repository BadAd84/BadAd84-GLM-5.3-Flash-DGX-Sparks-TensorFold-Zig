+def expert_owners(moe: list[bool], world: int, spec: str | None = None) -> tuple:
+    """OTS 0105, TF_GLM_EXPERT_ROTATE (``spec``): per layer the rank holding the first (widest) share of its routed
+    and shared experts, -1 for a layer without a MoE block (``moe``: per layer whether it has one; the MTP layer past
+    them keeps rank 0's). ``0`` (default): () = upstream's split, rank 0 first in every layer; ``mod``: MoE layer i
+    on rank i mod ``world``; ``C0,C1,...`` (a count a rank, summing to the MoE layers): rank r first in that many,
+    interleaved by a smooth weighted round robin (ties to the lower rank). Every rank must be given the same value
+    (the engine compares them at startup)."""
+
+    import os
+
+    spec = (os.environ.get("TF_GLM_EXPERT_ROTATE", "0") if spec is None else str(spec)).strip().lower()
+    if spec in ("", "0", "off"):
+        return ()
+    layers = [i for i, m in enumerate(moe) if m]
+    if spec in ("1", "mod"):
+        first = {i: i % world for i in layers}
+    else:
+        try:
+            counts = [int(c) for c in spec.split(",")]
+        except ValueError:
+            counts = []
+        if len(counts) != world or min(counts) < 0 or sum(counts) != len(layers):
+            raise ValueError(f"TF_GLM_EXPERT_ROTATE={spec!r}: 0, mod, or {world} counts (one a rank) summing to the "
+                             f"{len(layers)} MoE layers")
+        first, credit = {}, [0] * world
+        for i in layers:
+            credit = [c + n for c, n in zip(credit, counts)]
+            r = max(range(world), key=lambda q: (credit[q], -q))
+            credit[r] -= len(layers)
+            first[i] = r
+    return tuple(first.get(i, -1) for i in range(len(moe)))
+
