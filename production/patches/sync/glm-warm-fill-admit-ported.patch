+# that resumes a kept state carries only the ids past it (every rank holds its ids) and the hash of its ids, which each
+# follower checks against its own. Ids are hashed by position: hash(ids[:m]) = sum over i < m of
+# (ids[i] % SEAL_MOD + 1) * W[i], modulo SEAL_MOD, with W[i] a fixed weight of position i alone; the sum is additive,
+# so a stream hashes only the ids past its kept state, from that state's hash.
+_WEIGHTS = np.zeros(0, dtype=np.int64)
+
+
+def id_weights(n: int) -> np.ndarray:
+    """The first ``n`` position weights (1 .. SEAL_MOD - 1, splitmix64 of the position, so a longer table extends a
+    shorter one), the same on every rank."""
+
+    global _WEIGHTS
+    if len(_WEIGHTS) < n:
+        z = np.arange(max(n, 2 * len(_WEIGHTS), 1 << 16), dtype=np.uint64) + np.uint64(0x9E3779B97F4A7C15)
+        z = (z ^ (z >> np.uint64(30))) * np.uint64(0xBF58476D1CE4E5B9)
+        z = (z ^ (z >> np.uint64(27))) * np.uint64(0x94D049BB133111EB)
+        z ^= z >> np.uint64(31)
+        _WEIGHTS = (z % np.uint64(SEAL_MOD - 1) + np.uint64(1)).astype(np.int64)
+    return _WEIGHTS[:n]
+
+
