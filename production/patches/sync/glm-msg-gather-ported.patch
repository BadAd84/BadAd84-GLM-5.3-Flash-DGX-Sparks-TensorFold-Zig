+class MsgGather:
+    """OTS msg-gather: rank 0's int message as ONE fixed-size all-gather, enqueued before the host needs it.
+
+    The length is in slot 0 and the values follow it, so a message that fits (every round's plan, a FINISH) gathers
+    ``ints`` ints a rank once: no second rendezvous, and no pageable ``torch.tensor(..., device="cuda")`` upload in
+    the middle (a pageable copy is a cudaStreamSynchronize, so the old path waited out the prelaunched DFlash2 pass
+    on every rank before its gather could even be enqueued). A message past the buffer (an ADMIT's prompt ids) puts
+    its length in slot 0 and every rank runs the second gather of the values; that decision reads the GATHERED slot 0
+    alone (rank 0's own block, its own length), so every rank issues the same collectives whatever the buffer holds.
+
+    ``pre`` queues the next message's gather at a decode round's end, behind the round's DFlash2 pass: a follower's
+    half is constant zeros and goes out then, so the gather starts on the GPU when the pass ends with no host in
+    between (the sample gather's arrival, not the message's two host hops). Rank 0 fills its half at the message
+    (``send``), its values known only then; that enqueue still lands before the pass ends while the host reaches the
+    message in time. The staging buffer is pinned and reused under an event (``MultiDecoder._send``'s rule), so no
+    copy is a pageable upload and no copy reads a buffer the host has rewritten."""
+
+    ints = 1024                     # the fixed gather's ints a rank: 4 KiB, one RoCE one-shot (TF_ROCE_MAX_KB)
+
+    def __init__(self, comm, rank: int, world: int, torch) -> None:
+        self.comm, self.rank, self.world, self.torch = comm, rank, world, torch
+        self.host = self.mine = self.got = self.big = self.allv = self.ready = None
+        self.pending = False        # a follower: ``pre`` queued the fixed gather and ``take`` has not run since
+
+    def _fixed(self):
+        """The fixed gather's buffers (every rank): mine [ints], got [world * ints], each allocated once."""
+
+        if self.mine is None:
+            self.mine = self.torch.zeros((self.ints,), dtype=self.torch.int32, device="cuda")
+            self.got = self.torch.zeros((self.world * self.ints,), dtype=self.torch.int32, device="cuda")
+        return self.mine, self.got
+
+    def _staging(self, n: int):
+        """Rank 0's pinned staging of at least max(ints, n + 1) ints: grown in steps, reused only once its copies
+        have left (``ready``)."""
+
+        torch = self.torch
+        want = max(self.ints, n + 1)
+        if self.host is None or self.host.numel() < want:
+            if self.ready is not None:
+                self.ready.synchronize()              # the last message's copies have left the staging buffer
+            size = max(want, 2 * self.ints, 2 * (self.host.numel() if self.host is not None else 0))
+            self.host = torch.zeros((size,), dtype=torch.int32, pin_memory=True)
+            self.ready = torch.cuda.Event()
+        elif self.ready is not None:
+            self.ready.synchronize()                  # the last message's copies have left the staging buffer
+        return self.host
+
+    def _values(self, n: int):
+        """The second gather's buffers (a message past the fixed buffer): n ints sent, world * n gathered, grown in
+        steps; a follower sends the zeros its own block is never read as."""
+
+        torch = self.torch
+        if self.big is None or self.big.numel() < n:
+            size = max(n, 2 * self.ints, 2 * (self.big.numel() if self.big is not None else 0))
+            self.big = torch.zeros((size,), dtype=torch.int32, device="cuda")
+            self.allv = torch.empty((self.world * size,), dtype=torch.int32, device="cuda")
+        return self.big[:n], self.allv[:self.world * n]
+
+    def pre(self) -> None:
+        """Both ranks at a decode round's end (``MultiDecoder._round``): the next message's fixed gather is queued
+        behind the round's DFlash2 pass now, so it starts on the GPU when the pass ends with no host in between. A
+        follower enqueues its half here (its block is constant zeros); rank 0's half goes with the message, its
+        values known only then (``send``). Two rounds without a message between would queue two gathers against rank
+        0's one, so that fails here rather than hanging the ranks later."""
+
+        if self.rank == 0:
+            return
+        if self.pending:
+            raise RuntimeError("two decode rounds queued their messages with none taken between: the ranks would "
+                               "issue different collectives")
+        self.comm.all_gather(*self._fixed())
+        self.pending = True
+
+    def send(self, values: list[int], echo: bool = True) -> list[int] | None:
+        """Rank 0's message out: one fixed gather, and the values' gather only past the buffer. Nothing is read back
+        (``echo`` False, TF_GLM_MULTI_ASYNC's ``_send``, only drops the return): rank 0 owns its message, so its host
+        never waits for the GPU here, and this rank's own length decides the second gather - it is the gathered slot 0
+        (the gather's rank-0 block is this buffer), so every rank issues the same collectives. What is returned is
+        this rank's own values, the block every other rank reads out of the gather."""
+
+        values = [int(v) for v in values]
+        n = len(values)
+        host = self._staging(n)
+        host[0] = n
+        if n:
+            host[1:1 + n].numpy()[:] = values
+        mine, got = self._fixed()
+        mine.copy_(host[:self.ints], non_blocking=True)
+        self.comm.all_gather(mine, got)
+        if n > self.ints - 1:
+            send, recv = self._values(n)
+            send.copy_(host[1:1 + n], non_blocking=True)
+            self.comm.all_gather(send, recv)
+        if self.ready is not None:
+            self.ready.record()                       # every copy from the staging buffer is enqueued
+        return list(values) if echo else None
+
+    def take(self) -> list[int]:
+        """The follower's message (rank 0's values): the fixed gather's block when the message fits, else the
+        values' gather, the two decided from the gathered slot 0 so every rank issues the same collectives."""
+
+        mine, got = self._fixed()
+        if not self.pending:
+            self.comm.all_gather(mine, got)           # no pre() since the last message: queue it now
+        self.pending = False
+        row = got[:self.ints].tolist()                # one readback: the gathered length and the values
+        count = row[0]
+        if count <= self.ints - 1:
+            return [int(v) for v in row[1:1 + count]]
+        self.comm.all_gather(*self._values(count))
+        return [int(v) for v in self.allv[:count].tolist()]
+
+
