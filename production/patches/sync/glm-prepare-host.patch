+def _strings(value: Any):
+    """(OTS) Every string ``_any_string`` would test in ``value``, in its order: list items, dict keys and values."""
+
+    stack = [value]
+    while stack:
+        v = stack.pop()
+        if isinstance(v, str):
+            yield v
+        elif isinstance(v, list):
+            stack.extend(reversed(v))
+        elif isinstance(v, dict):
+            for k, x in reversed(list(v.items())):
+                stack.append(x)
+                stack.append(k)
+
