-        self._span = (_BASE, _BASE + len(self.plain))
+        # OTS: the masks' private-use range as one character class. _collides reads every string of every chat request;
+        # as a Python loop over the characters it cost ~50 ms at ~600k tokens (1.4M characters), the regex ~2 ms.
+        self._coll = re.compile(f"[{chr(_BASE)}-{chr(_BASE + len(self.plain) - 1)}]") if self.plain else None
 
