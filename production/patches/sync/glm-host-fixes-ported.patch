+"""A prompt's token ids from the ids of the last prompts it continues (OTS 0110): only the new text is tokenized.
+
+An agent's request is its previous request's prompt plus a reply and a tool result, and tokenizing all of it again took
+0.65 s at 592k tokens (rank 0's HTTP thread, every request, before any prefill), plus 60 ms for ``seed_for`` (with the
+GIL held). Here the last few prompts are kept with their ids, and a new prompt reuses the ids of the longest kept
+prefix up to an added token (``<|observation|>``, ``<|assistant|>``, ``<tool_call>`` ...), tokenizing only the text from
+there on: a few milliseconds.
+
+Why the ids are the same as a full encode's. HF ``tokenizers`` first finds the added tokens in the whole text (Aho-
+Corasick, leftmost-longest, non-overlapping), then normalizes, pre-tokenizes and runs the model on each piece between
+them separately; an added token's id is fixed. So where an added token starts in the text's own matching, the ids of
+the text are the ids of the text before it followed by the ids of the text from it. That holds when nothing else
+crosses a piece: no normalizer, added tokens without ``normalized`` / ``lstrip`` / ``rstrip`` / ``single_word``, a
+pre-tokenizer that treats each piece alike (``Split`` / ``ByteLevel`` without a prefix space: GLM-5.3's), no
+truncation, no BPE dropout; ``PromptIds.make`` checks the tokenizer's own JSON for each and keeps nothing otherwise.
+Two texts that agree up to L have the same matches up to a kept match at s, and that match too, when it ends by L and
+no added token holds another inside it (GLM-5.3's: a match at s is then decided by its own characters, and no match
+of the other text can start before s and cover it); with tokens that do hold others, when s + M <= L (M: the longest
+added token, in bytes; the matcher reads no further from s). The ids of the text before such an s are the kept ids
+before it.
+
+Where a kept prompt's added tokens start is found with ``re`` (the same leftmost-longest rule: the alternatives longest
+first) and checked against the tokenizer's own ids: the added-token ids among them, in order, must be exactly the
+matches found, else the prompt is not kept (and a tail that fails it is tokenized again in full).
+``seed_for``'s sha256 over the ids' decimal text is kept the same way, at every ``SUM_STEP`` tokens.
+
+``TF_GLM_PROMPT_IDS``: prompts kept (default 8, about one per conversation in flight; 0 turns this off).
+scripts/glm53/v110/tests/host: test_prompt_ids.py, mutants_0110.sh.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import json
+import os
+import re
+import sys
+import threading
+from array import array
+from dataclasses import dataclass, field
+from typing import Any, Callable
+
+import numpy as np
+
+SUM_STEP = 16384        # tokens between kept sha256 states of ``seed_for``'s text (a new prompt hashes at most this
+                        # many of the kept ids again, plus its own)
+SLACK = 256             # a kept prompt whose text past the cut a newer prompt reuses is at most this long is dropped
+                        # for it (a dropped generation prompt, a turn retried: its tokens cost microseconds again)
+_SAFE_PRE = {"Split", "ByteLevel", "Digits", "Punctuation", "Whitespace", "WhitespaceSplit", "Sequence"}
+
+
+def _env_entries() -> int:
+    raw = os.environ.get("TF_GLM_PROMPT_IDS", "").strip()
+    if not raw:
+        return 8
+    try:
+        value = int(raw)
+    except ValueError:
+        raise ValueError(f"TF_GLM_PROMPT_IDS={raw!r}: expected a whole number") from None
+    if value < 0:
+        raise ValueError(f"TF_GLM_PROMPT_IDS={raw!r}: expected 0 or more")
+    return value
+
+
+def unsplittable(spec: dict[str, Any]) -> str | None:
+    """Why a tokenizer's ids may not split at its added tokens (its JSON as ``Tokenizer.to_str`` gives it), or None."""
+
+    if spec.get("normalizer") is not None:
+        return "it has a normalizer"
+    if spec.get("truncation") is not None or spec.get("padding") is not None:
+        return "it truncates or pads"
+    added = spec.get("added_tokens") or []
+    if not added:
+        return "it has no added tokens"
+    for t in added:
+        if t.get("normalized") or t.get("lstrip") or t.get("rstrip") or t.get("single_word") or not t.get("content"):
+            return f"added token {t.get('content')!r} is normalized, stripped or single-word"
+
+    def pre(p: Any) -> str | None:
+        if p is None:
+            return None
+        kind = p.get("type")
+        if kind not in _SAFE_PRE:
+            return f"pre-tokenizer {kind}"
+        if kind == "ByteLevel" and p.get("add_prefix_space"):
+            return "a ByteLevel pre-tokenizer adds a prefix space"
+        for inner in p.get("pretokenizers") or []:
+            problem = pre(inner)
+            if problem:
+                return problem
+        return None
+
+    problem = pre(spec.get("pre_tokenizer"))
+    if problem:
+        return problem
+    if (spec.get("model") or {}).get("dropout"):
+        return "its model drops merges at random"
+    return None
+
+
+def _feed(h: Any, ids: array, start: int, end: int) -> None:
+    """Feed ``h`` the decimal text of ``ids[start:end]`` as ``seed_for`` joins them (after ``ids[:start]``)."""
+
+    if end > start:
+        h.update(("," if start else "").encode() + ",".join(map(str, ids[start:end])).encode())
+
+
+@dataclass(slots=True)
+class _Kept:
+    text: str
+    ids: array                          # array("I"): 4 bytes a token (a list of ints holds ~36)
+    starts: list[int]                   # where each added token starts in ``text`` (as the tokenizer matched them)
+    ends: list[int]                     # how far another text must agree for it to split there too (rising)
+    at: list[int]                       # its index in ``ids``
+    sums: list[tuple[int, Any]] = field(default_factory=list)   # (n, sha256 of seed_for's text of ids[:n]), n % SUM_STEP == 0
+
+
+class PromptIds:
+    """The last ``entries`` prompts' ids, to tokenize a prompt that continues one of them from the last added token
+    they share (``encode``: the same ids as ``encode_fast``, the tokenizer's own call)."""
+
+    def __init__(self, added: dict[str, int], vocab: int, encode_fast: Callable[[str], list[int]],
+                 entries: int = 8) -> None:
+        self.encode_fast = encode_fast
+        self.entries = int(entries)
+        self.id_of = dict(added)
+        # how far past a match's start another text must agree for the match to be its too: the token's own end when
+        # no added token holds another, else the longest token's bytes (the matcher reads no further)
+        longest = max(len(s.encode("utf-8")) for s in added)
+        nested = any(a != b and a in b for a in added for b in added)
+        self.reach = {s: longest if nested else len(s) for s in added}
+        # leftmost-longest, as the tokenizer's matcher: at each start ``re`` takes the first alternative that matches
+        self.pattern = re.compile("|".join(re.escape(s) for s in sorted(added, key=len, reverse=True)))
+        self.is_added = np.zeros(max(vocab, max(added.values()) + 1), dtype=bool)
+        self.is_added[list(added.values())] = True
+        self.kept: list[_Kept] = []     # most recent first
+        self.lock = threading.Lock()
+        self.warned = False
+
+    @classmethod
+    def make(cls, tok: Any, encode_fast: Callable[[str], list[int]]) -> "PromptIds | None":
+        """For ``tok`` (a ``tokenizers.Tokenizer``), or None: TF_GLM_PROMPT_IDS=0, or its ids may not split."""
+
+        entries = _env_entries()
+        if not entries:
+            return None
+        spec = json.loads(tok.to_str())
+        problem = unsplittable(spec)
+        if problem:
+            print(f"[tensorfold] prompt ids: every prompt is tokenized in full ({problem})", file=sys.stderr, flush=True)
+            return None
+        return cls({t["content"]: int(t["id"]) for t in spec["added_tokens"]}, tok.get_vocab_size(with_added_tokens=True),
+                   encode_fast, entries)
+
+    def _starts(self, text: str, ids: array) -> tuple[list[int], list[int], list[int]] | None:
+        """Where ``text``'s added tokens start, their ``_Kept.ends``, and their indexes in ``ids`` (its ids, an
+        ``array("I")``); None if the tokenizer matched other added tokens than these."""
+
+        found = [(m.start(), self.id_of[m.group()], m.start() + self.reach[m.group()])
+                 for m in self.pattern.finditer(text)]
+        arr = np.frombuffer(ids, dtype=np.uint32) if ids else np.zeros(0, dtype=np.uint32)
+        if arr.size and int(arr.max()) >= self.is_added.size:
+            return None
+        at = np.flatnonzero(self.is_added[arr])
+        if at.size != len(found) or not np.array_equal(arr[at], np.asarray([i for _, i, _ in found], dtype=np.uint32)):
+            return None
+        return [s for s, _, _ in found], [e for _, _, e in found], at.tolist()
+
+    @staticmethod
+    def _common(kept: str, text: str) -> int:
+        """The length of the longest common prefix of ``kept`` and ``text``."""
+
+        if text.startswith(kept):
+            return len(kept)
+        lo, hi = 0, min(len(kept), len(text))     # kept[:lo] == text[:lo]; past hi they differ or end
+        while hi - lo > 64:
+            mid = (lo + hi) // 2
+            if text.startswith(kept[lo:mid], lo):
+                lo = mid
+            else:
+                hi = mid
+        while lo < hi and kept[lo] == text[lo]:
+            lo += 1
+        return lo
+
+    def encode(self, text: str) -> tuple[list[int], Callable[[], Any]]:
+        """``text``'s ids (a list of the caller's own) and a function giving a sha256 fed their ``seed_for`` text
+        (``exact_sampling.seed_of``'s input; called only when a seed is drawn from the prompt)."""
+
+        with self.lock:
+            kept = list(self.kept)
+        best, j_best, whole = None, -1, False
+        for e in kept:
+            common = self._common(e.text, text)
+            j = bisect.bisect_right(e.ends, common) - 1
+            if j >= 0 and (best is None or e.starts[j] > best.starts[j_best]):
+                best, j_best, whole = e, j, common == len(e.text)
+        made = None
+        if best is not None:
+            cut, k = best.starts[j_best], best.at[j_best]
+            tail = self.encode_fast(text[cut:])
+            found = self._starts(text[cut:], array("I", tail))
+            if found is not None:
+                head = best.ids[:k]
+                ids = head.tolist() + tail
+                head.extend(tail)
+                made = _Kept(text, head, best.starts[:j_best] + [cut + s for s in found[0]],
+                             best.ends[:j_best] + [cut + e for e in found[1]],
+                             best.at[:j_best] + [k + a for a in found[2]], [s for s in best.sums if s[0] <= k])
+            else:
+                self._warn("a tail's added tokens differ from the tokenizer's")
+        if made is None:
+            ids = self.encode_fast(text)
+            arr = array("I", ids)
+            found = self._starts(text, arr)
+            if found is None or not found[0]:       # the tokenizer differs here, or nothing to continue from
+                if found is None:
+                    self._warn("a prompt's added tokens differ from the tokenizer's")
+                return ids, _summer(_Kept(text, arr, [], [], []), None)
+            made, best = _Kept(text, arr, *found), None
+        with self.lock:
+            # the prompt it came from goes when this one continues all of it, or all but its last SLACK characters
+            # (one entry a conversation: the next request, or a retry of this one, reuses nearly as much from this);
+            # one it shares less with (another conversation's system prompt and tools, an edited history) stays
+            # beside it, as recent
+            spent = best is None or whole or len(best.text) - best.starts[j_best] <= SLACK
+            rest = [e for e in self.kept if e is not best]
+            self.kept = [made] + ([] if spent else [best]) + rest
+            del self.kept[self.entries:]
+        return ids, _summer(made, self.lock)
+
+    def _warn(self, what: str) -> None:
+        if not self.warned:
+            self.warned = True
+            print(f"[tensorfold] prompt ids: {what}; tokenizing it in full", file=sys.stderr, flush=True)
+
+
+def _summer(e: _Kept, lock: threading.Lock | None) -> Callable[[], Any]:
+    """A function giving the sha256 of ``seed_for``'s text of ``e.ids`` (a new one each call, the caller's to update),
+    from its last kept state; with ``lock``, it keeps the states it passes for the prompts that continue this one."""
+
+    def summed() -> Any:
+        n, h = (e.sums[-1][0], e.sums[-1][1].copy()) if e.sums else (0, hashlib.sha256())
+        end = len(e.ids)
+        while n < end:
+            step = min(end, (n // SUM_STEP + 1) * SUM_STEP)
+            _feed(h, e.ids, n, step)
+            n = step
+            if n % SUM_STEP == 0 and lock is not None:
+                with lock:
+                    if not e.sums or e.sums[-1][0] < n:
+                        e.sums.append((n, h.copy()))
+        return h
+
+    return summed
