 # -- the tower --------------------------------------------------------------------------------------------------
+def visual_layout(model_dir: Path) -> list[tuple[Path, int, int, int]]:
+    """The tower's tensors as the safetensors headers place them, no data read: (file, byte offset, bytes, elements)
+    each. What a lazy tower reports at start (its bf16 bytes) and what a read-ahead touches."""
+
+    import struct
+
+    index = json.loads((model_dir / "model.safetensors.index.json").read_text())["weight_map"]
+    names = sorted(n for n in index if n.startswith("model.visual."))
+    if not names:
+        raise ValueError("this checkpoint has no vision tower (model.visual.*)")
+    out = []
+    for file in sorted({index[n] for n in names}):
+        with open(model_dir / file, "rb") as f:
+            size = struct.unpack("<Q", f.read(8))[0]
+            header = json.loads(f.read(size))
+        for n in names:
+            if index[n] == file:
+                begin, end = header[n]["data_offsets"]
+                out.append((model_dir / file, 8 + size + begin, end - begin, math.prod(header[n]["shape"])))
+    return out
+
