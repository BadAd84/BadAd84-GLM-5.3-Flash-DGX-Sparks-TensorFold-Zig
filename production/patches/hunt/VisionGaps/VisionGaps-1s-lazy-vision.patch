 PICTURE_UNCAPPED = 8 * 1024 * 1024        # a decode with less room than this was squeezed; not worth remembering
 
 
+# OTS lazy-vision: TF_GLM_VISION_LAZY=1 leaves the tower's 1.05 GiB of bf16 weights on disk until the first picture or
+# clip needs them (rank 0's engine thread loads them at that encode, before any rank is told of the request), and
+# releases them once TF_GLM_VISION_KEEP_S seconds (default 600) pass without an encode. The rows are the same bits:
+# the same tensors, loaded by the same code. 0 (default): loaded and warmed at start, as before.
+def vision_lazy() -> bool:
+    raw = os.environ.get("TF_GLM_VISION_LAZY", "").strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"TF_GLM_VISION_LAZY: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
+def vision_keep_s() -> float:
+    raw = os.environ.get("TF_GLM_VISION_KEEP_S", "").strip() or "600"
+    try:
+        s = float(raw)
+    except ValueError:
+        s = -1.0
+    if not 0 <= s < float("inf"):
+        raise ValueError(f"TF_GLM_VISION_KEEP_S: seconds from 0, not {raw!r}")
+    return s
+
