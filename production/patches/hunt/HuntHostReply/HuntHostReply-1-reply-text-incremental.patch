+class CallHider:
+    """``hide_tool_calls`` of one streamed reply's text as it grows, the same text back: the steps it has decided for
+    good (a call's block through its ``</tool_call>``, a mentioned tag) are not read again. A step is decided for good
+    once the text holds ``_call_head``'s whole window after its opener (and a call's close): any text that begins
+    with this one decides it the same. A text that does not begin with the last one is read from its start."""
+
+    def __init__(self) -> None:
+        self.text = ""              # the text last read: the steps before ``pos`` were decided on it
+        self.pos = 0                # where hide_tool_calls' loop goes on
+        self.kept = ""              # what that loop keeps before ``pos``
+        self.seek = (0, 0)          # (from, at): no opener in the text read between ``from`` and ``at``
+        self.close = (-1, 0)        # (start, at): no close in the text read between a call's ``start`` and ``at``
+
+    def __call__(self, text: str, *, finished: bool) -> str:
+        if not text.startswith(self.text):
+            self.pos, self.kept, self.seek, self.close = 0, "", (0, 0), (-1, 0)
+        out, pos, done, at = [self.kept], self.pos, 1, self.pos
+        while True:
+            seek = self.seek[1] if self.seek[0] == pos else pos
+            start = text.find(_CALL_OPEN, max(pos, seek))
+            if start < 0:
+                self.seek = (pos, max(pos, len(text) - len(_CALL_OPEN) + 1))
+                tail = text[pos:]
+                out.append(tail[: len(tail) - (0 if finished else _partial_tag(tail, _CALL_OPEN))])
+                break
+            head = start + len(_CALL_OPEN)
+            if not _call_head(text, head):                          # a mentioned tag: text
+                out.append(text[pos:head])
+                pos = head
+            else:
+                out.append(text[pos:start])
+                end = text.find(_CALL_CLOSE, max(start, self.close[1]) if self.close[0] == start else start)
+                if end < 0:
+                    self.close = (start, max(start, len(text) - len(_CALL_CLOSE) + 1))
+                    break
+                pos = end + len(_CALL_CLOSE)
+            if len(text) >= head + _HEAD_WINDOW:                    # the opener's window is whole: decided for good
+                done, at = len(out), pos
+        if done > 1:
+            self.kept, self.pos = "".join(out[:done]), at
+        self.text = text
+        return "".join(out)
+
