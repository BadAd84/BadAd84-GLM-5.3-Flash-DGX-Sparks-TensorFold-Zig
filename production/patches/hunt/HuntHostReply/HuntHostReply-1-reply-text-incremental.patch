+class SentText:
+    """``unmask(text)[sent:]`` for a streamed text that grows (``unmask``: ``ReplyMarks.unmask``, or None when the
+    reply has no masking), without unmask's two scans of the whole text every round: unmask gives a text with no inert
+    character and no inert character's JSON escape back as it is, and the part since the last text decides whether
+    this one has any. A text that does not begin with the last one is checked whole."""
+
+    def __init__(self, unmask: Any = None) -> None:
+        self.unmask, self.text, self.inert = unmask, "", False
+
+    def tail(self, text: str, sent: int) -> str:
+        if self.unmask is None:
+            return text[sent:]
+        if text.startswith(self.text):
+            old = len(self.text)
+            inert = (self.inert or _INERT in text[old:]
+                     or _INERT_JSON in text[max(0, old - len(_INERT_JSON) + 1):])
+        else:
+            inert = _INERT in text or _INERT_JSON in text
+        self.text, self.inert = text, inert
+        return self.unmask(text)[sent:] if inert else text[sent:]
 
 
