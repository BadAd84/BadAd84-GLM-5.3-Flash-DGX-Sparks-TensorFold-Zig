+def _uniform_seeded(seeds: np.ndarray, positions: np.ndarray, ids: np.ndarray) -> np.ndarray:
+    """``exact_sampling.uniform_rows`` with a seed a row: row r is ``uniform(seeds[r], positions[r], ids[r])``."""
+
+    with np.errstate(over="ignore"):
+        x = _mix(seeds + np.uint64(0x9E3779B97F4A7C15))[:, None]
+        x = _mix(x ^ (positions.astype(np.uint64)[:, None] * np.uint64(0xD1B54A32D192ED03)))
+        x = _mix(x ^ ids.astype(np.uint64))
+    return (x >> np.uint64(11)).astype(np.float64) * 2.0 ** -53 + 2.0 ** -54
+
+
+def _choose_seeded(values: np.ndarray, ids: np.ndarray, positions: np.ndarray, seeds: np.ndarray,
+                   s: Sampling) -> list[int]:
+    """``choose_rows`` for rows of several streams that share ``s``'s settings, each row keyed by its own seed."""
+
+    rows, width = ids.shape
+    order = np.lexsort((ids, -values), axis=-1)
+    k = max(1, min(int(s.top_k) if s.top_k else width, width))
+    ids = np.take_along_axis(ids, order, axis=-1)[:, :k]
+    scaled = np.take_along_axis(values, order, axis=-1)[:, :k].astype(np.float64) / max(float(s.temperature), 1e-6)
+    score = scaled - np.log(-np.log(_uniform_seeded(seeds, positions, ids)))
+    if 0.0 < s.top_p < 1.0:
+        probs = np.exp(scaled - scaled.max(axis=-1, keepdims=True))
+        probs /= probs.sum(axis=-1, keepdims=True)
+        keep = (np.cumsum(probs, axis=-1) < s.top_p).sum(axis=-1) + 1    # searchsorted(cumsum, top_p) + 1
+        score[np.arange(k)[None, :] >= keep[:, None]] = -np.inf
+    if s.min_p > 0.0:
+        score[scaled < scaled[:, :1] + s.min_log] = -np.inf               # ``choose``'s min_p prefix
+    return [int(t) for t in ids[np.arange(rows), np.argmax(score, axis=-1)]]
+
+
+def topk_host(host: torch.Tensor, layout: Sequence[tuple[int, int, int, int]], parts: Sequence[tuple],
+              out: list) -> None:
+    """The host half of a round's top-k (and greedy) sampling: ``host`` [world, words] float32 on the CPU, every
+    rank's packed candidates (each part's rows of n values, then n ids as float32 bits); ``layout`` [(part, rows, n,
+    first word)]; each part's tokens go to ``out[part]``. Row for row ``choose_rows``' arithmetic (greedy: the best
+    value, then the lowest id), with the ranks' columns read as one numpy view and the rows of every part with the
+    same settings drawn in one call, each keyed by its own stream's seed (the per-part loop's torch.cat, .numpy and
+    numpy calls a part were ~0.17 ms a part a round on the engine thread)."""
+
+    hn = host.numpy()
+    world = hn.shape[0]
+    groups: dict[tuple, list] = {}
+    for k, R, n, at in layout:
+        g = hn[:, at:at + R * 2 * n].reshape(world, R, 2 * n)
+        values = g[:, :, :n].transpose(1, 0, 2).reshape(R, world * n)
+        tokens = np.ascontiguousarray(g[:, :, n:]).view(np.int32).transpose(1, 0, 2).reshape(R, world * n) \
+            .astype(np.int64)
+        _, positions, sampling = parts[k]
+        if sampling is None or sampling.temperature <= 0:
+            order = np.lexsort((tokens, -values), axis=-1)
+            out[k] = [int(tokens[i, order[i, 0]]) for i in range(R)]
+            continue
+        key = (n, float(sampling.temperature), int(sampling.top_k), float(sampling.top_p), float(sampling.min_p))
+        groups.setdefault(key, []).append((k, values, tokens, positions, sampling.seed & 0xFFFFFFFFFFFFFFFF))
+    for members in groups.values():
+        sampling = parts[members[0][0]][2]
+        values = np.concatenate([m[1] for m in members]) if len(members) > 1 else members[0][1]
+        tokens = np.concatenate([m[2] for m in members]) if len(members) > 1 else members[0][2]
+        positions = np.concatenate([np.asarray(m[3], dtype=np.int64) for m in members])
+        seeds = np.concatenate([np.full(len(m[3]), m[4], dtype=np.uint64) for m in members])
+        drawn = _choose_seeded(values, tokens, positions, seeds, sampling)
+        at = 0
+        for k, _, _, rows, _ in members:
+            out[k] = drawn[at:at + len(rows)]
+            at += len(rows)
+
+
