 @triton.jit
+def _swiglu_sum(PART, OUT, XS, LIMIT, M, W: tl.constexpr, SK: tl.constexpr, BLOCK: tl.constexpr):
+    """``_swiglu`` on a 4-bit [gate | up] matmul's K-slice partials PART [SK, M, 2W] fp32: each value summed in slice
+    order and rounded to bf16 once (qmm.cu's reduce_kernel), then _swiglu's arithmetic line for line. The same bits as
+    reduce_kernel + _swiglu, without the bf16 [gate | up] round trip and one launch (HuntMatmulExperts-3)."""
+
+    r = tl.program_id(0)
+    cb = tl.program_id(1)
+    d = cb * BLOCK + tl.arange(0, BLOCK)
+    gs = tl.load(PART + r * (2 * W) + d)
+    us = tl.load(PART + r * (2 * W) + W + d)
+    for s in tl.static_range(1, SK):
+        gs = gs + tl.load(PART + (s * M + r) * (2 * W) + d)
+        us = us + tl.load(PART + (s * M + r) * (2 * W) + W + d)
+    g = tl.minimum(gs.to(tl.bfloat16).to(tl.float32), LIMIT)
+    u = us.to(tl.bfloat16).to(tl.float32)
+    u = tl.minimum(tl.maximum(u, -LIMIT), LIMIT)
+    a = ((g / (1.0 + tl.exp(-g))).to(tl.bfloat16).to(tl.float32) * u).to(tl.bfloat16)
+    tl.store(OUT + r * W + d, a)
+    s = tl.sum(tl.reshape(a.to(tl.float32), (BLOCK // 64, 64)), axis=1)
+    tl.store(XS + r * (W // 64) + cb * (BLOCK // 64) + tl.arange(0, BLOCK // 64), s)
+
+
+def swiglu_sum(part: torch.Tensor, out: torch.Tensor, xs: torch.Tensor, limit: float) -> None:
+    """``swiglu`` on ``part`` [SK, rows, 2 * width] fp32 (a matmul's unreduced K slices, ``qmm.matmul_swiglu``)."""
+
+    sk, rows, w2 = part.shape
+    w = out.shape[1]
+    block = math.gcd(512, w)
+    if block < 64 or w2 != 2 * w or out.shape[0] != rows or not part.is_contiguous():
+        raise ValueError(f"swiglu_sum: partials {tuple(part.shape)} for {tuple(out.shape)}")
+    _swiglu_sum[(rows, w // block)](part, out, xs, float(limit), rows, W=w, SK=sk, BLOCK=block, num_warps=4)
+
+@triton.jit
 def _router(X, W, OUT, M, x_stride, D: tl.constexpr, NE: tl.constexpr, BM: tl.constexpr,
             BLOCK_E: tl.constexpr, BK: tl.constexpr):
