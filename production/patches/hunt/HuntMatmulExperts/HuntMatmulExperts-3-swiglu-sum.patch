+# A decode window's [gate | up] 4-bit matmul whose K slices go through the partials buffer and reduce_kernel (qmm.cu's
+# rule: up to 64 rows, fewer than 28 Mi values, unless TF_GLM_QMM_CLUSTERS=1) leaves the slices unreduced and the
+# SwiGLU sums them (glue.swiglu_sum): the same bits, one launch and a bf16 round trip less a MoE layer
+# (HuntMatmulExperts-3; TF_GLM_SWIGLU_SUM=0: the separate reduce and SwiGLU).
+SWIGLU_SUM = __import__("os").environ.get("TF_GLM_SWIGLU_SUM", "1") != "0"
+_CLUSTER_ROWS, _CLUSTER_VALUES = 64, 28 << 20
+
+
+def matmul_swiglu(x: torch.Tensor, q, xs: torch.Tensor, act: torch.Tensor, act_xs: torch.Tensor, limit: float,
+                  part: torch.Tensor) -> bool:
+    """act, act_xs = swiglu(x @ q.T) when q is a Q4 [gate | up] whose decode K slices are reduced in the partials
+    buffer by the stock launch (then True); False (nothing run) for every other matmul, which takes ``matmul`` +
+    ``glue.swiglu`` (clustered slices, one slice, a DEC_TILES config: their launches stay as they are)."""
+
+    import os
+
+    m = x.shape[0]
+    if not SWIGLU_SUM or not isinstance(q, Q4) or m > _CLUSTER_ROWS or os.environ.get("TF_GLM_QMM_CLUSTERS") == "1":
+        return False
+    sk = split_k(q.n, q.k)
+    if sk == 1 or q.n * q.k >= _CLUSTER_VALUES or q.n % 2 or (m <= 16 and dec_tile(q.n, q.k) is not None) or \
+            part.numel() < sk * m * q.n:
+        return False
+    if x.shape[1] != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_swiglu: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    from . import glue
+
+    slices = shared.matmul(x, q, xs, sk=sk, reduce=False, part=part)
+    glue.swiglu_sum(slices, act, act_xs, limit)
+    return True
+
+
 # Decode rows (up to 16) of a Q4 matmul on another column tile / warp / stage count (``shared.qmm_cfg``): every
 # output keeps its chain, so every choice gives the same bits. By per-rank shape (n, k), measured on GB10.
 DEC_TILES: dict[tuple[int, int], int] = {(4096, 4096): 2, (2048, 4096): 2, (8192, 1536): 2, (4096, 8192): 4,
