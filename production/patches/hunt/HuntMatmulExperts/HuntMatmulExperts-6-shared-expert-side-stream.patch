+# HuntMatmulExperts-6: TF_GLM_SHARED_SIDE=0 runs a decode window's shared expert in line, as before (the same kernels on
+# disjoint buffers either way: the same bits)
+SHARED_SIDE = __import__("os").environ.get("TF_GLM_SHARED_SIDE", "1") != "0"
 
 
 def prompt_tile(m: int, n: int, k: int) -> int:
