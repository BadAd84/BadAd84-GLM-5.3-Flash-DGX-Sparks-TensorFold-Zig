+def _route(m, c, b: Buffers, R: int) -> None:
+    """A window's MoE routing (``moe_block``; ``warm_routers``): rows 0 .. R of ``b.normed`` to their experts' picks
+    and weights."""
+
+    glue.route_select(b.normed[:R], m.router, b.mlog[:R], m.bias, b.pick[:R], b.wts[:R], c.top_k, c.experts,
+                      c.routed_scale, c.norm_topk)
+
+
+def index_gate(ix, b: Buffers, rs: slice) -> None:
+    """The DSA indexer's head gates of rows ``rs`` (``_dsa_latent``'s, a prompt chunk's or a window's; and
+    ``warm_routers``; ``own_front`` and the plain-cache path make the same call on their rows)."""
+
+    glue.router(b.normed[rs], ix.gate, b.igr[rs])
+
+
+def warm_routers(w: Weights, b: Buffers) -> int:
+    """At start, every rank (P1ShortTTFT): each router kernel variant a window can need (``glue.router_warm_rows``)
+    launched once on ``b``'s rows through the windows' own calls (``_route``, ``index_gate``), so none is first
+    loaded inside a request's first token. A --parallel 1 server met them first in the 1-63-row prompt chunks a
+    grid point left (one per off-grid prompt); OTS 0121 on --parallel 1 (HuntRoundLoop-6) runs those prompts as one
+    chunk, so the first prompt of 33-63 tokens loaded the 64-row block's in its own first token (two variants, ~2 ms
+    each on the laptop, on every rank). Only scratch rows are written (picks, weights, logits and gates the next
+    window's routing writes before reading); the same bits. TF_GLM_ROUTER_WARM=0: not run. Returns the launches."""
+
+    import os
+
+    if os.environ.get("TF_GLM_ROUTER_WARM", "1").strip() == "0":
+        return 0
+    c = w.cfg
+    moe = next((l.moe for l in w.layers if l.moe is not None), None)
+    ix = next((l.dsa.index for l in w.layers if l.dsa is not None and l.dsa.index is not None), None)
+    n = 0
+    for R in glue.router_warm_rows():
+        if R > b.normed.shape[0]:
+            break
+        if moe is not None:
+            _route(moe, c, b, R)
+            n += 1
+        if ix is not None:
+            index_gate(ix, b, slice(0, R))
+            n += 1
+    return n
+
+
