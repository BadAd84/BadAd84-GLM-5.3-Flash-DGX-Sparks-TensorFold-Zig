 # Router kernel choice is fixed by shape because the sliced and single-pass reductions differ in their last bits.
 ROUTER_KS = 8
+ROUTER_BLOCKS = (16, 32, 64, 128)    # the row blocks (BM) of the router kernels: the first that holds the rows
+
+
+def router_block(m: int) -> int:
+    """The router kernels' row block (their BM constexpr) for m rows: ``router`` and ``route_select`` both."""
+
+    return next((bm for bm in ROUTER_BLOCKS if m <= bm), ROUTER_BLOCKS[-1])
+
+
+def router_warm_rows() -> list[int]:
+    """Row counts that launch every variant of the router kernels a window can need (P1ShortTTFT). A variant is
+    one row block (``router_block``) and Triton's own specialisation of the row count M (1, a multiple of 16, or
+    other: the other int arguments, D and the totals, are multiples of 16 at every call): per block its smallest
+    count and its largest (a multiple of 16), and 2 (the first block's other). Each variant's first launch loads
+    it (a Triton cache read and a module load, a few ms); a prompt chunk that is the first of its variant pays that
+    in its first token."""
 
+    rows, lo = [2], 1
+    for bm in ROUTER_BLOCKS:
+        rows += [lo, bm]
+        lo = bm + 1
+    return sorted(set(rows))
+
 
