+def held_bypass(value: str | None = None) -> int:
+    """TF_GLM_HELD_BYPASS (default 0: off): while a request is held first in line for room, at most this many later
+    requests that resume a kept state in place and need no more rows than are free (``MultiDecoder.in_place``) are
+    admitted past it, per hold (``GlmScheduler._bypass``). Scheduling only: every admitted request's ADMIT and tokens are
+    what they would be when it is admitted; only when it is admitted changes. Rank 0 decides, so only its setting
+    matters."""
+
+    raw = (os.environ.get("TF_GLM_HELD_BYPASS", "") if value is None else value).strip() or "0"
+    if not raw.isdecimal():
+        raise ValueError(f"TF_GLM_HELD_BYPASS: a count of requests per hold (0: off), not {raw!r}")
+    return int(raw)
+
+
+HELD_BYPASS = held_bypass()
+
