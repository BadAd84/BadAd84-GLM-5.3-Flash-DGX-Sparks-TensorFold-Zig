+    def in_place(self, s: Stream) -> bool:
+        """Rank 0, read only (TF_GLM_HELD_BYPASS, ``GlmScheduler._bypass``): whether admitting ``s`` now takes a kept
+        extent over in place and grows it by free rows only. The longest kept prefix of its prompt (``_resume``, the hit
+        ``admit`` finds) lies in an extent no stream holds, with no other conversation's longer state in it (else
+        ``_place`` copies into new rows), and the pool's free rows cover the growth plus a block for each decoding stream
+        (``fits``' headroom). ``_place`` then grows that extent (``_grow``: in place, the extents in its way moved, or
+        compacted; never an eviction, since the free rows cover the growth), so the request takes no rows but its own
+        kept ones and free ones no decoder's headroom needs. False with parts (TF_GLM_KV_SHARD: carries, twins), the
+        spill tier (``prestage`` may read a longer stored prompt into new rows), TF_GLM_PREFIX_WAIT, pictures, or a
+        request that does not draft (it resumes nothing)."""
+
+        g = self.g
+        if (self.pool.half or self.disk is not None or PREFIX_WAIT or s.vision is not None or not s.draft
+                or g.serial_only):
+            return False
+        prompt, karr = stream_ids(s)
+        if not prompt or len(prompt) >= g.limit:
+            return False
+        hit = self._resume(prompt, (getattr(s, "glm", None) or {}).get("salt"), karr)
+        if hit is None:
+            return False
+        x = hit.extent
+        if x.owner is not None or x.twin or getattr(x, "loading", None) is not None:
+            return False
+        if any(len(c.ids) > len(hit.ids) and not key_is(c, len(c.ids), karr) for c in x.kept):
+            return False
+        grow = max(0, self._need(len(prompt)) - x.size)
+        busy = sum(1 for l in self.lanes.values() if l.decoding)
+        return grow + ALIGN * busy <= self.pool.free_rows()
+
     def admit(self, s: Stream) -> None:
         """Rank 0: place a request (slot, extent; resumed from the longest kept prefix of its prompt when it drafts)
         and queue its ADMIT; its prompt is prefilled chunk by chunk in later iterations."""
