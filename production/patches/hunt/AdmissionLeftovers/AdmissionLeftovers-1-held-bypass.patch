+    bypass_for = None                    # TF_GLM_HELD_BYPASS: the held stream whose hold ``bypassed`` counts for
+    bypassed = 0                         # requests admitted past it during that hold
+
+    def _bypass(self, done: list[Stream]) -> None:
+        """TF_GLM_HELD_BYPASS=N (``HELD_BYPASS``; 0, the default: off). Right after a request is held first in line
+        (``held``: ``fits`` refused it, or ``admit`` raised NoRoom), queued requests that take a kept extent over in place
+        and need no more rows than are free (``MultiDecoder.in_place``) are admitted past it, in queue order, while
+        slots are free, at most N during one hold (from the held request's first hold until it is admitted or
+        cancelled); every other request keeps its place in line, and the held request is still the first tried at every
+        later iteration.
+
+        Fairness bound: after N have passed, admission is what it is with the knob off (the held request first, nothing
+        past it: ``ready``, ``prefix`` and the queue are all behind it), so the held request is admitted no later than
+        when every stream live at its first hold and the at most N admitted past it have ended or been given back (with
+        no stream live ``fits`` is True and ``admit`` may evict every kept state; a prompt past the pool fails either
+        way). Each of those ends within its own token count, so the hold stays bounded; with the knob off the bound is
+        the first set alone. A request passing evicts nothing and takes none of the headroom ``fits`` keeps for the
+        decoding streams. With the spill tier or TF_GLM_PREFIX_WAIT on nothing passes (``in_place``), so skipping
+        ``prestage`` and ``prefix_wait`` here skips nothing they would do."""
+
+        import heapq
+
+        held = self.held[0]
+        if self.bypass_for is not held:
+            self.bypass_for, self.bypassed = held, 0
+        while self.bypassed < HELD_BYPASS and self.decoder.live() + self._reading() < self.max_streams:
+            with self.waiting.mutex:
+                line = sorted(self.waiting.queue)
+            entry = next((e for e in line if e[2][0] is not self._Flush and self.decoder.in_place(e[2][0])), None)
+            if entry is None:
+                return
+            with self.waiting.mutex:            # (only this thread takes from the queue: the entry is still there)
+                self.waiting.queue.remove(entry)
+                heapq.heapify(self.waiting.queue)
+            if self._cancel_item(entry[2]):
+                continue
+            stream, box = entry[2]
+            self.boxes[id(stream)] = box
+            try:
+                self.decoder.admit(stream)
+            except NoRoom:                       # (a slot: ``in_place`` found the rows) its place in line again
+                self.boxes.pop(id(stream))
+                with self.waiting.mutex:
+                    heapq.heappush(self.waiting.queue, entry)
+                return
+            except Exception as exc:             # noqa: BLE001  (this request fails, the others go on)
+                self.boxes.pop(id(stream)).put(("error", exc))
+                continue
+            self.bypassed += 1
+            print(f"[tensorfold] request of {len(stream.prompt)} prompt tokens admitted past the held one "
+                  f"({self.bypassed} of {HELD_BYPASS} this hold), resumed {stream.cached} in place", flush=True)
+            if stream.done:
+                done.append(stream)
+
