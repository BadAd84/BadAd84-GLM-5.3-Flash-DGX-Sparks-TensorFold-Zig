 import sys
 from dataclasses import dataclass
 from pathlib import Path
@@ -20,7 +22,29 @@
 from . import glue, qmm
 from .weights import PREFIX, Weights
 
-EDGE = 0.6        # the selector's edge score weight in a chain pick
+EDGE_ENV = "TF_GLM_DRAFT_EDGE"
+EDGE_DEFAULT = 0.6
+
+
+def draft_edge(env: dict | None = None) -> float:
+    """TF_GLM_DRAFT_EDGE: the selector's edge score weight in a chain pick (``EDGE``); unset or empty: 0.6, the
+    recipe's. Lane DraftPolicy refit it on 24 real agent turns' TF_GLM_DRAFT_DUMP records (draft_sim, held out by
+    turn): 0.2-0.4 against 0.6, +1-2% decode tok/s. Only the chain's picks and confidences change (drafts are
+    verified: replies are the same). Every rank must read the same value (the engine's startup comparison)."""
+
+    value = (os.environ if env is None else env).get(EDGE_ENV, "").strip()
+    if not value:
+        return EDGE_DEFAULT
+    try:
+        edge = float(value)
+    except ValueError:
+        edge = math.nan
+    if not (math.isfinite(edge) and 0.0 <= edge <= 4.0):
+        raise ValueError(f"{EDGE_ENV}={value!r}: a weight from 0 to 4 (unset: {EDGE_DEFAULT})")
+    return edge
+
+
+EDGE = draft_edge()  # the selector's edge score weight in a chain pick
