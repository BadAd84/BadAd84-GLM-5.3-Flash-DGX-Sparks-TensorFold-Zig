+    def _why_held(self, stream, why: str) -> None:
+        """Rank 0: a request held at the head of the queue (every later one waits behind it) is logged once, with why
+        and the pool's state then: what tells a placement hold from a fill-order wait (recipe issue #199)."""
+
+        if getattr(stream, "held_logged", False):
+            return
+        stream.held_logged = True
+        d = self.decoder
+        pool = getattr(d, "pool", None)
+        print(f"[tensorfold] request of {len(stream.prompt)} prompt tokens held first in line, {why}: "
+              f"{d.live()} streams in ({len(d.filling)} filling), {self.waiting.qsize()} queued behind it, "
+              f"pool {pool.free_rows() if pool is not None else '?'} of {pool.rows if pool is not None else '?'} "
+              f"tokens free, {len(getattr(d, 'kept', []))} kept prompts", flush=True)
+
     def flush_spill(self, timeout: float = 60.0) -> bool:
         """Any thread (a SIGTERM): the worker writes the kept prompts to the spill tier at its next iteration, whatever
         its slots and queue hold (the queued item only wakes an idle worker)."""
