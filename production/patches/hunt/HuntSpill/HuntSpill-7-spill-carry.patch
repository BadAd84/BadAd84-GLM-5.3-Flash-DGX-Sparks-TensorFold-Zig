diff -ruN tensorfold/cuda/spill_carry.py tensorfold/cuda/spill_carry.py
--- tensorfold/cuda/spill_carry.py	1970-01-01 00:00:00.000000000 +0000
+++ tensorfold/cuda/spill_carry.py	2026-10-30 00:29:07.291845400 +0000
@@ -0,0 +1,111 @@
+"""The spill tier's carry gate, a node's side (``python3 -m tensorfold.cuda.spill_carry <command> ...``, in the NEW
+image, with the spill folder mounted): stored states of an earlier build or setting enter the serving folder only on
+proof that the new image computes the same bytes for them (``spill_blocks.compare_points``), the store taking the
+grant on its own (``BlockStore._take_grants``). The orchestration across nodes (pick the samples every rank holds,
+replay them through the serve, check and grant on every node, all or none) is the caller's.
+
+  plan <root> <rank>                  the serving folder (the newest key.json) and the one it may carry from (the newest
+                                      other whose key differs in spill_blocks.CARRY_PARTS alone), or why none
+  keys <rank dir>                     its whole points: key, tokens, last use, shared, head, with pictures
+  ids <rank dir> <key>                a point's ids as JSON (what a replay sends as its prompt)
+  check <old rank dir> <new rank dir> <key>...   EQUAL / DIFF lines (spill_blocks.compare_points)
+  grant <old rank dir> <new rank dir> <key>...   the check again, then the grant (spill_blocks.grant), or why not
+  status <rank dir>                   its grants: pending, done, refused
+Exit 0 on EQUAL / granted, 1 otherwise."""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+from . import spill_blocks as sb
+
+
+def _points(rank_dir: str, block: int):
+    pdir, bdir = os.path.join(rank_dir, "points"), os.path.join(rank_dir, "blocks")
+    present = {f[:-4] for f in os.listdir(bdir) if f.endswith(".bin")}
+    out = []
+    for f in sorted(os.listdir(pdir)):
+        if f.endswith(".json") and not f.startswith("."):
+            try:
+                out.append(sb.load_point(pdir, f[:-5], block, present))
+            except Exception:                               # noqa: BLE001, S112  (not whole: not a point)
+                continue
+    return sorted(out, key=lambda p: -p.used)
+
+
+def plan(root: str, rank: int) -> tuple[str | None, str | None, list[str]]:
+    """(the serving rank folder, the one it may carry from, notes)."""
+
+    folders = []
+    for d in os.listdir(root):
+        rd = os.path.join(root, d, f"rank{rank}")
+        m = sb.read_manifest(rd) if d.startswith("spill-") else None
+        if m is not None:
+            folders.append((os.path.getmtime(os.path.join(rd, "key.json")), rd, m))
+    if not folders:
+        return None, None, ["no folder with a key (key.json)"]
+    folders.sort(key=lambda f: -f[0])
+    _, to, new = folders[0]
+    notes = []
+    for _, rd, m in folders[1:]:
+        why = sb.carry_refusal(m, new)
+        if why is None:
+            return to, rd, notes
+        notes.append(f"{rd}: {why}")
+    return to, None, notes
+
+
+def main(argv: list[str]) -> int:
+    if not argv:
+        print(__doc__)
+        return 1
+    cmd, args = argv[0], argv[1:]
+    if cmd == "plan":
+        to, frm, notes = plan(args[0], int(args[1]))
+        print(json.dumps({"to": to, "from": frm, "notes": notes}))
+        return 0 if to and frm else 1
+    if cmd == "keys":
+        m = sb.read_manifest(args[0])
+        for p in _points(args[0], int((m or {}).get("block", 2048))):
+            print(json.dumps({"key": p.key, "n": p.n, "used": p.used, "shared": p.shared, "head": p.head,
+                              "pictures": p.tokens is not None}))
+        return 0
+    if cmd == "ids":
+        m = sb.read_manifest(args[0])
+        pdir, bdir = os.path.join(args[0], "points"), os.path.join(args[0], "blocks")
+        present = {f[:-4] for f in os.listdir(bdir) if f.endswith(".bin")}
+        p = sb.load_point(pdir, args[1], int((m or {}).get("block", 2048)), present)
+        print(json.dumps([int(t) for t in (p.tokens if p.tokens is not None else p.ids)]))
+        return 0
+    if cmd == "check":
+        old, new, keys = args[0], args[1], args[2:]
+        why = sb.carry_refusal(sb.read_manifest(old), sb.read_manifest(new))
+        if why is not None:
+            print(f"REFUSED {why}")
+            return 1
+        block = int(sb.read_manifest(old)["block"])
+        bad = 0
+        for k in keys:
+            diffs = sb.compare_points(old, new, k, block)
+            bad += bool(diffs)
+            print("\n".join(f"DIFF {d}" for d in diffs) if diffs else f"EQUAL {k}")
+        return 1 if bad or not keys else 0
+    if cmd == "grant":
+        ok, lines = sb.grant(args[0], args[1], args[2:])
+        print("\n".join(lines))
+        return 0 if ok else 1
+    if cmd == "status":
+        carry = os.path.join(args[0], "carry")
+        for f in sorted(os.listdir(carry)) if os.path.isdir(carry) else []:
+            state = next((s for s in ("grant", "done", "refused") if f.endswith(f".{s}.json")), None)
+            if state is not None and not f.startswith("."):
+                print(f"{'pending' if state == 'grant' else state} {f}")
+        return 0
+    print(f"unknown command {cmd!r}\n{__doc__}")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
