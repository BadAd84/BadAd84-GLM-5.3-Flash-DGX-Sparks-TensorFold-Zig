+def load_point(points_dir: str, key: str, block: int, present, used: float | None = None) -> Point:
+    """Point ``key`` of a rank folder's ``points`` (``present``: the names of the blocks its ``blocks`` holds), whole or
+    an error: its json, of this format and naming it; its ids file, against its CRC-32; its small state's file; every
+    block it names, on disk; its block list, the one its ids and lineage give. The start's check (``_scan``), the
+    carry gate's and the carry's (``compare_points``, ``BlockStore._carry_from``)."""
+
+    path = lambda suffix: os.path.join(points_dir, f"{key}{suffix}")      # noqa: E731
+    with open(path(".json")) as fh:
+        m = json.load(fh)
+    if m.get("format") != FORMAT or m["key"] != key:
+        raise ValueError("another format")
+    with open(path(".ids"), "rb") as fh:
+        raw = fh.read()
+    if zlib.crc32(raw) != m["ids_crc"] or not os.path.exists(path(".st")):
+        raise ValueError("ids or small state")
+    arr = np.frombuffer(raw, dtype=np.int64)
+    n = int(m["n"])
+    ids, tokens = arr[:n].copy(), (arr[n:].copy() if len(arr) > n else None)
+    blocks = list(m["blocks"])
+    if (len(ids) != n or point_key(ids) != key or not all(b in present for b in blocks)
+            or [h for _, _, h in block_hashes(ids, block, m["lineage"])] != blocks):
+        raise ValueError("blocks")
+    if used is None:
+        used = os.stat(path(".json")).st_mtime
+    return Point(key, n, ids, tokens, m["lineage"], blocks, [int(c) for c in m["crcs"]],
+                 [bytes.fromhex(x) for x in m["digests"]], int(m["small_crc"]), int(m["small_bytes"]),
+                 bool(m["shared"]), bool(m["head"]), float(used), _chain(ids, block), m.get("fields") or {})
+
+
+# -- the gated carry: stored states across a build or settings change ---------------------------------------------------
+# A folder is keyed by everything its bits may depend on (``BlockStore.compat``), so a new image or setting starts on an
+# empty folder. Its states may enter the new folder only on proof, as OTS 0123 does for our former tier: a gate
+# (``spill_carry``, run in the new image) re-prefills sampled stored states on the new image, compares what the new
+# image wrote with the old states byte for byte (``compare_points``) and only then writes a grant into the new
+# folder (``grant``); the store takes it (``BlockStore._take_grants``) only when the two folders' keys
+# (``key.json``, ``BlockStore.manifest``) differ in ``CARRY_PARTS`` alone.
+CARRY_PARTS = ("build", "agreed")         # the only parts of a folder's key a carried state's folder may differ in
+GRANT = "tensorfold-cuda-spill-carry-1"
+BIT_FIELDS = ("drafter_end", "mtp_len")   # a small state's plain fields that are computation (the rest is bookkeeping)
+_COMPAT_NAME = re.compile(r"[0-9a-f]{16}")
+
+
+def read_manifest(rank_dir: str) -> dict | None:
+    """A rank folder's key (``key.json``: what ``BlockStore`` was keyed by), or None."""
+
+    try:
+        with open(os.path.join(rank_dir, "key.json")) as fh:
+            m = json.load(fh)
+    except (OSError, ValueError):
+        return None
+    return m if isinstance(m, dict) else None
+
+
+def carry_refusal(old: dict | None, new: dict | None) -> str | None:
+    """Why states of a folder keyed ``old`` may not enter one keyed ``new`` (None: they may, on a gate's proof): both
+    keys known, other folders, every field equal (format, block, rank layout, this rank's weights, every part of the
+    signature) but the parts in ``CARRY_PARTS``, one of which differs."""
+
+    if old is None or new is None:
+        return "a folder without its key (key.json)"
+    if old.get("compat") == new.get("compat"):
+        return "the same folder"
+    top = sorted(k for k in set(old) | set(new) if k not in ("parts", "compat") and old.get(k) != new.get(k))
+    if top:
+        return f"they differ in {', '.join(top)}"
+    po, pn = old.get("parts") or {}, new.get("parts") or {}
+    other = sorted(k for k in set(po) | set(pn) if k not in CARRY_PARTS and po.get(k) != pn.get(k))
+    if other:
+        return f"they differ in {', '.join(other)} (only {' and '.join(CARRY_PARTS)} may)"
+    if all(po.get(k) == pn.get(k) for k in CARRY_PARTS):
+        return f"they differ in another rank's weights only (only {' and '.join(CARRY_PARTS)} may)"
+    return None
+
+
+def _small_tensors(raw) -> tuple[dict, dict, str | None]:
+    """A small state's file: its tensors as (dtype, shape, bytes) by name, its layer's plain fields, its class."""
+
+    (size,) = struct.unpack("<Q", bytes(raw[:8]))
+    header = json.loads(bytes(raw[8:8 + size]))
+    at = 8 + size
+    meta = header.pop("__metadata__", None) or {}
+    layer = json.loads(meta.get("layer") or "{}")
+    plain = {k: s["v"] for k, s in (layer.get("fields") or {}).items() if isinstance(s, dict) and "v" in s}
+    tensors = {name: (d["dtype"], tuple(d["shape"]), bytes(raw[at + d["data_offsets"][0]:at + d["data_offsets"][1]]))
+               for name, d in header.items()}
+    return tensors, plain, layer.get("class")
+
+
+def compare_points(old_dir: str, new_dir: str, key: str, block: int) -> list[str]:
+    """The gate's check of state ``key`` stored in two rank folders (``old_dir``: the old key's, ``new_dir``: the new
+    image's own computation of the same ids): every difference that matters to its bits, one line each; [] when they
+    are byte for byte the same: the ids (and tokens), every block's bytes, the small state's class, every one of its
+    tensors (KDA recurrences, conv windows, index-ring tails, the DFlash2 window; the head row when the old state kept
+    one) and its ``BIT_FIELDS``. Not compared: the lineage (the names of another computation of the same rows) and the
+    small state's bookkeeping fields (``after``: how the prompt that kept it went on)."""
+
+    pts = []
+    for d in (old_dir, new_dir):
+        bdir = os.path.join(d, "blocks")
+        try:
+            present = {f[:-4] for f in os.listdir(bdir) if f.endswith(".bin")}
+            pts.append(load_point(os.path.join(d, "points"), key, block, present))
+        except Exception as exc:                            # noqa: BLE001
+            return [f"{key}: not whole in {d}: {exc!r}"]
+    a, b = pts
+    if (a.n != b.n or not np.array_equal(a.ids, b.ids) or (a.tokens is None) != (b.tokens is None)
+            or (a.tokens is not None and not np.array_equal(a.tokens, b.tokens))):
+        return [f"{key}: ids"]
+    out = []
+    for i, (ha, hb) in enumerate(zip(a.blocks, b.blocks)):
+        with open(os.path.join(old_dir, "blocks", f"{ha}.bin"), "rb") as fa, \
+                open(os.path.join(new_dir, "blocks", f"{hb}.bin"), "rb") as fb:
+            if fa.read() != fb.read():
+                out.append(f"{key}: block {i} ({ha} / {hb})")
+    small = []
+    for d in (old_dir, new_dir):
+        with open(os.path.join(d, "points", f"{key}.st"), "rb") as fh:
+            small.append(_small_tensors(fh.read()))
+    (ta, fa, ca), (tb, fb, cb) = small
+    if ca != cb:
+        out.append(f"{key}: small state class {ca} / {cb}")
+    for name in sorted(set(ta) | set(tb)):
+        if name not in ta and name.rsplit(".", 1)[-1] == "head":
+            continue                                        # (the old state kept no head row: nothing to compare)
+        if ta.get(name) != tb.get(name):
+            out.append(f"{key}: small state {name}")
+    out += [f"{key}: small state {k} {fa.get(k)!r} / {fb.get(k)!r}" for k in BIT_FIELDS if fa.get(k) != fb.get(k)]
+    return out
+
+
+def grant(old_dir: str, new_dir: str, keys: Sequence[str], owner=None) -> tuple[bool, list[str]]:
+    """The gate, on one rank folder of one node: states ``keys`` (sampled from the old folder, re-prefilled on the new
+    image, stored by it) compared (``compare_points``); only when the keys may carry (``carry_refusal``), at least one
+    state was checked and every one is equal, ``new_dir/carry/spill-<old>.grant.json`` names the old folder, both keys
+    and each checked state's block digests and CRC-32s (the store re-reads them when it takes the grant: a folder that
+    changed since is refused). (granted, lines)."""
+
+    old, new = read_manifest(old_dir), read_manifest(new_dir)
+    why = carry_refusal(old, new)
+    if why is not None:
+        return False, [f"refused: {why}"]
+    if not keys:
+        return False, ["refused: no state checked"]
+    diffs = [line for k in keys for line in compare_points(old_dir, new_dir, k, int(old["block"]))]
+    if diffs:
+        return False, [f"DIFF {line}" for line in diffs] + ["refused: a checked state differs"]
+    checked = {}
+    for k in keys:
+        with open(os.path.join(old_dir, "points", f"{k}.json")) as fh:
+            m = json.load(fh)
+        checked[k] = {"n": m["n"], "ids_crc": m["ids_crc"], "crcs": m["crcs"], "digests": m["digests"]}
+    carry = os.path.join(new_dir, "carry")
+    os.makedirs(carry, mode=0o700, exist_ok=True)
+    path = os.path.join(carry, f"spill-{old['compat']}.grant.json")
+    if os.path.exists(path):
+        return False, ["refused: a grant of that folder is pending"]
+    _put(path, json.dumps({"format": GRANT, "from": old["compat"], "to": new["compat"], "from_key": old,
+                           "to_key": new, "checked": checked}).encode(), owner)
+    return True, [f"granted: {len(keys)} states equal, spill-{old['compat']} -> spill-{new['compat']}"]
+
