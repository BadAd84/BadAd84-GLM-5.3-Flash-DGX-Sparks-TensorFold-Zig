+    # -- the gated carry (``carry_refusal``, ``compare_points``, ``grant``) ---------------------------------------------
+    def _take_grants(self) -> int:
+        """Grants the carry gate wrote into this folder (``carry/spill-<old>.grant.json``, never one under its
+        temporary dot name), at start and on a quiet writer every TF_GLM_SPILL_CARRY_POLL_S: each one checked
+        (``_grant_refusal``), then the old folder's whole points taken (``_carry_from``); the grant then renamed
+        ``.done.json``, or ``.refused.json`` (counted). The points carried."""
+
+        carry = os.path.join(self.dir, "carry")
+        try:
+            names = sorted(f for f in os.listdir(carry) if f.endswith(".grant.json") and not f.startswith("."))
+        except OSError:
+            return 0
+        total = 0
+        for name in names:
+            path = os.path.join(carry, name)
+            stem = path[:-len(".grant.json")]
+            try:
+                with open(path) as fh:
+                    g = json.load(fh)
+                why = self._grant_refusal(g)
+                if why is None:
+                    n = self._carry_from(os.path.join(self.cfg.root, f"spill-{g['from']}", f"rank{self.rank}"))
+                    total += n
+                    os.replace(path, stem + ".done.json")
+                    print(f"[tensorfold] spill rank {self.rank}: carried {n} stored prompts from spill-{g['from']} "
+                          "(the carry gate's grant)", flush=True)
+                    continue
+            except Exception as exc:                        # noqa: BLE001  (a grant that cannot be read is refused)
+                why = repr(exc)
+            with self.lock:
+                self.stats["carry_refused"] += 1
+            try:
+                os.replace(path, stem + ".refused.json")
+            except OSError:
+                pass
+            print(f"[tensorfold] spill rank {self.rank}: carry grant {name} refused: {why}", flush=True)
+        return total
+
+    def _grant_refusal(self, g: dict) -> str | None:
+        """Why grant ``g`` is not taken (None: it is): of this format; for this folder, by its key; naming an old
+        folder of this root and rank by its name only, whose key is still the one the gate checked; the two keys may
+        carry (``carry_refusal``); at least one state checked, and every checked state still in both folders with the
+        ids and block CRC-32s and digests the gate saw (a folder changed since is refused)."""
+
+        if not isinstance(g, dict) or g.get("format") != GRANT:
+            return "another format"
+        if self.manifest is None or g.get("to") != self.compat or g.get("to_key") != self.manifest:
+            return "not this folder's grant"
+        frm = str(g.get("from", ""))
+        if not _COMPAT_NAME.fullmatch(frm):
+            return "no folder name"
+        old_dir = os.path.join(self.cfg.root, f"spill-{frm}", f"rank{self.rank}")
+        old = read_manifest(old_dir)
+        if old is None or old != g.get("from_key") or old.get("compat") != frm:
+            return f"spill-{frm} is not the folder the gate checked"
+        why = carry_refusal(old, self.manifest)
+        if why is not None:
+            return why
+        checked = g.get("checked")
+        if not isinstance(checked, dict) or not checked:
+            return "no state checked"
+        for key, seen in checked.items():
+            for d in (old_dir, self.dir):
+                try:
+                    with open(os.path.join(d, "points", f"{key}.json")) as fh:
+                        m = json.load(fh)
+                except (OSError, ValueError):
+                    return f"{key}: gone from {d} since the check"
+                if any(m.get(k) != seen.get(k) for k in ("n", "ids_crc", "crcs", "digests")):
+                    return f"{key}: changed in {d} since the check"
+        return None
+
+    def _carry_from(self, old_dir: str) -> int:
+        """The old folder's whole points (``load_point``) this folder neither holds nor is writing, most recently used
+        first, while they fit the cap: each taken by ``_carry_point``. The points taken."""
+
+        pdir = os.path.join(old_dir, "points")
+        present = {f[:-4] for f in os.listdir(os.path.join(old_dir, "blocks")) if f.endswith(".bin")}
+        metas = []
+        for f in os.listdir(pdir):
+            if f.endswith(".json") and not f.startswith("."):
+                try:
+                    metas.append((os.stat(os.path.join(pdir, f)).st_mtime, f[:-5]))
+                except OSError:
+                    pass
+        n = 0
+        for used, key in sorted(metas, reverse=True):
+            try:
+                pt = load_point(pdir, key, self.block, present, used)
