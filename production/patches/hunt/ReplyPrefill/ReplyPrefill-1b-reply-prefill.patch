diff -r tensorfold/families/glm5_next/cuda/reply_prefill.py ../tree6/tensorfold/families/glm5_next/cuda/reply_prefill.py
--- tensorfold/families/glm5_next/cuda/reply_prefill.py	1970-01-01 00:00:00.000000000 +0000
+++ ../tree6/tensorfold/families/glm5_next/cuda/reply_prefill.py	2026-10-30 06:55:04.406073600 +0000
@@ -0,0 +1,241 @@
+"""OTS (ReplyPrefill): a finished reply's prompt state, prefilled while the serve is idle before the agent's next turn.
+
+A conversation's kept states sit at its PROMPTS' grid points only (``multi.MultiDecoder._admitted``: ``lane.point``):
+the reply's rows were written by decode windows, whose bits are not a prompt chunk's, so the next turn prefills the
+previous reply again (a tool call of ~120 tokens, an answer of ~2k) before its own tool result. With
+``TF_GLM_REPLY_PREFILL=1`` the app (``app.GlmApp.run``), once a reply is out, renders the conversation's next prefix as
+the client will send it back (``next_prefix``: the request's messages, the reply's assistant message and an empty
+probe of what follows it, through the same ``_prepare``: template, prefix render cache, literal mask, prompt ids), cuts
+it to its last grid point B and submits it
+as a prefill-only job (``GlmEngine.generate(..., reply=...)``, background): it resumes from the request's own prompt
+state, fills the prompt's tail and the reply in a prompt chunk starting on the grid, and keeps the state at B with its
+head row (a greedy first token is sampled from that row as for any prompt, and thrown away). The next turn's prompt
+starts with those ids, so it resumes at B and prefills only the tool result.
+
+Exactness: the state at B is the one any prompt chunking on the grid leaves there (the engine's chunk invariance,
+which every resume relies on: scripts/glm53/v110/tests/kernels/chunkinv), so a reply resumed from it has the bits of
+one resumed from the prompt's own state. A next turn that does not start with those ids resumes from the prompt's
+state, which the job never drops.
+
+Never in a real request's way: the replies wait in one worker's queue (``submit``; the newest ``WAITING``) until the
+serve is idle (``GlmScheduler.idle``: nothing live, held or queued), and only then are rendered (no host work beside
+decoding streams) and submitted one at a time. The scheduler admits a job only while nothing else is live or pending,
+and ends it, unfinished, the moment any other request is dequeued: that request waits at most for the job's current
+prompt slice (``TF_GLM_REPLY_PREFILL_SLICE_MS`` with TF_GLM_FILL_BUDGET_MS's layer costs; else its chunk). It is
+admitted only when the kept state it resumes from is in no stream's use, nobody went on past its request, its rows
+fit without evicting anything, and the state it keeps can push no other conversation's resume point out of the kept
+states (``cap_spares``: only earlier, superseded turn states may go, never a conversation's latest state, a shared
+prefix or the job's own base).
+
+``TF_GLM_REPLY_PREFILL``: 0 (off, the default) or 1. ``TF_GLM_REPLY_PREFILL_SLICE_MS``: the job's layer slices (default
+50 ms; 0: its prompt chunk whole; needs TF_GLM_FILL_BUDGET_MS > 0, whose start-up layer timings it uses).
+"""
+from __future__ import annotations
+
+import math
+import os
+import threading
+import time
+from collections import deque
+from types import SimpleNamespace
+from typing import Any
+
+WAITING = 8                     # replies waiting for an idle serve at most (the oldest go first)
+IDLE_POLL_S = 0.01              # the worker's look at the scheduler while the serve is busy
+_DROP = ("logprobs", "top_logprobs", "response_format", "seed")     # (read by ``_prepare``, never rendered)
+
+
+def mode(value: str | None = None) -> int:
+    """TF_GLM_REPLY_PREFILL: 0 (off, the default) or 1."""
+
+    value = (os.environ.get("TF_GLM_REPLY_PREFILL", "") if value is None else value).strip() or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"TF_GLM_REPLY_PREFILL: 0 or 1, not {value!r}")
+    return int(value)
+
+
+def slice_ms(value: str | None = None) -> float:
+    """TF_GLM_REPLY_PREFILL_SLICE_MS: a job's layer slices (default 50; 0: whole prompt chunks)."""
+
+    raw = (os.environ.get("TF_GLM_REPLY_PREFILL_SLICE_MS", "") if value is None else value).strip() or "50"
+    try:
+        ms = float(raw)
+    except ValueError:
+        ms = -1.0
+    if not math.isfinite(ms) or ms < 0:
+        raise ValueError(f"TF_GLM_REPLY_PREFILL_SLICE_MS: finite milliseconds >= 0 (0: whole chunks), not {raw!r}")
+    return ms
+
+
+MODE = mode()
+SLICE_MS = slice_ms()
+
+
+def base_of(s: Any) -> int | None:
+    """Rank 0: a reply job's request prompt length, or None for any other stream."""
+
+    got = (getattr(s, "glm", None) or {}).get("reply")
+    return int(got) if got is not None else None
+
+
+def cap_spares(kept: list, hit: Any, n: int, cap: int, cap_victim, cost=None, budget: int = 0) -> bool:
+    """Rank 0, read only: whether keeping one more state of ``n`` ids in ``hit``'s extent (``hit`` touched first, as
+    the job's admission does) drops, past the entry cap ``cap`` (and, with ``budget``, the bytes ``cost`` gives each
+    state; the new state costs what ``hit`` does), only SUPERSEDED states (shorter than another state in their extent,
+    not a shared prefix: a conversation's earlier turns), never ``hit`` or the new state. Follows
+    ``MultiDecoder._keep``'s loops with ``cap_victim``'s order."""
+
+    new = SimpleNamespace(ids=range(n), extent=hit.extent, shared=False)
+    sim = [c for c in kept if c is not hit] + [hit, new]
+
+    def spare(v) -> bool:
+        if v is new or v is hit or getattr(v, "shared", False):
+            return False
+        return any(len(c.ids) > len(v.ids) for c in sim if c.extent is v.extent)
+
+    while len(sim) > max(1, cap):
+        v = cap_victim(sim)
+        if not spare(v):
+            return False
+        sim.remove(v)
+    if budget and cost is not None:
+        each = {id(c): cost(hit if c is new else c) for c in sim}
+        while len(sim) > 1 and sum(each.values()) > budget:
+            v = cap_victim(sim)
+            if not spare(v):
+                return False
+            sim.remove(v)
+            each.pop(id(v))
+    return True
+
+
+# -- the app's side ------------------------------------------------------------------------------------------------------
+def assistant_message(result: dict[str, Any]) -> dict[str, Any]:
+    """The reply's assistant message as the server sends it (``cuda.http``'s non-streamed message; a stream's deltas add
+    up to the same)."""
+
+    message: dict[str, Any] = {"role": "assistant", "content": result.get("content") or None}
+    if result.get("reasoning"):
+        message["reasoning_content"] = result["reasoning"]
+    if result.get("calls"):
+        message["tool_calls"] = result["calls"]
+    return message
+
+
+def next_prefix(app: Any, body: dict[str, Any], prepared: Any, result: dict[str, Any]) -> list[int] | None:
+    """The ids the conversation's next request starts with: the request's messages, the reply, then what the client
+    sends next (the calls' tool results, else a user message) as an empty probe, rendered and tokenized by the app's
+    own ``_prepare`` (the template, the prefix render cache, the literal mask, the prompt ids' cache), cut where the
+    probe's opener token (``<|observation|>`` / ``<|user|>``) starts. The template writes each message from that message
+    alone (``prefix_render``), so whatever the next request's results, its ids agree up to there; what a template puts
+    after the last message (the generation prompt, a moved effort line) is past the cut. None when there is nothing
+    past the request's prompt, or the body cannot be rendered again."""
+
+    reply = assistant_message(result)
+    calls = reply.get("tool_calls") or []
+    probe = ([{"role": "tool", "tool_call_id": c.get("id"), "content": ""} for c in calls] if calls
+             else [{"role": "user", "content": ""}])
+    nxt = {k: v for k, v in body.items() if k not in _DROP}
+    nxt.update(messages=[*body["messages"], reply, *probe], temperature=0, stream=False)
+    try:
+        ids = app._prepare(nxt, True).prompt
+    except Exception:  # noqa: BLE001 - a body the server cannot render again is one it cannot predict
+        return None
+    mark = app.tok.token_to_id("<|observation|>" if calls else "<|user|>")
+    at = len(ids) - 1
+    while at > len(prepared.prompt) and ids[at] != mark:     # (the probe's opener is a few tokens from the end)
+        at -= 1
+    return list(ids[:at]) if at > len(prepared.prompt) else None
+
+
+class Job:
+    """A reply waiting for an idle serve (``submit``'s handle): ``done`` is set once it ran or was dropped; ``stats``:
+    what the scheduler answered (None: nothing was submitted, ``why`` says why)."""
+
+    def __init__(self, app: Any, body: dict[str, Any], prepared: Any, result: dict[str, Any], policy, salt) -> None:
+        self.app, self.body, self.prepared, self.result, self.policy, self.salt = app, body, prepared, result, \
+            policy, salt
+        self.done = threading.Event()
+        self.stats: dict[str, Any] | None = None
+        self.why: str | None = None
+
+
+_LOCK = threading.Lock()
+_WAITING: deque = deque()               # Jobs, oldest first
+_WAKE = threading.Event()
+_WORKER: list = []                       # the worker thread, once started
+
+
+def submit(app: Any, body: dict[str, Any], prepared: Any, result: dict[str, Any]) -> Job | None:
+    """After a reply (``GlmApp.run``): queue its next-turn prefix for the worker, which renders it and submits it as a
+    background prefill-only job once the serve is idle. None when there is nothing to do."""
+
+    engine = app.engine
+    if not MODE or getattr(engine, "scheduler", None) is None or getattr(engine, "serial_only", False):
+        return None
+    if result.get("finish") not in ("tool_calls", "stop") or body.get("draft", True) is False:
+        return None
+    if prepared.vision is not None or not isinstance(body.get("messages"), list):
+        return None
+    job = Job(app, body, prepared, result, getattr(engine.request, "policy", None),
+              getattr(engine.request, "cache_salt", None))
+    with _LOCK:
+        _WAITING.append(job)
+        while len(_WAITING) > WAITING:
+            old = _WAITING.popleft()
+            old.why = "too many waiting"
+            old.done.set()
+        if not _WORKER or not _WORKER[0].is_alive():
+            _WORKER[:] = [threading.Thread(target=_work, name="reply-prefill", daemon=True)]
+            _WORKER[0].start()
+    _WAKE.set()
+    return job
+
+
+def pending() -> int:
+    """Replies waiting for an idle serve."""
+
+    with _LOCK:
+        return len(_WAITING)
+
+
+def _work() -> None:
+    """The worker: the oldest waiting reply, once its engine's scheduler is idle, then the next."""
+
+    while True:
+        _WAKE.wait()
+        with _LOCK:
+            job = _WAITING[0] if _WAITING else None
+            if job is None:
+                _WAKE.clear()
+                continue
+        if not job.app.engine.scheduler.idle():
+            time.sleep(IDLE_POLL_S)
+            continue
+        with _LOCK:
+            if not _WAITING or _WAITING[0] is not job:
+                continue                # (dropped meanwhile)
+            _WAITING.popleft()
+        try:
+            _run(job)
+        except Exception as exc:  # noqa: BLE001 - speculative work: logged, never raised into a request
+            job.why = f"failed: {exc!r}"
+            print(f"[tensorfold] reply prefill failed: {exc!r}", flush=True)
+        finally:
+            job.done.set()
+
+
+def _run(job: Job) -> None:
+    engine = job.app.engine
+    ids = next_prefix(job.app, job.body, job.prepared, job.result)
+    if ids is None:
+        job.why = "no next prefix"
+        return
+    grid = int(getattr(engine, "grid", 0) or 0)
+    n = len(job.prepared.prompt)
+    point = len(ids) // grid * grid if grid else len(ids)
+    if point <= (n // grid * grid if grid else n):
+        job.why = "the reply ends in the prompt's grid step"
+        return
+    engine.request.policy, engine.request.stop_eos, engine.request.cache_salt = job.policy, True, job.salt
+    job.stats = engine.generate(ids[:point], 1, None, lambda new: False, background=True, reply=n)
