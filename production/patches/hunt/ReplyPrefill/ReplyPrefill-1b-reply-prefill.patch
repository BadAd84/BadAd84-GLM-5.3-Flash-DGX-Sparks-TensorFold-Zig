+    # -- OTS (reply_prefill): reply jobs run only on an idle serve and end the moment a real request is pending --------
+    def idle(self) -> bool:
+        """Any thread (``reply_prefill``'s worker): nothing is live, held, read or queued."""
+
+        return (not self.decoder.live() and self.held is None and not self.loading and not self.ready
+                and not self.prefix and self.waiting.empty())
+
+    def _real_pending(self) -> bool:
+        """Whether any request other than a reply job waits: held, read, waiting for a prefix, or queued."""
+
+        if self.held is not None or self.ready or self.prefix or any(it is not None for _, it in self.loading):
+            return True
+        with self.waiting.mutex:
+            return any(reply_prefill.base_of(entry[2][0]) is None for entry in self.waiting.queue)
+
+    def _end_jobs(self, why: str) -> None:
+        """Every live reply job ends now, unfinished, on both ranks (FINISH, cancelled), answered with ``why``: a prompt
+        slice part way is given up (its rows past the kept state are overwritten by whoever resumes there)."""
+
+        for lane in list(self.decoder.lanes.values()):
+            s = lane.s
+            if reply_prefill.base_of(s) is None or s.done:
+                continue
+            s.done = True
+            s.started = s.finished = time.perf_counter()
+            self.decoder.replies["cancelled"] += 1
+            self.decoder.finish([s])
