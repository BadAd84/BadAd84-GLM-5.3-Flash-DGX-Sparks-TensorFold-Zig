+    trip would make it (``json_copy``: ~30 ms less at 650k tokens, where ``json.dumps`` and ``json.loads`` each held
+    the GIL 13-20 ms); one that holds anything else, and any other handler, gets the JSON text as before."""
 
-    data = json.dumps(body).encode()
+    parsed = _NOT_JSON
+    if getattr(type(handler), "takes_parsed_body", False):
+        try:
+            parsed = json_copy(body)
+        except RecursionError:          # nested deeper than a copy goes: the JSON text decides, as before
+            parsed = _NOT_JSON
+        if parsed is None:              # do_POST reads None as "no parsed body": a null body goes as its text
+            parsed = _NOT_JSON
+    data = json.dumps(body).encode() if parsed is _NOT_JSON else b""
     inner = type(handler).__new__(type(handler))
     inner.__dict__.update(handler.__dict__)
     inner.path, inner.rfile, inner.wfile, inner._headers_buffer = "/v1/chat/completions", io.BytesIO(data), wire, []
+    inner.parsed_body = None if parsed is _NOT_JSON else parsed
