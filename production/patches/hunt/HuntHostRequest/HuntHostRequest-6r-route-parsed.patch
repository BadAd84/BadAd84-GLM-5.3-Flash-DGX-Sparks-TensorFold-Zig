         pass
 
 
+_SCALARS = (str, int, float, bool, type(None))
+
+
+def json_copy(value: Any) -> Any:
+    """(OTS) ``json.loads(json.dumps(value))`` without the text: fresh dicts and lists over the same (immutable) str,
+    int, float, bool and None leaves, in the same order; ``_NOT_JSON`` when ``value`` holds anything else (a tuple, a
+    non-str key, a subclass), whose round trip would change it."""
+
+    t = type(value)
+    if t is dict:
+        out = {}
+        for k, v in value.items():
+            if type(k) is not str:
+                return _NOT_JSON
+            v = json_copy(v) if type(v) in (dict, list) else (v if type(v) in _SCALARS else _NOT_JSON)
+            if v is _NOT_JSON:
+                return _NOT_JSON
+            out[k] = v
+        return out
+    if t is list:
+        out = []
+        for v in value:
+            v = json_copy(v) if type(v) in (dict, list) else (v if type(v) in _SCALARS else _NOT_JSON)
+            if v is _NOT_JSON:
+                return _NOT_JSON
+            out.append(v)
+        return out
+    return value if t in _SCALARS else _NOT_JSON
+
+
+_NOT_JSON = object()
+
+
