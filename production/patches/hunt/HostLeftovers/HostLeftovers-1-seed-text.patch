+# (OTS) the decimal text of token ids without an int object or a str a token: each id's row of a table is its digits
+# behind a comma, right-aligned in 8 bytes with NULs before (",154855" at most), so the text of many ids is one gather
+# of rows and one deletion of the NULs. ``",".join(str(int(t)) ...)`` of a 650k-token prompt took ~60-85 ms with the
+# GIL held (seed_for, on the request's path before its ADMIT, which carries the seed to every rank); this ~10.
+_TEXT_IDS = 1 << 18             # ids the table covers (GLM-5.3's are below 154,880); others go the join's way
+_TEXT: tuple[np.ndarray, np.ndarray] | None = None     # (rows as uint64, each row's bytes), made once (2.25 MiB)
+
+
+def text_table() -> tuple[np.ndarray, np.ndarray]:
+    """The table, made at its first use (~27 ms; ``PromptIds.make`` makes it at load, not at the first request)."""
+
+    global _TEXT
+    table = _TEXT
+    if table is None:
+        x = np.arange(_TEXT_IDS, dtype=np.int64)
+        digits = np.ones(_TEXT_IDS, dtype=np.int64)
+        for p in range(1, len(str(_TEXT_IDS - 1))):     # its digits: 1 plus the powers of ten it reaches
+            digits += x >= 10 ** p
+        rows = np.zeros((_TEXT_IDS, 8), dtype=np.uint8)
+        for col in range(7, 0, -1):             # column 7 holds the units, column 7 - d + 1 the leading digit
+            rows[:, col] = np.where(col > 7 - digits, x // 10 ** (7 - col) % 10 + 48, 0)
+        rows[np.arange(_TEXT_IDS), 7 - digits] = 44         # the comma before them
+        _TEXT = table = (rows.view(np.uint64).ravel(), (digits + 1).astype(np.uint8))
+    return table
+
+
+def comma_text(ids: np.ndarray) -> bytes | None:
+    """``ids`` (non-negative integers) as ``","`` and its decimal before each (``",12,7,301"``), or None when one is
+    outside the table (the caller joins them itself)."""
+
+    if ids.size == 0:
+        return b""
+    if int(ids.min()) < 0 or int(ids.max()) >= _TEXT_IDS:
+        return None
+    return text_table()[0][ids].tobytes().translate(None, b"\0")
+
+
+def comma_lengths(ids: np.ndarray) -> np.ndarray:
+    """Each id's bytes in ``comma_text(ids)`` (its comma and digits), for ids ``comma_text`` took."""
+
+    return text_table()[1][ids]
+
+
+def ids_text(ids: Any) -> Any:
+    """``",".join(str(int(t)) for t in ids).encode()``, the same bytes (bytes-like: ``seed_for``'s and ``token_sha``'s
+    text). A list or tuple whose items are not all ints (``int64``), any other iterable, or an id outside the table:
+    joined as before."""
+
+    view = None
+    if isinstance(ids, np.ndarray):
+        view = ids if ids.ndim == 1 and ids.dtype.kind in "iu" else None
+    elif type(ids) in (list, tuple, array):
+        try:
+            view = np.frombuffer(array("q", ids), dtype=np.int64)
+        except (TypeError, OverflowError):
+            view = None
+    text = comma_text(view) if view is not None else None
+    if text is None:
+        return ",".join(str(int(t)) for t in ids).encode()
+    return memoryview(text)[1:]
 
 
