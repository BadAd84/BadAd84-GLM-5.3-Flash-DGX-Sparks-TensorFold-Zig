 from typing import Any
 
 from tensorfold.server.errors import RequestError
 
+try:                                    # (OTS) optional: without it every body goes through json as before
+    import orjson as _orjson
+except ImportError:
+    _orjson = None
+
 LIMIT = 32 * 1024**2
 _METADATA_LIMIT = 65536
+_INT_EDGE = float(1 << 63)              # orjson gives an integer past 64 bits as a float of at least this size
+
+
+def parse_body(data: bytes) -> Any:
+    """``json.loads(data)``: the same object, or the same exception. (OTS) Through orjson when it is importable and
+    takes ``data`` (~2x faster, one GIL hold: json.loads of a 2.6 MB agent body was 8-24 ms, the longest single hold
+    on the request path), else through json. orjson refuses what json reads otherwise (NaN, Infinity, numbers past a
+    double, lone surrogates, a BOM, other encodings, nesting past 1,024) and errors alike: json then decides, so the
+    value or the error is json's. The one input orjson reads differently, an integer outside -2^63 .. 2^64-1 (a float
+    for json's int), leaves a float of magnitude 2^63 or more in the value: any such float sends it to json too."""
+
+    if _orjson is not None:
+        try:
+            value = _orjson.loads(data)
+        except Exception:  # noqa: BLE001 - json reads it, or raises what it always raised
+            return json.loads(data)
+        if _plain(value):
+            return value
+    return json.loads(data)
+
+
+def _plain(value: Any) -> bool:
+    """No float of magnitude 2^63 or more anywhere in ``value`` (what an out-of-range integer becomes in orjson)."""
+
+    stack = [value]
+    pop, extend = stack.pop, stack.extend
+    while stack:
+        v = pop()
+        t = type(v)
+        if t is dict:
+            extend(v.values())
+        elif t is list:
+            extend(v)
+        elif t is float and not -_INT_EDGE < v < _INT_EDGE:
+            return False
+    return True
 
 
