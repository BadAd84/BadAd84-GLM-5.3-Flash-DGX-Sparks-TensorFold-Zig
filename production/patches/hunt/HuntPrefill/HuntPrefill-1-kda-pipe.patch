+def pipe_on() -> bool:
+    """TF_GLM_KDA_PIPE (default on where the GPU has thread-block clusters, compute capability 9.0+): each head's
+    prompt chunk on a producer / consumer pair of CTAs (kda_chunk.cu's chunk_kernel<true>: the state-free steps of
+    sub-chunk c + 1 beside the state's steps of c), the same bits as one CTA a head; 0: one CTA a head. The kernel
+    takes the pair only when the GPU holds a cluster for every head at once (``clusters``), else one CTA a head."""
+    import os
+
+    if os.environ.get("TF_GLM_KDA_PIPE", "1") == "0":
+        return False
+    return torch.cuda.is_available() and torch.cuda.get_device_capability() >= (9, 0)
+
+
+def clusters() -> int:
+    """The producer / consumer clusters this GPU holds at once (0 without clusters)."""
+    return int(_ext().clusters())
+
+
+# chunks of fewer rows take one CTA a head under the default switch: the pipe's first sub-chunk runs on the producer
+# alone and its last on the consumer alone, which a 2-sub-chunk chunk does not win back (RTX 5070, 16 heads, min of
+# 15: 64 rows 0.049 ms one CTA a head, 0.053 the pair; 2,390 rows 1.551 -> 1.018 ms, 4,096 rows 2.622 -> 1.695; a
+# sub-chunk 20.5 -> 12.9 us, so from 4 sub-chunks on the pair wins). Speed only.
