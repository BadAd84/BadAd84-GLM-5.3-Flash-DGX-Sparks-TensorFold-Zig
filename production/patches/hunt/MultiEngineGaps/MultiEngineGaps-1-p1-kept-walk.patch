+def kept_array(snap):
+    """--parallel 1: a kept snapshot's ids as an int64 array (``ids_array``), made once for the ids list it holds: id
+    lists are replaced, never changed in place, so ``_array_of`` (the list it was made from; ``spill.encode`` leaves
+    ``_`` fields out) tells a stale one."""
+
+    arr = getattr(snap, "ids_array", None)
+    if arr is None or getattr(snap, "_array_of", None) is not snap.ids:
+        import numpy as np
+
+        arr = snap.ids_array = np.asarray(snap.ids, dtype=np.int64)
+        snap._array_of = snap.ids
+    return arr
+
+
+class IdsOf:
+    """--parallel 1: ``seq[:len(snap.ids)] == snap.ids`` for one id list ``seq`` against many kept snapshots, the
+    list's int64 array (``arr``: one known to hold exactly its ids) made once and only if a snapshot passes the length
+    and last-id checks (``kept_array`` on the other side): a request's walk of the kept states no longer copies and
+    compares a list slice of every kept turn of its conversation (~5 ms each at 600k ids, 32 of them a turn)."""
+
+    def __init__(self, seq, arr=None) -> None:
+        self.seq, self.arr = seq, arr
+
+    def starts(self, snap) -> bool:
+        n, ids = len(snap.ids), snap.ids
+        if n > len(self.seq):
+            return False
+        if not n:
+            return True
+        if self.seq[n - 1] != ids[n - 1]:
+            return False
+        import numpy as np
+
+        if self.arr is None:
+            self.arr = np.asarray(self.seq, dtype=np.int64)
+        return bool(np.array_equal(self.arr[:n], kept_array(snap)))
+
