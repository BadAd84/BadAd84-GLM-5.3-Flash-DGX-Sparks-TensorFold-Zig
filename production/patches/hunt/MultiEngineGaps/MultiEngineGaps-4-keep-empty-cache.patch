+def keep_empty_cache(value: str | None = None) -> str:
+    """TF_GLM_KEEP_EMPTY_CACHE (--parallel 1): when a kept state's drop past TF_GLM_CACHE_ENTRIES / the bytes cap hands
+    torch's cached blocks back to the driver (``_remember``). ``always`` (default, as before): after every such drop,
+    which once the entry cap is reached is every turn, and the next prompt chunk then allocates its temporaries again
+    (RTX 5070: 67 ms to empty 40 x 64 MiB, 5.4 ms against 0.07 ms to allocate them again). ``rows``: only when a dropped
+    state held saved rows (another conversation's copy, the memory the empty is for); a drop of a state whose rows were
+    the live caches' frees fixed-size tensors the next keep reuses. Memory policy only: replies are the same bits."""
+
+    raw = (os.environ.get("TF_GLM_KEEP_EMPTY_CACHE", "") if value is None else value).strip() or "always"
+    if raw not in ("always", "rows"):
+        raise ValueError(f"TF_GLM_KEEP_EMPTY_CACHE: always or rows, not {raw!r}")
+    return raw
+
+
+KEEP_EMPTY_CACHE = keep_empty_cache()
