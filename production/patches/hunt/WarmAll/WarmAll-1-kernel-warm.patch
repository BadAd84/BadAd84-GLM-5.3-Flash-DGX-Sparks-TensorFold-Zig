+        glue.hc_pre(b.x[:R], h.fn, h.base, h.scale, first.in_norm, b.normed[:R], b.xs[:R], b.post[:R], b.comb[:R],
+                    b.hcpart[:R], c.eps, c.hc_eps, c.hc_iters, prompt=True)
+        n += 1
+    if getattr(b, "kproj", None) is not None and getattr(st, "conv", None) is not None:
+        conv = torch.empty((1,) + tuple(st.conv.shape[1:]), dtype=st.conv.dtype, device=dev)
+        for R in rows:                                     # KDA's conv window shift (a piece's rows from row lo)
+            for lo in (0, 1):
+                if lo + R <= b.kproj.shape[1]:
+                    forward._shift_conv(conv, b.kproj[:, lo:lo + R], R)
+                    n += 1
+    dsa = next((l for l in w.layers if l.dsa is not None), None)
+    if dsa is None or getattr(b, "lat_s", None) is None or not st.kc:
+        return n
+    a, s = dsa.dsa, b.lat_s
+    di = 0
+    lc = st.kc[di]
+    scale = c.qk_dim ** -0.5
+    nch = s.nch
+    lat = torch.empty((max(big, nch * latent.CHUNK), lc.shape[1]), dtype=lc.dtype, device=dev)
+    tok = torch.zeros((big, sparse.TOKENS), dtype=torch.int32, device=dev)
+    cnt = torch.zeros((big,), dtype=torch.int32, device=dev)
+    for R in rows:
+        for pos in poss:
+            latent.latent_write(b.lat[:R], lat, pos)
+            n += 1
+        latent.absorb_q(b.q[:R], a.absorb, s.qa[:R], prompt=latent.PROMPT_MMA)
+        latent.expand_v(s.ol[:R], a.absorb, b.vn[:R], prompt=latent.PROMPT_MMA)
+        latent.sparse_onepass(s.qa[:R], lat, tok[:R], cnt[:R], s.ol[:R], scale)
+        n += 3
+    heads = sorted({latent.head_block(R) for R in rows})
+    for R in rows:                                         # the dense pass: each block's rows, head block, position
+        if R > s.part_rows:
+            continue
+        for hb in heads:
+            for pos in (aligned, misaligned):
+                latent.attention(s.qa[:R], lat, pos, s, scale=scale, nch=1, out=s.ol[:R], hb=hb)
+                n += 1
+    for k in range(2, nch + 1):                            # ... and its merge's chunk counts
+        for R in _distinct(rows, ()):
+            if R <= s.part_rows:
+                latent.attention(s.qa[:R], lat, aligned, s, scale=scale, nch=k, out=s.ol[:R], hb=latent.HB)
+                n += 1
+    index = st.index[di] if getattr(st, "index", None) else None
+    if index is None or index[2] is None:
+        return n
+    ik, ig, pk = index
+    ix = a.index
+    if ik is not None and ix is not None:                  # the indexer's key ring and pooled keys
+        iks, igs = torch.empty_like(ik), torch.empty_like(ig)
