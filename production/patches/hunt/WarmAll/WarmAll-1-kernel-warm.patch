+def int_class(v: int) -> int:
+    """Triton's specialisation of an int kernel argument (not do_not_specialize): 1 for the value 1, 16 for a
+    multiple of 16, else 0. Each class is its own kernel variant (loaded at its first launch); the one owner of
+    this rule for the start-up warms (``class_rows``)."""
+
+    return 1 if v == 1 else 16 if v % 16 == 0 else 0
+
+
+def class_rows(rules, most: int) -> list[int]:
+    """The smallest row count of every distinct (``int_class``, rule(rows) for each rule) in 1 .. most: one count a
+    variant for kernels whose specialisation depends on a row count only through those (WarmAll; the rules are
+    the launches' own functions, e.g. ``router_block``, ``latent.head_block``)."""
+
+    seen, rows = set(), []
+    for m in range(1, int(most) + 1):
+        sig = (int_class(m),) + tuple(rule(m) for rule in rules)
+        if sig not in seen:
+            seen.add(sig)
+            rows.append(m)
+    return rows
+
