+"""The start-up kernel warm (WarmAll): every Triton kernel variant a request's eager launches can need is loaded at
+start, on every rank, so no request pays one inside its first token.
+
+A Triton kernel is one compiled variant per specialisation: every constexpr (row blocks chosen by row count, tiles
+chosen by score count, the dense merge's chunk count), each int argument's class (``glue.int_class``: 1, a multiple
+of 16, other) and each pointer's 16-byte alignment (a stream slot's position ``Slots.pos_dev[k]`` is 4k bytes into its
+table; a dense pass block's ``pos_dev + starts`` element i is 4i; a piece's KDA projection rows from row lo). A variant
+is loaded the first time it is launched in the process (a Triton cache read, or a compile when the cache misses, and
+a module load: ~2-4 ms each in a short request's first token on the workstation), and the request that launches it
+first waits for that on every rank. The boot's own launches (calibration's 64-row chunk, the CUDA graph captures of
+the decode windows, the router warm) load the variants they use; the rest were met by requests (WarmAll's probe: 35
+after the boot at --parallel 1, 56 at 4): a 1- or 2-row prompt (hc, absorb, expand, conv shift, the dense pass and
+merge), a prompt of 65-127 rows, each 512-token chunk count of the dense merge, the first sparse prompt (the
+selection, its tiers by score count, the one-pass attention), the first warm turn of under 8 rows at each score count
+(``select_tokens``' decode selection: its programs a row and split chunks), and under --parallel a stream slot but 0
+and 4 (the misaligned position) and a multi-prompt chunk's pieces.
+
+``warm_kernels`` launches each eager request-path kernel family through its own function (the call the request path
+makes) once per specialisation the serve can reach:
+  * rows: ``glue.class_rows`` of the launches' row rules (``row_rules``) up to the prompt buffers' rows;
+  * score counts: every pool count a stream's selection can take (``score_counts``), one per distinct output of the
+    score-count rules (``prompt_np_rules``, ``np_rules``);
+  * the dense merge's chunk counts 1 .. the scratch's; head blocks 16 and 32; the position pointer aligned, and
+    misaligned where a request can pass it so (always for the dense pass; under --parallel for every family).
+Every write goes to scratch (the prompt buffers' rows, which every prompt chunk writes before reading, or tensors made
+here and dropped); the weights, caches, kept states, pool, positions, rings, conv windows and drafter are not
+touched; no collective. The device positions read are this module's own zeros, so each launch reads at most its own
+few rows. TF_GLM_KERNEL_WARM=0: not run (the old start)."""
+
+import os
+
+import torch
+
+from . import forward, glue, latent, pool, sparse
+
+
+def row_rules():
+    """The row rules of the warmed launches (functions of a launch's row count that pick a constexpr or a path;
+    read at the call, so they are the owners' current ones), with glue.int_class: two counts with the same outputs
+    launch the same variants of every family below. ``latent.head_block``: the dense pass's head blocks (each
+    block's rows run with its chunk's); ``latent.row_block``: a 4-bit checkpoint's absorb; ``sparse.prompt_block``:
+    the prompt selection's step; PROMPT_ROWS: the decode selection under it (``select_tokens``)."""
+
+    return (latent.head_block, latent.row_block, sparse.prompt_block, lambda R: R >= sparse.PROMPT_ROWS)
+
+
+def np_rules(R: int):
+    """The score-count rules of the decode selection over R rows (``select_tokens`` under PROMPT_ROWS: functions
+    of the pool count NP that pick a constexpr or a path), with glue.int_class."""
+
+    return (sparse.row_score_programs, lambda NP: sparse.select_rows_launch(R, NP),
+            lambda NP: R < sparse.SPLIT_ROWS and NP >= sparse.SPLIT_FROM, sparse.split_chunk, sparse.split_chunks)
+
+
+def prompt_np_rules():
+    """The score-count rules of a prompt block's selection (``sparse.select_prompt_rows``), with glue.int_class."""
+
+    return (sparse.prompt_tile,)
+
+
+def enabled(env=None) -> bool:
+    """TF_GLM_KERNEL_WARM (default 1): ``warm_kernels`` runs at start; 0: the start without it."""
+
+    env = os.environ if env is None else env
+    return env.get("TF_GLM_KERNEL_WARM", "1").strip() != "0"
+
+
+def score_counts(np_max: int, streams: int) -> list[int]:
+    """Every pool count a stream's selection scores, up to ``np_max`` (the engine's pooled keys): ``sparse.pool_count``
+    gives a multiple of 1,024 (``sparse.pool_bucket``'s powers of two from 1,024 are among them), both capped at the
+    stream's pools: at --parallel 1 the one stream's own (``np_max``); under --parallel each stream's extent (a
+    multiple of ``pool.ALIGN`` tokens), so every such multiple from 1,024 pools is one."""
+
+    out = set(range(1024, np_max + 1, 1024))
+    if streams > 1:
+        ext = pool.ALIGN // sparse.POOL
+        out.update(n for n in range(ext, np_max + 1, ext) if n >= 1024)
+    else:
+        out.add(np_max)
+    return sorted(n for n in out if n >= 1024)
+
+
+def _position(NP: int, R: int) -> int:
+    """A host position for R rows whose visible pools are NP: ``pool_count`` and ``pool_bucket`` with NP as the
+    stream's pools both give NP."""
+
+    return sparse.POOL * NP - R - sparse.POOL
+
+
+def _distinct(values, rules) -> list[int]:
+    """The first of ``values`` with each distinct (int_class, rule outputs)."""
+
+    seen, out = set(), []
+    for v in values:
+        sig = (glue.int_class(v),) + tuple(rule(v) for rule in rules)
+        if sig not in seen:
+            seen.add(sig)
+            out.append(v)
+    return out
+
+
+@torch.no_grad()
+def warm_kernels(engine) -> int:
+    """At start, every rank: the eager request-path kernel variants (the module docstring). ``engine``: the
+    ``GlmEngine`` (its ``decode.Engine`` ``e``: weights, prompt buffers, the home stream's caches and slots).
+    Returns the launches made (0 when off)."""
