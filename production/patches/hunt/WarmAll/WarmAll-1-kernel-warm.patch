+        for R in rows:
+            for pos in poss:
+                sparse.index_update(b.ikr[:R, :c.index_dim], b.igr[:R], ix.ln_w, ix.ln_b, ix.ape, iks, igs, pks, pos)
+                n += 1
+    np_max = pk.shape[0] - 2                               # the home stream's pooled keys (under --parallel: the pool's)
+    if streams > 1:                                        # ... a stream's extent at most its context's
+        np_max = min(np_max, pool.align_up(int(engine.limit)) // sparse.POOL)
+    nps = score_counts(np_max, streams)
+    qi, wts = b.qi, b.ikr[:, c.index_dim:]
+    buf = torch.empty((big * nps[-1],), dtype=torch.float32, device=dev) if nps else None
+    cand = torch.empty((big * 2 * max(t[1] for t in sparse.PROMPT_TILES),), dtype=torch.int32, device=dev)
