+    dev = b.x.device
+    streams = int(e.slots.pos_dev.shape[0])
+    rows = glue.class_rows(row_rules(), b.rows)
+    zeros = torch.zeros((8,), dtype=torch.int32, device=dev)
+    aligned, misaligned = zeros[0:1], zeros[1:2]          # a stream slot's / a dense block's position views
+    poss = (aligned, misaligned) if streams > 1 else (aligned,)
+    big = max(rows)
