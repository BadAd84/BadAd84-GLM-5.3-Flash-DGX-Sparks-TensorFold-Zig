+// The host side of the prompt exchange over the NICs (TF_GLM_PRX, tensorfold/cuda/prx.py): an all-to-all of row
+// blocks between ranks cabled to each other directly (a triangle of Sparks, two rails a pair; any world of 2-4 ranks
+// in which every pair has a direct path), moved by the NICs alone. Apache License 2.0. The pinned region, the proxy
+// thread, each peer's payload striped over the pair's rails with a flag after each stripe follow roce_proxy.c (b12x's
+// "RoCEnante", by Jason Cook) and MiaAI-Lab recipe PR #205 (0126/0127, its ring of four: relays round the ring); this
+// file is the full-mesh form of that exchange, no code copied beyond the verbs calls' shape.
+//
+// One pinned host region a rank (the same layout on every rank of a world), per call slot s (call c uses slot
+// c % slots):
+//   send[s][world - 1][M]  staged by the local GPU's copy engines: the payload for each peer (link order: the other
+//                          ranks ascending); an all-gather's (``shared``) one payload sits in send[s][0]
+//   recv[s][world][M]      by the sending rank (absolute): written by the peers' NICs; this rank's own block unused
+//   flags                  a 4-byte word on its own line after every stripe from every source rank (the NIC writes
+//                          it after the stripe's data, on the same queue pair)
+//   ctrl                   ready[s][peer] and consumed[s] (GPU -> proxy, stream memory operations), send_done[s]
+//                          (proxy -> GPU), credit[rank] (a peer's freed calls, written by its NIC), the error word,
+//                          beat[rank] and abort (written by the peers' NICs)
+// Two memory registrations a HCA: the data blocks (relaxed ordering, TF_GLM_PRX_RO=0: without) and the flags and
+// ctrl (never relaxed), so a flag write, ordered after its stripe on the queue pair, cannot pass the stripe's data
+// on the way to memory (PCIe lets a relaxed-ordered write pass, never a write that is not).
+// A call c with M_c bytes for each peer: to each peer its block (recv[s][this rank] there), each stripe followed by
+// its flag. A rank writes call c into a peer's slot only once that peer has freed call c - slots (its GPU read it
+// out): ``credit``. Every wait is on an earlier call, so the exchange cannot deadlock while every rank posts the same
+// calls in the same order.
+//
+// Failures: a failed completion, no progress for TF_GLM_PRX_TIMEOUT_S while calls are outstanding, a peer whose
+// heartbeat (a counter its proxy writes here every PRX_BEAT_NS) stands still for TF_GLM_PRX_PEER_S, a peer's abort
+// or another channel's failure. The proxy then writes its abort to every peer, moves its queue pairs to the error
+// state and keeps every word the GPU can wait on (flags, send_done) at a value past all its waits until
+// prx_destroy; prx_post refuses calls, so the host raises. After TF_GLM_PRX_EXIT_S the process exits (code 70: the
+// ranks cannot agree any more; a supervisor restarts them).
+// Idle: caught up with every posted call (nothing outstanding), nothing can happen before the next prx_post, so after
+// TF_GLM_PRX_IDLE_MS the proxy sleeps on a futex that prx_post and prx_destroy wake (every second: a heartbeat).
+//
+// This file is compiled by prx.py at first use with the host C compiler and libibverbs; plain C, no CUDA.
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <infiniband/verbs.h>
+#include <linux/futex.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+#define PRX_ABI 1
+#define PRX_MAX_WORLD 4
+#define PRX_MAX_PEERS (PRX_MAX_WORLD - 1)
+#define PRX_MAX_HCAS 4
+#define PRX_MAX_STRIPES 4
+#define PRX_MAX_SLOTS 8
+#define PRX_PORT 1
+#define PRX_DEPTH 256
+#define PRX_QCAP 8192
+#define PRX_LINE 64
+#define KIND_SEND 1
+#define KIND_CREDIT 2
+#define KIND_BEAT 3
+#define KIND_ABORT 4
+#define NS 1000000000ull
+#define PRX_BEAT_NS (NS / 2)
+#define PRX_NAP_NS (NS / 1000)                // between re-releases after a failure
+// a value past every wait the GPU can have pending: those are within PRX_QCAP + slots calls of ``posted``, and
+// CU_STREAM_WAIT_VALUE_GEQ compares cyclically ((int32_t)(*addr - value) >= 0)
+#define PRX_PAST (1u << 30)
+
+// ctrl words, one line each, at the region's start
+#define CTRL_READY 0                                       // [slots][peers]: the payload for each peer staged
+#define CTRL_CONSUMED (PRX_MAX_SLOTS * PRX_MAX_PEERS)      // [slots]: the GPU read the call's receive blocks
+#define CTRL_SEND_DONE (CTRL_CONSUMED + PRX_MAX_SLOTS)     // [slots]: the NICs read the call's send blocks
+#define CTRL_CREDIT (CTRL_SEND_DONE + PRX_MAX_SLOTS)       // [world]: rank r's freed calls, written by rank r
+#define CTRL_ERROR (CTRL_CREDIT + PRX_MAX_WORLD)
+#define CTRL_BEAT (CTRL_ERROR + 1)                         // [world]: rank r's heartbeats, written by rank r
+#define CTRL_ABORT (CTRL_BEAT + PRX_MAX_WORLD)             // a peer's abort: the rank where it started, plus one
+#define CTRL_LINES (CTRL_ABORT + 1)
+
+typedef struct {
+    uint64_t region_addr;
+    uint32_t world, rank, slots, n_hca;
+    uint64_t M;
+    uint32_t rkey_sync[PRX_MAX_HCAS], rkey_data[PRX_MAX_HCAS];
+    uint32_t mtu[PRX_MAX_HCAS];
+    uint8_t gid[PRX_MAX_HCAS][16];
+    uint32_t qpn[PRX_MAX_WORLD][PRX_MAX_HCAS];   // this rank's QP toward rank r on its HCA h (0: none)
+} prx_blob_t;
+
+typedef struct {
+    struct ibv_context *ctx;
+    struct ibv_pd *pd;
+    struct ibv_mr *sync, *data;           // [0, data_off) and [data_off, total)
+    struct ibv_cq *cq;
+    union ibv_gid gid;
+    enum ibv_mtu mtu;
+} prx_hca_t;
+
+typedef struct {
+    int peer;                             // the rank at the other end
+    int n;                                // stripes
+    int hca[PRX_MAX_STRIPES];             // local HCA of each
+    int remote[PRX_MAX_STRIPES];          // the peer's HCA it reaches
+    struct ibv_qp *qp[PRX_MAX_STRIPES];
+    uint32_t outstanding[PRX_MAX_STRIPES];
+    uint32_t rkey_sync[PRX_MAX_STRIPES], rkey_data[PRX_MAX_STRIPES];
+    uint64_t peer_addr;
+} prx_link_t;
+
+typedef struct {
+    uint32_t bytes;                       // M_c: bytes for each peer
+    uint32_t shared;                      // one payload (send[s][0]) for every peer: an all-gather
+} prx_desc_t;
+
+typedef struct {
+    int world, rank, slots, n_hca, n_link, gid_index[PRX_MAX_HCAS], tclass;
+    prx_hca_t hca[PRX_MAX_HCAS];
+    prx_link_t link[PRX_MAX_PEERS];
+    uint8_t *region;
+    uint64_t region_bytes, M, slot_bytes, data_off, flag_off;
+    prx_desc_t desc[PRX_QCAP];
+    _Atomic uint64_t posted;              // calls the host posted (prx_post)
+    uint64_t next_send;
+    int send_mask;                        // the links call next_send went out on so far
+    uint32_t send_pending[PRX_QCAP];      // a call's stripes not completed yet
+    uint64_t send_done, freed, reported;
+    uint32_t inflight;                    // signaled exchange writes (sends, credits) not completed yet
+    pthread_t thread;
+    atomic_int running, failed;
+    _Atomic uint32_t wake;                // the futex word an idle proxy sleeps on
+    atomic_int sleeping;
+    uint64_t timeout_ns, peer_ns, exit_ns, idle_ns, fault_call;
+    int fault_peer;                       // TF_GLM_PRX_FAULT's target rank (-1: every peer)
+    uint64_t progress_ns, longest_ns, beat_ns, seen_ns[PRX_MAX_PEERS];
+    uint32_t beats, seen[PRX_MAX_PEERS], origin;   // origin: as CTRL_ABORT
+    int beat_out[PRX_MAX_PEERS];          // link L's last heartbeat not completed yet
+    uint64_t stat[3];                     // bytes posted, completions, sleeps
+    char err[512];
+} prx_ctx_t;
+
+static uint64_t align_up(uint64_t x, uint64_t a) { return (x + a - 1) / a * a; }
+
+int prx_abi_version(void) { return PRX_ABI; }
+
+// out = {flag_off, data_off, slot_bytes, total, line, recv block 0 within a slot}
+int prx_layout(int world, int slots, uint64_t M, uint64_t *out) {
+    if (world < 2 || world > PRX_MAX_WORLD || slots < 2 || slots > PRX_MAX_SLOTS || M == 0 || M % 4096 ||
+        M > ((uint64_t)1 << 31))
+        return -1;
+    uint64_t ctrl = align_up((uint64_t)CTRL_LINES * PRX_LINE, 4096);
+    uint64_t flags = align_up((uint64_t)slots * PRX_MAX_WORLD * PRX_MAX_STRIPES * PRX_LINE, 4096);
+    uint64_t slot_bytes = (uint64_t)(2 * world - 1) * M;
+    out[0] = ctrl;
+    out[1] = ctrl + flags;
+    out[2] = slot_bytes;
+    out[3] = ctrl + flags + (uint64_t)slots * slot_bytes;
+    out[4] = PRX_LINE;
+    out[5] = (uint64_t)(world - 1) * M;
+    return 0;
+}
+
+static volatile uint32_t *ctrl_word(prx_ctx_t *c, int line) {
+    return (volatile uint32_t *)(c->region + (uint64_t)line * PRX_LINE);
+}
+
+static uint64_t flag_off(prx_ctx_t *c, int slot, int src, int stripe) {
+    return c->flag_off + (((uint64_t)slot * PRX_MAX_WORLD + src) * PRX_MAX_STRIPES + stripe) * PRX_LINE;
+}
+
+// offsets of slot s: send[d] (d: link), recv[source rank]
+static uint64_t send_off(prx_ctx_t *c, int s, int d) {
+    return c->data_off + (uint64_t)s * c->slot_bytes + (uint64_t)d * c->M;
+}
+static uint64_t recv_off(prx_ctx_t *c, int s, int k) {
+    return c->data_off + (uint64_t)s * c->slot_bytes + (uint64_t)(c->world - 1 + k) * c->M;
+}
+
+static atomic_int any_failed;            // a channel of this process failed: the others stop too
+static _Atomic uint32_t any_origin;      // that failure's origin (CTRL_ABORT's value)
+
+// the first failure's message; written before ``failed``, which the host reads first
+static void fail(prx_ctx_t *c, const char *what, int e) {
+    if (atomic_load(&c->failed)) return;
+    snprintf(c->err, sizeof(c->err), "%s%s%s", what, e ? ": " : "", e ? strerror(e) : "");
+    if (!c->origin) c->origin = (uint32_t)c->rank + 1;
+    *ctrl_word(c, CTRL_ERROR) = 1;
+    atomic_store(&c->failed, 1);
+}
+
+static uint64_t now_ns(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * NS + (uint64_t)t.tv_nsec;
+}
+
+static long futex(_Atomic uint32_t *word, int op, uint32_t v, const struct timespec *timeout) {
+    return syscall(SYS_futex, (uint32_t *)word, op, v, timeout, NULL, 0);
+}
+
+static void wake(prx_ctx_t *c) {
+    atomic_fetch_add(&c->wake, 1);
+    futex(&c->wake, FUTEX_WAKE_PRIVATE, 1, NULL);
+}
+
+// an env setting in seconds (scale 1) or ms (scale 1000), 0: off; -1 (setup fails) when not a number >= 0
+static int64_t env_ns(const char *name, double fallback, double scale) {
+    const char *v = getenv(name);
+    double x = fallback;
+    if (v && *v) {
+        char *end;
+        x = strtod(v, &end);
+        if (end == v || *end || !(x >= 0 && x <= 86400 * scale)) return -1;
+    }
+    return (int64_t)(x * (double)NS / scale);
+}
+
+uint64_t prx_blob_bytes(void) { return sizeof(prx_blob_t); }
+
+static int open_hca(prx_ctx_t *c, int h, const char *name) {
+    int num = 0;
+    struct ibv_device **list = ibv_get_device_list(&num);
+    if (!list) { fail(c, "ibv_get_device_list", errno); return -1; }
+    struct ibv_device *dev = NULL;
+    for (int i = 0; i < num; i++)
+        if (strcmp(ibv_get_device_name(list[i]), name) == 0) dev = list[i];
+    if (!dev) {
+        ibv_free_device_list(list);
+        snprintf(c->err, sizeof(c->err), "RDMA device %s not found", name);
+        return -1;
+    }
+    prx_hca_t *x = &c->hca[h];
+    x->ctx = ibv_open_device(dev);
+    ibv_free_device_list(list);
+    if (!x->ctx) { fail(c, "ibv_open_device", errno); return -1; }
+    struct ibv_port_attr port;
+    if (ibv_query_port(x->ctx, PRX_PORT, &port) || port.state != IBV_PORT_ACTIVE) {
+        snprintf(c->err, sizeof(c->err), "RDMA device %s: port %d not active", name, PRX_PORT);
+        return -1;
+    }
+    x->mtu = port.active_mtu;
+    if (ibv_query_gid(x->ctx, PRX_PORT, c->gid_index[h], &x->gid)) { fail(c, "ibv_query_gid", errno); return -1; }
+    x->pd = ibv_alloc_pd(x->ctx);
+    if (!x->pd) { fail(c, "ibv_alloc_pd", errno); return -1; }
+    // relaxed ordering for the data blocks (an optional flag, ignored where unsupported): NCCL registers its buffers
+    // so too, and the NIC's DMA to and from host memory needs it for its full rate on these systems; never for the
+    // flags and ctrl (the header's ordering argument)
+    const char *ro = getenv("TF_GLM_PRX_RO");
+    int access = IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE;
+    x->sync = ibv_reg_mr(x->pd, c->region, c->data_off, access);
+    if (!x->sync) { fail(c, "ibv_reg_mr(flags)", errno); return -1; }
+    if (!(ro && ro[0] == '0')) access |= IBV_ACCESS_RELAXED_ORDERING;
+    x->data = ibv_reg_mr(x->pd, c->region + c->data_off, c->region_bytes - c->data_off, access);
+    if (!x->data) { fail(c, "ibv_reg_mr(data)", errno); return -1; }
+    x->cq = ibv_create_cq(x->ctx, 4 * PRX_DEPTH, NULL, NULL, 0);
+    if (!x->cq) { fail(c, "ibv_create_cq", errno); return -1; }
+    return 0;
+}
+
+static struct ibv_qp *make_qp(prx_ctx_t *c, int h) {
+    prx_hca_t *x = &c->hca[h];
+    struct ibv_qp_init_attr a;
+    memset(&a, 0, sizeof(a));
+    a.send_cq = a.recv_cq = x->cq;
+    a.qp_type = IBV_QPT_RC;
+    a.cap.max_send_wr = PRX_DEPTH;
+    a.cap.max_recv_wr = 1;
+    a.cap.max_send_sge = a.cap.max_recv_sge = 1;
+    a.cap.max_inline_data = 16;
+    struct ibv_qp *qp = ibv_create_qp(x->pd, &a);
+    if (!qp) { fail(c, "ibv_create_qp", errno); return NULL; }
+    struct ibv_qp_attr init;
+    memset(&init, 0, sizeof(init));
+    init.qp_state = IBV_QPS_INIT;
+    init.port_num = PRX_PORT;
+    init.qp_access_flags = IBV_ACCESS_REMOTE_WRITE;
+    if (ibv_modify_qp(qp, &init, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS)) {
+        fail(c, "ibv_modify_qp(INIT)", errno);
+        ibv_destroy_qp(qp);
+        return NULL;
+    }
+    return qp;
+}
+
+void prx_destroy(prx_ctx_t *c);
+
+// links: for each other rank ascending, {n, hca[n], remote[n]} (``roce.plan_routes``' pairs)
+prx_ctx_t *prx_create(int world, int rank, int slots, uint64_t M, const char *const *names, int n_hca,
+                      const int *gid_index, int tclass, void *region, uint64_t region_bytes, const int *links,
+                      char *err, uint64_t err_len) {
+    uint64_t lay[6];
+    if (rank < 0 || rank >= world || prx_layout(world, slots, M, lay) || lay[3] > region_bytes || n_hca < 1 ||
+        n_hca > PRX_MAX_HCAS || tclass < 0 || tclass > 255) {
+        snprintf(err, err_len, "prx: invalid geometry");
+        return NULL;
+    }
+    prx_ctx_t *c = calloc(1, sizeof(*c));
+    if (!c) { snprintf(err, err_len, "prx: out of memory"); return NULL; }
+    c->world = world; c->rank = rank; c->slots = slots; c->n_hca = n_hca; c->tclass = tclass;
+    c->n_link = world - 1;
+    c->region = region; c->region_bytes = lay[3]; c->M = M;
+    c->flag_off = lay[0]; c->data_off = lay[1]; c->slot_bytes = lay[2];
+    for (int h = 0; h < n_hca; h++) c->gid_index[h] = gid_index[h];
+    const char *names_ns[4] = {"TF_GLM_PRX_TIMEOUT_S", "TF_GLM_PRX_PEER_S", "TF_GLM_PRX_EXIT_S", "TF_GLM_PRX_IDLE_MS"};
+    int64_t ns[4] = {env_ns(names_ns[0], 300, 1), env_ns(names_ns[1], 10, 1), env_ns(names_ns[2], 10, 1),
+                     env_ns(names_ns[3], 20, 1000)};
+    for (int i = 0; i < 4; i++)
+        if (ns[i] < 0) {
+            snprintf(err, err_len, "%s: a number of %s (0: off), not '%s'", names_ns[i], i == 3 ? "ms" : "seconds",
+                     getenv(names_ns[i]));
+            free(c);
+            return NULL;
+        }
+    c->timeout_ns = (uint64_t)ns[0]; c->peer_ns = (uint64_t)ns[1]; c->exit_ns = (uint64_t)ns[2];
+    c->idle_ns = (uint64_t)ns[3];
+    // TF_GLM_PRX_FAULT=R:N[:P] (a test): on rank R, call N's sends (to rank P only, if given) go out with a bad rkey
+    c->fault_call = UINT64_MAX;
+    c->fault_peer = -1;
+    const char *fault = getenv("TF_GLM_PRX_FAULT");
+    int fr = -1, fp = -1;
+    unsigned long long fc = 0;
+    if (fault && *fault && sscanf(fault, "%d:%llu:%d", &fr, &fc, &fp) >= 2 && fr == rank) {
+        c->fault_call = fc;
+        c->fault_peer = fp;
+        fprintf(stderr, "[tensorfold] TF_GLM_PRX_FAULT: rank %d's call %llu goes out with a bad rkey\n", rank, fc);
+    }
+    for (int h = 0; h < n_hca; h++)
+        if (open_hca(c, h, names[h])) {
+            snprintf(err, err_len, "%s", c->err);
+            prx_destroy(c);
+            return NULL;
+        }
+    const int *p = links;
+    for (int L = 0; L < c->n_link; L++) {
+        prx_link_t *k = &c->link[L];
+        k->peer = L < rank ? L : L + 1;
+        k->n = *p++;
+        if (k->n < 1 || k->n > PRX_MAX_STRIPES) {
+            snprintf(err, err_len, "prx: the link to rank %d has %d stripes", k->peer, k->n);
+            prx_destroy(c);
+            return NULL;
+        }
+        for (int s = 0; s < k->n; s++) k->hca[s] = *p++;
+        for (int s = 0; s < k->n; s++) k->remote[s] = *p++;
+        for (int s = 0; s < k->n; s++) {
+            if (k->hca[s] < 0 || k->hca[s] >= n_hca || k->remote[s] < 0 || k->remote[s] >= PRX_MAX_HCAS ||
+                !(k->qp[s] = make_qp(c, k->hca[s]))) {
+                snprintf(err, err_len, "%s", c->err[0] ? c->err : "prx: bad stripe HCA");
+                prx_destroy(c);
+                return NULL;
+            }
+        }
+    }
+    return c;
+}
+
+int prx_local_blob(prx_ctx_t *c, void *out, uint64_t len) {
+    if (len < sizeof(prx_blob_t)) return -1;
+    prx_blob_t b;
+    memset(&b, 0, sizeof(b));
+    b.region_addr = (uint64_t)(uintptr_t)c->region;
+    b.world = (uint32_t)c->world; b.rank = (uint32_t)c->rank; b.slots = (uint32_t)c->slots;
+    b.n_hca = (uint32_t)c->n_hca; b.M = c->M;
+    for (int h = 0; h < c->n_hca; h++) {
+        b.rkey_sync[h] = c->hca[h].sync->rkey;
+        b.rkey_data[h] = c->hca[h].data->rkey;
+        b.mtu[h] = (uint32_t)c->hca[h].mtu;
+        memcpy(b.gid[h], c->hca[h].gid.raw, 16);
+    }
+    for (int L = 0; L < c->n_link; L++)
+        for (int s = 0; s < c->link[L].n; s++) b.qpn[c->link[L].peer][c->link[L].hca[s]] = c->link[L].qp[s]->qp_num;
+    memcpy(out, &b, sizeof(b));
+    return 0;
+}
+
+static int connect_qp(prx_ctx_t *c, struct ibv_qp *qp, int h, const prx_blob_t *peer, int rh, uint32_t qpn) {
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_RTR;
+    a.path_mtu = (enum ibv_mtu)(peer->mtu[rh] < (uint32_t)c->hca[h].mtu ? peer->mtu[rh] : (uint32_t)c->hca[h].mtu);
+    a.dest_qp_num = qpn;
+    a.max_dest_rd_atomic = 1;
+    a.min_rnr_timer = 12;
+    a.ah_attr.is_global = 1;
+    a.ah_attr.port_num = PRX_PORT;
+    memcpy(a.ah_attr.grh.dgid.raw, peer->gid[rh], 16);
+    a.ah_attr.grh.sgid_index = (uint8_t)c->gid_index[h];
+    a.ah_attr.grh.hop_limit = 64;
+    a.ah_attr.grh.traffic_class = (uint8_t)c->tclass;
+    if (ibv_modify_qp(qp, &a, IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN |
+                                  IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER)) {
+        fail(c, "ibv_modify_qp(RTR)", errno);
+        return -1;
+    }
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_RTS;
+    const char *t = getenv("TF_ROCE_IB_TIMEOUT");
+    int to = t && *t ? atoi(t) : 14;
+    a.timeout = (uint8_t)(to >= 1 && to <= 31 ? to : 14);
+    a.retry_cnt = 7;
+    a.rnr_retry = 7;
+    a.max_rd_atomic = 1;
+    if (ibv_modify_qp(qp, &a, IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_SQ_PSN |
+                                  IBV_QP_MAX_QP_RD_ATOMIC)) {
+        fail(c, "ibv_modify_qp(RTS)", errno);
+        return -1;
+    }
+    return 0;
+}
+
+// every rank's blob in rank order
+int prx_connect(prx_ctx_t *c, const void *blobs, uint64_t len) {
+    if (len < sizeof(prx_blob_t) * (uint64_t)c->world) {
+        snprintf(c->err, sizeof(c->err), "prx: peer blob buffer too small");
+        return -1;
+    }
+    const prx_blob_t *all = blobs;
+    for (int r = 0; r < c->world; r++)
+        if (all[r].world != (uint32_t)c->world || all[r].rank != (uint32_t)r || all[r].slots != (uint32_t)c->slots ||
+            all[r].M != c->M) {
+            snprintf(c->err, sizeof(c->err), "prx: rank %d's geometry differs from this rank's", r);
+            return -1;
+        }
+    for (int L = 0; L < c->n_link; L++) {
+        prx_link_t *k = &c->link[L];
+        const prx_blob_t *peer = &all[k->peer];
+        k->peer_addr = peer->region_addr;
+        for (int s = 0; s < k->n; s++) {
+            int rh = k->remote[s];
+            uint32_t qpn = rh < (int)peer->n_hca ? peer->qpn[c->rank][rh] : 0;
+            if (!qpn) {
+                snprintf(c->err, sizeof(c->err), "prx: rank %d has no QP on HCA %d for rank %d", k->peer, rh, c->rank);
+                return -1;
+            }
+            k->rkey_sync[s] = peer->rkey_sync[rh];
+            k->rkey_data[s] = peer->rkey_data[rh];
+            if (connect_qp(c, k->qp[s], k->hca[s], peer, rh, qpn)) return -1;
+        }
+    }
+    return 0;
+}
+
+// the exchange's completions (heartbeats not counted), or -1
+static int drain(prx_ctx_t *c) {
+    int done = 0;
+    for (int h = 0; h < c->n_hca; h++) {
+        struct ibv_wc wc[64];
+        int n = ibv_poll_cq(c->hca[h].cq, 64, wc);
+        if (n < 0) { fail(c, "ibv_poll_cq", errno); return -1; }
+        for (int i = 0; i < n; i++) {
+            uint64_t id = wc[i].wr_id;
+            // wr_id: kind (4 bits), link (2 bits), stripe (2 bits), whether it also covers the unsignaled data write
+            // before it (bit 7 of the next byte: bit 10), the call from bit 11
+            int kind = (int)(id & 0xf), L = (int)((id >> 4) & 3), s = (int)((id >> 6) & 3), two = (int)((id >> 10) & 1);
+            uint64_t call = id >> 11;
+            if (wc[i].status != IBV_WC_SUCCESS) {
+                char why[256];
+                snprintf(why, sizeof(why), "prx: RDMA write to rank %d (kind %d, stripe %d, call %llu) failed: %s "
+                         "(vendor 0x%x)", c->link[L].peer, kind, s, (unsigned long long)call,
+                         ibv_wc_status_str(wc[i].status), wc[i].vendor_err);
+                fail(c, why, 0);
+                return -1;
+            }
+            c->link[L].outstanding[s] -= 1 + two;
+            if (kind == KIND_BEAT) {
+                c->beat_out[L] = 0;
+                continue;
+            }
+            c->inflight--;
+            if (kind == KIND_SEND) c->send_pending[call % PRX_QCAP]--;
+            c->stat[1]++;
+            done++;
+        }
+    }
+    return done;
+}
+
+static int room(prx_ctx_t *c, int L, int s, int need) {
+    while (c->link[L].outstanding[s] + need > PRX_DEPTH - 4) {
+        if (drain(c) < 0) return -1;
+        if (!atomic_load_explicit(&c->running, memory_order_relaxed)) return -1;
+    }
+    return 0;
+}
+
+static uint64_t wr_id(int kind, int L, int s, uint64_t call) {
+    return (call << 11) | ((uint64_t)s << 6) | ((uint64_t)L << 4) | (uint64_t)kind;
+}
+
+// one part on link L: bytes [0, n) from local offset ``from`` to the peer's offset ``to``, striped (16-byte aligned
+// cuts), each stripe followed by its flag (value v) at the peer's flag line of (slot, this rank, stripe)
+static int post_part(prx_ctx_t *c, int L, uint64_t from, uint64_t to, uint64_t n, int slot, uint32_t v, uint64_t call) {
+    prx_link_t *k = &c->link[L];
+    uint64_t lo = 0;
+    for (int s = 0; s < k->n; s++) {
+        uint64_t hi = s + 1 == k->n ? n : align_up(n * (s + 1) / k->n, 16);
+        if (hi > n) hi = n;
+        if (room(c, L, s, 2)) return -1;
+        struct ibv_send_wr wr[2], *bad = NULL;
+        struct ibv_sge sge;
+        memset(wr, 0, sizeof(wr));
+        uint64_t id = wr_id(KIND_SEND, L, s, call);
+        uint32_t flip = call == c->fault_call && (c->fault_peer < 0 || c->fault_peer == k->peer) ? 0xffu : 0u;
+        int first = 0;
+        if (hi > lo) {
+            sge.addr = (uint64_t)(uintptr_t)(c->region + from + lo);
+            sge.length = (uint32_t)(hi - lo);
+            sge.lkey = c->hca[k->hca[s]].data->lkey;
+            wr[0].wr_id = id;                 // completes only in error
+            wr[0].sg_list = &sge;
+            wr[0].num_sge = 1;
+            wr[0].opcode = IBV_WR_RDMA_WRITE;
+            wr[0].wr.rdma.remote_addr = k->peer_addr + to + lo;
+            wr[0].wr.rdma.rkey = k->rkey_data[s] ^ flip;
+            wr[0].next = &wr[1];
+        } else {
+            first = 1;
+        }
+        struct ibv_sge fs;
+        uint32_t val = v;
+        fs.addr = (uint64_t)(uintptr_t)&val;
+        fs.length = 4;
+        fs.lkey = 0;
+        wr[1].wr_id = id | ((uint64_t)(first == 0) << 10);
+        wr[1].sg_list = &fs;
+        wr[1].num_sge = 1;
+        wr[1].opcode = IBV_WR_RDMA_WRITE;
+        wr[1].send_flags = IBV_SEND_INLINE | IBV_SEND_SIGNALED;
+        wr[1].wr.rdma.remote_addr = k->peer_addr + flag_off(c, slot, c->rank, s);
+        wr[1].wr.rdma.rkey = k->rkey_sync[s] ^ flip;
+        int rc = ibv_post_send(k->qp[s], &wr[first], &bad);
+        if (rc) { fail(c, "ibv_post_send", rc); return -1; }
+        k->outstanding[s] += 2 - first;
+        c->inflight++;
+        c->send_pending[call % PRX_QCAP]++;
+        c->stat[0] += hi - lo;
+        lo = hi;
+    }
+    return 0;
+}
+
+// a 4-byte inline write of v to the peer on link L, its stripe s's queue pair, at its ctrl line
+static int post_word(prx_ctx_t *c, int L, int s, int line, uint32_t v, int kind) {
+    prx_link_t *k = &c->link[L];
+    struct ibv_sge fs = {.addr = (uint64_t)(uintptr_t)&v, .length = 4, .lkey = 0};
+    struct ibv_send_wr wr, *bad = NULL;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = wr_id(kind, L, s, 0);
+    wr.sg_list = &fs;
+    wr.num_sge = 1;
+    wr.opcode = IBV_WR_RDMA_WRITE;
+    wr.send_flags = IBV_SEND_INLINE | IBV_SEND_SIGNALED;
+    wr.wr.rdma.remote_addr = k->peer_addr + (uint64_t)line * PRX_LINE;
+    wr.wr.rdma.rkey = k->rkey_sync[s];
+    int rc = ibv_post_send(k->qp[s], &wr, &bad);
+    if (!rc) k->outstanding[s]++;
+    return rc;
+}
+
+static int credit_ok(prx_ctx_t *c, int L, uint64_t call) {
+    uint32_t got = *ctrl_word(c, CTRL_CREDIT + c->link[L].peer);
+    return call < (uint64_t)c->slots || (int32_t)(got - (uint32_t)(call - c->slots + 1)) >= 0;
+}
+
+static int ready(prx_ctx_t *c, int slot, int d, uint32_t v) {
+    return (int32_t)(*ctrl_word(c, CTRL_READY + slot * PRX_MAX_PEERS + d) - v) >= 0;
+}
+
+// the head call's parts, each as soon as its payload is staged and the peer freed the slot
+static int step_sends(prx_ctx_t *c) {
+    uint64_t posted = atomic_load_explicit(&c->posted, memory_order_acquire);
+    int did = 0, all = (1 << c->n_link) - 1;
+    while (c->next_send < posted) {
+        uint64_t call = c->next_send;
+        int s = (int)(call % c->slots);
+        uint32_t v = (uint32_t)(call + 1);
+        prx_desc_t *d = &c->desc[call % PRX_QCAP];
+        if (c->send_mask == 0) c->send_pending[call % PRX_QCAP] = 0;
+        for (int L = 0; L < c->n_link; L++) {
+            int blk = d->shared ? 0 : L;
+            if ((c->send_mask >> L) & 1 || !credit_ok(c, L, call) || !ready(c, s, blk, v)) continue;
+            __atomic_thread_fence(__ATOMIC_ACQUIRE);
+            if (post_part(c, L, send_off(c, s, blk), recv_off(c, s, c->rank), d->bytes, s, v, call)) return -1;
+            c->send_mask |= 1 << L;
+            did = 1;
+        }
+        if (c->send_mask != all) break;
+        c->send_mask = 0;
+        c->next_send++;
+    }
+    return did;
+}
+
+static int step_done(prx_ctx_t *c) {
+    int did = 0;
+    while (c->send_done < c->next_send && c->send_pending[c->send_done % PRX_QCAP] == 0) {
+        uint64_t call = c->send_done++;
+        *ctrl_word(c, CTRL_SEND_DONE + (int)(call % c->slots)) = (uint32_t)(call + 1);
+        did = 1;
+    }
+    // freed: calls this rank's GPU read out of its receive blocks (consumed[slot])
+    uint64_t posted = atomic_load_explicit(&c->posted, memory_order_acquire);
+    while (c->freed < posted &&
+           (int32_t)(*ctrl_word(c, CTRL_CONSUMED + (int)(c->freed % c->slots)) - (uint32_t)(c->freed + 1)) >= 0) {
+        c->freed++;
+        did = 1;
+    }
+    if (c->freed != c->reported) {
+        // to every peer: it keeps it as credit[this rank]
+        for (int L = 0; L < c->n_link; L++) {
+            if (room(c, L, 0, 1)) return -1;
+            int rc = post_word(c, L, 0, CTRL_CREDIT + c->rank, (uint32_t)c->freed, KIND_CREDIT);
+            if (rc) { fail(c, "ibv_post_send(credit)", rc); return -1; }
+            c->inflight++;
+        }
+        c->reported = c->freed;
+        did = 1;
+    }
+    return did;
+}
+
+// every PRX_BEAT_NS, busy or idle: a counter to each peer (it watches it while it has calls outstanding); a dead
+// peer fails the write after the queue pair's retries
+static int beat(prx_ctx_t *c, uint64_t t) {
+    if (t - c->beat_ns < PRX_BEAT_NS) return 0;
+    c->beat_ns = t;
+    c->beats++;
+    for (int L = 0; L < c->n_link; L++) {
+        if (c->beat_out[L] || c->link[L].outstanding[0] + 1 > PRX_DEPTH - 4) continue;
+        int rc = post_word(c, L, 0, CTRL_BEAT + c->rank, c->beats, KIND_BEAT);
+        if (rc) { fail(c, "ibv_post_send(heartbeat)", rc); return -1; }
+        c->beat_out[L] = 1;
+    }
+    return 0;
+}
+
+// while calls are outstanding: progress within TF_GLM_PRX_TIMEOUT_S, each peer's heartbeat within _PEER_S
+static int watch(prx_ctx_t *c, uint64_t t) {
+    char why[160];
+    for (int L = 0; L < c->n_link; L++) {
+        uint32_t h = *ctrl_word(c, CTRL_BEAT + c->link[L].peer);
+        if (h != c->seen[L]) {
+            c->seen[L] = h;
+            c->seen_ns[L] = t;
+        } else if (c->peer_ns && t - c->seen_ns[L] > c->peer_ns) {
+            snprintf(why, sizeof(why), "prx: no heartbeat from rank %d for %.0f s (TF_GLM_PRX_PEER_S): it is stopped "
+                     "or gone", c->link[L].peer, (double)(t - c->seen_ns[L]) / NS);
+            fail(c, why, 0);
+            return -1;
+        }
+    }
+    if (c->timeout_ns && t - c->progress_ns > c->timeout_ns) {
+        snprintf(why, sizeof(why), "prx: no progress for %.0f s with calls outstanding (TF_GLM_PRX_TIMEOUT_S)",
+                 (double)(t - c->progress_ns) / NS);
+        fail(c, why, 0);
+        return -1;
+    }
+    return 0;
+}
+
+static void release(prx_ctx_t *c) {
+    uint32_t past = (uint32_t)atomic_load(&c->posted) + PRX_PAST;
+    for (int s = 0; s < c->slots; s++) {
+        for (int src = 0; src < PRX_MAX_WORLD; src++)
+            for (int st = 0; st < PRX_MAX_STRIPES; st++)
+                *(volatile uint32_t *)(c->region + flag_off(c, s, src, st)) = past;
+        *ctrl_word(c, CTRL_SEND_DONE + s) = past;
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
+
+// drops every completion; returns those of ``kind``
+static int discard(prx_ctx_t *c, int kind) {
+    int n = 0;
+    for (int h = 0; h < c->n_hca; h++) {
+        struct ibv_wc wc[64];
+        int got = ibv_poll_cq(c->hca[h].cq, 64, wc);
+        for (int i = 0; i < got; i++) n += (int)(wc[i].wr_id & 0xf) == kind;
+    }
+    return n;
+}
+
+// after a failure, until prx_destroy: abort the peers, stop their writes here (they could lower a released word
+// again), keep the GPU's waits released
+static void hold(prx_ctx_t *c) {
+    uint32_t none = 0;
+    atomic_compare_exchange_strong(&any_origin, &none, c->origin);
+    atomic_store(&any_failed, 1);
+    uint64_t t0 = now_ns();
+    fprintf(stderr, "[tensorfold] TF_GLM_PRX failed on rank %d: %s; the GPU's waits are released%s\n", c->rank, c->err,
+            c->exit_ns ? ", the process exits soon (TF_GLM_PRX_EXIT_S)" : "");
+    int aborts = 0;
+    for (int L = 0; L < c->n_link; L++)
+        for (int s = 0; s < c->link[L].n; s++) aborts += !post_word(c, L, s, CTRL_ABORT, c->origin, KIND_ABORT);
+    while (aborts > 0 && now_ns() - t0 < NS / 5) aborts -= discard(c, KIND_ABORT);
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_ERR;
+    for (int L = 0; L < c->n_link; L++)
+        for (int s = 0; s < c->link[L].n; s++) ibv_modify_qp(c->link[L].qp[s], &a, IBV_QP_STATE);
+    struct timespec nap = {0, PRX_NAP_NS};
+    while (atomic_load(&c->running)) {
+        release(c);
+        discard(c, KIND_ABORT);
+        if (c->exit_ns && now_ns() - t0 >= c->exit_ns) {
+            fprintf(stderr, "[tensorfold] TF_GLM_PRX failed on rank %d %.0f s ago: exiting (TF_GLM_PRX_EXIT_S)\n",
+                    c->rank, (double)(now_ns() - t0) / NS);
+            _exit(70);
+        }
+        nanosleep(&nap, NULL);
+    }
+}
+
+// every posted call sent, freed and reported, nothing in flight: nothing can happen here before the next prx_post
+static int caught_up(prx_ctx_t *c, uint64_t posted) {
+    return c->send_done == posted && c->freed == posted && c->reported == c->freed && c->inflight == 0;
+}
+
+// caught up for TF_GLM_PRX_IDLE_MS: sleep until prx_post or prx_destroy wakes it, or a second for the heartbeat.
+// ``sleeping`` is set before ``posted`` is read again and prx_post stores ``posted`` before it reads ``sleeping``
+// (both sequentially consistent), so one of the two sees the other: a post is never missed
+static void nap(prx_ctx_t *c, uint64_t posted) {
+    uint32_t w = atomic_load(&c->wake);
+    atomic_store(&c->sleeping, 1);
+    if (atomic_load(&c->posted) == posted && atomic_load(&c->running) && !*ctrl_word(c, CTRL_ABORT) &&
+        !atomic_load(&any_failed)) {
+        struct timespec second = {1, 0};
+        c->stat[2]++;
+        futex(&c->wake, FUTEX_WAIT_PRIVATE, w, &second);
+    }
+    atomic_store(&c->sleeping, 0);
+}
+
+static void *proxy_main(void *arg) {
+    prx_ctx_t *c = arg;
+    uint64_t t = now_ns(), idle_since = t, spins = 0;
+    c->progress_ns = c->beat_ns = t;
+    for (int L = 0; L < c->n_link; L++) c->seen_ns[L] = t;
+    while (atomic_load_explicit(&c->running, memory_order_relaxed)) {
+        // first: a peer's abort lands before that peer's queue pairs fail this rank's writes
+        uint32_t origin = *ctrl_word(c, CTRL_ABORT);
+        if (origin) {
+            char why[128];
+            snprintf(why, sizeof(why), "prx: rank %u failed and its abort reached this rank", origin - 1);
+            c->origin = origin;
+            fail(c, why, 0);
+            break;
+        }
+        if (atomic_load_explicit(&any_failed, memory_order_relaxed)) {
+            c->origin = atomic_load(&any_origin);
+            fail(c, "prx: another TF_GLM_PRX channel of this rank failed", 0);
+            break;
+        }
+        int a = step_sends(c), d = drain(c), e = step_done(c);
+        if (a < 0 || d < 0 || e < 0) break;
+        t = now_ns();
+        if (beat(c, t)) break;
+        uint64_t posted = atomic_load_explicit(&c->posted, memory_order_acquire);
+        if (a || d || e) {
+            uint64_t gap = t - c->progress_ns;
