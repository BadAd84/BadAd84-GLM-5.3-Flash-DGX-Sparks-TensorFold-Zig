@@ -0,0 +1,437 @@
+"""TF_GLM_PRX=1: the prompt chunks' row-split exchanges (``comm.NCCL.exchange_all``: ``hcsplit``'s partial and row
+swaps) moved by the NICs, with no GPU kernel and no SM: the copy engines stage each peer's bytes into a pinned
+region, the proxy thread (prx_proxy.c) RDMA-writes them to each peer over the pair's rails (the routes the RoCE
+all-gather uses, ``roce.plan_routes``), and the GPU waits for the data with stream memory operations before the copy
+engines move it into place. For ranks cabled to each other directly (a triangle of Sparks, two rails a pair; up to
+four ranks with every pair connected). After MiaAI-Lab recipe PR #205 (0126 + 0127), whose ring of four relays the
+across rank's halves; with every pair connected there is nothing to relay.
+
+The same bytes land in the same receive tensors as NCCL's send/receive would put them (a transport, not arithmetic:
+the same bits). Exchanges larger than a slot go as several calls; captured exchanges (CUDA graphs) use NCCL.
+TF_GLM_PRX_SLOT_MB (16) and TF_GLM_PRX_SLOTS (4) size the pinned region (slots x (2 world - 1) x slot: 320 MiB at
+three ranks); TF_GLM_PRX_HCA (default TF_ROCE_HCA / NCCL_IB_HCA, as the RoCE all-gather) names the RDMA functions.
+TF_GLM_PRX_ZC=1: the row split's partials are read where the NICs land them (``post_zc``, ``recv_view``: hc_post
+reads every peer's block in the pinned region), no copy out. TF_GLM_PRX_SHARE=1: a second channel (its own region,
+queue pairs and proxy; TF_GLM_PRX_SHARE_MB, 8) for the prompt indexer shard's all-gather of its rows' pools on the
+main stream (``indexer_shard.prompt_shard``), which then runs no NCCL kernel either.
+
+A failure (prx_proxy.c: a failed write, TF_GLM_PRX_TIMEOUT_S (300) without progress, a peer silent for
+TF_GLM_PRX_PEER_S (10), an abort from a peer) releases every wait the GPU has on the exchange, so it computes on
+garbage: the next call raises, and so does ``comm.check_prx`` after the samplers read a sample, before any token
+reaches a client. TF_GLM_PRX_EXIT_S (10) later the process exits with code 70 (0: it stays, broken).
+TF_GLM_PRX_IDLE_MS (20): how long a caught-up proxy polls before it sleeps until the next call (0: it never sleeps).
+TF_GLM_PRX_RO=0: no relaxed ordering on the data blocks (the flags never have it)."""
+
+from __future__ import annotations
+
+import ctypes
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from . import roce
+
+_SOURCE = Path(__file__).with_name("prx_proxy.c")
+# prx_proxy.c's layout constants
+MAX_WORLD, MAX_PEERS, MAX_STRIPES, MAX_SLOTS, LINE = 4, 3, 4, 8, 64
+CTRL_READY = 0
+CTRL_CONSUMED = MAX_SLOTS * MAX_PEERS
+CTRL_SEND_DONE = CTRL_CONSUMED + MAX_SLOTS
+ALIGN = 16                                   # every piece of a call starts 16-byte aligned in its block
+
+
+def bind(lib: ctypes.CDLL) -> ctypes.CDLL:
+    """prx_proxy.c's entry points on ``lib`` (the built proxy, or a test's build of it)."""
+
+    u64, p, i = ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int
+    for name, res, args in (
+            ("prx_abi_version", i, []), ("prx_layout", i, [i, i, u64, ctypes.POINTER(u64)]),
+            ("prx_blob_bytes", u64, []),
+            ("prx_create", p, [i, i, i, u64, ctypes.POINTER(ctypes.c_char_p), i, ctypes.POINTER(i), i, p, u64,
+                               ctypes.POINTER(i), ctypes.c_char_p, u64]),
+            ("prx_local_blob", i, [p, p, u64]), ("prx_connect", i, [p, p, u64]), ("prx_start", i, [p]),
+            ("prx_post", ctypes.c_int64, [p, u64, i]), ("prx_failed", i, [p]), ("prx_error", ctypes.c_char_p, [p]),
+            ("prx_stat", u64, [p, i]), ("prx_destroy", None, [p])):
+        fn = getattr(lib, name)
+        fn.restype, fn.argtypes = res, args
+    if lib.prx_abi_version() != 1:
+        raise RuntimeError("unexpected prx_proxy ABI version")
+    return lib
+
+
+@lru_cache(maxsize=1)
+def library() -> ctypes.CDLL:
+    return bind(roce.build_proxy(_SOURCE, "prx_proxy", "TF_GLM_PRX"))
+
+
+def layout(lib, world: int, slots: int, M: int) -> tuple[int, ...]:
+    """(flag offset, data offset, slot bytes, total bytes, line, receive blocks' offset in a slot)."""
+
+    out = (ctypes.c_uint64 * 6)()
+    if lib.prx_layout(world, slots, M, out) != 0:
+        raise ValueError(f"TF_GLM_PRX: no layout for {world} ranks, {slots} slots of {M >> 20} MiB")
+    return tuple(int(v) for v in out)
+
+
+def _env_int(name: str, default: int, lo: int, hi: int) -> int:
+    raw = os.environ.get(name, "").strip() or str(default)
+    try:
+        value = int(raw)
+    except ValueError:
+        value = lo - 1
+    if not lo <= value <= hi:
+        raise ValueError(f"{name}: {lo} to {hi}, not {raw!r}")
+    return value
+
+
+def _env_flag(name: str) -> bool:
+    raw = os.environ.get(name, "").strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"{name}: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
+@dataclass(frozen=True)
+class PrxSettings:
+    """What TF_GLM_PRX* ask for; every rank must agree (the engine's startup comparison)."""
+
+    on: bool = False
+    share: bool = False
+    zc: bool = False
+    slots: int = 4
+    slot_mb: int = 16
+    share_mb: int = 8
+
+    @classmethod
+    def from_env(cls, world: int) -> "PrxSettings":
+        on = _env_flag("TF_GLM_PRX")
+        share, zc = _env_flag("TF_GLM_PRX_SHARE"), _env_flag("TF_GLM_PRX_ZC")
+        if (share or zc) and not on:
+            raise ValueError("TF_GLM_PRX_SHARE / TF_GLM_PRX_ZC are TF_GLM_PRX's options: set TF_GLM_PRX=1")
+        if on and not 3 <= int(world) <= MAX_WORLD:
+            raise ValueError(f"TF_GLM_PRX moves the exchanges of three or four ranks cabled to each other, not "
+                             f"{world} ranks")
+        return cls(on, share, zc, _env_int("TF_GLM_PRX_SLOTS", 4, 2, MAX_SLOTS),
+                   _env_int("TF_GLM_PRX_SLOT_MB", 16, 1, 2048), _env_int("TF_GLM_PRX_SHARE_MB", 8, 1, 2048))
+
+    def code(self) -> list[int]:
+        if not self.on:
+            return [0, 0, 0, 0, 0, 0]
+        return [1, int(self.share), int(self.zc), self.slots, self.slot_mb, self.share_mb]
+
+    def channels(self) -> list[int]:
+        """Each channel's slot size in bytes (channel 0, then the share channel)."""
+        return [self.slot_mb << 20] + ([self.share_mb << 20] if self.share else [])
+
+    def allocate(self, world: int) -> list[torch.Tensor]:
+        """Each channel's pinned region (before the cache pool is sized: the memory they take is counted)."""
+        lib = library()
+        return [torch.zeros(layout(lib, world, self.slots, M)[3], dtype=torch.uint8, pin_memory=True)
+                for M in self.channels()]
+
+
+@lru_cache(maxsize=1)
+def _cu() -> ctypes.CDLL:
+    lib = ctypes.CDLL("libcuda.so.1")
+    for name in ("cuStreamWriteValue32_v2", "cuStreamWaitValue32_v2"):
+        fn = getattr(lib, name)
+        fn.restype = ctypes.c_int
+        fn.argtypes = [ctypes.c_void_p, ctypes.c_uint64, ctypes.c_uint32, ctypes.c_uint]
+    lib.cuMemHostGetDevicePointer_v2.restype = ctypes.c_int
+    lib.cuMemHostGetDevicePointer_v2.argtypes = [ctypes.POINTER(ctypes.c_uint64), ctypes.c_void_p, ctypes.c_uint]
+    return lib
+
+
+def _check(rc: int, what: str) -> None:
+    if rc != 0:
+        raise RuntimeError(f"TF_GLM_PRX: {what} failed (CUresult {rc})")
+
+
+class StreamOps:
+    """The GPU's side of an exchange on the current CUDA stream: stream memory operations on the pinned region's
+    words (a write after the stream's earlier work, a wait until a word reaches a value: CU_STREAM_WAIT_VALUE_GEQ,
+    cyclic) and copy-engine copies between tensors and the region (no kernel: a copy kernel on the side stream waited
+    for SMs behind the compute kernels)."""
+
+    def __init__(self, region: torch.Tensor) -> None:
+        self.region = region
+        dev = ctypes.c_uint64()
+        _check(_cu().cuMemHostGetDevicePointer_v2(ctypes.byref(dev), ctypes.c_void_p(region.data_ptr()), 0),
+               "device pointer")
+        self.dbase = dev.value
+        self.dregion = None
+
+    @staticmethod
+    def capturing() -> bool:
+        return torch.cuda.is_current_stream_capturing()
+
+    def write(self, off: int, value: int) -> None:
+        h = ctypes.c_void_p(torch.cuda.current_stream().cuda_stream)
+        _check(_cu().cuStreamWriteValue32_v2(h, self.dbase + off, value & 0xFFFFFFFF, 0), "write")
+
+    def wait(self, off: int, value: int) -> None:
+        h = ctypes.c_void_p(torch.cuda.current_stream().cuda_stream)
+        _check(_cu().cuStreamWaitValue32_v2(h, self.dbase + off, value & 0xFFFFFFFF, 0), "wait")
+
+    def stage(self, at: int, src: torch.Tensor) -> None:
+        self.region[at:at + src.numel()].copy_(src, non_blocking=True)
+
+    def unstage(self, dst: torch.Tensor, at: int) -> None:
+        dst.copy_(self.region[at:at + dst.numel()], non_blocking=True)
+
+    def view(self, at: int, n: int) -> torch.Tensor:
+        """Region bytes [at, at + n) as a CUDA tensor (the device's mapping of the pinned memory)."""
+        if self.dregion is None:
+            class _View:
+                def __init__(self, ptr, size):
+                    self.__cuda_array_interface__ = {"shape": (size,), "typestr": "|u1", "data": (ptr, False),
+                                                     "version": 3}
+            self.dregion = torch.as_tensor(_View(self.dbase, self.region.numel()), device="cuda")
+        return self.dregion[at:at + n]
+
+
+def _bytes(t: torch.Tensor) -> torch.Tensor:
+    return t.reshape(-1).view(torch.uint8)
+
+
+class Prx:
+    """One rank's side of a channel: the pinned region, the proxy and the exchanges. ``gather(words)``: every rank's
+    int32 ``words`` (the same count on every rank) in rank order, for the setup only (the communicator's). ``region``
+    (``PrxSettings.allocate``), ``ops`` (the GPU side, ``StreamOps``), ``hcas``/``found`` (the RDMA functions and
+    their (GID index, IPv4, prefix), ``roce._ipv4_gid``) and ``lib`` default to the real ones; tests emulate them."""
+
+    def __init__(self, rank: int, world: int, gather, slots: int, M: int, zc: bool = False, *, region=None,
+                 ops=None, hcas: list[str] | None = None, found: list | None = None, lib=None) -> None:
+        if not 2 <= world <= MAX_WORLD:
+            raise ValueError(f"TF_GLM_PRX: 2 to {MAX_WORLD} ranks, not {world}")
+        self.ctx = None
+        lib = lib or library()
+        self.lib, self.rank, self.world, self.slots, self.M, self.zc = lib, rank, world, slots, M, zc
+        self.peers = [p for p in range(world) if p != rank]
+        self.flag_off, self.data_off, self.slot_bytes, total, self.line, self.recv0 = layout(lib, world, slots, M)
+        self.region = region if region is not None else torch.zeros(total, dtype=torch.uint8, pin_memory=True)
+        if self.region.numel() < total or self.region.dtype != torch.uint8:
+            raise ValueError("TF_GLM_PRX: the pinned region is smaller than the layout")
+        self.ops = ops(self.region) if callable(ops) else (ops or StreamOps(self.region))
+        self.hcas = (hcas if hcas is not None else roce._hcas(world, "TF_GLM_PRX_HCA"))[:roce.MAX_HCAS]
+        found = found if found is not None else [roce._ipv4_gid(h) for h in self.hcas]
+        gids = roce.gid_indexes(world, found)
+        addrs = [None if f is None else (f[1], f[2]) for f in found]
+        # every rank's geometry and (IPv4, prefix) a HCA, for the routes (``roce.plan_routes``, as the RoCE gather)
+        mine = [world, slots, M >> 12, len(self.hcas)] + [0, -1] * roce.MAX_HCAS
+        for h, a in enumerate(addrs):
+            if a is not None:
+                mine[4 + 2 * h] = a[0] - (1 << 32) if a[0] >= 1 << 31 else a[0]
+                mine[5 + 2 * h] = a[1]
+        rows = gather(mine)
+        if len({tuple(r[:3]) for r in rows}) != 1:
+            raise RuntimeError("TF_GLM_PRX: the ranks' slot geometry differs (TF_GLM_PRX_SLOTS / _SLOT_MB)")
+        table = [[None if int(r[5 + 2 * h]) < 0 else (int(r[4 + 2 * h]) & 0xFFFFFFFF, int(r[5 + 2 * h]))
+                  for h in range(int(r[3]))] for r in rows]
+        routes, n = roce.plan_routes(table)
+        self.stripes = min(n, MAX_STRIPES)
+        links = []
+        for p in self.peers:
+            pairs = routes[(rank, p)][:self.stripes]
+            links += [len(pairs), *[a for a, _ in pairs], *[b for _, b in pairs]]
+        self.routes = {p: routes[(rank, p)][:self.stripes] for p in self.peers}
+        names = (ctypes.c_char_p * len(self.hcas))(*[x.encode() for x in self.hcas])
+        err = ctypes.create_string_buffer(512)
+        tc = int(os.environ.get("NCCL_IB_TC", "0"), 0)
+        self.ctx = lib.prx_create(world, rank, slots, M, names, len(self.hcas), (ctypes.c_int * len(gids))(*gids),
+                                  tc, ctypes.c_void_p(self.region.data_ptr()), total,
+                                  (ctypes.c_int * len(links))(*links), err, len(err))
+        n = int(lib.prx_blob_bytes())
+        blob = ctypes.create_string_buffer(n)
+        ok = bool(self.ctx) and lib.prx_local_blob(self.ctx, blob, n) == 0
+        words = -(-n // 4)
+        raw = torch.frombuffer(bytearray(blob.raw.ljust(4 * words, b"\0")), dtype=torch.int32).tolist()
+        rows = gather([0 if ok else 1] + raw)
+        if any(r[0] for r in rows):
+            why = err.value.decode(errors="replace")
+            self.close()
+            raise RuntimeError(f"TF_GLM_PRX setup failed on some rank: {why or 'see that rank'}")
+        blobs = b"".join(torch.tensor(r[1:], dtype=torch.int32).numpy().tobytes()[:n] for r in rows)
+        ok = lib.prx_connect(self.ctx, blobs, len(blobs)) == 0 and lib.prx_start(self.ctx) == 0
+        rows = gather([0 if ok else 1])
+        if any(r[0] for r in rows):
+            why = lib.prx_error(self.ctx).decode(errors="replace")
+            self.close()
+            raise RuntimeError(f"TF_GLM_PRX could not connect: {why or 'see that rank'}")
+
+    # -- region offsets (prx_proxy.c's) ---------------------------------------------------------------------------
+    def _ctrl(self, line: int) -> int:
+        return line * self.line
+
+    def _flag(self, slot: int, src: int, stripe: int) -> int:
+        return self.flag_off + ((slot * MAX_WORLD + src) * MAX_STRIPES + stripe) * self.line
+
+    def _send(self, slot: int, d: int) -> int:
+        return self.data_off + slot * self.slot_bytes + d * self.M
+
+    def _recv(self, slot: int, k: int) -> int:
+        """The receive block of rank k's payload (this rank's own: unused)."""
+        return self.data_off + slot * self.slot_bytes + self.recv0 + k * self.M
+
+    # -- calls ----------------------------------------------------------------------------------------------------
+    def takes(self, sends: dict) -> bool:
+        """Whether ``comm.NCCL.exchange_all``'s call goes here: eager (not captured), with every other rank."""
+        return not self.ops.capturing() and sorted(sends) == self.peers
+
+    def _post(self, nbytes: int, shared: bool) -> tuple[int, int]:
+        c = int(self.lib.prx_post(self.ctx, nbytes, int(shared)))
+        if c < 0:
+            self.check()
+            raise RuntimeError("TF_GLM_PRX: the call queue is full")
+        s = c % self.slots
+        if c >= self.slots:                     # the NICs have read this slot's previous payloads
+            self.ops.wait(self._ctrl(CTRL_SEND_DONE + s), c - self.slots + 1)
+        return c, s
+
+    def _stage(self, c: int, s: int, payload: dict, shared: bool) -> None:
+        """Each peer's payload [(tensor bytes, lo, hi, offset in the block)] into its send block, then its ready
+        word (an all-gather's ``shared`` one into block 0)."""
+        for d, p in enumerate(self.peers[:1] if shared else self.peers):
+            base = self._send(s, d)
+            for t, lo, hi, o in payload[p]:
+                if hi > lo:
+                    self.ops.stage(base + o, t[lo:hi])
+            self.ops.write(self._ctrl(CTRL_READY + s * MAX_PEERS + d), c + 1)
+
+    def _arrived(self, c: int, s: int, p: int) -> None:
+        for st in range(self.stripes):
+            self.ops.wait(self._flag(s, p, st), c + 1)
+
+    def exchange_all(self, sends: dict, recvs: dict) -> None:
+        """``comm.NCCL.exchange_all``'s call (every other rank; the i-th tensor alike for every peer), on the current
+        stream: as many calls as the bytes need, each at most a slot."""
+
+        p0 = self.peers[0]
+        k = len(sends[p0])
+        sizes = [t.numel() * t.element_size() for t in sends[p0]]
+        for p in self.peers:
+            if len(sends[p]) != k or [t.numel() * t.element_size() for t in sends[p]] != sizes or \
+                    [t.numel() * t.element_size() for t in recvs[p]] != sizes:
+                raise ValueError("TF_GLM_PRX: exchange_all needs the i-th send and receive alike for every peer")
+        shared = all(sends[p][i].data_ptr() == sends[p0][i].data_ptr() for p in self.peers for i in range(k))
+        flat = {p: [_bytes(t) for t in sends[p]] for p in self.peers}
+        into = {p: [_bytes(t) for t in recvs[p]] for p in self.peers}
+        call: list[tuple[int, int, int]] = []       # (tensor, lo, hi) byte ranges of one call
+        used = 0
+        for i, n in enumerate(sizes):
+            lo = 0
+            while lo < n:
+                take = min(n - lo, self.M - used)
+                call.append((i, lo, lo + take))
+                used += -(-take // ALIGN) * ALIGN
+                lo += take
+                if used >= self.M:
+                    self._call(call, flat, into, shared)
+                    call, used = [], 0
+        if call:
+            self._call(call, flat, into, shared)
+
+    def _call(self, pieces, flat, into, shared: bool) -> None:
+        offs, at = [], 0
+        for _, lo, hi in pieces:
+            offs.append(at)
+            at += -(-(hi - lo) // ALIGN) * ALIGN
+        c, s = self._post(at, shared)
+        self._stage(c, s, {p: [(flat[p][i], lo, hi, o) for (i, lo, hi), o in zip(pieces, offs)]
+                           for p in self.peers}, shared)
+        for p in self.peers:
+            self._arrived(c, s, p)
+            base = self._recv(s, p)
+            for (i, lo, hi), o in zip(pieces, offs):
+                if hi > lo:
+                    self.ops.unstage(into[p][i][lo:hi], base + o)
+        self.ops.write(self._ctrl(CTRL_CONSUMED + s), c + 1)
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        """recv [world * n] <- every rank's send [n] in rank order (``comm.NCCL.all_gather``'s call): one payload
+        staged once for every peer, this rank's block copied locally."""
+        n = send.numel()
+        if recv.numel() != n * self.world or recv.dtype != send.dtype or not (send.is_contiguous()
+                                                                               and recv.is_contiguous()):
+            raise ValueError("TF_GLM_PRX all_gather: recv must hold world x send, contiguous, of the same dtype")
+        flat = recv.view(-1)
+        self.exchange_all({p: [send] for p in self.peers}, {p: [flat[p * n:(p + 1) * n]] for p in self.peers})
+        flat[self.rank * n:(self.rank + 1) * n].copy_(send, non_blocking=True)
+
+    def fits_gather(self, send: torch.Tensor) -> bool:
+        return not self.ops.capturing() and 0 < send.numel() * send.element_size() <= self.M
+
+    # -- zero-copy receives (TF_GLM_PRX_ZC: the row split's partials read where the NICs land them) ---------------
+    def post_zc(self, sends: dict) -> tuple[int, int] | None:
+        """One call sending each peer its tensor (contiguous, alike for every peer), on the current stream up to the
+        arrival of every peer's block; the caller reads them in place (``recv_view``) and then calls ``done`` (on the
+        stream that read them). None when the bytes exceed a slot (the caller exchanges as usual)."""
+        nbytes = sends[self.peers[0]].numel() * sends[self.peers[0]].element_size()
+        if nbytes > self.M or any(t.numel() * t.element_size() != nbytes for t in sends.values()):
+            return None
+        c, s = self._post(-(-nbytes // ALIGN) * ALIGN, False)
+        self._stage(c, s, {p: [(_bytes(sends[p]), 0, nbytes, 0)] for p in self.peers}, False)
+        for p in self.peers:
+            self._arrived(c, s, p)
+        return c, s
+
+    def recv_view(self, call: tuple[int, int], dtype: torch.dtype, rows: int, width: int) -> torch.Tensor:
+        """Every rank's received [rows, width] block of ``call`` as one [world, rows, width] view (rank stride: the
+        block size; this rank's own block is not written)."""
+        size = torch.tensor([], dtype=dtype).element_size()
+        if self.M % size or rows * width * size > self.M:
+            raise ValueError("TF_GLM_PRX recv_view: the blocks do not hold that shape")
+        base = self.ops.view(self._recv(call[1], 0), self.world * self.M).view(dtype)
+        return base.as_strided((self.world, rows, width), (self.M // size, width, 1))
+
+    def done(self, call: tuple[int, int]) -> None:
+        """On the current stream, after the receive blocks of ``call`` are read: its peers may reuse them."""
+        c, s = call
+        self.ops.write(self._ctrl(CTRL_CONSUMED + s), c + 1)
+
+    # -- state ----------------------------------------------------------------------------------------------------
+    def check(self) -> None:
+        if self.ctx and self.lib.prx_failed(self.ctx):
+            raise RuntimeError(f"TF_GLM_PRX failed: {self.lib.prx_error(self.ctx).decode(errors='replace')} "
+                               f"[{self.stats()}]")
+
+    def health(self) -> dict:
+        """Calls posted, the longest wait with calls outstanding (against TF_GLM_PRX_TIMEOUT_S), sleeps, failure."""
+        if not self.ctx:
+            return {"closed": True}
+        lib, c = self.lib, self.ctx
+        return {"posted": lib.prx_stat(c, 2), "longest_wait_ms": lib.prx_stat(c, 7), "sleeps": lib.prx_stat(c, 8),
+                "failed": bool(lib.prx_failed(c))}
+
+    def stats(self) -> str:
+        if not self.ctx:
+            return "closed"
+        names = ("bytes", "completions", "posted", "sent", "send done", "freed", "mtu enum", "longest wait ms",
+                 "sleeps", "heartbeats")
+        return ", ".join(f"{n} {self.lib.prx_stat(self.ctx, i)}" for i, n in enumerate(names))
+
+    def close(self) -> None:
+        if getattr(self, "ctx", None):
+            self.lib.prx_destroy(self.ctx)
+            self.ctx = None
+
+
+def attach(comm, rank: int, world: int, settings: PrxSettings, regions: list[torch.Tensor]) -> None:
+    """Connect the channels (every rank together, after the startup comparison found the settings alike) and hang
+    them on the NCCL communicator (``prx``, ``prx_share``): its ``exchange_all`` then goes over them."""
+
+    nccl = getattr(comm, "nccl", comm)
+
+    def gather(words: list[int]) -> list[list[int]]:
+        mine = torch.tensor(words, dtype=torch.int32, device="cuda")
+        got = torch.empty(world * mine.numel(), dtype=torch.int32, device="cuda")
+        nccl.all_gather(mine, got)
+        return got.view(world, -1).cpu().tolist()
+
+    sizes = settings.channels()
+    nccl.prx = Prx(rank, world, gather, settings.slots, sizes[0], settings.zc, region=regions[0])
+    if settings.share:
+        nccl.prx_share = Prx(rank, world, gather, settings.slots, sizes[1], region=regions[1])
