+        case 1: return c->stat[1];
+        case 2: return atomic_load(&c->posted);
+        case 3: return c->next_send;
+        case 4: return c->send_done;
+        case 5: return c->freed;
+        case 6: return (uint64_t)c->hca[0].mtu;
+        case 7: return c->longest_ns / 1000000;
+        case 8: return c->stat[2];
+        case 9: return c->beats;
+        default: return 0;
+    }
+}
+
+void prx_destroy(prx_ctx_t *c) {
+    if (!c) return;
+    if (atomic_exchange(&c->running, 0)) {
