+def mla_select_scores(capacity: int, prefill_rows: int = PREFILL_ROWS) -> int:
+    """A prompt chunk's fp32 pool scores (``sparse._select_prompt`` and the sharded prefill: MLA_SELECT_ROWS rows
+    at once over ``sparse.pool_bucket``'s pools), charged here for every pool of ``capacity`` tokens. Allocated per
+    chunk and bounded by the chunk's stream (a prompt shorter than the window: at most 262,144 pools at 1,048,576
+    tokens), not by the pool the streams share (PoolCharge)."""
+
+    return min(prefill_rows, MLA_SELECT_ROWS) * 4 * ((capacity + 3) // 4)
