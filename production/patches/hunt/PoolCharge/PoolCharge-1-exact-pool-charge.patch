+def pool_charge(value: str | None = None) -> str:
+    """TF_GLM_POOL_CHARGE (PoolCharge): what --parallel's pool charges a token past the window's slots. ``estimate``
+    (the default): the startup estimate's slope, which counts a prompt chunk's fp32 select scores
+    (``geometry.mla_select_scores``, 512 B a token) for every pool token, though a chunk allocates them for its own
+    stream (bounded by the window, whose slots the estimate already charges). ``exact``: the bytes a pool token
+    allocates (``pool_token_bytes``), and the batched window's split-selection scratch at the pool's pools."""
+
+    value = (os.environ.get("TF_GLM_POOL_CHARGE", "") if value is None else value).strip().lower() or "estimate"
+    if value not in ("estimate", "exact"):
+        raise ValueError(f"TF_GLM_POOL_CHARGE: estimate or exact, not {value!r}")
+    return value
+
+
+def pool_token_bytes(g, capacity: int, prefill_rows: int) -> int:
+    """PoolCharge: the bytes a pool token past ``capacity`` allocates, from the startup estimate's slope (``g``: the
+    engine's ``geometry``, built with ``prefill_rows`` prompt rows) less the prompt chunk's select scores
+    (``mla_select_scores``). What stays: the cache planes (``forward.Caches``: latents and pooled keys) and the batched
+    window's select scores (``geometry``'s ``per``: ``verify.BatchedVerify``'s ``SelectScratch`` spans the pool). Only
+    for the engine ``TF_GLM_POOL_CHARGE=exact`` admits: windows verified batched, with an index."""
+
+    from tensorfold.cuda.geometry import mla_select_scores
+
+    step = 65536
+    slope = g.bytes_at(capacity + step) - g.bytes_at(capacity)
+    slope -= mla_select_scores(capacity + step, prefill_rows) - mla_select_scores(capacity, prefill_rows)
+    return max(1, -(-slope // step))
+
+
