+def msg_side(value: str | None = None) -> bool:
+    """TF_GLM_MSG_SIDE (lane MsgSide, LEADS 12): 1 gives the per-round message's fixed gather its own RoCE channel
+    (``RoceComm.open_messages``) and runs it on a side stream (``SideMsgGather``), so after a round it moves while the
+    prelaunched DFlash2 pass runs and a follower's host reads it without waiting behind that pass; 0 (the default):
+    ``MsgGather`` as before. Every rank alike (the startup settings comparison); a RoCE communicator only
+    (TF_GLM_COMM=roce). Replies are the same bits: only where and when the message's gather runs changes."""
+
+    raw = (os.environ.get("TF_GLM_MSG_SIDE", "") if value is None else value).strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"TF_GLM_MSG_SIDE: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
+class SideMsgGather(MsgGather):
+    """MsgSide (TF_GLM_MSG_SIDE=1): ``MsgGather`` whose fixed gather goes over the RoCE message channel
+    (``RoceComm.msg_gather``: its own region, counters, slots and proxy, so it never races the main channel's
+    gathers) on a side stream of its own. The collectives and their order on every rank are ``MsgGather``'s; a
+    message past the buffer still runs its values' gather on the main stream and channel, decided from the gathered
+    slot 0 as before (``take`` repeats ``MsgGather.take``'s decision; ``pre``'s refusals are ``MsgGather.pre``'s).
+
+    Where the gather starts (the gate): the side stream waits on ``gate``, an event on the main stream that ``mark``
+    records in ``MultiDecoder._round`` just before the round's prelaunched DFlash2 pass (every rank), else at the
+    gather's own enqueue, the point ``MsgGather`` starts it. So after a round the message moves while the pass runs,
+    and otherwise it starts where it did before: its RoCE wait (TF_ROCE_WAIT_S) is at most a pass longer than the old
+    path's, and it never spins on an SM through a verify window or a prompt chunk.
+
+    Why reading it on the side stream is correct - every consumer orders behind the gather: (1) a follower's host
+    reads it through ``sampling.readback`` entered on the side stream, a copy queued behind the gather whose event
+    the host waits on; (2) the next gather into ``mine`` / ``got`` is later on the same side stream; (3) rank 0's
+    pinned staging is rewritten only after ``ready`` (recorded on the side stream behind the staging copy) and
+    ``values_ready`` (on the main stream behind the values' copy). Nothing on the main stream reads or writes
+    ``mine`` or ``got`` (they are even made, zero fill and all, on the side stream: ``_fixed``); the message's effects
+    reach the main stream only through the host, after (1)."""
+
+    def __init__(self, comm, rank: int, world: int, torch) -> None:
+        super().__init__(comm, rank, world, torch)
+        self.side = torch.cuda.Stream()
+        self.gate = torch.cuda.Event()
+        self.marked = False         # ``mark`` recorded the gate since the last gather
+        self.values_ready = None    # rank 0: the values' copy out of the staging buffer (a message past it)
+
+    def mark(self) -> None:
+        """Every rank, just before a round's prelaunched DFlash2 pass (``MultiDecoder._round``): the next message's
+        gather may start from the main stream's point now instead of behind the pass."""
+
+        self.gate.record()
+        self.marked = True
+
+    def _gather(self, mine, got) -> None:
+        """The fixed gather, on the side stream from the gate (``mark``'s point, else the main stream's end now)."""
+
+        if not self.marked:
+            self.gate.record()
+        self.marked = False
+        self.side.wait_event(self.gate)
+        self.comm.msg_gather(mine, got, self.side)
+
+    def _fixed(self):
+        """``MsgGather._fixed``'s buffers, made on the side stream: their zero fill is then queued before the side
+        stream's first copy into ``mine`` (made on a busy main stream, the fill would land after that copy and send
+        zeros)."""
+
+        if self.mine is None:
+            with self.torch.cuda.stream(self.side):
+                return super()._fixed()
+        return self.mine, self.got
+
+    def _staging(self, n: int):
+        if self.values_ready is not None:
+            self.values_ready.synchronize()           # the last long message's values' copy has left it too
+        return super()._staging(n)
+
+    def pre(self) -> None:
+        if self.rank == 0 or self.pending:
+            return super().pre()                      # (its refusals, raised before any gather)
+        self._gather(*self._fixed())
+        self.pending = True
+
+    def send(self, values: list[int], echo: bool = True) -> list[int] | None:
+        torch = self.torch
+        if not exact_ints(values):
+            values = [int(v) for v in values]
+        n = len(values)
+        host = self._staging(n)
+        host[0] = n
+        if n:
+            host[1:1 + n].numpy()[:] = values
+        mine, got = self._fixed()
+        with torch.cuda.stream(self.side):            # behind the side stream's last gather, which read ``mine``
+            mine.copy_(host[:self.ints], non_blocking=True)
+            self.ready.record()                       # the staging copy is enqueued (on the side stream)
+        self._gather(mine, got)
+        if n > self.ints - 1:
+            send, recv = self._values(n)
+            send.copy_(host[1:1 + n], non_blocking=True)
+            self.comm.all_gather(send, recv)
+            if self.values_ready is None:
+                self.values_ready = torch.cuda.Event()
+            self.values_ready.record()
+        return list(values) if echo else None
+
+    def take(self) -> list[int]:
+        from tensorfold.cuda.sampling import readback
+
+        mine, got = self._fixed()
+        if not self.pending:
+            self._gather(mine, got)                   # no pre() since the last message: queue it now
+        self.pending = False
+        with self.torch.cuda.stream(self.side):       # the readback's copy and event behind the gather
+            row = readback(got[:self.ints]).tolist()
+        self.comm.check()                             # a timed-out wait poisons the channel: say so, not a torn message
+        count = row[0]
+        if count <= self.ints - 1:
+            return row[1:1 + count]
+        self.comm.all_gather(*self._values(count))
+        return readback(self.allv[:count]).tolist()
+
