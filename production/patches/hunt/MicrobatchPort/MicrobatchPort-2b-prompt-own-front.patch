+"""TF_GLM_PROMPT_OWN_FRONT=1: a row-split prompt chunk's DSA layers run their replicated front on each rank's own rows.
+
+With the row split (``hcsplit``, TF_GLM_HC_SPLIT=1) each rank ends a layer holding the next layer's normed input for
+its own rows [r H, r H + H) only, and swaps those bf16 rows (hidden 4,096: 8 KiB a row) so that every rank can run the
+next block on every row. KDA blocks and the MoE need every row (their projections are split by heads and experts),
+but a DSA block's front is replicated, not head-split: q_a / kv_a (one projection, ``a.proj``) and their RMSNorms,
+the indexer's key and weight projection (``kw``) and its gate. Every rank ran all of it on every row.
+
+Here, before a DSA layer, the glue keeps the normed rows on their owner (``HcSplit.glue(share=False)``); each rank runs
+that front on its own rows and the ranks share its outputs instead:
+
+1. own rows: q_a / kv_a, their norms (b.qr, b.lat) and q_b for this rank's heads (``forward.dsa_front``, already run
+   during the glue with TF_GLM_PREFILL_OVERLAP=2), and with the indexer the index keys and weights (b.ikr) and gates
+   (b.igr);
+2. shared: b.ikr and b.igr's rows (832 B a row), then b.qr and b.lat's rows (4 KiB a row);
+3. every rank, every row, as before (``forward.dsa_rows(fronted=True)``): q_b for its heads on the other ranks' rows,
+   the latent write, the index update, absorb, dense attention, the token selection (OTS 0101's shard: each rank its
+   own rows' pools), sparse attention, expand; then o_proj into the split's partials.
+
+Every kernel is the unchanged path's on the same row (the projections, norms and writers keep rows apart), so the
+caches and every output are the unchanged path's bit for bit, and identical on every rank: what each rank writes it
+computed from the same shared bytes. The selection's half (the indexer's top-k on own rows) is OTS 0101's, already in
+the tree; this is the recipe's tp4 0102 without it.
+
+Order: with the overlap (TF_GLM_PREFILL_OVERLAP=1 or 2) the shares run on the split's side stream, in one order on
+every rank (index keys, then the rows). Without it they run in place. Not for several streams' prompts in one chunk
+(``multi_prefill``'s mixer), chunks too short to split, decode and verify windows, TF_GLM_KV_SHARD, nor without the
+latent cache: those keep the unchanged path.
+
+Ported from the GLM-5.3 recipe's tp4 patch 0102 (Mia's AI Lab, Apache-2.0), its non-indexer half. Design credit:
+drowzeys (github.com/drowzeys/TensorFold, branch glm53-tp4-2026-10-05, ``compute_prompt_sp`` with
+TF_GLM53_SP_SELECT); no code of theirs."""
+
+from __future__ import annotations
+
+from . import glue, latent, prof, qmm, shard
+
+
+def applies(w, st, b, mixer, host_pos) -> bool:
+    """Whether a row-split prompt chunk's DSA layers take the own-row front: TF_GLM_PROMPT_OWN_FRONT, one stream's
+    prompt on ``st`` (no ``mixer``), its position known on the host, the latent cache without the shard."""
+
+    sp = b.split
+    return (sp is not None and sp.settings.own_front and mixer is None and st is not None and host_pos is not None
+            and b.prefill and latent.ENABLED and not shard.ON)
+
+
+def takes(layer) -> bool:
+    """A layer whose attention block runs here: DSA on the latent cache."""
+    return layer.kind == "dsa" and layer.dsa.absorb is not None
+
+
+def dsa_block(layer, w, st, b, R: int, nch: int | None, host_pos: int, done: tuple[int, int] | None = None):
+    """A DSA block of a row-split prompt chunk with its replicated front on this rank's rows (the module's steps);
+    this rank's partials go out through the split (None returned). ``done``: rows ``forward.dsa_front`` already ran
+    on (the glue's fronts, TF_GLM_PREFILL_OVERLAP=2)."""
+
+    from .forward import dsa_front, dsa_rows, mm, out_proj, undone
+
+    c = w.cfg
+    a = layer.dsa
+    sp = b.split
+    di = st.dsa_index[layer.index]
+    index = st.index[di] if st.index is not None else None
+    lo, hi = sp.own()
+    # 1. the replicated front on this rank's rows
+    with prof.timed("dsa: own front"):
+        if hi > lo:
+            if done != (lo, hi):
+                dsa_front(layer, w, b, lo, hi)
+            if index is not None:
+                mm(b, b.normed[lo:hi], a.index.kw, b.xs[lo:hi], b.ikr[lo:hi])
+                glue.router(b.normed[lo:hi], a.index.gate, b.igr[lo:hi])
+    # 2. shared: the index keys and gates, then the norms' rows (one order on every rank)
+    ev_keys = sp.share([b.ikr, b.igr], slot=0) if index is not None else None
+    ev_rows = sp.share([b.qr, b.lat], slot=1)
+    # 3. every row: q_b for this rank's heads on the other ranks' rows, then the block as before
+    sp.wait(ev_rows)
+    with prof.timed("dsa: projections"):
+        for x, z in undone(R, (lo, hi)):
+            mm(b, b.qr[x:z], a.q_b, b.xs_qr[x:z], b.q[x:z].view(z - x, a.heads * c.qk_dim))
+    sp.wait(ev_keys)
+    o = dsa_rows(a, w, st.kc[di], st.pos_dev, b, R, nch, index, host_pos, None, layer.index, fronted=True)
+    return out_proj(w, b, o, a.o, qmm.group_sums(o, b.xs_ao[:R]), R, site=(layer.index, "a"))
