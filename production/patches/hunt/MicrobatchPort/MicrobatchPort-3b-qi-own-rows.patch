+def prompt_rows(n: int, rank: int, world: int) -> tuple[int, int]:
+    """The rows [lo, hi) of an n-row block of a prompt window whose pools ``rank`` scores (``prompt_shard_rows``:
+    ceil(n / world) a rank, the last short): the only rows of the block's index queries (qi) it reads."""
+    step = -(-n // world)
+    return min(rank * step, n), min((rank + 1) * step, n)
+
+
+def read_rows(R: int, rank: int, world: int, blocks=()) -> list[tuple[int, int]]:
+    """Every row range of an R-row window whose index queries ``rank`` reads: its rows of each block the selection
+    gathers (PrefillLeftovers-3's ``blocks``; () or None: the window as one), non-empty, in order."""
+    out = []
+    for s0, s1 in (blocks or ((0, R),)):
+        lo, hi = prompt_rows(s1 - s0, rank, world)
+        if hi > lo:
+            out.append((s0 + lo, s0 + hi))
+    return out
+
+
