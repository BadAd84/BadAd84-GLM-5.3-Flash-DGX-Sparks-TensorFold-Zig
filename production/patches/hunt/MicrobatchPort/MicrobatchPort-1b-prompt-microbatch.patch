+"""TF_GLM_PROMPT_MICROBATCH=1: a row-split prompt chunk in two halves, one's exchanges under the other's compute.
+
+The row split (``hcsplit``) exchanges, at each of a layer's two sites, every rank's fp32 partials of the other ranks'
+rows, then glues its own rows and swaps the glued (normed) rows. With the overlap (TF_GLM_PREFILL_OVERLAP) the
+exchanges run on a side stream, but the main stream soon waits for them: the glue needs the partials, the next block
+the glued rows, and little else is left to compute. At three ranks a 4,096-row chunk moves ~32 MiB a peer each way
+at each of its 90 sites.
+
+Here a chunk of R rows at position p is two halves, A = rows [0, h) at p and B = rows [h, R) at p + h (``cut``: h
+about half, a multiple of 64, KDA's chunked grid, and of the world size, so A has no pad row; at three ranks a
+4,096-row chunk is 1,920 + 2,176 rows), each row-split by its own ``HcSplit`` over row views of the prompt buffers
+(``view``: the row-indexed tensors' rows, the KDA and latent scratch rows, its own region of the partial staging;
+the main stream's scratch shared), both on the buffers' one side stream. Per layer the main stream runs
+
+    A's KDA / DSA block, B's, A's MoE (or MLP), B's
+
+and as soon as a half's block has filled its partials, its chain (the partials' exchange, queued by the block's
+``partials``, then the glue on its own rows and the glued rows' swap, ``HcSplit.glue_side``) is queued on the side
+stream, so it runs while the main stream computes the other half: A's after-attention chain under B's attention,
+B's under A's MoE, A's layer-end chain under B's MoE, B's under A's next attention. The main stream waits for a
+half's chain (``HcSplit.join``) only right before that half's next block.
+
+Bits: half A is a chunk of h rows at p and half B one of R - h rows at p + h, layer by layer. A row's arithmetic does
+not depend on the chunking on the 64-token grid (scripts/glm53/v110/tests/kernels/chunkinv: the prompt matmuls and
+glue keep rows apart, partials are summed rank 0 first as before, a row's pools depend on its query and the keys at
+or before it, KDA's chunked recurrence runs from the state at the half's first row on its absolute 32-row
+sub-chunks), and both halves take the whole chunk's ``nch`` and head block for the dense attention, so every bit is
+the whole chunk's. The order keeps every dependency of two chunks run one after the other: B's KDA continues from
+A's state of the layer, B's attention reads A's latents, index keys and pooled keys of the layer (A's block came
+first on the main stream); nothing of A reads B. The side stream touches only a half's own rows and its own region
+of the partial staging. A half's KDA layers flip the state's parity once each (twice a layer for the chunk), which
+the engine keeps for either parity (its graphs are captured for both).
+
+OTS 0101 (TF_GLM_INDEXER_SHARD prefill): a half's DSA block all-gathers its rows' pools on the main stream while the
+other half's chain may be on the side stream; the gather waits for the side stream and the side stream for it
+(``indexer_shard.prompt_shard``'s ``side``), so two collectives never run at once, as KV sharding's fetch does. OTS
+0121 (a kept point inside the chunk): halves only when the point is not in half A (it then splits half B's
+recurrence as it split the chunk's, so the state at the point is the one left in the other parity).
+
+The glue's fronts (TF_GLM_PREFILL_OVERLAP=2) are not run during the halves' glue: the other half's compute covers the
+exchanges instead. Without a side stream (TF_GLM_PREFILL_OVERLAP=0) the chains run in place, in the same order: the
+same bits, no overlap. Layer-sliced prefill (``forward.compute_steps``) joins both halves' side work at each yield, as
+the unhalved split joins its side stream there.
+
+Halves of fewer than TF_GLM_PROMPT_MICROBATCH_MIN_ROWS rows (default 1,920: a 4,096-row chunk at two, three and four
+ranks) run the chunk whole: the routed experts decode each expert's weights once a call, so smaller calls cost more a
+row. Not for several streams' prompts in one chunk (``multi_prefill``), a chunk off the 64-token grid, nor without
+the latent cache or with TF_GLM_KV_SHARD.
+
+Ported from the GLM-5.3 recipe's tp4 patch 0104 (Mia's AI Lab, Apache-2.0) to our tree (OTS 0105's rotated MoE sums,
+OTS 0101's indexer shard, OTS 0121's kept points, the startup comparison outside the spill tier's key). Design credit:
+drowzeys (github.com/drowzeys/TensorFold, branch glm53-tp4-2026-10-05, ``compute_prompt_sp`` with
+TF_GLM53_PROMPT_OVERLAP) authored the two micro-batches whose exchange chains run on a communication stream under the
+other half's compute; no code of theirs."""
+
+from __future__ import annotations
+
+import copy
+import dataclasses
+import math
+from types import SimpleNamespace
+
+import torch
+
+from . import glue, latent, prof, shard, tp
+
+# the prompt buffers' row-indexed tensors (rows first): a half's view is rows [lo, lo + n) of each
+ROWS = ("ids", "hin", "x", "normed", "xs", "post", "comb", "hcpart", "ka", "kg", "xs_fa", "xs_ga", "kxs", "dp", "qr",
+        "xs_qr", "lat", "xs_lat", "q", "kn", "vn", "xs_ao", "ikr", "igr", "qi", "gu", "act", "xs_act", "mlog", "pick",
+        "wts", "ey", "sy", "part", "hidden", "fnormed", "fxs", "me", "mcat", "mxs", "mx")
+GRID = 64                 # KDA's chunked recurrence keeps prompt rows on a 64-row grid (absolute 32-row sub-chunks)
+
+
+def cut(R: int, world: int) -> int:
+    """Half A's rows of a chunk of R: about half, a multiple of 64 and of the world size."""
+
+    unit = GRID * world // math.gcd(GRID, world)
+    return max(unit, (R // 2) // unit * unit)
+
+
+def applies(w, st, b, mixer, host_pos, R: int) -> bool:
+    """Whether a row-split prompt chunk of R rows runs as two halves: TF_GLM_PROMPT_MICROBATCH, one stream's prompt on
+    ``st`` (no ``mixer``) from a position on the 64-token grid known on the host, the latent cache without the shard,
+    no kept point in half A, and both halves of at least the minimum rows (and of what the split takes)."""
+
+    sp = b.split
+    if not (sp is not None and sp.settings.microbatch and mixer is None and st is not None and host_pos is not None
+            and b.prefill and latent.ENABLED and not shard.ON and host_pos % GRID == 0):
+        return False
+    h = cut(R, sp.world)
+    least = max(sp.settings.micro_min, sp.settings.min_rows)
+    if h < least or R - h < least:
+        return False
+    point = int(getattr(st, "keep_point", 0) or 0)
+    return not (point and host_pos < point <= host_pos + h)
+
+
+def view(b, lo: int, n: int, world: int, gath_lo: int):
+    """The prompt buffers' rows [lo, lo + n) (pad rows past them included up to ``n``) as a Buffers-like object for a
+    half: every row-indexed tensor's rows, the half's own region of the partial staging from ``gath_lo``; the scratch
+    the main stream uses one call at a time (attention partials, the experts', the matmuls') shared."""
+
+    v = copy.copy(b)
+    v.__dict__.pop("micro_halves", None)
+    for name in ROWS:
+        t = getattr(b, name, None)
+        if isinstance(t, torch.Tensor):
+            setattr(v, name, t[lo:lo + n])
+    v._views = {}                        # moe_views of the half: the same flat scratch from its start (main stream)
+    if getattr(b, "kproj", None) is not None:
+        v.kproj = b.kproj[:, lo:lo + n]
+        k = b.kscratch
+        v.kscratch = SimpleNamespace(out=k.out[lo:lo + n], k=k.k[lo:lo + n], v=k.v[lo:lo + n], g=k.g[lo:lo + n],
+                                     b=k.b[lo:lo + n])
+    if b.lat_s is not None:
+        v.lat_s = copy.copy(b.lat_s)
+        v.lat_s.qa, v.lat_s.ol = b.lat_s.qa[lo:lo + n], b.lat_s.ol[lo:lo + n]
+    v.taps = [t[lo:lo + n] for t in b.taps]
+    d = b.part.shape[1]
+    v.gath = b.gath[gath_lo:gath_lo + world * n * d]
+    v.rows = v.alloc_rows = n
+    v.split = None
+    return v
+
+
+class Halves:
+    """A chunk's two halves: their buffer views and splits (kept on the buffers for chunks of one size)."""
+
+    def __init__(self, w, b, R: int) -> None:
+        from .hcsplit import HcSplit
+
+        sp = b.split
+        world = sp.world
+        h = cut(R, world)
+        nb = sp.padded(R - h)                 # B's rows with its pad rows (the chunk's last rows of the buffers)
+        if h + nb > b.alloc_rows:
+            raise ValueError(f"microbatch: halves of {h} and {nb} rows past the buffers' {b.alloc_rows}")
+        self.h, self.R = h, R
+        settings = dataclasses.replace(sp.settings, pieces=1, microbatch=False)
+        d = b.part.shape[1]
+        self.a = view(b, 0, h, world, 0)
+        self.b = view(b, h, nb, world, world * h * d)
+        for v in (self.a, self.b):
+            v.split = HcSplit(w, v, settings, stream=sp.stream)
+            v.split.half = True               # (``forward.dsa_rows``: the indexer shard's gather waits for the side)
+
+
+def _halves(w, b, R: int) -> Halves:
+    cache = b.__dict__.setdefault("micro_halves", {})
+    key = (R, id(b.split))
+    hv = cache.get(key)
+    if hv is None:
+        if len(cache) >= 4:                   # a few chunk sizes: a full chunk and a prompt's long tails
+            cache.pop(next(iter(cache)))
+        hv = cache[key] = Halves(w, b, R)
+    return hv
+
+
+def _state(st, at: int):
+    """``st`` from ``at`` rows on: the same caches, KDA states, parities and conv windows (shared objects), its
+    position ``at`` rows later."""
+
+    s = copy.copy(st)
+    s.pos = st.pos + at
+    s.pos_dev = st.pos_dev + at
+    return s
+
+
+def layer_steps(w, st, b, R: int, nch: int | None, host_pos: int, need: tuple[int, ...] | None = None):
+    """``forward.split_layer_steps`` for a chunk in two halves: every layer, yielding after each; the taps whole and
+    b.hidden's rows (``need``: only those, each by its half's owner, as the unhalved loop leaves them; None: every
+    row) at the end."""
+
+    from .forward import _ffn, _mixer
+
+    c = w.cfg
+    layers = w.layers
+    lay = tp.of(w)
+    hv = _halves(w, b, R)
+    halves = ((hv.a, st, hv.h, host_pos), (hv.b, _state(st, hv.h), R - hv.h, host_pos + hv.h))
+    # the final rows a half's glue gathers: its own of ``need``, in its rows (None: every row)
+    fins = (None, None) if need is None else (tuple(r for r in need if r < hv.h),
+                                             tuple(r - hv.h for r in need if r >= hv.h))
+    for half, _, n, _ in halves:
+        half.split.begin(n)
+    b.split.micro = [hv.a.split, hv.b.split]
+    try:
+        # the first hc_pre on every row, as unsplit (B's pad rows: zero streams, as its split's begin left them)
+        Rp = hv.h + hv.b.split.Rp
+        first, h0 = layers[0], layers[0].attn_hc
+        glue.hc_pre(b.x[:Rp], h0.fn, h0.base, h0.scale, first.in_norm, b.normed[:Rp], b.xs[:Rp], b.post[:Rp],
+                    b.comb[:Rp], b.hcpart[:Rp], c.eps, c.hc_eps, c.hc_iters, prompt=True)
+        for i, layer in enumerate(layers):
+            nxt = layers[i + 1] if i + 1 < len(layers) else None
+            for half, hs, n, pos in halves:
+                half.split.join()
+                # (the chunk's nch: every row's dense attention visits the chunks it does in the whole chunk)
+                _mixer(layer, w, hs, half, n, nch, pos, None)
+                with prof.timed("hc"):
+                    half.split.glue_side(layer.ffn_hc, layer.post_norm)
+            for (half, hs, n, pos), fin in zip(halves, fins):
+                half.split.join()
+                _ffn(layer, w, half, n)
+                with prof.timed("hc (layer end)"):
+                    half.split.glue_side(nxt.attn_hc if nxt is not None else None,
+                                         nxt.in_norm if nxt is not None else None,
+                                         taps=tuple(b.tap_at.get(layer.index, ())), final=nxt is None,
+                                         rot=lay.owner(layer.index), rows=fin if nxt is None else None)
+            yield layer.index
+    finally:
+        for half, _, _, _ in halves:
+            half.split.finish()
+        b.split.micro = []
+        b.split.finish()                      # compute_steps re-activated the chunk's split at each resume
