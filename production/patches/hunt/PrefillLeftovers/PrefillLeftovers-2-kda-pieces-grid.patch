+# -- several streams' pieces of a multi-prompt chunk (PrefillLeftovers) --------------------------------------------
+# A multi-prompt chunk (multi_prefill) used to launch chunk_kernel once a piece, H CTAs each, one after another: four
+# fork pieces of 39 rows run 4 x 22 CTAs in four launches on a GB10's 48 SMs. chain_pieces runs pieces in one grid
+# (kda_chunk.cu's chunk_pieces: H CTAs a piece, or 2 H as producer / consumer clusters), each CTA its own piece's
+# rows, conv window and state, so each piece has the bits of its own launch. Which pieces share a launch, and in which
+# form, is a speed choice from a model of the launches (``launch_plan``); every plan gives the same bits.
+#
+# The model, in units of one sub-chunk of one head on one SM (RTX 5070: 20.5 us one CTA a head, HuntPrefill-1): a
+# CTA of a piece of n sub-chunks costs n one CTA a head, 0.63 n + 1.5 as a pair (12.9 / 20.5 a sub-chunk; the
+# pipe's first sub-chunk runs on the producer alone and its last on the consumer alone); a grid's CTAs run in
+# waves over the slots the GPU holds at once (its SMs x blocks an SM; clusters for pairs), assigned in launch order,
+# longest pieces first; a launch costs LAUNCH more. The plan with the least modelled time wins: the longest pieces
+# alone (each as a pair when that wins and the GPU holds a cluster for every head), the rest in one grid. Measured on
+# the RTX 5070 (bench_kda_pieces.py): a 4,096-row chunk of 16 heads takes 2.646 ms one CTA a head and 1.624 as pairs
+# (0.614 of it; the model says 0.642); the plan beat one launch a piece in all 10 shapes measured (-2% to -45%).
+# Speed only: a GB10 run of the same bench recalibrates PIECE_PAIR and PIECE_LAUNCH.
+PIECE_PAIR = (0.63, 1.5)
+PIECE_LAUNCH = 0.25
+
+
+def pieces_mode(value: str | None = None) -> str:
+    """TF_GLM_KDA_PIECES: ``plan`` (default) runs a multi-prompt chunk's pieces by ``launch_plan``; ``grid``: every
+    piece in one grid of one CTA a head; ``0``: one launch a piece, as before (``forward.kda_rows`` each). The same
+    bits whichever is set."""
+    import os
+
+    value = (os.environ.get("TF_GLM_KDA_PIECES", "") if value is None else value).strip() or "plan"
+    if value not in ("plan", "grid", "0"):
+        raise ValueError(f"TF_GLM_KDA_PIECES: plan, grid or 0, not {value!r}")
+    return value
+
+
+def subchunks(rows: int, off: int) -> int:
+    """The 32-row sub-chunks a prompt piece of ``rows`` rows starting ``off`` rows into its sub-chunk runs."""
+    return (int(rows) + int(off) + CHUNK - 1) // CHUNK
+
+
+def _grid_cost(subs: list[int], H: int, slots: int, pair: bool) -> float:
+    """A grid's modelled time: its pieces' H CTAs each (longest piece first) in waves over ``slots``."""
+    import heapq
+
+    a, b = PIECE_PAIR
+    free = [0.0] * max(1, min(slots, H * len(subs)))
+    for n in sorted(subs, reverse=True):
+        t = a * n + b if pair else float(n)
+        for _ in range(H):
+            heapq.heapreplace(free, free[0] + t)
+    return max(free)
+
+
+@lru_cache(maxsize=256)
+def launch_plan(rows: tuple, offs: tuple, H: int, slots: int, clusters: int, pipe: bool,
+                mode: str = "plan") -> tuple:
+    """The launches of a multi-prompt chunk's pieces: ((pair, (piece indices, longest first)), ...). ``slots``: the
+    GPU's one-CTA-a-head CTAs at once (``slots()``); ``clusters``: its pairs at once; ``pipe``: pairs allowed
+    (``pipe_on()``). Speed only."""
+    subs = [subchunks(r, o) for r, o in zip(rows, offs)]
+    order = tuple(sorted(range(len(rows)), key=lambda i: (-subs[i], i)))
+    if mode == "grid":
+        return ((False, order),)
+
+    def alone(i: int) -> tuple[float, bool]:
+        one = _grid_cost([subs[i]], H, slots, False)
+        if pipe and clusters >= H:                   # kda_chunk_cuda's pair needs a cluster for every head
+            two = _grid_cost([subs[i]], H, clusters, True)
+            if two < one:
+                return two, True
+        return one, False
+
+    best = None
+    for k in range(len(order) + 1):
+        solo, rest = order[:k], order[k:]
+        cost, plan = 0.0, []
+        for i in solo:
+            t, pair = alone(i)
+            cost += t + PIECE_LAUNCH
+            plan.append((pair, (i,)))
+        if len(rest) == 1:
+            t, pair = alone(rest[0])
+            cost += t + PIECE_LAUNCH
+            plan.append((pair, rest))
+        elif rest:
+            t, pair = _grid_cost([subs[i] for i in rest], H, slots, False), False
+            if pipe and clusters > 0:
+                two = _grid_cost([subs[i] for i in rest], H, clusters, True)
+                if two < t:
+                    t, pair = two, True
+            cost += t + PIECE_LAUNCH
+            plan.append((pair, rest))
+        if best is None or cost < best[0] - 1e-9:
+            best = (cost, tuple(plan))
+    return best[1]
+
+
+@lru_cache(maxsize=1)
+def _GPU() -> tuple[int, int, bool]:
+    pipe = _PIPE()
+    return int(_ext().slots()), clusters() if pipe else 0, pipe
+
+
+def slots() -> int:
+    """The one-CTA-a-head CTAs this GPU runs at once (SMs x chunk_pieces' blocks an SM)."""
+    return int(_ext().slots())
+
+
+def chain_pieces(pieces, b_off: int, conv_w: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor,
+                 norm_w: torch.Tensor, eps: float, lower: float, *, plan: tuple | None = None,
+                 mode: str | None = None) -> tuple:
+    """``chain`` over several streams' pieces of one multi-prompt chunk: ``pieces`` a sequence of (p, a, g,
+    conv_state, state_in, out, state_out, rows, pos), as ``chain`` takes them; each piece's out[:rows] and state_out
+    written with the bits of its own ``chain`` call. Launches by ``launch_plan`` (``plan``: given launches instead);
+    returns the plan run."""
+
+    H = a_log.numel()
+    rows = tuple(int(x[7]) for x in pieces)
+    offs = tuple(int(x[8]) % CHUNK for x in pieces)
+    if plan is None:
+        nslots, nclu, pipe = _GPU()
+        plan = launch_plan(rows, offs, H, nslots, nclu, pipe, mode or pieces_mode())
+    ext = _ext()
+    for pair, idx in plan:
+        if len(idx) == 1:
+            p, a, g, cs, s_in, out, s_out, n, _ = pieces[idx[0]]
+            ext.chain(p, p.stride(0), int(b_off), a, a.stride(0), g, g.stride(0), cs, conv_w, s_in, a_log, dt_bias,
+                      norm_w, float(eps), float(lower), rows[idx[0]], offs[idx[0]], out, s_out, bool(pair))
+            continue
+        sel = [pieces[i] for i in idx]
+        p0 = sel[0][0]
+        ext.chain_pieces([x[0] for x in sel], p0.stride(0), int(b_off), [x[1] for x in sel], sel[0][1].stride(0),
+                         [x[2] for x in sel], sel[0][2].stride(0), [x[3] for x in sel], conv_w,
+                         [x[4] for x in sel], a_log, dt_bias, norm_w, float(eps), float(lower),
+                         [rows[i] for i in idx], [offs[i] for i in idx], [x[5] for x in sel], [x[6] for x in sel],
+                         bool(pair))
+    return plan
+
+
 @lru_cache(maxsize=1)
 def _PIPE() -> bool:
     return pipe_on()
