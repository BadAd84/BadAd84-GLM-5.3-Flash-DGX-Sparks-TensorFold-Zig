+def prompt_shard_rows(qi, wts, pk, pos: int, R: int, np_max: int, pos_dev, comm, s0: int, s1: int, tokens, counts,
+                      buf, cand) -> None:
+    """prompt_shard over rows s0 .. s1 of the R-row piece only, into tokens[s0:s1] / counts[s0:s1]: this rank scores
+    and selects its share of those rows (contiguous slices of ceil((s1 - s0) / world), with the piece's NP, so each
+    row's pools are its own), one all-gather of the rows' pools, then _tokens over them at their positions. Every
+    rank must run the same blocks (PrefillLeftovers-3's TF_GLM_PROMPT_OVERLAP, agreed at start) in the same order."""
+    n = s1 - s0
+    step = -(-n // comm.world)                                # every rank sends step rows (the last padded)
+    lo, hi = s0 + min(comm.rank * step, n), s0 + min((comm.rank + 1) * step, n)
+    mine = torch.empty((step, TOPK_POOLS), dtype=torch.int32, device=qi.device)
+    if hi - lo < step:                                        # the padded rows (never read after the gather)
+        mine[hi - lo:].zero_()
+    prefill_rank_pools(qi, wts, pk, pos, R, np_max, pos_dev, lo, hi, buf, cand, out=mine[:hi - lo])
+    pools = _all_gather(comm, mine).view(comm.world, step, TOPK_POOLS).reshape(-1, TOPK_POOLS)[:n]
+    at = pos_dev if s0 == 0 else pos_dev + s0
+    sparse._tokens[(n,)](pools, at, tokens[s0:s1], counts[s0:s1], W=tokens.shape[1], K=TOPK_POOLS, PL=POOL,
+                         BLOCK=1024, num_warps=4)
+
