+# TF_GLM_PROMPT_OVERLAP (PrefillLeftovers-3): a prompt piece's sparse rows in blocks, the token selection of block j + 1
+# (indexer scoring + selection, and with TF_GLM_INDEXER_SHARD=prefill its all-gather: tensor-pipe-bound) on a side
+# stream beside the sparse attention of block j (sparse_onepass: DRAM-bound) on the current one. The same kernels on
+# the same rows: a row's tokens are its own (the piece's NP, its own position) and onepass's rows are independent, so
+# the same bits. 0 (default): off; 1: blocks of OVERLAP_ROWS; N (a multiple of 512): blocks of N rows. Every rank
+# must use the same blocks (each block is one all-gather under the shard): the engine checks the ranks agree.
+OVERLAP_ROWS = 1024
+
+
+def prompt_overlap(value: str | None = None) -> int:
+    """TF_GLM_PROMPT_OVERLAP's block rows (0: off)."""
+    import os
+
+    value = (os.environ.get("TF_GLM_PROMPT_OVERLAP", "") if value is None else value).strip() or "0"
+    rows = OVERLAP_ROWS if value == "1" else int(value) if value.isdecimal() else -1
+    if rows < 0 or (rows and rows % sparse.SELECT_ROWS):
+        raise ValueError(f"TF_GLM_PROMPT_OVERLAP: 0, 1 or rows a block (a multiple of {sparse.SELECT_ROWS}), "
+                         f"not {value!r}")
+    return rows
+
+
+_OVERLAP = prompt_overlap()
+_OVERLAP_STREAMS: dict = {}
+
+
+def overlap_blocks(R: int, rows: int | None = None) -> tuple:
+    """A piece's row blocks [(s0, s1), ...] for TF_GLM_PROMPT_OVERLAP, () when off or the piece is one block."""
+    rows = _OVERLAP if rows is None else rows
+    if not rows or R <= rows:
+        return ()
+    return tuple((s, min(R, s + rows)) for s in range(0, R, rows))
+
+
+def _overlap_stream(dev) -> torch.cuda.Stream:
+    s = _OVERLAP_STREAMS.get(dev)
