 from __future__ import annotations
 
+import hashlib
+import importlib
+import json
 import os
+import shutil
+import sys
+import threading
 import time
 from pathlib import Path
+from typing import Any, Callable
+
+FORMAT = 2                       # the folder format (manifest layout, encoding): a change misses every old folder
+CHUNK = 64 << 20                 # reader / checksum chunk (bytes); every chunk offset is a multiple of it
+ALIGN = 4096                     # storage offsets and the file size (O_DIRECT)
+SAMPLE_EVERY = 16                # TF_GLM_PREPARED_VERIFY=sample: every 16th chunk (and the last); full is the default
+KEEP = 2                         # key folders kept a rank and model (each ~50 GiB at TP=3)
 
