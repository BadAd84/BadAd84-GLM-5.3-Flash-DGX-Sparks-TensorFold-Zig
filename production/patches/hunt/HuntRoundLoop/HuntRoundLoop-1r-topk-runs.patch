 # -- sampling --------------------------------------------------------------------------------------------------------
+def _adjacent(a: torch.Tensor, b: torch.Tensor) -> bool:
+    """``b``'s rows follow ``a``'s in one buffer: same storage, dtype and row layout (unit column stride), b's first
+    row right after a's last (the parts of a batched verify window, ``verify.BatchedVerify.forward``)."""
+
+    if a.dim() != 2 or b.dim() != 2 or a.dtype != b.dtype or a.device != b.device or a.shape[1] != b.shape[1]:
+        return False
+    if a.stride() != b.stride() or a.stride(1) != 1 or a.stride(0) < a.shape[1]:
+        return False
+    if a.untyped_storage().data_ptr() != b.untyped_storage().data_ptr():
+        return False
+    return b.storage_offset() == a.storage_offset() + a.shape[0] * a.stride(0)
+
+
+def topk_words(w, items: Sequence[tuple]) -> torch.Tensor:
+    """[(logits [R_k, V/world], n_k)] in order -> one flat fp32 tensor: each item's top n_k values of every row, then
+    their ids (plus the rank's vocabulary offset, as int32 bits), row after row - what ``torch.topk(logits.float(),
+    n_k)`` of each item gives, concatenated in order. A run of consecutive items with the same n whose rows are adjacent
+    in one buffer takes ONE topk over all its rows: a row's top-k does not depend on the rows beside it (values and
+    ids, ties included; HuntRoundLoop test_topk_runs.py checks it on the serve's torch), so the words are the same, at
+    one launch sequence (~25 radix kernels) for the run instead of one a stream."""
+
+    words: list[torch.Tensor] = []
+    run: list[torch.Tensor] = []
+    run_n = 0
+    for logits, n in [*items, (None, 0)]:
+        if run and (logits is None or n != run_n or not _adjacent(run[-1], logits)):
+            first = run[0]
+            rows = first if len(run) == 1 else torch.as_strided(
+                first, (sum(x.shape[0] for x in run), first.shape[1]), first.stride(), first.storage_offset())
+            vals, ids = torch.topk(rows.float(), run_n, dim=-1)
+            ids = (ids + w.vocab_offset).to(torch.int32)
+            words.append(torch.cat([vals, ids.view(torch.float32)], dim=1).reshape(-1))
+            run = []
+        if logits is not None:
+            run.append(logits)
+            run_n = n
+    return torch.cat(words) if len(words) > 1 else words[0]
+
+
