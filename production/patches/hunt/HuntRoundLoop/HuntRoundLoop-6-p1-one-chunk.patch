+    def _one_chunk(self, n: int, point: int | None, begin: int, mtp: bool, drafter) -> bool:
+        """--parallel 1, TF_GLM_ONE_CHUNK_WARM (OTS 0121, as ``multi.MultiDecoder._inner_ok``; every rank alike): whether
+        an n-token prompt prefilled from ``begin`` keeps its grid point ``point`` (< n) inside its last chunk rather than
+        at a chunk of its own. Not with the MTP head (its pending rows are a chunk stop's), not when a chunk of the
+        prompt ends exactly at the point (it is kept at that stop as before), and not when the rows past the point
+        would overwrite its DFlash2 window in the drafter's ring (n - point >= ring - window). The point and n lie in
+        one grid cell and chunks start on the grid, so the chunk holding the point is the last."""
+
+        from .multi import ONE_CHUNK
+
+        if not ONE_CHUNK or point is None or mtp or not begin < point < n:
+            return False
+        if (point - begin) % self.e.prefill_rows == 0:
+            return False
+        ring = getattr(drafter, "ring", 0) if drafter is not None else 0
+        return not (ring and n - point >= ring - drafter.window)
+
     def _drop(self, snap) -> None:
