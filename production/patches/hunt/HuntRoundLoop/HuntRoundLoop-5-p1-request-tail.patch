+PID_MOD = 2_147_483_647
+
+
+def prefix_pid(ids, start: int = 0, stop: int | None = None, base: tuple[int, int] = (0, 0)) -> tuple[int, int]:
+    """--parallel 1: the identity of ``ids[:stop]`` both ranks compute alike, extended from ``base`` (``ids[:start]``'s)
+    by the ids start .. stop: two sums mod 2^31 - 1 of each id weighted by its position (p + 1 and (p + 1)^2), so a kept
+    state's identity is its resume point's plus its own new rows' (O(new rows)). Rank 0 names the kept state a
+    request resumes from by it and sends only the ids past it (``generate``); a follower finds the state by its
+    length, salt and identity and rebuilds the prompt from the state's ids (``follow_one``)."""
+
+    import numpy as np
+
+    a = np.asarray(ids[start:stop], dtype=np.int64)
+    if not a.size:
+        return base
+    p = np.arange(start + 1, start + 1 + a.size, dtype=np.int64)
+    h1 = (base[0] + int(((a * p) % PID_MOD).sum())) % PID_MOD
+    h2 = (base[1] + int(((a * (p * p % PID_MOD)) % PID_MOD).sum())) % PID_MOD
+    return h1, h2
+
+
+def snap_pid(snap) -> tuple[int, int]:
+    """A kept state's ``prefix_pid`` (kept with it by ``_run_once``; worked out once for one that came without it)."""
+
+    pid = getattr(snap, "pid", None)
+    if pid is None:
+        pid = snap.pid = prefix_pid(snap.ids)
+    return pid
+
