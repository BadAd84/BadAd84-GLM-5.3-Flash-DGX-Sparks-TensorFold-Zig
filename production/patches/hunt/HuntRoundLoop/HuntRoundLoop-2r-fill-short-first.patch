+def fill_short_rows(prefill_rows: int, value: str | None = None) -> int:
+    """TF_GLM_FILL_SHORT_ROWS (TF_GLM_MULTI_PREFILL only): a filling prompt with at most this many rows left takes the
+    next prompt chunk before older, longer ones (``MultiDecoder._fill_turn``; default four prompt chunks, 0: the oldest
+    first, as before). The chunks each prompt runs are the ones it runs anyway: scheduling only, the same bits."""
+
+    value = (os.environ.get("TF_GLM_FILL_SHORT_ROWS", "") if value is None else value).strip()
+    rows = 4 * int(prefill_rows) if value == "" else int(value) if value.isdecimal() else -1
+    if rows < 0:
+        raise ValueError(f"TF_GLM_FILL_SHORT_ROWS: rows (0: off), not {value!r}")
+    return rows
+
