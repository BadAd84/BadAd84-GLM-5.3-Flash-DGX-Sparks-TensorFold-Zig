+def fast_slices(value: str | None = None) -> bool:
+    """TF_GLM_FILL_FAST_SLICES (0, the default: off; needs TF_GLM_FILL_FAST_MS): a prompt chunk that ends every prompt in
+    it runs in slices of up to TF_GLM_FILL_FAST_MS instead of TF_GLM_FILL_BUDGET_MS beside decoding streams, so a warm
+    turn waits for fewer decode rounds; the decoding streams pause up to TF_GLM_FILL_FAST_MS a slice, which 0122 already
+    allows for the chunk's last slice. Scheduling only: the same bits."""
