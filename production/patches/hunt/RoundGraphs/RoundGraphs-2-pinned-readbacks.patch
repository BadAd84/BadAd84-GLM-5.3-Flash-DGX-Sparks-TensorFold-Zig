 MASS = 2.0 ** 40        # a token's share of the mass in fixed point: shard sums are exact, so ranks agree bit for bit
 NUCLEUS = 1024          # candidates a rank reads for a top_k-off draw; a row they don't cover reads whole shards
 
+_READBACK: dict = {}
+
+
+def readback(t: torch.Tensor, slot=0) -> torch.Tensor:
+    """``t.cpu()``'s values (a CPU tensor of t's shape and dtype) through a pinned host buffer and an event; ``slot``:
+    one buffer a slot, device and thread, which the slot's next readback on that thread reuses (read the result
+    before). LEADS #3: a pageable ``.cpu()`` is a synchronous copy that holds every other thread's CUDA call until the
+    round ends (8-9 ms a call beside decode, docs/notes/pr124-round2-2026-10-11.md); a pinned copy and an event wait
+    do not. A CPU tensor: ``.cpu()``. Slots in use: 0 / 1 (multi.sample_streams, MsgGather.take,
+    multi_tune.sample_packed), "nucleus" / "nucleus+" (``nucleus_rows``' first and later candidate reads),
+    "sample_rows" (``decode.sample_rows``), "gather_ints" (``GlmEngine._gather_ints``, which the spill
+    tier also calls)."""
+
+    if t.device.type != "cuda":
+        return t.cpu()
+    t = t.contiguous()
+    nbytes = t.numel() * t.element_size()
+    key = (t.device.index, slot, threading.get_ident())
+    held = _READBACK.get(key)
+    if held is None or held[0].numel() < nbytes:
+        size = max(nbytes, 1 << 16, 2 * held[0].numel() if held is not None else 0)
+        held = _READBACK[key] = (torch.empty((size,), dtype=torch.uint8, pin_memory=True), torch.cuda.Event())
+    buf, ev = held
+    host = buf[:nbytes].view(t.dtype).view(t.shape)
+    host.copy_(t, non_blocking=True)
+    ev.record()
+    ev.synchronize()
+    return host
+
 
