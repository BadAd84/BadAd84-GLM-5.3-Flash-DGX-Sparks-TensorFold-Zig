@@ -481,6 +481,25 @@
     return bool(s.lone or s.profile or verify_kind(e.get("TF_GLM_MULTI_VERIFY", "")) == "serial")
 
 
+def solo_drafter_graphs(solo: bool, env=None) -> bool:
+    """BootLeft: whether the solo DFlash2 drafter's CUDA graphs are captured at start (``dflash2.Drafter.capture``: its
+    block pass and context updates of 1 .. TF_GLM_MAX_ROWS rows, each after an eager run whose gathers every rank
+    joins). Only that drafter's own calls replay them (``Drafter.candidates`` / ``add_taps``: the one-stream decode,
+    ``drafter_choice``, ``draft_dump``, ``GlmEngine._calibrate``). Under --parallel every request runs through
+    ``MultiDecoder``, whose ``MultiDrafter`` captures graphs of its own over the same weights, so the one caller left
+    there is ``_calibrate``, which runs only when ``MultiDecoder.fcost_costs`` has no batched window graphs to price
+    on: TF_GLM_MULTI_GRAPHS=0 (``multi.batched_graphs``) or the serial verify seam (which sets ``solo``). So: captured
+    whenever the one-stream graphs are (``solo``: --parallel 1, TF_GLM_SOLO_GRAPHS=1, the lone stream, the profile,
+    the serial seam) or the batched windows have no graphs; otherwise nothing would ever replay them. Every rank
+    decides alike (the answer is in the ranks' settings comparison)."""
+
+    if solo:
+        return True
+    from .multi import batched_graphs
+
+    return not batched_graphs(env)
+
+
