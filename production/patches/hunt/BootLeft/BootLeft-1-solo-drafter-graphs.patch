+def batched_graphs(env=None) -> bool:
+    """TF_GLM_MULTI_GRAPHS: the batched verify window's CUDA graphs, one a window size (1, the default; 0: eager
+    windows, the same bits). ``MultiDecoder`` captures them; ``engine.solo_drafter_graphs`` reads it too."""
+
