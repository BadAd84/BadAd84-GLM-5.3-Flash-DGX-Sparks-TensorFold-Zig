-                rooms = [r[0] for r in self._gather_ints([max(0, plan["budget_bytes"] - plan["total_bytes_estimate"])])]
+                # (bytes: GiBs a rank, past int32: two words a value, ``gather_bytes``)
+                room = max(0, plan["budget_bytes"] - plan["total_bytes_estimate"])
+                rooms = [r[0] for r in gather_bytes(self._gather_ints, [room])]
