+    def _encode_ahead(self, lane: Lane) -> list[Stream] | None:
+        """PoolP8, rank 0, before anything about the lane's next prompt chunk is decided or sent (a FILL, a FILLPART,
+        an MFILL: image prompts are never grouped, ``_group``): a lazy image prompt's pictures for that chunk (the rows
+        ``_stop`` gives it, as the fill paths below do), encoded now. A tower failure fails this request alone, as at
+        its admission: its error to its client (``finish`` then FINISHes it on every rank, freeing its slot and rows),
+        the states its own prefill kept (kid >= its feed's ``kid0``; not a state it resumed from) evicted; every other
+        stream goes on untouched. None: nothing failed."""
+
+        from .engine import LazyVisionFeed
+
+        feed = lane.feed
+        if not isinstance(feed, LazyVisionFeed) or lane.head is not None:
+            return None
+        start = lane.st.pos
+        try:
+            feed.prepare(start, self._stop(lane) - start)
+        except Exception as exc:                 # noqa: BLE001  (this request fails, the others go on)
+            for c in [c for c in lane.extent.kept if c.kid >= feed.kid0]:
+                self._evict(c)
+            feed.held.clear()
+            lane.s.error = exc
+            lane.s.done = True
+            return [lane.s]
+        return None
 
