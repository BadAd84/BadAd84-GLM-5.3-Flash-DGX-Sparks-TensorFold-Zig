+class LazyVisionFeed(VisionFeed):
+    """PoolP8, rank 0: a feed whose pictures the tower encodes as the prefill reaches them, for a request with more
+    feature rows than startup set aside (``vision_rows_reserved``). Before a chunk is sent to the other ranks the
+    decoder encodes the items it will read a row of (``prepare``: a failure fails this request alone, nothing of the
+    chunk sent yet) and drops the items whose rows all lie before it, so at most the items one chunk spans are held.
+    The tower encodes every item on its own, in passes of that item's frames only (``GlmVisionTower.features``), so an
+    item's rows are the same bits whichever other items share its call: the rows, ids and replies of the eager feed."""
+
+    def __init__(self, engine: GlmEngine, positions: list[int], prepared) -> None:
+        super().__init__(engine, positions, None)
+        if sum(prepared.item_rows) != len(positions):
+            raise ValueError(f"{sum(prepared.item_rows)} feature rows in the items for {len(positions)} positions")
+        self.prepared = prepared
+        self.ends: list[int] = []             # feed row past each item's last
+        for rows in prepared.item_rows:
+            self.ends.append((self.ends[-1] if self.ends else 0) + int(rows))
+        self.held: dict[int, Any] = {}        # item -> its rows, on the device
+        self.peak_rows = 0                    # the most feature rows held at once (tests, logs)
+        self.kid0 = 0                         # the decoder's next kept-state id at admission (its own states: >= this)
+
+    def prepare(self, start: int, count: int) -> None:
+        """The items prompt rows start .. start + count read, encoded now (``chunk`` then only slices them)."""
+
+        import bisect
+
+        lo = bisect.bisect_left(self.positions, start)
+        hi = bisect.bisect_left(self.positions, start + count)
+        if lo < hi:
+            self._ensure(lo, hi)
+
+    def _ensure(self, lo: int, hi: int) -> tuple[int, int]:
+        """Feed rows lo .. hi's items held (encoded if not), the ones before them dropped -> (first, last) item."""
+
+        import bisect
+        import time
+        from dataclasses import replace
+
+        first = bisect.bisect_right(self.ends, lo)         # the item holding row lo
+        last = bisect.bisect_left(self.ends, hi)           # the item holding row hi - 1
+        for k in [k for k in self.held if k < first]:     # the prefill is past every row of these
+            del self.held[k]
+        missing = [k for k in range(first, last + 1) if k not in self.held]
+        if missing:
+            t = time.perf_counter()
+            a, b = missing[0], missing[-1] + 1             # (a run: items are only ever dropped from the front)
+            p = self.prepared
+            part = replace(p, items=p.items[a:b], positions=[], item_rows=p.item_rows[a:b], item_keys=p.item_keys[a:b])
+            rows = self.engine.vision.features(part)
+            if rows.shape[0] != self.ends[b - 1] - self.ends[a] + int(p.item_rows[a]):
+                raise ValueError(f"the tower gave {rows.shape[0]} rows for items {a}..{b - 1}")
+            at = 0
+            for k in range(a, b):
+                n = int(p.item_rows[k])
+                self.held[k] = rows[at:at + n]
+                at += n
+            self.encode_s += time.perf_counter() - t
+        self.peak_rows = max(self.peak_rows, sum(int(self.prepared.item_rows[k]) for k in self.held))
+        return first, last
+
+    def _mine(self, lo: int, hi: int):
+        torch = self.engine.torch
+        first, last = self._ensure(lo, hi)
+        starts = [self.ends[k] - int(self.prepared.item_rows[k]) for k in range(first, last + 1)]
+        parts = [self.held[k][max(lo, s) - s:min(hi, self.ends[k]) - s] for k, s in zip(range(first, last + 1), starts)]
+        return (parts[0] if len(parts) == 1 else torch.cat(parts)).contiguous()
