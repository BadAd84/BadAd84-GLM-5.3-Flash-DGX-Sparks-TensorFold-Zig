+def vision_rows_reserved(row_bytes: int, workspace: int | None = None) -> int:
+    """PoolP8: the feature rows of ``row_bytes`` each (the hidden size in bf16: 8 KiB) a request's pictures may hold
+    at once within what startup set aside for the tower (``vision_workspace``): the 16,384 its base was sized for
+    (TensorFold's own request picture budget, 128 MiB of it), plus one for every ``row_bytes`` set aside past the base
+    (the recipe's scripts/config.sh reserves them for a request picture budget past 16,384). A request past this
+    count has its pictures encoded as its prefill reaches them (``LazyVisionFeed``), not all before its ADMIT."""
+
+    from tensorfold.vision.glm import GlmVisionLimits
+
+    base = VISION_WORKSPACE * max(4096, GlmVisionLimits.from_env().image_tokens) // 4096
+    workspace = vision_workspace() if workspace is None else int(workspace)
+    return VISION_BASE_ROWS + max(0, workspace - base) // int(row_bytes)
 
 
