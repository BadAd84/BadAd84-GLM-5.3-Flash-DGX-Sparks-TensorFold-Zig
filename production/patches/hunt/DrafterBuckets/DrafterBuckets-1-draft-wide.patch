+# TF_GLM_DRAFT_WIDE=<rows>[:prompt] (lane DrafterBuckets; 0, the default: off, every update in ``t_max``-row launches
+# as before): one stream's update of more than ``t_max`` rows (a prompt chunk) runs eagerly in launches of up to that
+# many rows, after the rows it overwrites itself in the ring (all but its last ``ring``) are dropped, so no launch holds
+# two rows of one ring row. A wide launch sweeps the 4-bit fc weight once per L2 group of row tiles (qmm.cu's
+# ``group``) instead of once per ``t_max`` rows. Every kernel of an update is row-independent (``_taps_rows``), so the
+# ring rows, device ends and context ends are the bits of the ``t_max`` launches; the trash rows (written only by a
+# padded graph launch, read by nothing) are left alone. ``:prompt``: a wide launch's 4-bit matmuls (fc, each layer's
+# kv) run on the prompt chunks' matmul instead (``forward.mm``'s: ``qmm.prefill_matmul`` on ``forward.prompt_tile``,
+# weights rounded to bf16, one fp32 chain over K): faster, but other bits than decode's in those ring rows, so other
+# drafts (the replies keep: the verify decides every token).
+_WIDE = (os.environ.get("TF_GLM_DRAFT_WIDE", "").strip() or "0").partition(":")
+if not _WIDE[0].isdigit() or (_WIDE[1] and _WIDE[2] != "prompt"):
+    raise ValueError("TF_GLM_DRAFT_WIDE: 0 (off), <rows> (wide launches, the same bits) or <rows>:prompt (wide "
+                     "launches on the prompt chunks' matmul: other draft bits)")
+DRAFT_WIDE, DRAFT_WIDE_PROMPT = int(_WIDE[0]), bool(_WIDE[1])
+
 
