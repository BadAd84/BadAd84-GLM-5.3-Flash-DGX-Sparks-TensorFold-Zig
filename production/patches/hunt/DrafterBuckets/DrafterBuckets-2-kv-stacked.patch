+def stack_parts(qs: list) -> tuple[Q4, list] | None:
+    """Several 4-bit matrices of one shape [n, k] side by side as one [len * n, k] (DrafterBuckets): the stacked Q4
+    and each part again as views into it (its weight a slice, its scales / biases strided column slices, which
+    ``matmul`` reads as they are), so the parts take no memory of their own. None when the shapes or groups differ or
+    n is not a multiple of 128 (``shared.pack`` pads n to 128: a part's columns would not start where its rows do)."""
+
+    q0 = qs[0]
+    if any(not isinstance(q, Q4 | shared.Q4) or (q.n, q.k, q.gs) != (q0.n, q0.k, q0.gs) for q in qs) or q0.n % 128:
+        return None
+    w = torch.cat([q.weight for q in qs])
+    s = torch.cat([q.scales for q in qs], dim=1)
+    b = torch.cat([q.biases for q in qs], dim=1)
+    t = w.shape[0] // len(qs)
+    stacked = type(q0)(weight=w, scales=s, biases=b, n=q0.n * len(qs), k=q0.k, gs=q0.gs)
+    views = [type(q0)(weight=w[i * t:(i + 1) * t], scales=s[:, i * q0.n:(i + 1) * q0.n],
+                      biases=b[:, i * q0.n:(i + 1) * q0.n], n=q0.n, k=q0.k, gs=q0.gs) for i in range(len(qs))]
+    return stacked, views
+
+
+def matmul_parts(x: torch.Tensor, q: Q4, parts: int) -> torch.Tensor:
+    """``matmul`` of ``parts`` equal matrices stacked side by side (``stack_parts``) in one launch: every output column
+    takes its own part's K slices (``split_k``) and decode tile (``dec_tile``) by the part's shape, and a column's
+    chain depends on nothing else, so each part's columns are the bits ``matmul`` gives it alone."""
+
+    if x.shape[1] != q.k or x.stride(1) != 1 or x.dtype != torch.bfloat16:
+        raise ValueError(f"matmul_parts: x {tuple(x.shape)} {x.dtype} does not match K={q.k}")
+    n = q.n // parts
+    return shared.matmul(x, q, group_sums(x), sk=split_k(n, q.k),
+                         variant=dec_tile(n, q.k) if x.shape[0] <= 16 else None)
+
+
