+class TapRows:
+    """Rows lo .. hi of a forward's per-layer DFlash2 taps (``Buffers.taps``), read as their concatenation
+    [rows, taps * D] in layer order without building it (lane DrafterLeftovers): a context update copies the rows it
+    launches straight into its input (``copy_taps``), so a prompt chunk's rows it drops (``ring_skip``,
+    ``WindowTaps``) are never copied, and the rows it keeps are copied once instead of twice. The same bytes land in
+    the input either way. Read before the next forward on those buffers (every update launches its copies before
+    returning)."""
+
+    __slots__ = ("parts", "lo", "hi")
+
+    def __init__(self, parts: list[torch.Tensor], lo: int, hi: int) -> None:
+        self.parts, self.lo, self.hi = parts, int(lo), int(hi)
+
+    @property
+    def shape(self) -> tuple[int, int]:
+        return (self.hi - self.lo, sum(int(p.shape[1]) for p in self.parts))
+
+    def __getitem__(self, rows: slice) -> TapRows:
+        start, stop, step = rows.indices(self.hi - self.lo)
+        if step != 1:
+            raise ValueError("tap rows slice with step 1 only")
+        return TapRows(self.parts, self.lo + start, self.lo + max(start, stop))
+
+    def copy_to(self, out: torch.Tensor) -> None:
+        torch.cat([p[self.lo:self.hi] for p in self.parts], dim=1, out=out)
+
+
+def copy_taps(out: torch.Tensor, taps) -> None:
+    """``out.copy_(taps)`` for a taps tensor or ``TapRows``."""
+
+    if isinstance(taps, TapRows):
+        taps.copy_to(out)
+    else:
+        out.copy_(taps)
+
