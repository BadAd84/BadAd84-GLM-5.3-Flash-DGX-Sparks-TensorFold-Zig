+def _index_from(env=None) -> int:
+    """TF_GLM_COPY_INDEX: contexts of at least this many tokens index their prompt (``GramIndex``); 0 never. The
+    proposals are the same either way, so ranks may differ in it."""
+
+    text = (os.environ if env is None else env).get("TF_GLM_COPY_INDEX", "").strip()
+    if text == "":
+        return INDEX_DEFAULT
+    if not text.isdecimal():
+        raise ValueError(f"TF_GLM_COPY_INDEX: 0 (off) or a context length in tokens, not {text!r}")
+    return int(text)
+
+
+INDEX_DEFAULT = 65536
+INDEX_FROM = _index_from()
+_HASH_MUL = 0x9E3779B97F4A7C15
+_MASK64 = (1 << 64) - 1
+_POOL: ThreadPoolExecutor | None = None
+
+
+def _pool() -> ThreadPoolExecutor:
+    global _POOL
+    if _POOL is None:
+        _POOL = ThreadPoolExecutor(1, thread_name_prefix="copy-index")
+    return _POOL
+
+
+class GramIndex:
+    """The starts of a token array's ``match``-token grams that leave a token after them (0 .. ``limit`` - 1),
+    grouped by a 32-bit hash of the gram. ``lookup`` returns, ascending, every start whose gram hashes like the
+    query's: a superset of the starts whose gram equals it (collisions are the caller's to filter)."""
+
+    def __init__(self, tokens: np.ndarray, match: int) -> None:
+        n = self.match = int(match)
+        self.limit = B = max(int(tokens.shape[0]) - n, 0)
+        t = tokens[:B + n - 1].astype(np.uint64)   # each step below releases the GIL (numpy loops, the sort)
+        mul = np.uint64(_HASH_MUL)
+        h = t[:B].copy()
+        for k in range(1, n):
+            h *= mul
+            h += t[k:k + B]
+        del t
+        h *= mul                                # the last token reaches the high half too
+        h >>= np.uint64(32)
+        keys = h.astype(np.uint32)
+        del h
+        self.order = np.argsort(keys)
+        self.keys = keys[self.order]
+
+    @staticmethod
+    def key(gram: Sequence[int]) -> int:
+        h = 0
+        for t in gram:
+            h = (h * _HASH_MUL + (int(t) & _MASK64)) & _MASK64
+        return ((h * _HASH_MUL) & _MASK64) >> 32
+
+    def lookup(self, gram: Sequence[int]) -> np.ndarray:
+        key = np.uint32(self.key(gram))          # the keys' own dtype: a Python int converts the whole table
+        lo = int(np.searchsorted(self.keys, key, "left"))
+        hi = int(np.searchsorted(self.keys, key, "right"))
+        return np.sort(self.order[lo:hi])
+
