+    def fcost_costs(self, reps: int = 2) -> dict | None:
+        """Both ranks, at start before any stream (lane DrafterLeftovers): the cost table a request's fcost policy
+        prices a round by under --parallel (``engine.decode_policy`` / ``round_costs``, its only reader there), from
+        this scheduler's own graphs: one stream's batched window of 1 .. 8 rows (``_time_rows``, or the joint
+        policy's table), a one-stream block pass and the smallest row bucket's context update per row
+        (``MultiDrafter.time_passes``; ``_calibrate``'s ``taps8`` / 8 likewise); fastest of ``reps`` + 1, the larger
+        of both ranks'. None without the window's graphs (``GlmEngine._calibrate`` then times its own)."""
+
+        from .engine import GRAPH_ROWS
+
+        v = self.verify
+        if not isinstance(v, BatchedVerify) or not v.graphs:
+            return None
+        widest = max(GRAPH_ROWS)
