# DrafterLeftovers-3b (lane DrafterLeftovers, 2026-10-30; HuntDrafter F8): no _calibrate in a --parallel boot.
# GlmEngine._calibrate spent ~4.5 s of every boot (boot log "calibration (4.5s)") timing eager one-stream windows,
# MTP steps and a solo DFlash2 pass for a cost table that under --parallel only a request naming an fcost policy reads
# (decode_policy -> round_costs); production's fnc7:0.3 (and every other policy) never reads it. Under --parallel the
# table is now priced once the scheduler is built, on its own graphs (MultiDecoder.fcost_costs): one stream's batched
# window of 1..8 rows (_time_rows(most=8), or TF_GLM_MULTI_DEPTH=joint's table), a one-stream block pass and the
# smallest row bucket's update per row (MultiDrafter.time_passes, on the trash tables), the larger of the ranks'.
# --parallel 1 calibrates as before. Policy decisions: unchanged for every policy but fcost (tested); fcost is now
# priced on the windows it runs (the eager v1 44 ms against ~21 ms graphed was a latent mispricing).
# Boot only; replies unchanged. Applies with `patch -p0` in the folder holding tensorfold/, after DrafterLeftovers-2.
# 3b: re-made against stack/all6's base + DrafterLeftovers-2b (no fuzz).
--- tensorfold/families/glm5_next/cuda/dflash2_multi.py
+++ tensorfold/families/glm5_next/cuda/dflash2_multi.py
@@ -364,6 +364,30 @@
         for c, e in zip(self.contexts, ends):
             c.context_end = e
 
+    @torch.no_grad()
+    def time_passes(self, reps: int = 3) -> tuple[float, float]:
+        """GPU ms of a one-stream block pass and of the smallest row bucket's context update (each captured graph
+        replayed once unmeasured, then the fastest of ``reps``) on the trash tables, as ``capture`` runs them: the
+        streams' ring rows, device ends and context ends are not touched (the update writes the trash rows and the
+        trash end only). Both ranks together (the pass all-gathers), before any stream decodes
+        (``multi.MultiDecoder.fcost_costs``, lane DrafterLeftovers)."""
+
+        torch.cuda.synchronize()
+        self._trash_tables()
+        start, stop = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        out = []
+        for g in (self.block_graphs[1], self.tap_graphs[self.buckets[0]]):
+            best = float("inf")
+            for i in range(max(1, int(reps)) + 1):
+                start.record()
+                g.replay()
+                stop.record()
+                stop.synchronize()
+                if i:
+                    best = min(best, start.elapsed_time(stop))
+            out.append(best)
+        return out[0], out[1]
+
     def drop_graphs(self) -> None:
