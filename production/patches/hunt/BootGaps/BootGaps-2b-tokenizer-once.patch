diff -r tensorfold/cuda/tokenizer_file.py ../tok6/tensorfold/cuda/tokenizer_file.py
--- tensorfold/cuda/tokenizer_file.py	1970-01-01 00:00:00.000000000 +0000
+++ tensorfold/cuda/tokenizer_file.py	2026-10-30 06:54:56.236665400 +0000
@@ -0,0 +1,74 @@
+"""One ``tokenizers.Tokenizer`` per checkpoint folder per process (lane BootGaps).
+
+GLM's rank 0 read the checkpoint's 20 MB ``tokenizer.json`` twice during its start, each on the boot's critical
+path: the vision tower's (``vision.glm.GlmVision``) and the server's (``server.App``), ~0.7-1.0 s each on a
+workstation. ``preload`` starts the read on a daemon thread when the engine starts (``Tokenizer.from_file`` releases
+the GIL for its parse: a main-thread spin beside it keeps 84-101% of its pace), so the weights load hides it; ``load``
+hands every caller that one object. A ``Tokenizer`` is only read here (no padding, truncation or added tokens are set
+on it anywhere in the package), so a shared one encodes and decodes as a caller's own did.
+"""
+
+from __future__ import annotations
+
+import threading
+from pathlib import Path
+from typing import Any
+
+_LOCK = threading.Lock()
+_FILES: dict[str, "_Load"] = {}
+
+
+class _Load:
+    def __init__(self, path: str) -> None:
+        self.path = path
+        self.done = threading.Event()
+        self.tok: Any = None
+        self.error: BaseException | None = None
+
+    def run(self) -> None:
+        try:
+            from tokenizers import Tokenizer
+
+            self.tok = Tokenizer.from_file(self.path)
+        except BaseException as exc:  # noqa: BLE001 - handed to the caller of ``load``
+            self.error = exc
+        finally:
+            self.done.set()
+
+
+def _key(model_dir: str | Path) -> str:
+    return str(Path(model_dir) / "tokenizer.json")
+
+
+def preload(model_dir: str | Path) -> None:
+    """Start reading ``model_dir``'s tokenizer.json on a daemon thread (once; nothing when there is none)."""
+
+    path = _key(model_dir)
+    if not Path(path).is_file():
+        return
+    with _LOCK:
+        if path in _FILES:
+            return
+        job = _FILES[path] = _Load(path)
+    threading.Thread(target=job.run, name="tensorfold-tokenizer", daemon=True).start()
+
+
+def load(model_dir: str | Path) -> Any:
+    """``Tokenizer.from_file(model_dir / "tokenizer.json")``, the same object on every call: the preloaded one
+    (waiting for its read), else read now. A failed read raises its error, here as it did at the caller."""
+
+    path = _key(model_dir)
+    with _LOCK:
+        job = _FILES.get(path)
+        mine = job is None
+        if mine:
+            job = _FILES[path] = _Load(path)
+    if mine:
+        job.run()
+    job.done.wait()
+    if job.error is not None:
+        with _LOCK:                      # a failure is not kept: the next call reads again, as before
+            if _FILES.get(path) is job:
+                del _FILES[path]
+        raise job.error
+    return job.tok
