@@ -9,6 +9,24 @@
 from .mtp import mtp_compute
 
 
+def capture(run, pool) -> torch.cuda.CUDAGraph:
+    """A CUDA graph of ``run()`` (lane BootGaps): ONE eager run first, then the capture into ``pool``. The eager run
+    does what a window's first call does once (extension builds and loads, Triton specialisations, cuBLAS handles and
+    workspaces, the caching allocator's blocks); none of the captured windows changes host state a later call reads
+    (positions, parities, extents and tables are device tensors or set by the caller before each capture), so a second
+    eager run left every launch the capture records as the first one did. Every capture site of the GLM engine takes
+    this (one-stream graphs here, ``verify.BatchedVerify``, ``dflash2.Drafter``, ``dflash2_multi.MultiDrafter``); it
+    was two eager runs a graph, ~44 ms each at boot (an eager window's RoCE gathers each wait in an NCCL barrier until
+    ``RoceComm.settle``)."""
+
+    run()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g, pool=pool):
+        run()
+    return g
+
+
 def pool_buckets(np_max: int) -> list[int]:
     """Every value ``sparse.pool_bucket`` can return for a sparse step (past TOPK_POOLS complete pools)."""
     out, b = [], 1024
