+def kept_state_bytes(t: dict, world: int = 2, rank: int = 0, draft: dict | None = None) -> int:
+    """The device bytes one kept --parallel state owns outside the pool on rank ``rank`` of ``world`` (``t``: the
+    target's text config; ``draft``: the DFlash2 drafter's config, None without one), from the shapes the code copies:
+    ``decode.take_snapshot``'s KDA states (one parity of ``forward.Slots.rec``) and conv windows (``Slots.conv``), the
+    indexer rings' tail (``_ring_tail``: at most 3 rows of keys and gates a ring), the head row a prompt's end keeps
+    (``multi._keep``: one bf16 logits row of this rank's vocabulary share, at most), and the DFlash2 window copy
+    (``decode._ring_window`` / ``_drafter_views``: the drafter window's rows of every draft layer's keys and values,
+    this rank's KV heads, ``tp.draft_parts``). It replaced a fixed ``slot_bytes(rows=0) // 2 + 22 MiB``: half the
+    conv windows plus 22 MiB, which fits the window copy at two ranks (4 KV heads: 20 MiB) but over-reserves it at
+    three (rank 0: 69.57 MiB reserved for 63.39 MiB held, /health kept_bytes 66,472,960 a state) and under-reserves a
+    longer TF_GLM_DRAFT_WINDOW."""
+
+    from tensorfold.cuda.geometry import draft_window, layer_counts
+
+    from .tp import UNITS, draft_parts, split_sizes
+
+    linear, dsa = layer_counts(t)
+    lin = t.get("linear_attn_config") or {}
+    lh = split_sizes(int(lin.get("num_heads", t.get("linear_num_heads", 64))), world, UNITS["lin"])[rank]
+    ld = int(lin.get("head_dim", t.get("linear_head_dim", 128)))
+    conv = int(lin.get("short_conv_kernel_size", t.get("linear_conv_kernel_dim", 4)))
+    held = linear * (lh * ld * ld * 4 + (conv - 1) * 3 * lh * ld * 2)       # rec (fp32, one parity) + conv (bf16)
+    rings = dsa + int(t.get("num_nextn_predict_layers", 0) or 0)          # the DSA layers' rings and the MTP layer's
+    held += rings * (3 * 8 + 2 * 3 * int(t.get("index_head_dim", 128)) * 2)  # slots (int64) + [2, <=3, dim] bf16
+    held += -(-int(t["vocab_size"]) // world) * 2                         # a kept head row (bf16 logits)
+    if draft is not None:
+        _, kvs, _ = draft_parts(int(draft["num_attention_heads"]), int(draft["num_key_value_heads"]),
+                                int(draft["intermediate_size"]), world)
+        hd = int(draft.get("head_dim") or int(draft["hidden_size"]) // int(draft["num_attention_heads"]))
+        held += int(draft["num_hidden_layers"]) * 2 * kvs[rank] * draft_window(draft)[0] * hd * 2
+    return held
+
