+    def newest_states(self) -> list[Point]:
+        """Rank 0, before the first request (TF_GLM_SPILL_BOOT_RESTORE, ``MultiDecoder.boot_plan``): each
+        conversation's newest complete state (the newest leaf of its path, the one ``_victims`` keeps longest), most
+        recently used first, then the shared-prefix states, most recently used first."""
+
+        with self.lock:
+            parent, conv = self._tree()
+            children: dict[str, list[str]] = {}
+            for k, p in parent.items():
+                if p is not None:
+                    children.setdefault(p, []).append(k)
+            groups: dict[str, list[str]] = {}
+            for k, c in conv.items():
+                groups.setdefault(c, []).append(k)
+            out = []
+            for c, keys in groups.items():
+                if c is None:
+                    continue
+                leaves = [k for k in keys if not [x for x in children.get(k, []) if conv.get(x) == c]]
+                out.append(self.index[max(leaves or keys, key=lambda k: (self.index[k].used, self.index[k].n))])
+            out.sort(key=lambda p: (-p.used, -p.n))
+            out += sorted((self.index[k] for k in groups.get(None, [])), key=lambda p: (-p.used, -p.n))
+            return [p for p in out if all(b in self.have for b in p.blocks)]
