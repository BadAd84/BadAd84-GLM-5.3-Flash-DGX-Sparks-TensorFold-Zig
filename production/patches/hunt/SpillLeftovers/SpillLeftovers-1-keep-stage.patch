+    def _take_slots(self, need: int) -> list[int] | None:
+        """The engine: ``need`` free write-ring slots at once, or None (and none taken)."""
+
+        got: list[int] = []
+        while len(got) < need:
+            try:
+                got.append(self.free_slots.get_nowait())
+            except queue.Empty:
+                for slot in got:
+                    self.free_slots.put(slot)
+                return None
+        return got
+
+    def _stage_small(self, items: list):
+        """The engine (``persist``): a small state's tensors' bytes, in its file's order (``_small_parts``), into free
+        write-ring slots: copies on the current stream into pinned memory, the event of the last slot recorded after
+        them (made at start, ``ring``), nothing waited for. (slots, pieces, event) for ``_lay_small``, or None when the
+        ring has too few free slots now (never more than half of it: the pumps go on)."""
+
+        self.ring()
+        per = self.slots[0].numel()
+        nbytes = sum(t.numel() * t.element_size() for _, t in items)
+        need = max(1, -(-nbytes // per))
+        if need > len(self.slots) // 2:
+            return None
+        got = self._take_slots(need)
+        if got is None:
+            return None
+        pieces: list[tuple[int, int, int]] = []              # (slot, offset, bytes) in file order
+        k = off = 0
+        try:
+            for _, t in items:
+                if not t.numel():
+                    continue
+                flat = t.contiguous().view(-1).view(torch.uint8)
+                a, n = 0, flat.numel()
+                while a < n:
+                    if off == per:
+                        k, off = k + 1, 0
+                    m = min(n - a, per - off)
+                    self.slots[got[k]][off:off + m].copy_(flat[a:a + m], non_blocking=True)
+                    pieces.append((got[k], off, m))
+                    off, a = off + m, a + m
+            ev = self.slot_events[got[-1]] if self.slot_events else None
+            if ev is not None:
+                ev.record()
+        except BaseException:
+            for slot in got:                                # (anything staged there next is queued after these)
+                self.free_slots.put(slot)
+            raise
+        return got, pieces, ev
+
+    def _lay_small(self, items: list, layer: dict, got: list[int], pieces: list, ev) -> _Assembled:
+        """The small-state helper thread: once the copies ``_stage_small`` queued ended, the ``.st`` file's bytes laid
+        out as ``_put`` writes them (``_small_parts``'s header and tensors, padded with zeros to 4 KiB), the slots given
+        back. ``items``' tensors are read for their dtype and shape only."""
+
+        try:
+            if ev is not None:
+                ev.synchronize()
+            header, _ = _sp._header(items, {"format": FORMAT, "layer": json.dumps(layer)})
+            total = len(header) + sum(m for _, _, m in pieces)
+            buf = _aligned_buffer(total)
+            buf[:len(header)] = np.frombuffer(header, dtype=np.uint8)
+            at = len(header)
+            for slot, off, m in pieces:
+                buf[at:at + m] = self.slots[slot][off:off + m].numpy()
+                at += m
+            buf[at:] = 0
+            return _Assembled(buf, total)
+        finally:
+            for slot in got:
+                self.free_slots.put(slot)
+
+    def _stage_rows(self, where, s: int, e: int):
+        """The engine: tokens [s, e) of the extent at ``where`` off the device now. Into a free write-ring slot as
+        ``pump`` stages a block (one gather into the device slot, one copy to pinned memory on the current stream, the
+        slot's event after): (slot, bytes, event), the writer's "block" item; else (no slot free) copied to fresh host
+        memory (``_host``), its "rows" item."""
+
+        self.ring()
+        got = self._take_slots(1)
+        if got is None:
+            return _host(torch.cat(self._parts(where, s, e)))
+        slot = got[0]
+        try:
+            parts = self._parts(where, s, e)
+            nb = sum(t.numel() for t in parts)
+            torch.cat(parts, out=self.dev_slot[:nb])
+            self.slots[slot][:nb].copy_(self.dev_slot[:nb], non_blocking=True)
+            ev = self.slot_events[slot] if self.slot_events else None
+            if ev is not None:
+                ev.record()
+        except BaseException:
+            self.free_slots.put(slot)
+            raise
+        self.stats["cut_staged"] += 1
+        return slot, nb, ev
+
