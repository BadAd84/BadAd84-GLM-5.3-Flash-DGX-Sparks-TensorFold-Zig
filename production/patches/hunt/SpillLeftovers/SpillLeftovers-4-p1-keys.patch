+def int64s(ids: Sequence[int]) -> np.ndarray:
+    """``np.asarray(ids, dtype=np.int64)``, the same values: an array as it is; a list of ints through ``array.array``
+    (~20 against ~27 ms at 772k ids on the workstation), anything else (or a list it refuses) through numpy."""
+
+    if type(ids) is list:
+        try:
+            return np.frombuffer(array.array("q", ids), dtype=np.int64)
+        except (TypeError, OverflowError):
+            pass
+    return np.asarray(ids, dtype=np.int64)
+
+
+def _arr_key(a: np.ndarray) -> tuple[int, int]:
+    h = hashlib.sha1(a.tobytes()).digest()
     return int.from_bytes(h[0:4], "big", signed=True), int.from_bytes(h[4:8], "big", signed=True)
 
 
+def ids_key(ids: Sequence[int]) -> tuple[int, int]:
+    return _arr_key(int64s(ids))
+
+
+def _ids_json(ids: Sequence[int], arr: np.ndarray | None = None) -> str:
+    """``json.dumps([int(t) for t in ids])``, the same text: a list of plain ints dumped as it is, anything else as its
+    int64 values (``arr``, if made already). ~70 against ~110 ms at 772k ids on the workstation."""
+
+    if type(ids) is list and set(map(type, ids)) <= {int}:
+        return json.dumps(ids)
+    return json.dumps((int64s(ids) if arr is None else arr).tolist())
+
