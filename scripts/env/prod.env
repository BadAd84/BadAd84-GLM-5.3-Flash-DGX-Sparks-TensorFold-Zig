# prod.env - the PRODUCTION environment of this serve, complete: every row of zig/src/platform/environment.zig whose scope this
# serve reads (glm, cuda, common) is set here. One NAME=value a line, no spaces in a value; a line starting with # is a comment.
# KNOBS=measured (or prod, or all) applies both sections below, KNOBS=off only the runtime one.
#
# NO ROW IS LEFT UNSET (owner 2026-11-23). The recipe section holds two kinds of line: the adopted recipe, a value measured
# against this stack with its cells (docs/KNOBS.md names each cell's OVERNIGHT section), and the completeness block, every
# remaining row at the engine's own default, the argument its reader passes when the setting is absent. A completeness line
# boots the same as the row unset; it is debt in scripts/env/register.env until a measurement earns it a cell, and it then
# moves up into the adopted recipe in the same commit as that cell. A row the table gains that neither block sets is a hard
# stop: scripts/env/check-env-coverage.py fails on it, so a rebase cannot inherit a new default silently.
#
# A BLANK value is a decision, not an omission: it is the engine's own default where that default is "no value" (no dump
# file, no captured kernel set, no HIP limit), or a value the launcher computes per boot (the rank, the world, the memory
# reserve). serve.sh does not pass a blank line, so the engine sees exactly the absent setting the row documents.
# dev.env carries every name of this file (scripts/check-env.py), so a boot of the development environment differs from a
# production boot only by the lines dev.env adds or changes in its candidates section.
# --- runtime
# The runtime, applied by every KNOBS mode (off included): the production stack's NCCL shape (ai-engine serve4.sh's measured set: P2P and SHM off, 4
# channels, cross-NIC routing, GID 3, the four RoCE HCAs, a LAN socket name) so a boot here and a production boot are comparable, and the
# serve's fixed model settings. serve.sh adds what depends on the boot: rank, world, memory reserve and NCCL_COMM_ID. A caller's own
# NCCL_IB_HCA or NCCL_SOCKET_IFNAME in the launching environment wins over the lines here (serve.sh's CALLER_WINS).
HF_HUB_OFFLINE=1
TENSORFOLD_NO_UPDATE_CHECK=1
TF_GLM_HEAD_BITS=8
TF_GLM_DENSE_BITS=4
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_GID_INDEX=3
NCCL_IB_HCA=roceP2p1s0f0,roceP2p1s0f1,rocep1s0f0,rocep1s0f1
NCCL_SOCKET_IFNAME=enP7s7
#
# --- recipe
# KDA_PAD to MLA_FUSEMERGE: the arm measured together (docs/OVERNIGHT-2026-11-12.md section 17).
TF_GLM_KDA_PAD=1
TF_GLM_OVN_KEPT_WALK=1
TF_GLM_OVN_DRAFT_ONEPASS=1
TF_GLM_OVN_DRAFT_DOWN4=1
TF_GLM_OVN_DRAFT_MLPSPLIT=4
TF_GLM_OVN_MLA_FUSEMERGE=1
# Production's DFlash2 chain rule (fnc7:0.3, section 22).
TF_GLM_OVN_DRAFT_EDGE=0.6
TF_GLM_OVN_DRAFT_BETA=2
TF_GLM_OVN_DRAFT_CUTS=1:0.3
# Production's routed-expert decode kernel set (section 24). The 16-pair item plan these ran beside is upstream's unconditional decode path on
# this base (upstream 4e6cdeed9 and 51a6fe02a, our PR #2044), so TF_GLM_OVN_EXL3_ITEMS has no line.
TF_EXL3_DEC_ORDER=1
TF_GLM_OVN_X3_NC=1
TF_GLM_OVN_X3_XROW=1
TF_GLM_OVN_X3_FUSEDOWN=1
# KEEP_SEQS was measured with EY_DIRECT at 1/2/4/6/8 streams (sections 30 and 34); EY_DIRECT's win is upstream's own path now.
TF_GLM_OVN_KEEP_SEQS=1
# Sets no speed cell: it is the prompt production sends. A thinking-off request renders without its default `Reasoning Effort: Max` line, so
# its replies are not token-identical to the knob-off ones by design.
TF_GLM_OVN_OFF_EFFORT_LINE=1
# The last seven joined together (sections 45 to 49 and the queue71 and queue72 records in docs/KNOBS.md): replies equal the recipe's on every
# cell and the pairs show no level slower. NO_COPY: a DFlash2 drafter's windows without copied continuations. MM_DECTILE: a decode-window
# tile variant of the matmul launch. SWIGLU_REDUCE: the reduce and the swiglu in one launch (both checked byte for byte against the default
# launches by glm-mm-ovn). ONEPASS_PIPE: the DSA block's prompt rows on the one-pass pipeline. CHUNK_SOLO=4096: upstream's one 4,096-row
# prompt step while no stream decodes. HOST_ONCE: a request rendered once. DRAFT_NOISE: a sampled stream's draft pick uses the target's keyed
# Gumbel draws (a greedy stream never reads it).
TF_GLM_OVN_NO_COPY=1
TF_GLM_OVN_MM_DECTILE=100000
TF_GLM_OVN_SWIGLU_REDUCE=1
TF_GLM_OVN_ONEPASS_PIPE=1
TF_GLM_CHUNK_SOLO=4096
TF_GLM_OVN_HOST_ONCE=1
TF_GLM_OVN_DRAFT_NOISE=1
# Promoted from the candidates section on the queue116 receipts: the whole dev env against this recipe at 1, 2, 4,
# 6 and 8 streams read +0.15, +0.99, -0.22, +0.28 and +0.23% in its favour, every level inside the boot spread,
# and the cold prompt is 6.9% faster at 8k and 7.4% at 32k on the T bundle with X another 2.8% (sections 94 and 95).
TF_GLM_OVN_ABSORB_VEC=1
TF_GLM_OVN_MM_WIDE=1
TF_GLM_OVN_SIDE_PRIO=1
TF_GLM_OVERLAP_PIECES=4
TF_GLM_OVN_LATENT_ROWS=2
TF_GLM_OVN_PIECE_FRONT=1
TF_GLM_OVN_PIECE_FFN=1
TF_GLM_OVN_PIECE_MLA=1
NCCL_NCHANNELS_PER_NET_PEER=4
TF_GLM_OVN_SOLO_TO_START=1
TF_GLM_OVN_RESTORE_HELD=1
# Set to the engine's own default, and measured: the default holds.
#   TF_CACHE_EVICT=main: queue98 (E3) served decayed_resume, no gain, reply-equal (docs/KNOBS.md).
#   TF_GLM_PDL=1: queue91 mz1 read PDL=0 2.48 to 4.02 percent lower over 12 cells (docs/KNOBS.md).
#   TF_ROCE_GID_INDEX=3: the engine's own table search picks index 3 on all four HCAs (docs/ENV-REGISTER.md).
TF_CACHE_EVICT=main
TF_GLM_PDL=1
TF_ROCE_GID_INDEX=3
#
# --- completeness: every remaining row of the table, at its own default (debt; scripts/env/register.env)
# Each line's value is the argument the row's reader passes when the setting is absent, so a boot with these lines reads
# exactly as the row unset (a blank line is that absent setting, and serve.sh does not pass it). The register carries the
# per-row verdict; a row that measures a gain moves up into the adopted recipe above, with its cells, in the same commit.
# common
TF_STARTUP_RECEIPT=0
TF_SHARED_PRICE_LOG=0
TENSORFOLD_DEVICE_CHECK=1
TENSORFOLD_VIDEO_TOKENS=16384
TENSORFOLD_MAX_PDF_PAGES=16
TENSORFOLD_PARALLEL=
TENSORFOLD_PRESSURE_CACHE_PERCENT=50
TENSORFOLD_PREFIX_WAIT_MS=0
TENSORFOLD_RESTORE_PREFETCH=2
TENSORFOLD_RESTORE_PREFETCH_GIB=16
TENSORFOLD_RESTORE_PREFETCH_MS=30000
TENSORFOLD_TOOL_ID_KEY_FILE=
# cuda
TF_FLASHNEXT_BATCH_DRAWS=1
TENSORFOLD_CUDA_KERNELS=
TF_NCCL_LIB=libnccl.so.2
TF_CUDA_DEVICE=0
TF_CUDA_SEGMENTS=1
TF_CUDA_CARVEOUT=0
TF_CUDA_CARVEOUT_MIB=1792
TF_MTP_DRAFTS=3
TF_DSPINE_WINDOW=
TF_DRAFT_NODES=15
TF_QMMF_HALF_BELOW=96
TF_HY4_MEM_FLOOR_GIB=10
TENSORFOLD_MEMORY_RESERVE_GIB=
TENSORFOLD_HIP_MEMORY_LIMIT_GB=
TF_QWEN_KEEP_LATE=0
TF_QWEN_KV_PAGE_TEST=
TF_COST_KEY_TRACE=0
TF_TIMING=0
TF_NO_TREES=0
TF_MTP_TREES=0
TF_MTP_BATCH=1
TF_QWEN_POOL_LOG=0
TF_Q27_POCKET_OFF=
TF_Q27_TAIL=
TF_Q27_GEMM=
TENSORFOLD_PROMPT_CACHE_KEEP_OTHERS=0
TF_PROMPT_INTERMEDIATE=0
TENSORFOLD_LFM2_KV_PAGES=1
TENSORFOLD_UNIFIED_HOST_COUNTS=0
TF_QWEN35_CHUNK_SOLO=4096
# glm
TF_GLM_RANK=
TF_GLM_WORLD=
TF_GLM_HOST_CACHE=0
TF_GLM_VISION_HOST=0
TF_GLM_PROF=0
TF_GLM_LINK_WAIT=0
TF_GLM_PROMPT_STEPS=1
TF_GLM_PROMPT_MANY=0
TF_GLM_SHARED=1
TF_GLM_DSEL=1
TF_GLM_DSCORES=1
TF_GLM_DFLASH2_LOG=0
TF_GLM_DRAFT_CONFIDENCE=0.7
TF_GLM_CONTEXT_CEILING=
TF_GLM_EXPERT_FORM=
TF_GLM_KDA_DUMP=
TF_GLM_INDEX_DECODE_FROM=0
TF_GLM_OVN_DECODE_INDEX=0
TF_GLM_OVN_MULTI_FILL=0
TF_GLM_OVN_KVB8=0
TF_GLM_OVN_FRONT_ROWS=0
TF_GLM_OVN_GLUE_FUSE=0
TF_GLM_OVN_GLUE_ROW=0
TF_GLM_OVN_PDL_EARLY=0
TF_GLM_OVN_DISK_SLICE_MIB=0
TF_GLM_INDEX_CUDA=1
TF_GLM_KV_HOST_GIB=
