new file mode 100644
index 0000000..96ac308
--- /dev/null
+++ b/zig/cache_agent_sweep.zig
@@ -0,0 +1,93 @@
+//! A sweep over the frozen agent traces: the replay's own state sizes at capacities converted from another
+//! serve's budget, and that serve's measured kept-state sizes at its own budget. Host only, no device, no serve.
+const std = @import("std");
+const traces = @import("cache_agent_trace.zig");
+const common = @import("cache_replay_trace.zig");
+const run = @import("cache_replay_run.zig");
+const model = @import("cache_replay_model.zig");
+
+const MIB: u64 = 1 << 20;
+
+/// GLM-5.3-Flash at TP=3 as served: a kept state is `page2M(fixed + per_row * at)`, from queue91's probe rows
+/// (202, 352 and 888 MiB at 7,999, 32,014 and 120,388 rows; the 168 MiB minimum at 2,048). `ours-measured`
+/// keeps 11 caches' rows, 6,378 a row, which is 11 x (512 + 4 + 64) bytes; `ours-layout` prices the source's
+/// own page math for 12 caches, 6,960 a row, and `ours-mid` sits between the two fits.
+const ours_measured: model.Model = .{ .padded = true, .recurrent = 162_843_852, .per_token = 6_378, .eighths = 0, .align_bytes = 2 * MIB };
+const ours_mid: model.Model = .{ .padded = true, .recurrent = 163_420_569, .per_token = 6_662, .eighths = 0, .align_bytes = 2 * MIB };
+const ours_layout: model.Model = .{ .padded = true, .recurrent = 163_997_286, .per_token = 6_947, .eighths = 0, .align_bytes = 2 * MIB };
+const budget_ours: u64 = 8_426_464_256;
+
+const Set = struct { name: []const u8, params: traces.Params };
+const sets = [_]Set{
+    .{ .name = "default", .params = .{} },
+    .{ .name = "conversations-3", .params = .{ .conversations = 3 } },
+    .{ .name = "conversations-12", .params = .{ .conversations = 12 } },
+    .{ .name = "prefix-32768", .params = .{ .prefix = 32768, .base = 65_536, .stride = 4096, .growth = 2048, .one_sizes = .{ 4096, 16_384, 32_768, 48_000 } } },
+    .{ .name = "rounds-24", .params = .{ .rounds = 24 } },
+    .{ .name = "prefix-32768-rounds-24", .params = .{ .rounds = 24, .prefix = 32768, .base = 65_536, .stride = 4096, .growth = 2048, .one_sizes = .{ 4096, 16_384, 32_768, 48_000 } } },
+};
+
+const Cell = struct { label: []const u8, m: model.Model, budget: u64, ref_rows: u32 = 0 };
+
+fn runCell(a: std.mem.Allocator, out: anytype, set: []const u8, shape: traces.Shape, seed: u64, trace: *const common.Trace, cell: Cell) !void {
+    for ([_]run.policy.Policy{ .main, .decayed_resume }) |selected| {
+        var replay: run.Replay = undefined;
+        replay.init(a, selected, cell.budget, cell.m);
+        defer replay.deinit();
+        var stats: run.Stats = .{};
+        defer stats.deinit(a);
+        for (trace.requests) |request| try stats.add(a, request, try replay.request(request));
+        try out.print("{{\"set\":\"{s}\",\"trace\":\"{s}\",\"seed\":{d},\"cell\":\"{s}\",\"policy\":\"{s}\",\"budget_bytes\":{d},\"budget_mib\":{d},\"ref_rows\":{d},\"state_2048\":{d},\"state_8192\":{d},\"state_32768\":{d},\"state_120000\":{d},\"digest\":\"{x}\",\"requests\":{d},\"hits\":{d},\"prompt_rows\":{d},\"rebuilt_rows\":{d},\"evictions\":{d},\"peak_bytes\":{d}}}\n", .{
+            set, @tagName(shape), seed, cell.label, @tagName(selected), cell.budget, cell.budget / MIB, cell.ref_rows,
+            cell.m.bytes(2048), cell.m.bytes(8192), cell.m.bytes(32768), cell.m.bytes(120_000),
+            trace.digest, stats.requests, stats.hits, stats.prompt_tokens, stats.recompute_tokens, stats.evicted, replay.peak_bytes,
+        });
+    }
+}
+
+pub fn main(init: std.process.Init) !void {
+    var buffer: [8192]u8 = undefined;
+    var stdout = std.Io.File.stdout().writerStreaming(init.io, &buffer);
+    const out = &stdout.interface;
+    const sim_model: model.Model = .{};
+    // Our capacity in the replay's own unit: the states of a reference length this serve's budget holds under
+    // the measured model, times the replay's bytes for one such state.
+    const refs = [5]u32{ 8192, 16_384, 32_768, 42_512, 120_000 };
+    const ref_labels = [5][]const u8{ "converted-8192", "converted-16384", "converted-32768", "converted-42512", "converted-120000" };
+    const ours = [3]model.Model{ ours_measured, ours_mid, ours_layout };
+    const ours_labels = [3][]const u8{ "ours-measured", "ours-mid", "ours-layout" };
+    const seeds = [3]u64{ 7, 11, 23 };
+    const shapes = [2]traces.Shape{ .agent_loops, .agent_cohorts };
+    for (sets, 0..) |set, si| {
+        const default_set = si == 0;
+        for (shapes) |shape| {
+            for (seeds) |seed| {
+                var trace = try traces.makeParams(init.gpa, shape, seed, set.params);
+                defer trace.deinit();
+                if (default_set) try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = "replay-16gib", .m = sim_model, .budget = 16 << 30 });
+                if (seed == 7) {
+                    if (default_set) {
+                        try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = "replay-4gib", .m = sim_model, .budget = 4 << 30 });
+                        try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = "replay-8gib", .m = sim_model, .budget = 8 << 30 });
+                    }
+                    for (refs, ref_labels) |at, label| {
+                        const held = budget_ours / ours_measured.bytes(at);
+                        try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = label, .m = sim_model, .budget = held * sim_model.bytes(at), .ref_rows = at });
+                    }
+                }
+                for (ours, ours_labels) |m, label| {
+                    try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = label, .m = m, .budget = budget_ours });
+                }
+                // The same measured sizes at the smaller budgets a cheap served A/B could run: pressure at 8k prefixes.
+                if (seed == 7) {
+                    const small_budgets = [3]u64{ 2 << 30, 4 << 30, 6 << 30 };
+                    const small_labels = [3][]const u8{ "ours-measured-2gib", "ours-measured-4gib", "ours-measured-6gib" };
+                    for (small_budgets, small_labels) |budget, label| {
+                        try runCell(init.gpa, out, set.name, shape, seed, &trace, .{ .label = label, .m = ours_measured, .budget = budget });
+                    }
+                }
+            }
+        }
+    }
+    try out.flush();
+}
